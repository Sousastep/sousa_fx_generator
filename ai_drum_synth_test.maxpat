                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1988.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// kick_808_tension.txt — triggered kick drum: sine body whose pitch falls with\n//                        its energy (tension modulation), loopback-FM\n//                        harmonics for small speakers, soft contact beater\n//\n// From: K. J. Werner, J. S. Abel, J. O. Smith III, \"A Physically-Informed,\n//       Circuit-Bendable, Digital Model of the Roland TR-808 Bass Drum\n//       Circuit\", DAFx-14: §4 (pulse shaper: the trigger is a short smooth\n//       pulse, not a step), §8.1 (frequency shift on attack), §8.2 (pitch\n//       sigh: the centre frequency rises while the swing is large);\n//       R. Marogna, F. Avanzini, B. Bank, \"Energy Based Synthesis of Tension\n//       Modulation in Membranes\", DAFx-10 P49: §2.3, §3.2 eq. 20 (quasistatic\n//       tension is proportional to membrane energy, f ~ sqrt(tension));\n//       J. Hsu, T. Smyth, \"Percussion Synthesis using Loopback Frequency\n//       Modulation Oscillators\", SMC-19: §3.2 eq. 4-5, §3.4 eq. 8-9 (closed\n//       form z0 = (b0 + e^jT)/(1 + b0 e^jT): b0 sets the harmonic series\n//       independently of the integrated phase T);\n//       F. Avanzini, D. Rocchesso, \"Modeling Collision Sounds: Non-Linear\n//       Contact Force\", DAFx-01: §2.1 (contact force ~ compression^alpha,\n//       contact time shortens with hardness).\n//\n// Body: phase-integrated oscillator at f = tune * sqrt(1 + k * tension),\n// tension decaying with drop_ms and topped up by each hit (energy adds, so a\n// retrigger into a ringing drum starts a little sharper). Its waveform is\n// Re{z0} - b0 with b0 <= 0 driven by a fast envelope plus the amplitude, so\n// the attack carries a harmonic series (audible on phones) that thins to a\n// clean sine as the note dies (b0 is also capped so the series is -60 dB\n// at Nyquist on high tunings). Gentle tanh for weight; a -3 dB tilt at\n// 800 Hz keeps loudness even across the tuning range. Beater: half-sine^1.5\n// contact pulse, lowpassed (no click) plus a band-passed \"knock\".\n// Every hit moves a random-walk strike spot (detune, brightness, knock\n// pitch, contact time); a retrigger ramps from the current level (no reset,\n// phase continuous) with a shorter, quieter contact.\n//\n// Inlets:\n//   in1: audio-rate trigger (single-sample click, rising edge above 0.1)\n// Outlets:\n//   out1 / out2: audio (mono kick on both)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Tune (settled pitch)\n@param({ min: 35, max: 800, exponent: 3 }) tune_hz = 50;\n// Decay (time to -40 dB)\n@param({ min: 80, max: 1500, exponent: 2 }) decay_ms = 380;\n// Pitch drop at the hit\n@param({ min: 0, max: 36 }) drop_st = 14;\n// Pitch drop time\n@param({ min: 5, max: 200, exponent: 2 }) drop_ms = 35;\n// Harmonics (loopback FM brightness + weight)\n@param({ min: 0, max: 100 }) harmonics = 45;\n// Beater\n@param({ min: 0, max: 100 }) beater = 40;\n// Hit-to-hit variance\n@param({ min: 0, max: 100 }) variance = 35;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state rng = new noise();\n@state thumpLp = new onepole();\n@state dcLp = new onepole();\n\n@state prevTrig = 0.0;\n@state lastSr = 0.0;\n@state lastDecay = -1.0;\n@state lastDrop = -1.0;\n@state kAmp = 0.0;\n@state kTens = 0.0;\n@state kBright = 0.0;\n\n@state ph = 0.0;\n@state ampEnv = 0.0;\n@state ampStart = 0.0;\n@state brightEnv = 0.0;\n@state brightStart = 0.0;\n@state atkPos = 1000000.0;\n@state atkLen = 48.0;\n@state tens = 0.0;\n\n@state spot = 0.0;\n@state detuneMul = 1.0;\n@state harmMul = 1.0;\n\n@state beatPos = 1000000.0;\n@state beatLen = 48.0;\n@state beatGain = 0.0;\n@state kA1 = 0.0;\n@state kA2 = 0.0;\n@state kA3 = 0.0;\n@state kK = 0.4;\n@state ic1 = 0.0;\n@state ic2 = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\n\nif (sr != lastSr || decay_ms != lastDecay || drop_ms != lastDrop) {\n\tlet dec = clamp(decay_ms, 80.0, 1500.0) * 0.001;\n\tlet drp = clamp(drop_ms, 5.0, 200.0) * 0.001;\n\tkAmp = exp(-4.6 / (dec * sr));\n\tkTens = exp(-1.0 / (drp * sr));\n\tkBright = exp(-1.0 / ((0.02 + 1.2 * drp) * sr));\n\tlastSr = sr;\n\tlastDecay = decay_ms;\n\tlastDrop = drop_ms;\n}\n\nlet v = clamp(variance, 0.0, 100.0) * 0.01;\nlet harm = clamp(harmonics, 0.0, 100.0) * 0.01;\nlet beat = clamp(beater, 0.0, 100.0) * 0.01;\n\n// --- trigger: rising edge of the click ---\nlet trigIn = abs(in1);\nif (trigIn > 0.1 && prevTrig <= 0.1) {\n\tlet ringing = clamp(ampEnv, 0.0, 1.0);\n\tlet u1 = rng.next();\n\tlet u2 = rng.next();\n\tlet u3 = rng.next();\n\t// strike spot drifts like a hand, it does not jump\n\tspot = clamp(0.55 * spot + 0.65 * u1, -1.0, 1.0);\n\tdetuneMul = exp2(v * 0.2 * spot / 12.0);\n\tharmMul = 1.0 + v * 0.4 * abs(spot);\n\tif (ringing < 0.001) {\n\t\tph = 0.0;\n\t}\n\tampStart = ampEnv;\n\tbrightStart = brightEnv;\n\tatkPos = 0.0;\n\tatkLen = maximum(1.0, 0.0008 * sr);\n\t// energy adds: a hit into a ringing head starts sharper\n\ttens = minimum(tens + 1.0 + v * 0.2 * u3, 1.35);\n\t// contact: harder beater = shorter contact; moving head = shorter, softer\n\tlet tc = (0.0016 - 0.00115 * beat) * exp2(v * 0.7 * u2) * (1.0 - 0.3 * ringing);\n\tbeatLen = maximum(2.0, tc * sr);\n\tbeatPos = 0.0;\n\tbeatGain = sqrt(beat) * (1.0 + v * 0.3 * u3) * (1.0 - 0.25 * ringing);\n\tlet knockHz = clamp(2100.0 * exp2(v * 0.35 * spot), 200.0, sr * 0.4);\n\tlet g = tan(pi * knockHz / sr);\n\tkK = 0.4;\n\tkA1 = 1.0 / (1.0 + g * (g + kK));\n\tkA2 = g * kA1;\n\tkA3 = g * kA2;\n}\nprevTrig = trigIn;\n\n// --- envelopes: linear ramp from the current level, then exponential ---\nif (atkPos < atkLen) {\n\tlet a = atkPos / atkLen;\n\tampEnv = ampStart + (1.0 - ampStart) * a;\n\tbrightEnv = brightStart + (1.0 - brightStart) * a;\n\tatkPos += 1.0;\n} else {\n\tampEnv *= kAmp;\n\tbrightEnv *= kBright;\n}\ntens *= kTens;\n\n// --- body: tension-modulated pitch, closed-form loopback FM waveform ---\nlet kDrop = exp2(2.0 * clamp(drop_st, 0.0, 36.0) / 12.0) - 1.0;\nlet f0 = clamp(tune_hz, 35.0, 800.0) * detuneMul;\nlet freq = f0 * sqrt(1.0 + kDrop * tens) * (1.0 + 0.025 * ampEnv);\nfreq = clamp(freq, 1.0, sr * 0.45);\nph += freq / sr;\nph = ph - floor(ph);\n\n// keep the harmonic series |b|^k under -60 dB at Nyquist for high tunings\nlet bLim = minimum(0.85, exp(-6.9 * freq / maximum(0.5 * sr - freq, 1.0)));\nlet b = 0.0 - clamp(harm * harmMul * (0.3 * ampEnv + 0.5 * brightEnv), 0.0, bLim);\nlet c = sin(2.0 * pi * ph);\nlet raw = (2.0 * b + (1.0 + b * b) * c) / (1.0 + 2.0 * b * c + b * b) - b;\nlet shaped = raw / (1.0 - b * b) * (1.0 + 0.5 * b);\nlet drive = 1.0 + 1.5 * harm;\n// equal loudness across tunings: -3 dB at 800 Hz, exactly 1 at the 50 Hz default\nlet tuneComp = sqrt((1.0 + 0.00390625) / (1.0 + (f0 / 800.0) * (f0 / 800.0)));\nlet body = 0.8 * tuneComp * tanh(drive * shaped * ampEnv) / tanh(drive);\n\n// --- beater: smooth contact pulse -> thump + knock ---\nlet pulse = 0.0;\nif (beatPos < beatLen) {\n\tlet p = sin(pi * beatPos / beatLen);\n\tpulse = p * sqrt(p) * beatGain;\n\tbeatPos += 1.0;\n}\nlet thump = thumpLp.next(pulse, 3500.0);\nlet v3 = pulse - ic2;\nlet v1 = kA1 * ic1 + kA2 * v3;\nlet v2 = ic2 + kA2 * ic1 + kA3 * v3;\nic1 = 2.0 * v1 - ic1;\nic2 = 2.0 * v2 - ic2;\nlet knock = kK * v1;\n\nlet mixed = body + 0.45 * thump + 3.0 * knock;\nlet y = mixed - dcLp.next(mixed, 15.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = y * gain;\nout2 = y * gain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 1,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "expr": "",
                                        "code": "// ============================================================================\n// kick_808_tension.txt — triggered kick drum: sine body whose pitch falls with\n//                        its energy (tension modulation), loopback-FM\n//                        harmonics for small speakers, soft contact beater\n//\n// From: K. J. Werner, J. S. Abel, J. O. Smith III, \"A Physically-Informed,\n//       Circuit-Bendable, Digital Model of the Roland TR-808 Bass Drum\n//       Circuit\", DAFx-14: §4 (pulse shaper: the trigger is a short smooth\n//       pulse, not a step), §8.1 (frequency shift on attack), §8.2 (pitch\n//       sigh: the centre frequency rises while the swing is large);\n//       R. Marogna, F. Avanzini, B. Bank, \"Energy Based Synthesis of Tension\n//       Modulation in Membranes\", DAFx-10 P49: §2.3, §3.2 eq. 20 (quasistatic\n//       tension is proportional to membrane energy, f ~ sqrt(tension));\n//       J. Hsu, T. Smyth, \"Percussion Synthesis using Loopback Frequency\n//       Modulation Oscillators\", SMC-19: §3.2 eq. 4-5, §3.4 eq. 8-9 (closed\n//       form z0 = (b0 + e^jT)/(1 + b0 e^jT): b0 sets the harmonic series\n//       independently of the integrated phase T);\n//       F. Avanzini, D. Rocchesso, \"Modeling Collision Sounds: Non-Linear\n//       Contact Force\", DAFx-01: §2.1 (contact force ~ compression^alpha,\n//       contact time shortens with hardness).\n//\n// Body: phase-integrated oscillator at f = tune * sqrt(1 + k * tension),\n// tension decaying with drop_ms and topped up by each hit (energy adds, so a\n// retrigger into a ringing drum starts a little sharper). Its waveform is\n// Re{z0} - b0 with b0 <= 0 driven by a fast envelope plus the amplitude, so\n// the attack carries a harmonic series (audible on phones) that thins to a\n// clean sine as the note dies (b0 is also capped so the series is -60 dB\n// at Nyquist on high tunings). Gentle tanh for weight; a -3 dB tilt at\n// 800 Hz keeps loudness even across the tuning range. Beater: half-sine^1.5\n// contact pulse, lowpassed (no click) plus a band-passed \"knock\".\n// Every hit moves a random-walk strike spot (detune, brightness, knock\n// pitch, contact time); a retrigger ramps from the current level (no reset,\n// phase continuous) with a shorter, quieter contact.\n//\n// Inlets:\n//   in1: audio-rate trigger (single-sample click, rising edge above 0.1)\n// Outlets:\n//   out1 / out2: audio (mono kick on both)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Tune (settled pitch)\n@param({ min: 35, max: 800, exponent: 3 }) tune_hz = 50;\n// Decay (time to -40 dB)\n@param({ min: 80, max: 1500, exponent: 2 }) decay_ms = 380;\n// Pitch drop at the hit\n@param({ min: 0, max: 36 }) drop_st = 14;\n// Pitch drop time\n@param({ min: 5, max: 200, exponent: 2 }) drop_ms = 35;\n// Harmonics (loopback FM brightness + weight)\n@param({ min: 0, max: 100 }) harmonics = 45;\n// Beater\n@param({ min: 0, max: 100 }) beater = 40;\n// Hit-to-hit variance\n@param({ min: 0, max: 100 }) variance = 35;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state rng = new noise();\n@state thumpLp = new onepole();\n@state dcLp = new onepole();\n\n@state prevTrig = 0.0;\n@state lastSr = 0.0;\n@state lastDecay = -1.0;\n@state lastDrop = -1.0;\n@state kAmp = 0.0;\n@state kTens = 0.0;\n@state kBright = 0.0;\n\n@state ph = 0.0;\n@state ampEnv = 0.0;\n@state ampStart = 0.0;\n@state brightEnv = 0.0;\n@state brightStart = 0.0;\n@state atkPos = 1000000.0;\n@state atkLen = 48.0;\n@state tens = 0.0;\n\n@state spot = 0.0;\n@state detuneMul = 1.0;\n@state harmMul = 1.0;\n\n@state beatPos = 1000000.0;\n@state beatLen = 48.0;\n@state beatGain = 0.0;\n@state kA1 = 0.0;\n@state kA2 = 0.0;\n@state kA3 = 0.0;\n@state kK = 0.4;\n@state ic1 = 0.0;\n@state ic2 = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\n\nif (sr != lastSr || decay_ms != lastDecay || drop_ms != lastDrop) {\n\tlet dec = clamp(decay_ms, 80.0, 1500.0) * 0.001;\n\tlet drp = clamp(drop_ms, 5.0, 200.0) * 0.001;\n\tkAmp = exp(-4.6 / (dec * sr));\n\tkTens = exp(-1.0 / (drp * sr));\n\tkBright = exp(-1.0 / ((0.02 + 1.2 * drp) * sr));\n\tlastSr = sr;\n\tlastDecay = decay_ms;\n\tlastDrop = drop_ms;\n}\n\nlet v = clamp(variance, 0.0, 100.0) * 0.01;\nlet harm = clamp(harmonics, 0.0, 100.0) * 0.01;\nlet beat = clamp(beater, 0.0, 100.0) * 0.01;\n\n// --- trigger: rising edge of the click ---\nlet trigIn = abs(in1);\nif (trigIn > 0.1 && prevTrig <= 0.1) {\n\tlet ringing = clamp(ampEnv, 0.0, 1.0);\n\tlet u1 = rng.next();\n\tlet u2 = rng.next();\n\tlet u3 = rng.next();\n\t// strike spot drifts like a hand, it does not jump\n\tspot = clamp(0.55 * spot + 0.65 * u1, -1.0, 1.0);\n\tdetuneMul = exp2(v * 0.2 * spot / 12.0);\n\tharmMul = 1.0 + v * 0.4 * abs(spot);\n\tif (ringing < 0.001) {\n\t\tph = 0.0;\n\t}\n\tampStart = ampEnv;\n\tbrightStart = brightEnv;\n\tatkPos = 0.0;\n\tatkLen = maximum(1.0, 0.0008 * sr);\n\t// energy adds: a hit into a ringing head starts sharper\n\ttens = minimum(tens + 1.0 + v * 0.2 * u3, 1.35);\n\t// contact: harder beater = shorter contact; moving head = shorter, softer\n\tlet tc = (0.0016 - 0.00115 * beat) * exp2(v * 0.7 * u2) * (1.0 - 0.3 * ringing);\n\tbeatLen = maximum(2.0, tc * sr);\n\tbeatPos = 0.0;\n\tbeatGain = sqrt(beat) * (1.0 + v * 0.3 * u3) * (1.0 - 0.25 * ringing);\n\tlet knockHz = clamp(2100.0 * exp2(v * 0.35 * spot), 200.0, sr * 0.4);\n\tlet g = tan(pi * knockHz / sr);\n\tkK = 0.4;\n\tkA1 = 1.0 / (1.0 + g * (g + kK));\n\tkA2 = g * kA1;\n\tkA3 = g * kA2;\n}\nprevTrig = trigIn;\n\n// --- envelopes: linear ramp from the current level, then exponential ---\nif (atkPos < atkLen) {\n\tlet a = atkPos / atkLen;\n\tampEnv = ampStart + (1.0 - ampStart) * a;\n\tbrightEnv = brightStart + (1.0 - brightStart) * a;\n\tatkPos += 1.0;\n} else {\n\tampEnv *= kAmp;\n\tbrightEnv *= kBright;\n}\ntens *= kTens;\n\n// --- body: tension-modulated pitch, closed-form loopback FM waveform ---\nlet kDrop = exp2(2.0 * clamp(drop_st, 0.0, 36.0) / 12.0) - 1.0;\nlet f0 = clamp(tune_hz, 35.0, 800.0) * detuneMul;\nlet freq = f0 * sqrt(1.0 + kDrop * tens) * (1.0 + 0.025 * ampEnv);\nfreq = clamp(freq, 1.0, sr * 0.45);\nph += freq / sr;\nph = ph - floor(ph);\n\n// keep the harmonic series |b|^k under -60 dB at Nyquist for high tunings\nlet bLim = minimum(0.85, exp(-6.9 * freq / maximum(0.5 * sr - freq, 1.0)));\nlet b = 0.0 - clamp(harm * harmMul * (0.3 * ampEnv + 0.5 * brightEnv), 0.0, bLim);\nlet c = sin(2.0 * pi * ph);\nlet raw = (2.0 * b + (1.0 + b * b) * c) / (1.0 + 2.0 * b * c + b * b) - b;\nlet shaped = raw / (1.0 - b * b) * (1.0 + 0.5 * b);\nlet drive = 1.0 + 1.5 * harm;\n// equal loudness across tunings: -3 dB at 800 Hz, exactly 1 at the 50 Hz default\nlet tuneComp = sqrt((1.0 + 0.00390625) / (1.0 + (f0 / 800.0) * (f0 / 800.0)));\nlet body = 0.8 * tuneComp * tanh(drive * shaped * ampEnv) / tanh(drive);\n\n// --- beater: smooth contact pulse -> thump + knock ---\nlet pulse = 0.0;\nif (beatPos < beatLen) {\n\tlet p = sin(pi * beatPos / beatLen);\n\tpulse = p * sqrt(p) * beatGain;\n\tbeatPos += 1.0;\n}\nlet thump = thumpLp.next(pulse, 3500.0);\nlet v3 = pulse - ic2;\nlet v1 = kA1 * ic1 + kA2 * v3;\nlet v2 = ic2 + kA2 * ic1 + kA3 * v3;\nic1 = 2.0 * v1 - ic1;\nic2 = 2.0 * v2 - ic2;\nlet knock = kK * v1;\n\nlet mixed = body + 0.45 * thump + 3.0 * knock;\nlet y = mixed - dcLp.next(mixed, 15.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = y * gain;\nout2 = y * gain;\n",
                                        "nocache": 0
                                    },
                                    "rnbo_serial": 1,
                                    "rnbo_uniqueid": "effect_code",
