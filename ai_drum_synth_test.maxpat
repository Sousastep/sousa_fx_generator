                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1903.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// tom_loopback_membrane.txt — triggered tom: four membrane modes as\n//                             closed-form loopback-FM oscillators whose\n//                             pitch glides with the head's energy\n//\n// From: J. Hsu, T. Smyth, \"Percussion Synthesis using Loopback Frequency\n//       Modulation Oscillators\", SMC-19: §3.4 eq. 9-10 (z0 = (b0 + e^jT)/\n//       (1 + b0 e^jT), T the integrated phase: glide and timbre are\n//       independent), §4.1 eq. 11 (modal synthesis with loopback FM\n//       oscillators times decaying envelopes), §5.3 (time-varying b0: bright\n//       attack, purer tail), §5.5 (pitch glides), §6.2 (tom tom excited by a\n//       filtered noise burst);\n//       R. Marogna, F. Avanzini, B. Bank, \"Energy Based Synthesis of Tension\n//       Modulation in Membranes\", DAFx-10 P49: §2.2 (Bessel-zero modes and\n//       J_n(mu r) strike weights), §3.2 eq. 20 (quasistatic tension is\n//       proportional to the membrane energy), §4 eq. 21 (hammer contact);\n//       F. Avanzini, D. Rocchesso, \"Modeling Collision Sounds: Non-Linear\n//       Contact Force\", DAFx-01: §2.1 (harder mallet = shorter contact =\n//       more high modes).\n//\n// Modes (0,1) 1.000, (1,1) 1.593, (2,1) 2.136, (0,2) 2.295 of tune_hz. Each is\n// Re{z0} - b0 (DC-free, fundamental normalised), its phase integrated at\n// f_i * sqrt(1 + K * E) where E = sum of squared mode amplitudes (the\n// energy): the glide comes from the decay itself, as in a real head.\n// Mode amplitudes ramp over the contact time (felt 4 ms .. stick 0.4 ms)\n// to J_n(mu r) * contact lowpass, then decay (higher modes faster).\n// Attack texture: a noise burst through a band-pass around 3 * f0 (Hsu\n// §6.2). Modes 1..3 are panned out by spread.\n// Every hit moves a random-walk strike radius (mode balance, detune, pan\n// tilt, burst colour, contact time). A retrigger ramps each mode from its\n// current amplitude (energy adds, so a roll pushes the pitch back up). The\n// phase is continuous and nothing resets.\n// Hand mute (in2): a hand laid on the head is extra damping at the contact\n// (an added loss term, cf. Hunt-Crossley damping in DAFx-10 eq. 21). Every\n// mode then decays to -40 dB within 200 ms (fingertips) .. 12 ms (firm palm),\n// the upper modes first. The decay rate changes and the amplitude does not\n// jump, so the mute itself cannot click. The palm landing makes a dull\n// low-passed noise thump, scaled by the head's current amplitude: muting a\n// silent tom is silent. The hand stays until the next stick hit lifts it.\n//\n// Inlets:\n//   in1: audio-rate trigger (single-sample click, rising edge above 0.1)\n//   in2: audio-rate hand mute (single-sample click, rising edge above 0.1)\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Tune (head fundamental)\n@param({ min: 35, max: 800, exponent: 3 }) tune_hz = 110;\n// Decay (time to -40 dB)\n@param({ min: 100, max: 2500, exponent: 2 }) decay_ms = 600;\n// Pitch glide at full energy\n@param({ min: 0, max: 12 }) glide_st = 3;\n// Loopback FM brightness\n@param({ min: 0, max: 100 }) fm = 35;\n// Mallet: felt (0) -> stick (100)\n@param({ min: 0, max: 100 }) mallet = 40;\n// Stereo spread of the modes\n@param({ min: 0, max: 100 }) spread = 40;\n// Hit-to-hit variance\n@param({ min: 0, max: 100 }) variance = 35;\n// Hand mute: fingertips (0) -> firm palm (100)\n@param({ min: 0, max: 100 }) hand = 40;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state rng = new noise();\n@state dcLpL = new onepole();\n@state dcLpR = new onepole();\n@state handLp1 = new onepole();\n@state handLp2 = new onepole();\n\n@state modeOrder = new FixedSampleArray(4);\n@state modeMu = new FixedSampleArray(4);\n@state modePh = new FixedSampleArray(4);\n@state modeAmp = new FixedSampleArray(4);\n@state modeStart = new FixedSampleArray(4);\n@state modePeak = new FixedSampleArray(4);\n@state modeK = new FixedSampleArray(4);\n@state modeGL = new FixedSampleArray(4);\n@state modeGR = new FixedSampleArray(4);\n@state modeMuteK = new FixedSampleArray(4);\n\n@state prevTrig = 0.0;\n@state lastSr = 0.0;\n@state lastDecay = -1.0;\n@state lastSpread = -1.0;\n@state spot = 0.0;\n@state detuneMul = 1.0;\n@state tilt = 0.0;\n@state atkPos = 1000000.0;\n@state atkLen = 48.0;\n@state bright = 0.0;\n@state brightStart = 0.0;\n@state kBright = 0.0;\n@state burstEnv = 0.0;\n@state kBurst = 0.0;\n@state kA1 = 0.0;\n@state kA2 = 0.0;\n@state kA3 = 0.0;\n@state ic1 = 0.0;\n@state ic2 = 0.0;\n@state prevDamp = 0.0;\n@state muted = 0.0;\n@state handEnvA = 0.0;\n@state handEnvD = 0.0;\n@state handHz = 700.0;\n@state kHandRise = 0.0;\n@state kHandFall = 0.0;\n\nfunction init() {\n\tmodeOrder[0] = 0.0;\n\tmodeMu[0] = 2.404826;\n\tmodeOrder[1] = 1.0;\n\tmodeMu[1] = 3.831706;\n\tmodeOrder[2] = 2.0;\n\tmodeMu[2] = 5.135622;\n\tmodeOrder[3] = 0.0;\n\tmodeMu[3] = 5.520078;\n}\n\n// J_n(x) = (1/pi) * integral_0^pi cos(n t - x sin t) dt  (midpoint rule)\nfunction besselJ(n, x) {\n\tlet acc = 0.0;\n\tfor (let k: Int = 0; k < 24; k++) {\n\t\tlet t = pi * (k + 0.5) / 24.0;\n\t\tacc += cos(n * t - x * sin(t));\n\t}\n\treturn acc / 24.0;\n}\n\nfunction setPans() {\n\tlet sp = clamp(spread, 0.0, 100.0) * 0.01;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tlet side = (i == 0) ? 0.0 : ((i == 2) ? 1.0 : -1.0);\n\t\tif (i == 3) {\n\t\t\tside = -0.5;\n\t\t}\n\t\tlet p = clamp(side * sp * 0.8 + tilt, -1.0, 1.0);\n\t\tmodeGL[i] = sqrt(0.5 * (1.0 - p));\n\t\tmodeGR[i] = sqrt(0.5 * (1.0 + p));\n\t}\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet v = clamp(variance, 0.0, 100.0) * 0.01;\nlet hard = clamp(mallet, 0.0, 100.0) * 0.01;\nlet f0 = clamp(tune_hz, 35.0, 800.0) * detuneMul;\n\nif (sr != lastSr || decay_ms != lastDecay) {\n\tlet dec = clamp(decay_ms, 100.0, 2500.0) * 0.001;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tlet ratio = modeMu[i] / 2.404826;\n\t\tmodeK[i] = exp(-4.6 / (dec * pow(ratio, -0.9) * sr));\n\t}\n\tkBright = exp(-1.0 / ((0.04 + 0.15 * dec) * sr));\n\tkHandRise = exp(-1.0 / (0.0005 * sr));\n\tkHandFall = exp(-1.0 / (0.006 * sr));\n\tlastSr = sr;\n\tlastDecay = decay_ms;\n}\nif (spread != lastSpread) {\n\tsetPans();\n\tlastSpread = spread;\n}\n\n// --- trigger ---\nlet trigIn = abs(in1);\nif (trigIn > 0.1 && prevTrig <= 0.1) {\n\tlet u1 = rng.next();\n\tlet u2 = rng.next();\n\tlet u3 = rng.next();\n\tlet ringing = clamp(modeAmp[0], 0.0, 1.0);\n\tspot = clamp(0.55 * spot + 0.65 * u1, -1.0, 1.0);\n\tlet r = clamp(0.3 + 0.25 * v * spot, 0.05, 0.6);\n\tdetuneMul = exp2(v * 0.15 * u2 / 12.0);\n\tf0 = clamp(tune_hz, 35.0, 800.0) * detuneMul;\n\ttilt = v * 0.25 * u3;\n\tsetPans();\n\t// the stick hit lifts any resting hand\n\tmuted = 0.0;\n\t// contact time: felt 4 ms .. stick 0.4 ms; a moving head shortens it\n\tlet tc = 0.004 * exp2(0.0 - 3.3 * hard) * exp2(v * 0.5 * u2) * (1.0 - 0.3 * ringing);\n\tatkLen = maximum(2.0, tc * sr);\n\tatkPos = 0.0;\n\t// contact lowpass relative to the fundamental: level stays put, the\n\t// balance of the upper modes changes\n\tlet fc0 = f0 * tc * 1.5;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tlet ratio = modeMu[i] / 2.404826;\n\t\tlet fc = fc0 * ratio;\n\t\tlet pk = besselJ(modeOrder[i], modeMu[i] * r) * (1.0 + fc0 * fc0) / (1.0 + fc * fc);\n\t\tlet cur = modeAmp[i];\n\t\tmodeStart[i] = cur;\n\t\t// energy adds, bounded so a roll cannot run away\n\t\tmodePeak[i] = minimum(sqrt(cur * cur + pk * pk), 1.5 * abs(pk) + 0.05);\n\t}\n\tbrightStart = bright;\n\tburstEnv = burstEnv + (0.4 + 0.6 * hard) * (1.0 - 0.3 * ringing);\n\tkBurst = exp(-1.0 / ((0.012 - 0.008 * hard) * sr));\n\tlet bpHz = clamp(f0 * 3.2 * exp2(v * 0.4 * spot), 100.0, sr * 0.4);\n\tlet g = tan(pi * bpHz / sr);\n\tkA1 = 1.0 / (1.0 + g * (g + 0.6));\n\tkA2 = g * kA1;\n\tkA3 = g * kA2;\n}\nprevTrig = trigIn;\n\n// --- hand mute (in2): extra damping until the next stick hit ---\nlet dampIn = abs(in2);\nif (dampIn > 0.1 && prevDamp <= 0.1) {\n\tlet hd = clamp(hand, 0.0, 100.0) * 0.01;\n\t// fingertips 200 ms .. firm palm 12 ms to -40 dB; upper modes go first\n\tlet tMute = 0.2 * exp2(0.0 - 4.0 * hd) * exp2(v * 0.4 * rng.next());\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tlet ratio = modeMu[i] / 2.404826;\n\t\tmodeMuteK[i] = exp(-4.6 / (tMute * pow(ratio, -0.5) * sr));\n\t}\n\tmuted = 1.0;\n\t// the palm landing: a dull thump, louder and brighter when firm. It only\n\t// sounds against a moving head, so it scales with how loud the tom still\n\t// is (full right after a hit, nothing on a silent drum)\n\tlet ringE = 0.0;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tringE += modeAmp[i] * modeAmp[i];\n\t}\n\tlet ring = clamp(sqrt(ringE) * 1.25, 0.0, 1.0);\n\thandEnvA = handEnvA + hd * ring;\n\thandEnvD = handEnvD + hd * ring;\n\thandHz = 250.0 + 1200.0 * hd;\n}\nprevDamp = dampIn;\n\n// --- envelopes: raised-cosine ramp over the contact, then exponential ---\nlet inAtk = atkPos < atkLen;\nlet ramp = 0.5 - 0.5 * cos(pi * minimum(atkPos / atkLen, 1.0));\nif (inAtk) {\n\tbright = brightStart + (1.0 - brightStart) * ramp;\n\tatkPos += 1.0;\n} else {\n\tbright *= kBright;\n}\n\n// energy (quasistatic tension) from the mode amplitudes\nlet energy = 0.0;\nfor (let i: Int = 0; i < 4; i++) {\n\tif (inAtk) {\n\t\tmodeAmp[i] = modeStart[i] + (modePeak[i] - modeStart[i]) * ramp;\n\t} else {\n\t\tlet kd = (muted > 0.5) ? minimum(modeK[i], modeMuteK[i]) : modeK[i];\n\t\tmodeAmp[i] = modeAmp[i] * kd;\n\t}\n\tenergy += modeAmp[i] * modeAmp[i];\n}\nenergy = minimum(energy, 1.5);\nlet kGlide = exp2(2.0 * clamp(glide_st, 0.0, 12.0) / 12.0) - 1.0;\nlet tensMul = sqrt(1.0 + kGlide * energy);\n\n// --- modes: closed-form loopback FM, fundamental normalised ---\nlet bBase = clamp(fm, 0.0, 100.0) * 0.01 * (0.25 + 0.55 * bright);\nlet yl = 0.0;\nlet yr = 0.0;\nfor (let i: Int = 0; i < 4; i++) {\n\tlet ratio = modeMu[i] / 2.404826;\n\tlet f = minimum(f0 * ratio * tensMul, sr * 0.45);\n\tlet ph = modePh[i] + f / sr;\n\tph = ph - floor(ph);\n\tmodePh[i] = ph;\n\t// keep each mode's harmonic series under -60 dB at Nyquist\n\tlet bLim = minimum(0.85, exp(-6.9 * f / maximum(0.5 * sr - f, 1.0)));\n\tlet b = 0.0 - clamp(bBase * (1.0 - 0.2 * i), 0.0, bLim);\n\tlet c = sin(2.0 * pi * ph);\n\tlet raw = (2.0 * b + (1.0 + b * b) * c) / (1.0 + 2.0 * b * c + b * b) - b;\n\tlet s = modeAmp[i] * raw / (1.0 - b * b) * (1.0 + 0.5 * b);\n\tyl += s * modeGL[i];\n\tyr += s * modeGR[i];\n}\n\n// --- attack texture: band-passed noise burst (Hsu §6.2) ---\nlet nz = rng.next() * burstEnv;\nburstEnv *= kBurst;\nlet v3 = nz - ic2;\nlet v1 = kA1 * ic1 + kA2 * v3;\nlet v2 = ic2 + kA2 * ic1 + kA3 * v3;\nic1 = 2.0 * v1 - ic1;\nic2 = 2.0 * v2 - ic2;\nlet burst = 0.6 * v1 * 0.5;\n\n// palm thump: two-pole low-passed noise on a 0.5 / 6 ms envelope\nhandEnvA = handEnvA * kHandRise;\nhandEnvD = handEnvD * kHandFall;\nlet palm = handLp2.next(handLp1.next(rng.next() * (handEnvD - handEnvA), handHz), handHz) * 1.8;\n\n// equal loudness across tunings: lift below ~40 Hz, exactly 1 at 110 Hz\nlet tuneComp = sqrt((1.0 + (40.0 / f0) * (40.0 / f0)) / (1.0 + (40.0 / 110.0) * (40.0 / 110.0)));\nyl = 0.7 * tuneComp * yl + burst + palm;\nyr = 0.7 * tuneComp * yr + burst + palm;\nyl = yl - dcLpL.next(yl, 20.0);\nyr = yr - dcLpR.next(yr, 20.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = yl * gain;\nout2 = yr * gain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "expr": "",
                                        "code": "// ============================================================================\n// tom_loopback_membrane.txt — triggered tom: four membrane modes as\n//                             closed-form loopback-FM oscillators whose\n//                             pitch glides with the head's energy\n//\n// From: J. Hsu, T. Smyth, \"Percussion Synthesis using Loopback Frequency\n//       Modulation Oscillators\", SMC-19: §3.4 eq. 9-10 (z0 = (b0 + e^jT)/\n//       (1 + b0 e^jT), T the integrated phase: glide and timbre are\n//       independent), §4.1 eq. 11 (modal synthesis with loopback FM\n//       oscillators times decaying envelopes), §5.3 (time-varying b0: bright\n//       attack, purer tail), §5.5 (pitch glides), §6.2 (tom tom excited by a\n//       filtered noise burst);\n//       R. Marogna, F. Avanzini, B. Bank, \"Energy Based Synthesis of Tension\n//       Modulation in Membranes\", DAFx-10 P49: §2.2 (Bessel-zero modes and\n//       J_n(mu r) strike weights), §3.2 eq. 20 (quasistatic tension is\n//       proportional to the membrane energy), §4 eq. 21 (hammer contact);\n//       F. Avanzini, D. Rocchesso, \"Modeling Collision Sounds: Non-Linear\n//       Contact Force\", DAFx-01: §2.1 (harder mallet = shorter contact =\n//       more high modes).\n//\n// Modes (0,1) 1.000, (1,1) 1.593, (2,1) 2.136, (0,2) 2.295 of tune_hz. Each is\n// Re{z0} - b0 (DC-free, fundamental normalised), its phase integrated at\n// f_i * sqrt(1 + K * E) where E = sum of squared mode amplitudes (the\n// energy): the glide comes from the decay itself, as in a real head.\n// Mode amplitudes ramp over the contact time (felt 4 ms .. stick 0.4 ms)\n// to J_n(mu r) * contact lowpass, then decay (higher modes faster).\n// Attack texture: a noise burst through a band-pass around 3 * f0 (Hsu\n// §6.2). Modes 1..3 are panned out by spread.\n// Every hit moves a random-walk strike radius (mode balance, detune, pan\n// tilt, burst colour, contact time). A retrigger ramps each mode from its\n// current amplitude (energy adds, so a roll pushes the pitch back up). The\n// phase is continuous and nothing resets.\n// Hand mute (in2): a hand laid on the head is extra damping at the contact\n// (an added loss term, cf. Hunt-Crossley damping in DAFx-10 eq. 21). Every\n// mode then decays to -40 dB within 200 ms (fingertips) .. 12 ms (firm palm),\n// the upper modes first. The decay rate changes and the amplitude does not\n// jump, so the mute itself cannot click. The palm landing makes a dull\n// low-passed noise thump, scaled by the head's current amplitude: muting a\n// silent tom is silent. The hand stays until the next stick hit lifts it.\n//\n// Inlets:\n//   in1: audio-rate trigger (single-sample click, rising edge above 0.1)\n//   in2: audio-rate hand mute (single-sample click, rising edge above 0.1)\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Tune (head fundamental)\n@param({ min: 35, max: 800, exponent: 3 }) tune_hz = 110;\n// Decay (time to -40 dB)\n@param({ min: 100, max: 2500, exponent: 2 }) decay_ms = 600;\n// Pitch glide at full energy\n@param({ min: 0, max: 12 }) glide_st = 3;\n// Loopback FM brightness\n@param({ min: 0, max: 100 }) fm = 35;\n// Mallet: felt (0) -> stick (100)\n@param({ min: 0, max: 100 }) mallet = 40;\n// Stereo spread of the modes\n@param({ min: 0, max: 100 }) spread = 40;\n// Hit-to-hit variance\n@param({ min: 0, max: 100 }) variance = 35;\n// Hand mute: fingertips (0) -> firm palm (100)\n@param({ min: 0, max: 100 }) hand = 40;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state rng = new noise();\n@state dcLpL = new onepole();\n@state dcLpR = new onepole();\n@state handLp1 = new onepole();\n@state handLp2 = new onepole();\n\n@state modeOrder = new FixedSampleArray(4);\n@state modeMu = new FixedSampleArray(4);\n@state modePh = new FixedSampleArray(4);\n@state modeAmp = new FixedSampleArray(4);\n@state modeStart = new FixedSampleArray(4);\n@state modePeak = new FixedSampleArray(4);\n@state modeK = new FixedSampleArray(4);\n@state modeGL = new FixedSampleArray(4);\n@state modeGR = new FixedSampleArray(4);\n@state modeMuteK = new FixedSampleArray(4);\n\n@state prevTrig = 0.0;\n@state lastSr = 0.0;\n@state lastDecay = -1.0;\n@state lastSpread = -1.0;\n@state spot = 0.0;\n@state detuneMul = 1.0;\n@state tilt = 0.0;\n@state atkPos = 1000000.0;\n@state atkLen = 48.0;\n@state bright = 0.0;\n@state brightStart = 0.0;\n@state kBright = 0.0;\n@state burstEnv = 0.0;\n@state kBurst = 0.0;\n@state kA1 = 0.0;\n@state kA2 = 0.0;\n@state kA3 = 0.0;\n@state ic1 = 0.0;\n@state ic2 = 0.0;\n@state prevDamp = 0.0;\n@state muted = 0.0;\n@state handEnvA = 0.0;\n@state handEnvD = 0.0;\n@state handHz = 700.0;\n@state kHandRise = 0.0;\n@state kHandFall = 0.0;\n\nfunction init() {\n\tmodeOrder[0] = 0.0;\n\tmodeMu[0] = 2.404826;\n\tmodeOrder[1] = 1.0;\n\tmodeMu[1] = 3.831706;\n\tmodeOrder[2] = 2.0;\n\tmodeMu[2] = 5.135622;\n\tmodeOrder[3] = 0.0;\n\tmodeMu[3] = 5.520078;\n}\n\n// J_n(x) = (1/pi) * integral_0^pi cos(n t - x sin t) dt  (midpoint rule)\nfunction besselJ(n, x) {\n\tlet acc = 0.0;\n\tfor (let k: Int = 0; k < 24; k++) {\n\t\tlet t = pi * (k + 0.5) / 24.0;\n\t\tacc += cos(n * t - x * sin(t));\n\t}\n\treturn acc / 24.0;\n}\n\nfunction setPans() {\n\tlet sp = clamp(spread, 0.0, 100.0) * 0.01;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tlet side = (i == 0) ? 0.0 : ((i == 2) ? 1.0 : -1.0);\n\t\tif (i == 3) {\n\t\t\tside = -0.5;\n\t\t}\n\t\tlet p = clamp(side * sp * 0.8 + tilt, -1.0, 1.0);\n\t\tmodeGL[i] = sqrt(0.5 * (1.0 - p));\n\t\tmodeGR[i] = sqrt(0.5 * (1.0 + p));\n\t}\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet v = clamp(variance, 0.0, 100.0) * 0.01;\nlet hard = clamp(mallet, 0.0, 100.0) * 0.01;\nlet f0 = clamp(tune_hz, 35.0, 800.0) * detuneMul;\n\nif (sr != lastSr || decay_ms != lastDecay) {\n\tlet dec = clamp(decay_ms, 100.0, 2500.0) * 0.001;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tlet ratio = modeMu[i] / 2.404826;\n\t\tmodeK[i] = exp(-4.6 / (dec * pow(ratio, -0.9) * sr));\n\t}\n\tkBright = exp(-1.0 / ((0.04 + 0.15 * dec) * sr));\n\tkHandRise = exp(-1.0 / (0.0005 * sr));\n\tkHandFall = exp(-1.0 / (0.006 * sr));\n\tlastSr = sr;\n\tlastDecay = decay_ms;\n}\nif (spread != lastSpread) {\n\tsetPans();\n\tlastSpread = spread;\n}\n\n// --- trigger ---\nlet trigIn = abs(in1);\nif (trigIn > 0.1 && prevTrig <= 0.1) {\n\tlet u1 = rng.next();\n\tlet u2 = rng.next();\n\tlet u3 = rng.next();\n\tlet ringing = clamp(modeAmp[0], 0.0, 1.0);\n\tspot = clamp(0.55 * spot + 0.65 * u1, -1.0, 1.0);\n\tlet r = clamp(0.3 + 0.25 * v * spot, 0.05, 0.6);\n\tdetuneMul = exp2(v * 0.15 * u2 / 12.0);\n\tf0 = clamp(tune_hz, 35.0, 800.0) * detuneMul;\n\ttilt = v * 0.25 * u3;\n\tsetPans();\n\t// the stick hit lifts any resting hand\n\tmuted = 0.0;\n\t// contact time: felt 4 ms .. stick 0.4 ms; a moving head shortens it\n\tlet tc = 0.004 * exp2(0.0 - 3.3 * hard) * exp2(v * 0.5 * u2) * (1.0 - 0.3 * ringing);\n\tatkLen = maximum(2.0, tc * sr);\n\tatkPos = 0.0;\n\t// contact lowpass relative to the fundamental: level stays put, the\n\t// balance of the upper modes changes\n\tlet fc0 = f0 * tc * 1.5;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tlet ratio = modeMu[i] / 2.404826;\n\t\tlet fc = fc0 * ratio;\n\t\tlet pk = besselJ(modeOrder[i], modeMu[i] * r) * (1.0 + fc0 * fc0) / (1.0 + fc * fc);\n\t\tlet cur = modeAmp[i];\n\t\tmodeStart[i] = cur;\n\t\t// energy adds, bounded so a roll cannot run away\n\t\tmodePeak[i] = minimum(sqrt(cur * cur + pk * pk), 1.5 * abs(pk) + 0.05);\n\t}\n\tbrightStart = bright;\n\tburstEnv = burstEnv + (0.4 + 0.6 * hard) * (1.0 - 0.3 * ringing);\n\tkBurst = exp(-1.0 / ((0.012 - 0.008 * hard) * sr));\n\tlet bpHz = clamp(f0 * 3.2 * exp2(v * 0.4 * spot), 100.0, sr * 0.4);\n\tlet g = tan(pi * bpHz / sr);\n\tkA1 = 1.0 / (1.0 + g * (g + 0.6));\n\tkA2 = g * kA1;\n\tkA3 = g * kA2;\n}\nprevTrig = trigIn;\n\n// --- hand mute (in2): extra damping until the next stick hit ---\nlet dampIn = abs(in2);\nif (dampIn > 0.1 && prevDamp <= 0.1) {\n\tlet hd = clamp(hand, 0.0, 100.0) * 0.01;\n\t// fingertips 200 ms .. firm palm 12 ms to -40 dB; upper modes go first\n\tlet tMute = 0.2 * exp2(0.0 - 4.0 * hd) * exp2(v * 0.4 * rng.next());\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tlet ratio = modeMu[i] / 2.404826;\n\t\tmodeMuteK[i] = exp(-4.6 / (tMute * pow(ratio, -0.5) * sr));\n\t}\n\tmuted = 1.0;\n\t// the palm landing: a dull thump, louder and brighter when firm. It only\n\t// sounds against a moving head, so it scales with how loud the tom still\n\t// is (full right after a hit, nothing on a silent drum)\n\tlet ringE = 0.0;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tringE += modeAmp[i] * modeAmp[i];\n\t}\n\tlet ring = clamp(sqrt(ringE) * 1.25, 0.0, 1.0);\n\thandEnvA = handEnvA + hd * ring;\n\thandEnvD = handEnvD + hd * ring;\n\thandHz = 250.0 + 1200.0 * hd;\n}\nprevDamp = dampIn;\n\n// --- envelopes: raised-cosine ramp over the contact, then exponential ---\nlet inAtk = atkPos < atkLen;\nlet ramp = 0.5 - 0.5 * cos(pi * minimum(atkPos / atkLen, 1.0));\nif (inAtk) {\n\tbright = brightStart + (1.0 - brightStart) * ramp;\n\tatkPos += 1.0;\n} else {\n\tbright *= kBright;\n}\n\n// energy (quasistatic tension) from the mode amplitudes\nlet energy = 0.0;\nfor (let i: Int = 0; i < 4; i++) {\n\tif (inAtk) {\n\t\tmodeAmp[i] = modeStart[i] + (modePeak[i] - modeStart[i]) * ramp;\n\t} else {\n\t\tlet kd = (muted > 0.5) ? minimum(modeK[i], modeMuteK[i]) : modeK[i];\n\t\tmodeAmp[i] = modeAmp[i] * kd;\n\t}\n\tenergy += modeAmp[i] * modeAmp[i];\n}\nenergy = minimum(energy, 1.5);\nlet kGlide = exp2(2.0 * clamp(glide_st, 0.0, 12.0) / 12.0) - 1.0;\nlet tensMul = sqrt(1.0 + kGlide * energy);\n\n// --- modes: closed-form loopback FM, fundamental normalised ---\nlet bBase = clamp(fm, 0.0, 100.0) * 0.01 * (0.25 + 0.55 * bright);\nlet yl = 0.0;\nlet yr = 0.0;\nfor (let i: Int = 0; i < 4; i++) {\n\tlet ratio = modeMu[i] / 2.404826;\n\tlet f = minimum(f0 * ratio * tensMul, sr * 0.45);\n\tlet ph = modePh[i] + f / sr;\n\tph = ph - floor(ph);\n\tmodePh[i] = ph;\n\t// keep each mode's harmonic series under -60 dB at Nyquist\n\tlet bLim = minimum(0.85, exp(-6.9 * f / maximum(0.5 * sr - f, 1.0)));\n\tlet b = 0.0 - clamp(bBase * (1.0 - 0.2 * i), 0.0, bLim);\n\tlet c = sin(2.0 * pi * ph);\n\tlet raw = (2.0 * b + (1.0 + b * b) * c) / (1.0 + 2.0 * b * c + b * b) - b;\n\tlet s = modeAmp[i] * raw / (1.0 - b * b) * (1.0 + 0.5 * b);\n\tyl += s * modeGL[i];\n\tyr += s * modeGR[i];\n}\n\n// --- attack texture: band-passed noise burst (Hsu §6.2) ---\nlet nz = rng.next() * burstEnv;\nburstEnv *= kBurst;\nlet v3 = nz - ic2;\nlet v1 = kA1 * ic1 + kA2 * v3;\nlet v2 = ic2 + kA2 * ic1 + kA3 * v3;\nic1 = 2.0 * v1 - ic1;\nic2 = 2.0 * v2 - ic2;\nlet burst = 0.6 * v1 * 0.5;\n\n// palm thump: two-pole low-passed noise on a 0.5 / 6 ms envelope\nhandEnvA = handEnvA * kHandRise;\nhandEnvD = handEnvD * kHandFall;\nlet palm = handLp2.next(handLp1.next(rng.next() * (handEnvD - handEnvA), handHz), handHz) * 1.8;\n\n// equal loudness across tunings: lift below ~40 Hz, exactly 1 at 110 Hz\nlet tuneComp = sqrt((1.0 + (40.0 / f0) * (40.0 / f0)) / (1.0 + (40.0 / 110.0) * (40.0 / 110.0)));\nyl = 0.7 * tuneComp * yl + burst + palm;\nyr = 0.7 * tuneComp * yr + burst + palm;\nyl = yl - dcLpL.next(yl, 20.0);\nyr = yr - dcLpR.next(yr, 20.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = yl * gain;\nout2 = yr * gain;\n",
                                        "nocache": 0
                                    },
                                    "rnbo_serial": 1,
                                    "rnbo_uniqueid": "effect_code",
