        "classnamespace": "box",
        "rect": [ 447.0, 534.0, 1000.0, 780.0 ],
        "boxes": [
            {
                "box": {
                    "autosave": 1,
                    "id": "obj-32",
                    "inletInfo": {
                        "IOInfo": [
                            {
                                "type": "signal",
