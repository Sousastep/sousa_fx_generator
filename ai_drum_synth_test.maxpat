                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 0,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1970.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// snare_wire_collision.txt — triggered snare drum: six-mode batter head,\n//                            snare wires driven by a one-sided collision\n//                            force, wire texture from velvet noise\n//\n// From: A. Torin, B. Hamilton, \"An Energy Conserving Finite Difference Scheme\n//       for the Simulation of Collisions in Snare Drums\", DAFx-14: §2.4\n//       eq. 10-11 (mallet force kappa*[eta]+^alpha), §2.5 eq. 15-16 (snare\n//       wires collide one-sidedly with the head, force kappa*[xi]+^beta);\n//       R. Marogna, F. Avanzini, B. Bank, \"Energy Based Synthesis of Tension\n//       Modulation in Membranes\", DAFx-10 P49: §2.2 (circular membrane modes\n//       J_n(mu_nm r / R), mu_nm = Bessel zeros);\n//       K. J. Werner, \"Generalizations of Velvet Noise and their Use in 1-Bit\n//       Music\", DAFx-19 paper 53 (one signed impulse per period at a random\n//       offset: sparse noise whose density is a timbre control);\n//       S. Poirot, S. Bilbao, R. Kronland-Martinet, \"A Coupled Resonant\n//       Filter Bank for the Sound Synthesis of Nonlinear Sources\", DAFx-23\n//       paper 42: §5.2 (collisions as a nonlinear coupling between modes;\n//       random processes add realism).\n//\n// Head: six complex one-pole resonators at the Bessel-zero ratios\n// (0,1) 1.000, (1,1) 1.593, (2,1) 2.136, (0,2) 2.295, (3,1) 2.653,\n// (1,2) 2.917, each fed by the stick's contact pulse times J_n(mu r) for\n// strike radius r (centre = round, towards the rim = ringier). Higher modes\n// decay faster; the head gets a small level lift below ~40 Hz so loudness\n// stays even across tunings. Wires: the low-mode head displacement d gives a one-sided\n// penetration [-d - gap]+, force = pen^1.5 (Torin eq. 16). The force\n// envelope scales a velvet-noise stream per channel (separate L/R, so the\n// wires are wide) that is high-passed and toned. The wires come in bursts\n// at the head's own period, which is the snare buzz. A small gap\n// (loose) keeps them colliding far down the decay.\n// Every hit moves a random-walk strike radius (mode balance, contact time,\n// detune, wire sensitivity). A retrigger adds into the ringing modes (the\n// resonators are linear and never reset) with a shorter contact.\n//\n// Inlets:\n//   in1: audio-rate trigger (single-sample click, rising edge above 0.1)\n// Outlets:\n//   out1 / out2: stereo (head centred, wires wide)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Tune (head fundamental)\n@param({ min: 35, max: 800, exponent: 3 }) tune_hz = 190;\n// Head decay (time to -40 dB)\n@param({ min: 40, max: 800, exponent: 2 }) decay_ms = 180;\n// Snare wires level\n@param({ min: 0, max: 100 }) snares = 70;\n// Wire gap: tight (0) -> loose (100)\n@param({ min: 0, max: 100 }) wire_gap = 50;\n// Wire tone (lowpass)\n@param({ min: 1500, max: 12000, exponent: 2 }) tone_hz = 5000;\n// Grain: crackly sparse (0) -> smooth dense (100)\n@param({ min: 0, max: 100 }) grain = 70;\n// Hit-to-hit variance\n@param({ min: 0, max: 100 }) variance = 35;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state rng = new noise();\n@state wireHpL = new onepole();\n@state wireHpR = new onepole();\n@state wireLp1L = new onepole();\n@state wireLp2L = new onepole();\n@state wireLp1R = new onepole();\n@state wireLp2R = new onepole();\n@state crackLp = new onepole();\n@state dcLpL = new onepole();\n@state dcLpR = new onepole();\n\n// per mode: Bessel order, Bessel zero, strike weight, rotation, state\n@state modeOrder = new FixedSampleArray(6);\n@state modeMu = new FixedSampleArray(6);\n@state modeW = new FixedSampleArray(6);\n@state modeCos = new FixedSampleArray(6);\n@state modeSin = new FixedSampleArray(6);\n@state modeRe = new FixedSampleArray(6);\n@state modeIm = new FixedSampleArray(6);\n\n@state prevTrig = 0.0;\n@state lastSr = 0.0;\n@state lastTune = -1.0;\n@state lastDecay = -1.0;\n@state lastSnares = -1.0;\n@state spot = 0.0;\n@state detuneMul = 1.0;\n@state headComp = 1.0;\n@state gapMul = 1.0;\n@state pulsePos = 1000000.0;\n@state pulseLen = 24.0;\n@state pulseGain = 0.0;\n@state prevPulse = 0.0;\n@state wireEnv = 0.0;\n@state velPosL = 0.0;\n@state velAtL = 0.0;\n@state velSgnL = 1.0;\n@state velPosR = 0.0;\n@state velAtR = 0.0;\n@state velSgnR = 1.0;\n\nfunction init() {\n\tmodeOrder[0] = 0.0;\n\tmodeMu[0] = 2.404826;\n\tmodeOrder[1] = 1.0;\n\tmodeMu[1] = 3.831706;\n\tmodeOrder[2] = 2.0;\n\tmodeMu[2] = 5.135622;\n\tmodeOrder[3] = 0.0;\n\tmodeMu[3] = 5.520078;\n\tmodeOrder[4] = 3.0;\n\tmodeMu[4] = 6.380162;\n\tmodeOrder[5] = 1.0;\n\tmodeMu[5] = 7.015587;\n}\n\n// J_n(x) = (1/pi) * integral_0^pi cos(n t - x sin t) dt  (midpoint rule)\nfunction besselJ(n, x) {\n\tlet acc = 0.0;\n\tfor (let k: Int = 0; k < 24; k++) {\n\t\tlet t = pi * (k + 0.5) / 24.0;\n\t\tacc += cos(n * t - x * sin(t));\n\t}\n\treturn acc / 24.0;\n}\n\nfunction setModes(sr) {\n\tlet f0 = clamp(tune_hz, 35.0, 800.0) * detuneMul;\n\tlet dec = clamp(decay_ms, 40.0, 800.0) * 0.001;\n\t// equal loudness across tunings: lift below ~40 Hz, exactly 1 at 190 Hz\n\theadComp = sqrt((1.0 + (40.0 / f0) * (40.0 / f0)) / (1.0 + (40.0 / 190.0) * (40.0 / 190.0)));\n\t// wires resting on the head drain it a little\n\tlet damp = 1.0 - 0.25 * clamp(snares, 0.0, 100.0) * 0.01;\n\tfor (let i: Int = 0; i < 6; i++) {\n\t\tlet ratio = modeMu[i] / 2.404826;\n\t\tlet f = minimum(f0 * ratio, sr * 0.45);\n\t\tlet t60 = dec * damp * pow(ratio, -0.8);\n\t\tlet rad = exp(-4.6 / (t60 * sr));\n\t\tlet w = 2.0 * pi * f / sr;\n\t\tmodeCos[i] = rad * cos(w);\n\t\tmodeSin[i] = rad * sin(w);\n\t}\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet v = clamp(variance, 0.0, 100.0) * 0.01;\n\nif (sr != lastSr || tune_hz != lastTune || decay_ms != lastDecay || snares != lastSnares) {\n\tsetModes(sr);\n\tlastSr = sr;\n\tlastTune = tune_hz;\n\tlastDecay = decay_ms;\n\tlastSnares = snares;\n}\n\n// --- trigger ---\nlet trigIn = abs(in1);\nif (trigIn > 0.1 && prevTrig <= 0.1) {\n\tlet u1 = rng.next();\n\tlet u2 = rng.next();\n\tlet u3 = rng.next();\n\tlet ringing = clamp(abs(modeIm[0]) + abs(modeRe[0]), 0.0, 1.0);\n\tspot = clamp(0.55 * spot + 0.65 * u1, -1.0, 1.0);\n\t// strike radius: 0.3 of the radius, wandering 0.05 .. 0.6\n\tlet r = clamp(0.3 + 0.3 * v * spot, 0.05, 0.6);\n\tfor (let i: Int = 0; i < 6; i++) {\n\t\tmodeW[i] = besselJ(modeOrder[i], modeMu[i] * r);\n\t}\n\tdetuneMul = exp2(v * 0.15 * u2 / 12.0);\n\tgapMul = exp2(v * 0.5 * u3);\n\tsetModes(sr);\n\t// stick contact 0.35 ms; shorter on a moving head\n\tlet tc = 0.00035 * exp2(v * 0.5 * u2) * (1.0 - 0.3 * ringing);\n\tpulseLen = maximum(2.0, tc * sr);\n\tpulsePos = 0.0;\n\t// unit-area pulse: the low modes get the same push for any contact time\n\tpulseGain = 2.4 / pulseLen;\n}\nprevTrig = trigIn;\n\nlet pulse = 0.0;\nif (pulsePos < pulseLen) {\n\tlet p = sin(pi * pulsePos / pulseLen);\n\tpulse = p * sqrt(p) * pulseGain;\n\tpulsePos += 1.0;\n}\n\n// --- head: complex one-pole modal resonators, output = imaginary part ---\nlet head = 0.0;\nlet disp = 0.0;\nfor (let i: Int = 0; i < 6; i++) {\n\tlet re = modeRe[i];\n\tlet im = modeIm[i];\n\tlet x = pulse * modeW[i];\n\tlet nre = modeCos[i] * re - modeSin[i] * im + x;\n\tlet nim = modeSin[i] * re + modeCos[i] * im;\n\tmodeRe[i] = nre;\n\tmodeIm[i] = nim;\n\thead += nim;\n\tif (i < 2) {\n\t\tdisp += nim;\n\t}\n}\n\n// stick crack: velocity of the contact pulse, lowpassed\nlet crack = crackLp.next(pulse - prevPulse, 6000.0) * pulseLen * 0.6;\nprevPulse = pulse;\n\n// --- wires: one-sided collision with the resonant head ---\nlet loose = clamp(wire_gap, 0.0, 100.0) * 0.01;\nlet gap = (0.005 + 0.35 * pow(1.0 - loose, 1.5)) * gapMul;\nlet pen = maximum(0.0 - disp - gap, 0.0);\nlet force = pen * sqrt(pen);\nlet rel = exp(-1.0 / ((0.003 + 0.022 * loose) * sr));\nif (force > wireEnv) {\n\twireEnv += (force - wireEnv) * 0.3;\n} else {\n\twireEnv *= rel;\n}\n\n// velvet noise: one +-1 impulse per period Td, at a random offset\nlet dens = 300.0 * exp2(5.6 * clamp(grain, 0.0, 100.0) * 0.01);\nlet td = maximum(sr / dens, 1.0);\nlet velNorm = sqrt(td) * 0.35;\nlet velL = 0.0;\nif (velPosL >= velAtL && velPosL < velAtL + 1.0) {\n\tvelL = velSgnL;\n}\nvelPosL += 1.0;\nif (velPosL >= td) {\n\tvelPosL -= td;\n\tvelAtL = floor((0.5 + 0.5 * rng.next()) * (td - 1.0));\n\tvelSgnL = (rng.next() < 0.0) ? -1.0 : 1.0;\n}\nlet velR = 0.0;\nif (velPosR >= velAtR && velPosR < velAtR + 1.0) {\n\tvelR = velSgnR;\n}\nvelPosR += 1.0;\nif (velPosR >= td) {\n\tvelPosR -= td;\n\tvelAtR = floor((0.5 + 0.5 * rng.next()) * (td - 1.0));\n\tvelSgnR = (rng.next() < 0.0) ? -1.0 : 1.0;\n}\n\nlet tone = clamp(tone_hz, 1500.0, minimum(12000.0, sr * 0.45));\nlet wl = velL * velNorm * wireEnv;\nlet wr = velR * velNorm * wireEnv;\nwl = wl - wireHpL.next(wl, 1800.0);\nwr = wr - wireHpR.next(wr, 1800.0);\nwl = wireLp2L.next(wireLp1L.next(wl, tone), tone);\nwr = wireLp2R.next(wireLp1R.next(wr, tone), tone);\nlet wireAmt = clamp(snares, 0.0, 100.0) * 0.01 * 2.2;\nlet wireL = (0.7 * wl + 0.3 * wr) * wireAmt;\nlet wireR = (0.7 * wr + 0.3 * wl) * wireAmt;\n\nlet centre = 0.28 * headComp * head + crack;\nlet yl = centre + wireL;\nlet yr = centre + wireR;\nyl = yl - dcLpL.next(yl, 20.0);\nyr = yr - dcLpR.next(yr, 20.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = yl * gain;\nout2 = yr * gain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 1,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "expr": "",
                                        "code": "// ============================================================================\n// snare_wire_collision.txt — triggered snare drum: six-mode batter head,\n//                            snare wires driven by a one-sided collision\n//                            force, wire texture from velvet noise\n//\n// From: A. Torin, B. Hamilton, \"An Energy Conserving Finite Difference Scheme\n//       for the Simulation of Collisions in Snare Drums\", DAFx-14: §2.4\n//       eq. 10-11 (mallet force kappa*[eta]+^alpha), §2.5 eq. 15-16 (snare\n//       wires collide one-sidedly with the head, force kappa*[xi]+^beta);\n//       R. Marogna, F. Avanzini, B. Bank, \"Energy Based Synthesis of Tension\n//       Modulation in Membranes\", DAFx-10 P49: §2.2 (circular membrane modes\n//       J_n(mu_nm r / R), mu_nm = Bessel zeros);\n//       K. J. Werner, \"Generalizations of Velvet Noise and their Use in 1-Bit\n//       Music\", DAFx-19 paper 53 (one signed impulse per period at a random\n//       offset: sparse noise whose density is a timbre control);\n//       S. Poirot, S. Bilbao, R. Kronland-Martinet, \"A Coupled Resonant\n//       Filter Bank for the Sound Synthesis of Nonlinear Sources\", DAFx-23\n//       paper 42: §5.2 (collisions as a nonlinear coupling between modes;\n//       random processes add realism).\n//\n// Head: six complex one-pole resonators at the Bessel-zero ratios\n// (0,1) 1.000, (1,1) 1.593, (2,1) 2.136, (0,2) 2.295, (3,1) 2.653,\n// (1,2) 2.917, each fed by the stick's contact pulse times J_n(mu r) for\n// strike radius r (centre = round, towards the rim = ringier). Higher modes\n// decay faster; the head gets a small level lift below ~40 Hz so loudness\n// stays even across tunings. Wires: the low-mode head displacement d gives a one-sided\n// penetration [-d - gap]+, force = pen^1.5 (Torin eq. 16). The force\n// envelope scales a velvet-noise stream per channel (separate L/R, so the\n// wires are wide) that is high-passed and toned. The wires come in bursts\n// at the head's own period, which is the snare buzz. A small gap\n// (loose) keeps them colliding far down the decay.\n// Every hit moves a random-walk strike radius (mode balance, contact time,\n// detune, wire sensitivity). A retrigger adds into the ringing modes (the\n// resonators are linear and never reset) with a shorter contact.\n//\n// Inlets:\n//   in1: audio-rate trigger (single-sample click, rising edge above 0.1)\n// Outlets:\n//   out1 / out2: stereo (head centred, wires wide)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Tune (head fundamental)\n@param({ min: 35, max: 800, exponent: 3 }) tune_hz = 190;\n// Head decay (time to -40 dB)\n@param({ min: 40, max: 800, exponent: 2 }) decay_ms = 180;\n// Snare wires level\n@param({ min: 0, max: 100 }) snares = 70;\n// Wire gap: tight (0) -> loose (100)\n@param({ min: 0, max: 100 }) wire_gap = 50;\n// Wire tone (lowpass)\n@param({ min: 1500, max: 12000, exponent: 2 }) tone_hz = 5000;\n// Grain: crackly sparse (0) -> smooth dense (100)\n@param({ min: 0, max: 100 }) grain = 70;\n// Hit-to-hit variance\n@param({ min: 0, max: 100 }) variance = 35;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state rng = new noise();\n@state wireHpL = new onepole();\n@state wireHpR = new onepole();\n@state wireLp1L = new onepole();\n@state wireLp2L = new onepole();\n@state wireLp1R = new onepole();\n@state wireLp2R = new onepole();\n@state crackLp = new onepole();\n@state dcLpL = new onepole();\n@state dcLpR = new onepole();\n\n// per mode: Bessel order, Bessel zero, strike weight, rotation, state\n@state modeOrder = new FixedSampleArray(6);\n@state modeMu = new FixedSampleArray(6);\n@state modeW = new FixedSampleArray(6);\n@state modeCos = new FixedSampleArray(6);\n@state modeSin = new FixedSampleArray(6);\n@state modeRe = new FixedSampleArray(6);\n@state modeIm = new FixedSampleArray(6);\n\n@state prevTrig = 0.0;\n@state lastSr = 0.0;\n@state lastTune = -1.0;\n@state lastDecay = -1.0;\n@state lastSnares = -1.0;\n@state spot = 0.0;\n@state detuneMul = 1.0;\n@state headComp = 1.0;\n@state gapMul = 1.0;\n@state pulsePos = 1000000.0;\n@state pulseLen = 24.0;\n@state pulseGain = 0.0;\n@state prevPulse = 0.0;\n@state wireEnv = 0.0;\n@state velPosL = 0.0;\n@state velAtL = 0.0;\n@state velSgnL = 1.0;\n@state velPosR = 0.0;\n@state velAtR = 0.0;\n@state velSgnR = 1.0;\n\nfunction init() {\n\tmodeOrder[0] = 0.0;\n\tmodeMu[0] = 2.404826;\n\tmodeOrder[1] = 1.0;\n\tmodeMu[1] = 3.831706;\n\tmodeOrder[2] = 2.0;\n\tmodeMu[2] = 5.135622;\n\tmodeOrder[3] = 0.0;\n\tmodeMu[3] = 5.520078;\n\tmodeOrder[4] = 3.0;\n\tmodeMu[4] = 6.380162;\n\tmodeOrder[5] = 1.0;\n\tmodeMu[5] = 7.015587;\n}\n\n// J_n(x) = (1/pi) * integral_0^pi cos(n t - x sin t) dt  (midpoint rule)\nfunction besselJ(n, x) {\n\tlet acc = 0.0;\n\tfor (let k: Int = 0; k < 24; k++) {\n\t\tlet t = pi * (k + 0.5) / 24.0;\n\t\tacc += cos(n * t - x * sin(t));\n\t}\n\treturn acc / 24.0;\n}\n\nfunction setModes(sr) {\n\tlet f0 = clamp(tune_hz, 35.0, 800.0) * detuneMul;\n\tlet dec = clamp(decay_ms, 40.0, 800.0) * 0.001;\n\t// equal loudness across tunings: lift below ~40 Hz, exactly 1 at 190 Hz\n\theadComp = sqrt((1.0 + (40.0 / f0) * (40.0 / f0)) / (1.0 + (40.0 / 190.0) * (40.0 / 190.0)));\n\t// wires resting on the head drain it a little\n\tlet damp = 1.0 - 0.25 * clamp(snares, 0.0, 100.0) * 0.01;\n\tfor (let i: Int = 0; i < 6; i++) {\n\t\tlet ratio = modeMu[i] / 2.404826;\n\t\tlet f = minimum(f0 * ratio, sr * 0.45);\n\t\tlet t60 = dec * damp * pow(ratio, -0.8);\n\t\tlet rad = exp(-4.6 / (t60 * sr));\n\t\tlet w = 2.0 * pi * f / sr;\n\t\tmodeCos[i] = rad * cos(w);\n\t\tmodeSin[i] = rad * sin(w);\n\t}\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet v = clamp(variance, 0.0, 100.0) * 0.01;\n\nif (sr != lastSr || tune_hz != lastTune || decay_ms != lastDecay || snares != lastSnares) {\n\tsetModes(sr);\n\tlastSr = sr;\n\tlastTune = tune_hz;\n\tlastDecay = decay_ms;\n\tlastSnares = snares;\n}\n\n// --- trigger ---\nlet trigIn = abs(in1);\nif (trigIn > 0.1 && prevTrig <= 0.1) {\n\tlet u1 = rng.next();\n\tlet u2 = rng.next();\n\tlet u3 = rng.next();\n\tlet ringing = clamp(abs(modeIm[0]) + abs(modeRe[0]), 0.0, 1.0);\n\tspot = clamp(0.55 * spot + 0.65 * u1, -1.0, 1.0);\n\t// strike radius: 0.3 of the radius, wandering 0.05 .. 0.6\n\tlet r = clamp(0.3 + 0.3 * v * spot, 0.05, 0.6);\n\tfor (let i: Int = 0; i < 6; i++) {\n\t\tmodeW[i] = besselJ(modeOrder[i], modeMu[i] * r);\n\t}\n\tdetuneMul = exp2(v * 0.15 * u2 / 12.0);\n\tgapMul = exp2(v * 0.5 * u3);\n\tsetModes(sr);\n\t// stick contact 0.35 ms; shorter on a moving head\n\tlet tc = 0.00035 * exp2(v * 0.5 * u2) * (1.0 - 0.3 * ringing);\n\tpulseLen = maximum(2.0, tc * sr);\n\tpulsePos = 0.0;\n\t// unit-area pulse: the low modes get the same push for any contact time\n\tpulseGain = 2.4 / pulseLen;\n}\nprevTrig = trigIn;\n\nlet pulse = 0.0;\nif (pulsePos < pulseLen) {\n\tlet p = sin(pi * pulsePos / pulseLen);\n\tpulse = p * sqrt(p) * pulseGain;\n\tpulsePos += 1.0;\n}\n\n// --- head: complex one-pole modal resonators, output = imaginary part ---\nlet head = 0.0;\nlet disp = 0.0;\nfor (let i: Int = 0; i < 6; i++) {\n\tlet re = modeRe[i];\n\tlet im = modeIm[i];\n\tlet x = pulse * modeW[i];\n\tlet nre = modeCos[i] * re - modeSin[i] * im + x;\n\tlet nim = modeSin[i] * re + modeCos[i] * im;\n\tmodeRe[i] = nre;\n\tmodeIm[i] = nim;\n\thead += nim;\n\tif (i < 2) {\n\t\tdisp += nim;\n\t}\n}\n\n// stick crack: velocity of the contact pulse, lowpassed\nlet crack = crackLp.next(pulse - prevPulse, 6000.0) * pulseLen * 0.6;\nprevPulse = pulse;\n\n// --- wires: one-sided collision with the resonant head ---\nlet loose = clamp(wire_gap, 0.0, 100.0) * 0.01;\nlet gap = (0.005 + 0.35 * pow(1.0 - loose, 1.5)) * gapMul;\nlet pen = maximum(0.0 - disp - gap, 0.0);\nlet force = pen * sqrt(pen);\nlet rel = exp(-1.0 / ((0.003 + 0.022 * loose) * sr));\nif (force > wireEnv) {\n\twireEnv += (force - wireEnv) * 0.3;\n} else {\n\twireEnv *= rel;\n}\n\n// velvet noise: one +-1 impulse per period Td, at a random offset\nlet dens = 300.0 * exp2(5.6 * clamp(grain, 0.0, 100.0) * 0.01);\nlet td = maximum(sr / dens, 1.0);\nlet velNorm = sqrt(td) * 0.35;\nlet velL = 0.0;\nif (velPosL >= velAtL && velPosL < velAtL + 1.0) {\n\tvelL = velSgnL;\n}\nvelPosL += 1.0;\nif (velPosL >= td) {\n\tvelPosL -= td;\n\tvelAtL = floor((0.5 + 0.5 * rng.next()) * (td - 1.0));\n\tvelSgnL = (rng.next() < 0.0) ? -1.0 : 1.0;\n}\nlet velR = 0.0;\nif (velPosR >= velAtR && velPosR < velAtR + 1.0) {\n\tvelR = velSgnR;\n}\nvelPosR += 1.0;\nif (velPosR >= td) {\n\tvelPosR -= td;\n\tvelAtR = floor((0.5 + 0.5 * rng.next()) * (td - 1.0));\n\tvelSgnR = (rng.next() < 0.0) ? -1.0 : 1.0;\n}\n\nlet tone = clamp(tone_hz, 1500.0, minimum(12000.0, sr * 0.45));\nlet wl = velL * velNorm * wireEnv;\nlet wr = velR * velNorm * wireEnv;\nwl = wl - wireHpL.next(wl, 1800.0);\nwr = wr - wireHpR.next(wr, 1800.0);\nwl = wireLp2L.next(wireLp1L.next(wl, tone), tone);\nwr = wireLp2R.next(wireLp1R.next(wr, tone), tone);\nlet wireAmt = clamp(snares, 0.0, 100.0) * 0.01 * 2.2;\nlet wireL = (0.7 * wl + 0.3 * wr) * wireAmt;\nlet wireR = (0.7 * wr + 0.3 * wl) * wireAmt;\n\nlet centre = 0.28 * headComp * head + crack;\nlet yl = centre + wireL;\nlet yr = centre + wireR;\nyl = yl - dcLpL.next(yl, 20.0);\nyr = yr - dcLpR.next(yr, 20.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = yl * gain;\nout2 = yr * gain;\n",
                                        "nocache": 0
                                    },
