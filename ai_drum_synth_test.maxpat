                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 0,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1900.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// clap_cavity_ensemble.txt — triggered hand clap: 1-20 virtual clappers, each\n//                            a noise burst through the resonance of the air\n//                            cavity between the hands, flammed, plus a tail\n//\n// From: A. Jylhä, C. Erkut, \"Inferring the Hand Configuration from Hand\n//       Clapping Sounds\", DAFx-08: §2 (a clap is ~5 ms with one pronounced\n//       cavity resonance; a smaller cavity resonates higher), §2.1 (ClaPD:\n//       each clap = enveloped noise burst into a 2nd-order resonator whose\n//       parameters are drawn per clap), Table 1 (mean and deviation of\n//       centre f, -3 dB bandwidth B and gain G per hand configuration);\n//       W. Ahmad, A. M. Kondoz, \"Generation of Non-Repetitive Everyday Impact\n//       Sounds for Interactive Applications\", DAFx-11: §5.2, §6.1 (every\n//       event re-drawn from the analysed distributions, so repeats are never\n//       identical).\n//\n// cavity morphs along Table 1, sorted by centre frequency:\n//   A1+ (cupped) 500 Hz -> A1 775 -> A1- 984 -> A2 1355 -> P3 (flat) 1562.\n// Per hit, each clapper draws f, B, G from Gaussians around the morphed\n// means (deviations from the table, scaled by variance), adds its own fixed\n// hand bias (every clapper cups a little differently) and fires after a\n// random offset within spread_ms. Burst = difference of two exponentials\n// (0.25 ms rise, ~2.5 ms fall) into a unity-peak TPT band-pass. \"air\" adds\n// the broadband slap of palm contact. Every clap re-peaks the tail (stereo\n// noise through a wide band-pass, decaying over tail_ms) unless another\n// clap is due within 30 ms, continuing from its current level: a tight flam\n// gets one tail after its last clap, spread claps each get their own.\n// The random walk drifts the whole ensemble's cavity between hits. A\n// retrigger while the clap is still sounding flams tighter (the hands are\n// already close) and adds into the ringing resonators. Nothing resets.\n//\n// Inlets:\n//   in1: audio-rate trigger (single-sample click, rising edge above 0.1)\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Hand cavity: cupped (0) -> flat (100)\n@param({ min: 0, max: 100 }) cavity = 50;\n// Number of clappers\n@param({ min: 1, max: 20, steps: 20 }) clappers = 4;\n// Flam spread between clappers\n@param({ min: 0, max: 1000, exponent: 3 }) spread_ms = 12;\n// Tail (time to -40 dB)\n@param({ min: 20, max: 1500, exponent: 2 }) tail_ms = 250;\n// Air: palm slap / brightness\n@param({ min: 0, max: 100 }) air = 50;\n// Stereo width\n@param({ min: 0, max: 100 }) width = 60;\n// Hit-to-hit variance\n@param({ min: 0, max: 100 }) variance = 35;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state rng = new noise();\n@state airLpL = new onepole();\n@state airLpR = new onepole();\n@state tailLpL = new onepole();\n@state tailLpR = new onepole();\n@state dcLpL = new onepole();\n@state dcLpR = new onepole();\n\n// Table 1 chain: A1+, A1, A1-, A2, P3\n@state cavF = new FixedSampleArray(5);\n@state cavDf = new FixedSampleArray(5);\n@state cavB = new FixedSampleArray(5);\n@state cavDb = new FixedSampleArray(5);\n@state cavG = new FixedSampleArray(5);\n@state cavDg = new FixedSampleArray(5);\n\n// per clapper\n@state vBias = new FixedSampleArray(20);\n@state vWait = new FixedSampleArray(20);\n@state vEnvA = new FixedSampleArray(20);\n@state vEnvD = new FixedSampleArray(20);\n@state vGain = new FixedSampleArray(20);\n@state vGL = new FixedSampleArray(20);\n@state vGR = new FixedSampleArray(20);\n@state vK = new FixedSampleArray(20);\n@state vA1 = new FixedSampleArray(20);\n@state vA2 = new FixedSampleArray(20);\n@state vA3 = new FixedSampleArray(20);\n@state vIc1 = new FixedSampleArray(20);\n@state vIc2 = new FixedSampleArray(20);\n\n@state prevTrig = 0.0;\n@state lastSr = 0.0;\n@state lastTail = -1.0;\n@state kRise = 0.0;\n@state kFall = 0.0;\n@state kTail = 0.0;\n@state spot = 0.0;\n@state tailEnvA = 0.0;\n@state tailEnvD = 0.0;\n@state tailHz = 1300.0;\n@state tA1 = 0.0;\n@state tA2 = 0.0;\n@state tA3 = 0.0;\n@state tIc1L = 0.0;\n@state tIc2L = 0.0;\n@state tIc1R = 0.0;\n@state tIc2R = 0.0;\n@state recent = 0.0;\n@state slapNorm = 1.0;\n\nfunction init() {\n\tcavF[0] = 500.0;\n\tcavDf[0] = 178.0;\n\tcavB[0] = 91.0;\n\tcavDb[0] = 27.0;\n\tcavG[0] = 33.8;\n\tcavDg[0] = 5.57;\n\tcavF[1] = 775.0;\n\tcavDf[1] = 39.0;\n\tcavB[1] = 137.0;\n\tcavDb[1] = 15.0;\n\tcavG[1] = 22.2;\n\tcavDg[1] = 3.55;\n\tcavF[2] = 984.0;\n\tcavDf[2] = 396.0;\n\tcavB[2] = 137.0;\n\tcavDb[2] = 36.0;\n\tcavG[2] = 11.3;\n\tcavDg[2] = 1.42;\n\tcavF[3] = 1355.0;\n\tcavDf[3] = 57.0;\n\tcavB[3] = 222.0;\n\tcavDb[3] = 53.0;\n\tcavG[3] = 24.0;\n\tcavDg[3] = 8.03;\n\tcavF[4] = 1562.0;\n\tcavDf[4] = 257.0;\n\tcavB[4] = 375.0;\n\tcavDb[4] = 94.0;\n\tcavG[4] = 19.5;\n\tcavDg[4] = 6.31;\n\tfor (let k: Int = 0; k < 20; k++) {\n\t\tvBias[k] = 0.12 * rng.next();\n\t\tvWait[k] = -1.0;\n\t}\n}\n\n// ~N(0,1) from three uniforms (variance 3 * 1/3)\nfunction gauss() {\n\treturn rng.next() + rng.next() + rng.next();\n}\n\n// unity-peak TPT band-pass coefficients for voice k\nfunction setVoiceFilter(k: Int, f, bw, sr) {\n\tlet fc = clamp(f, 150.0, sr * 0.4);\n\tlet damp = clamp(bw / fc, 0.02, 2.0);\n\tlet g = tan(pi * fc / sr);\n\tlet a1 = 1.0 / (1.0 + g * (g + damp));\n\tvK[k] = damp;\n\tvA1[k] = a1;\n\tvA2[k] = g * a1;\n\tvA3[k] = g * g * a1;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet v = clamp(variance, 0.0, 100.0) * 0.01;\nlet airAmt = clamp(air, 0.0, 100.0) * 0.01;\nlet wid = clamp(width, 0.0, 100.0) * 0.01;\n\nif (sr != lastSr || tail_ms != lastTail) {\n\tkRise = exp(-1.0 / (0.00025 * sr));\n\tkFall = exp(-1.0 / (0.0025 * sr));\n\tkTail = exp(-4.6 / (clamp(tail_ms, 20.0, 1500.0) * 0.001 * sr));\n\tlastSr = sr;\n\tlastTail = tail_ms;\n}\n\n// --- trigger: schedule the ensemble ---\nlet trigIn = abs(in1);\nif (trigIn > 0.1 && prevTrig <= 0.1) {\n\tlet n: Int = trunc(clamp(clappers, 1.0, 20.0) + 0.5);\n\tspot = clamp(0.55 * spot + 0.65 * rng.next(), -1.0, 1.0);\n\t// equal loudness for any number of clappers: normalise by how many claps\n\t// overlap (~8 ms each within the spread); 4 clappers over 12 ms -> 3 -> 1.0\n\tlet nEff = 1.0 + (n - 1.0) * minimum(1.0, 8.0 / maximum(spread_ms, 0.001));\n\tlet nNorm = sqrt(3.0 / nEff);\n\t// the slap shares one noise source, so overlapping slaps add coherently\n\tslapNorm = 3.0 / nEff;\n\tlet busy = clamp(recent, 0.0, 1.0);\n\tlet spr = clamp(spread_ms, 0.0, 1000.0) * 0.001 * sr * (1.0 - 0.4 * busy);\n\tfor (let k: Int = 0; k < 20; k++) {\n\t\tif (k < n) {\n\t\t\tlet x = clamp(clamp(cavity, 0.0, 100.0) * 0.01 + 0.15 * v * spot + vBias[k], 0.0, 1.0);\n\t\t\tlet pos = x * 4.0;\n\t\t\tlet ii: Int = trunc(minimum(pos, 3.0));\n\t\t\tlet fr = pos - ii;\n\t\t\tlet fm = cavF[ii] + (cavF[ii + 1] - cavF[ii]) * fr;\n\t\t\tlet dfm = cavDf[ii] + (cavDf[ii + 1] - cavDf[ii]) * fr;\n\t\t\tlet bm = cavB[ii] + (cavB[ii + 1] - cavB[ii]) * fr;\n\t\t\tlet dbm = cavDb[ii] + (cavDb[ii + 1] - cavDb[ii]) * fr;\n\t\t\tlet gm = cavG[ii] + (cavG[ii + 1] - cavG[ii]) * fr;\n\t\t\tlet dgm = cavDg[ii] + (cavDg[ii + 1] - cavDg[ii]) * fr;\n\t\t\tlet dev = 1.4 * v;\n\t\t\tlet f = maximum(fm + dev * dfm * gauss(), 250.0);\n\t\t\tlet bw = maximum(bm + dev * dbm * gauss(), 40.0);\n\t\t\tlet gg = maximum(gm + dev * dgm * gauss(), 4.0);\n\t\t\tsetVoiceFilter(k, f, bw, sr);\n\t\t\t// G from the table; sqrt(sr / (pi B)) keeps narrow cavities as loud as\n\t\t\t// wide ones (a unity-peak band-pass passes noise power ~ B)\n\t\t\tvGain[k] = gg / 22.0 * 0.6 * sqrt(sr / (pi * bw)) * nNorm;\n\t\t\t// first clapper on time, the others within the spread\n\t\t\tlet w = (k == 0) ? 0.0 : spr * (k + 0.6 * rng.next()) / n;\n\t\t\tvWait[k] = maximum(w, 0.0);\n\t\t\tlet p = clamp(wid * ((k == 0) ? 0.2 * rng.next() : rng.next()), -1.0, 1.0);\n\t\t\tvGL[k] = sqrt(0.5 * (1.0 - p));\n\t\t\tvGR[k] = sqrt(0.5 * (1.0 + p));\n\t\t\tif (k == 0) {\n\t\t\t\ttailHz = clamp(f * 1.4, 400.0, sr * 0.4);\n\t\t\t}\n\t\t}\n\t}\n\tlet tg = tan(pi * tailHz / sr);\n\ttA1 = 1.0 / (1.0 + tg * (tg + 0.6));\n\ttA2 = tg * tA1;\n\ttA3 = tg * tA2;\n}\nprevTrig = trigIn;\n\n// --- clappers ---\nlet yl = 0.0;\nlet yr = 0.0;\nlet slapL = 0.0;\nlet slapR = 0.0;\nlet active = 0.0;\nlet fired = 0.0;\nfor (let k: Int = 0; k < 20; k++) {\n\tif (vWait[k] >= 0.0) {\n\t\tvWait[k] = vWait[k] - 1.0;\n\t\tif (vWait[k] < 0.0) {\n\t\t\tvEnvA[k] = vEnvA[k] + 1.0;\n\t\t\tvEnvD[k] = vEnvD[k] + 1.0;\n\t\t\t// a clap starts the tail unless another lands within 30 ms (a\n\t\t\t// tight flam keeps one tail, after its last clap)\n\t\t\tlet soon = 0.0;\n\t\t\tfor (let j: Int = 0; j < 20; j++) {\n\t\t\t\tif (vWait[j] >= 0.0 && vWait[j] < 0.03 * sr) {\n\t\t\t\t\tsoon = 1.0;\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (soon < 0.5) {\n\t\t\t\tfired = 1.0;\n\t\t\t}\n\t\t}\n\t}\n\tlet envA = vEnvA[k] * kRise;\n\tlet envD = vEnvD[k] * kFall;\n\tvEnvA[k] = envA;\n\tvEnvD[k] = envD;\n\tlet env = envD - envA;\n\tlet ic1 = vIc1[k];\n\tlet ic2 = vIc2[k];\n\tif (env > 0.00001 || abs(ic1) + abs(ic2) > 0.000001) {\n\t\tlet x = rng.next() * env * 1.2;\n\t\tlet v3 = x - ic2;\n\t\tlet v1 = vA1[k] * ic1 + vA2[k] * v3;\n\t\tlet v2 = ic2 + vA2[k] * ic1 + vA3[k] * v3;\n\t\tvIc1[k] = 2.0 * v1 - ic1;\n\t\tvIc2[k] = 2.0 * v2 - ic2;\n\t\tlet s = vK[k] * v1 * vGain[k];\n\t\tyl += s * vGL[k];\n\t\tyr += s * vGR[k];\n\t\tslapL += env * vGL[k];\n\t\tslapR += env * vGR[k];\n\t\tactive += env;\n\t}\n}\nrecent = maximum(active, recent * kFall);\n\n// --- air: broadband palm slap (high-passed noise on the burst envelopes) ---\nlet nL = rng.next();\nlet nR = rng.next();\nlet nRw = (1.0 - wid) * nL + wid * nR;\nlet hL = nL - airLpL.next(nL, 2500.0);\nlet hR = nRw - airLpR.next(nRw, 2500.0);\nyl += hL * slapL * airAmt * 0.6 * slapNorm;\nyr += hR * slapR * airAmt * 0.6 * slapNorm;\n\n// --- tail: every clap re-peaks it (a clap in a room always has its room),\n// except one with another clap due within 30 ms. Continues from the current\n// level (no jump): a tight flam gets one tail, spread-out claps each get one.\nif (fired > 0.5) {\n\tlet tailNow = tailEnvD - tailEnvA;\n\ttailEnvD = maximum(tailEnvD, 1.0);\n\ttailEnvA = tailEnvD - tailNow;\n}\ntailEnvA = tailEnvA * kFall;\ntailEnvD = tailEnvD * kTail;\nlet tailEnv = tailEnvD - tailEnvA;\nlet tl = nL * tailEnv;\nlet tr = nRw * tailEnv;\nlet tv3L = tl - tIc2L;\nlet tv1L = tA1 * tIc1L + tA2 * tv3L;\nlet tv2L = tIc2L + tA2 * tIc1L + tA3 * tv3L;\ntIc1L = 2.0 * tv1L - tIc1L;\ntIc2L = 2.0 * tv2L - tIc2L;\nlet tv3R = tr - tIc2R;\nlet tv1R = tA1 * tIc1R + tA2 * tv3R;\nlet tv2R = tIc2R + tA2 * tIc1R + tA3 * tv3R;\ntIc1R = 2.0 * tv1R - tIc1R;\ntIc2R = 2.0 * tv2R - tIc2R;\n// air also opens the tail: band-pass blended with the brighter raw noise\nlet tailHi = 1500.0 + 9000.0 * airAmt;\nlet tbl = 0.6 * tv1L + 0.25 * airAmt * tailLpL.next(tl, tailHi);\nlet tbr = 0.6 * tv1R + 0.25 * airAmt * tailLpR.next(tr, tailHi);\nyl += 0.8 * tbl;\nyr += 0.8 * tbr;\n\nyl = yl - dcLpL.next(yl, 30.0);\nyr = yr - dcLpR.next(yr, 30.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = 1.4 * yl * gain;\nout2 = 1.4 * yr * gain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 1,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "expr": "",
                                        "code": "// ============================================================================\n// clap_cavity_ensemble.txt — triggered hand clap: 1-20 virtual clappers, each\n//                            a noise burst through the resonance of the air\n//                            cavity between the hands, flammed, plus a tail\n//\n// From: A. Jylhä, C. Erkut, \"Inferring the Hand Configuration from Hand\n//       Clapping Sounds\", DAFx-08: §2 (a clap is ~5 ms with one pronounced\n//       cavity resonance; a smaller cavity resonates higher), §2.1 (ClaPD:\n//       each clap = enveloped noise burst into a 2nd-order resonator whose\n//       parameters are drawn per clap), Table 1 (mean and deviation of\n//       centre f, -3 dB bandwidth B and gain G per hand configuration);\n//       W. Ahmad, A. M. Kondoz, \"Generation of Non-Repetitive Everyday Impact\n//       Sounds for Interactive Applications\", DAFx-11: §5.2, §6.1 (every\n//       event re-drawn from the analysed distributions, so repeats are never\n//       identical).\n//\n// cavity morphs along Table 1, sorted by centre frequency:\n//   A1+ (cupped) 500 Hz -> A1 775 -> A1- 984 -> A2 1355 -> P3 (flat) 1562.\n// Per hit, each clapper draws f, B, G from Gaussians around the morphed\n// means (deviations from the table, scaled by variance), adds its own fixed\n// hand bias (every clapper cups a little differently) and fires after a\n// random offset within spread_ms. Burst = difference of two exponentials\n// (0.25 ms rise, ~2.5 ms fall) into a unity-peak TPT band-pass. \"air\" adds\n// the broadband slap of palm contact. Every clap re-peaks the tail (stereo\n// noise through a wide band-pass, decaying over tail_ms) unless another\n// clap is due within 30 ms, continuing from its current level: a tight flam\n// gets one tail after its last clap, spread claps each get their own.\n// The random walk drifts the whole ensemble's cavity between hits. A\n// retrigger while the clap is still sounding flams tighter (the hands are\n// already close) and adds into the ringing resonators. Nothing resets.\n//\n// Inlets:\n//   in1: audio-rate trigger (single-sample click, rising edge above 0.1)\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Hand cavity: cupped (0) -> flat (100)\n@param({ min: 0, max: 100 }) cavity = 50;\n// Number of clappers\n@param({ min: 1, max: 20, steps: 20 }) clappers = 4;\n// Flam spread between clappers\n@param({ min: 0, max: 1000, exponent: 3 }) spread_ms = 12;\n// Tail (time to -40 dB)\n@param({ min: 20, max: 1500, exponent: 2 }) tail_ms = 250;\n// Air: palm slap / brightness\n@param({ min: 0, max: 100 }) air = 50;\n// Stereo width\n@param({ min: 0, max: 100 }) width = 60;\n// Hit-to-hit variance\n@param({ min: 0, max: 100 }) variance = 35;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state rng = new noise();\n@state airLpL = new onepole();\n@state airLpR = new onepole();\n@state tailLpL = new onepole();\n@state tailLpR = new onepole();\n@state dcLpL = new onepole();\n@state dcLpR = new onepole();\n\n// Table 1 chain: A1+, A1, A1-, A2, P3\n@state cavF = new FixedSampleArray(5);\n@state cavDf = new FixedSampleArray(5);\n@state cavB = new FixedSampleArray(5);\n@state cavDb = new FixedSampleArray(5);\n@state cavG = new FixedSampleArray(5);\n@state cavDg = new FixedSampleArray(5);\n\n// per clapper\n@state vBias = new FixedSampleArray(20);\n@state vWait = new FixedSampleArray(20);\n@state vEnvA = new FixedSampleArray(20);\n@state vEnvD = new FixedSampleArray(20);\n@state vGain = new FixedSampleArray(20);\n@state vGL = new FixedSampleArray(20);\n@state vGR = new FixedSampleArray(20);\n@state vK = new FixedSampleArray(20);\n@state vA1 = new FixedSampleArray(20);\n@state vA2 = new FixedSampleArray(20);\n@state vA3 = new FixedSampleArray(20);\n@state vIc1 = new FixedSampleArray(20);\n@state vIc2 = new FixedSampleArray(20);\n\n@state prevTrig = 0.0;\n@state lastSr = 0.0;\n@state lastTail = -1.0;\n@state kRise = 0.0;\n@state kFall = 0.0;\n@state kTail = 0.0;\n@state spot = 0.0;\n@state tailEnvA = 0.0;\n@state tailEnvD = 0.0;\n@state tailHz = 1300.0;\n@state tA1 = 0.0;\n@state tA2 = 0.0;\n@state tA3 = 0.0;\n@state tIc1L = 0.0;\n@state tIc2L = 0.0;\n@state tIc1R = 0.0;\n@state tIc2R = 0.0;\n@state recent = 0.0;\n@state slapNorm = 1.0;\n\nfunction init() {\n\tcavF[0] = 500.0;\n\tcavDf[0] = 178.0;\n\tcavB[0] = 91.0;\n\tcavDb[0] = 27.0;\n\tcavG[0] = 33.8;\n\tcavDg[0] = 5.57;\n\tcavF[1] = 775.0;\n\tcavDf[1] = 39.0;\n\tcavB[1] = 137.0;\n\tcavDb[1] = 15.0;\n\tcavG[1] = 22.2;\n\tcavDg[1] = 3.55;\n\tcavF[2] = 984.0;\n\tcavDf[2] = 396.0;\n\tcavB[2] = 137.0;\n\tcavDb[2] = 36.0;\n\tcavG[2] = 11.3;\n\tcavDg[2] = 1.42;\n\tcavF[3] = 1355.0;\n\tcavDf[3] = 57.0;\n\tcavB[3] = 222.0;\n\tcavDb[3] = 53.0;\n\tcavG[3] = 24.0;\n\tcavDg[3] = 8.03;\n\tcavF[4] = 1562.0;\n\tcavDf[4] = 257.0;\n\tcavB[4] = 375.0;\n\tcavDb[4] = 94.0;\n\tcavG[4] = 19.5;\n\tcavDg[4] = 6.31;\n\tfor (let k: Int = 0; k < 20; k++) {\n\t\tvBias[k] = 0.12 * rng.next();\n\t\tvWait[k] = -1.0;\n\t}\n}\n\n// ~N(0,1) from three uniforms (variance 3 * 1/3)\nfunction gauss() {\n\treturn rng.next() + rng.next() + rng.next();\n}\n\n// unity-peak TPT band-pass coefficients for voice k\nfunction setVoiceFilter(k: Int, f, bw, sr) {\n\tlet fc = clamp(f, 150.0, sr * 0.4);\n\tlet damp = clamp(bw / fc, 0.02, 2.0);\n\tlet g = tan(pi * fc / sr);\n\tlet a1 = 1.0 / (1.0 + g * (g + damp));\n\tvK[k] = damp;\n\tvA1[k] = a1;\n\tvA2[k] = g * a1;\n\tvA3[k] = g * g * a1;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet v = clamp(variance, 0.0, 100.0) * 0.01;\nlet airAmt = clamp(air, 0.0, 100.0) * 0.01;\nlet wid = clamp(width, 0.0, 100.0) * 0.01;\n\nif (sr != lastSr || tail_ms != lastTail) {\n\tkRise = exp(-1.0 / (0.00025 * sr));\n\tkFall = exp(-1.0 / (0.0025 * sr));\n\tkTail = exp(-4.6 / (clamp(tail_ms, 20.0, 1500.0) * 0.001 * sr));\n\tlastSr = sr;\n\tlastTail = tail_ms;\n}\n\n// --- trigger: schedule the ensemble ---\nlet trigIn = abs(in1);\nif (trigIn > 0.1 && prevTrig <= 0.1) {\n\tlet n: Int = trunc(clamp(clappers, 1.0, 20.0) + 0.5);\n\tspot = clamp(0.55 * spot + 0.65 * rng.next(), -1.0, 1.0);\n\t// equal loudness for any number of clappers: normalise by how many claps\n\t// overlap (~8 ms each within the spread); 4 clappers over 12 ms -> 3 -> 1.0\n\tlet nEff = 1.0 + (n - 1.0) * minimum(1.0, 8.0 / maximum(spread_ms, 0.001));\n\tlet nNorm = sqrt(3.0 / nEff);\n\t// the slap shares one noise source, so overlapping slaps add coherently\n\tslapNorm = 3.0 / nEff;\n\tlet busy = clamp(recent, 0.0, 1.0);\n\tlet spr = clamp(spread_ms, 0.0, 1000.0) * 0.001 * sr * (1.0 - 0.4 * busy);\n\tfor (let k: Int = 0; k < 20; k++) {\n\t\tif (k < n) {\n\t\t\tlet x = clamp(clamp(cavity, 0.0, 100.0) * 0.01 + 0.15 * v * spot + vBias[k], 0.0, 1.0);\n\t\t\tlet pos = x * 4.0;\n\t\t\tlet ii: Int = trunc(minimum(pos, 3.0));\n\t\t\tlet fr = pos - ii;\n\t\t\tlet fm = cavF[ii] + (cavF[ii + 1] - cavF[ii]) * fr;\n\t\t\tlet dfm = cavDf[ii] + (cavDf[ii + 1] - cavDf[ii]) * fr;\n\t\t\tlet bm = cavB[ii] + (cavB[ii + 1] - cavB[ii]) * fr;\n\t\t\tlet dbm = cavDb[ii] + (cavDb[ii + 1] - cavDb[ii]) * fr;\n\t\t\tlet gm = cavG[ii] + (cavG[ii + 1] - cavG[ii]) * fr;\n\t\t\tlet dgm = cavDg[ii] + (cavDg[ii + 1] - cavDg[ii]) * fr;\n\t\t\tlet dev = 1.4 * v;\n\t\t\tlet f = maximum(fm + dev * dfm * gauss(), 250.0);\n\t\t\tlet bw = maximum(bm + dev * dbm * gauss(), 40.0);\n\t\t\tlet gg = maximum(gm + dev * dgm * gauss(), 4.0);\n\t\t\tsetVoiceFilter(k, f, bw, sr);\n\t\t\t// G from the table; sqrt(sr / (pi B)) keeps narrow cavities as loud as\n\t\t\t// wide ones (a unity-peak band-pass passes noise power ~ B)\n\t\t\tvGain[k] = gg / 22.0 * 0.6 * sqrt(sr / (pi * bw)) * nNorm;\n\t\t\t// first clapper on time, the others within the spread\n\t\t\tlet w = (k == 0) ? 0.0 : spr * (k + 0.6 * rng.next()) / n;\n\t\t\tvWait[k] = maximum(w, 0.0);\n\t\t\tlet p = clamp(wid * ((k == 0) ? 0.2 * rng.next() : rng.next()), -1.0, 1.0);\n\t\t\tvGL[k] = sqrt(0.5 * (1.0 - p));\n\t\t\tvGR[k] = sqrt(0.5 * (1.0 + p));\n\t\t\tif (k == 0) {\n\t\t\t\ttailHz = clamp(f * 1.4, 400.0, sr * 0.4);\n\t\t\t}\n\t\t}\n\t}\n\tlet tg = tan(pi * tailHz / sr);\n\ttA1 = 1.0 / (1.0 + tg * (tg + 0.6));\n\ttA2 = tg * tA1;\n\ttA3 = tg * tA2;\n}\nprevTrig = trigIn;\n\n// --- clappers ---\nlet yl = 0.0;\nlet yr = 0.0;\nlet slapL = 0.0;\nlet slapR = 0.0;\nlet active = 0.0;\nlet fired = 0.0;\nfor (let k: Int = 0; k < 20; k++) {\n\tif (vWait[k] >= 0.0) {\n\t\tvWait[k] = vWait[k] - 1.0;\n\t\tif (vWait[k] < 0.0) {\n\t\t\tvEnvA[k] = vEnvA[k] + 1.0;\n\t\t\tvEnvD[k] = vEnvD[k] + 1.0;\n\t\t\t// a clap starts the tail unless another lands within 30 ms (a\n\t\t\t// tight flam keeps one tail, after its last clap)\n\t\t\tlet soon = 0.0;\n\t\t\tfor (let j: Int = 0; j < 20; j++) {\n\t\t\t\tif (vWait[j] >= 0.0 && vWait[j] < 0.03 * sr) {\n\t\t\t\t\tsoon = 1.0;\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (soon < 0.5) {\n\t\t\t\tfired = 1.0;\n\t\t\t}\n\t\t}\n\t}\n\tlet envA = vEnvA[k] * kRise;\n\tlet envD = vEnvD[k] * kFall;\n\tvEnvA[k] = envA;\n\tvEnvD[k] = envD;\n\tlet env = envD - envA;\n\tlet ic1 = vIc1[k];\n\tlet ic2 = vIc2[k];\n\tif (env > 0.00001 || abs(ic1) + abs(ic2) > 0.000001) {\n\t\tlet x = rng.next() * env * 1.2;\n\t\tlet v3 = x - ic2;\n\t\tlet v1 = vA1[k] * ic1 + vA2[k] * v3;\n\t\tlet v2 = ic2 + vA2[k] * ic1 + vA3[k] * v3;\n\t\tvIc1[k] = 2.0 * v1 - ic1;\n\t\tvIc2[k] = 2.0 * v2 - ic2;\n\t\tlet s = vK[k] * v1 * vGain[k];\n\t\tyl += s * vGL[k];\n\t\tyr += s * vGR[k];\n\t\tslapL += env * vGL[k];\n\t\tslapR += env * vGR[k];\n\t\tactive += env;\n\t}\n}\nrecent = maximum(active, recent * kFall);\n\n// --- air: broadband palm slap (high-passed noise on the burst envelopes) ---\nlet nL = rng.next();\nlet nR = rng.next();\nlet nRw = (1.0 - wid) * nL + wid * nR;\nlet hL = nL - airLpL.next(nL, 2500.0);\nlet hR = nRw - airLpR.next(nRw, 2500.0);\nyl += hL * slapL * airAmt * 0.6 * slapNorm;\nyr += hR * slapR * airAmt * 0.6 * slapNorm;\n\n// --- tail: every clap re-peaks it (a clap in a room always has its room),\n// except one with another clap due within 30 ms. Continues from the current\n// level (no jump): a tight flam gets one tail, spread-out claps each get one.\nif (fired > 0.5) {\n\tlet tailNow = tailEnvD - tailEnvA;\n\ttailEnvD = maximum(tailEnvD, 1.0);\n\ttailEnvA = tailEnvD - tailNow;\n}\ntailEnvA = tailEnvA * kFall;\ntailEnvD = tailEnvD * kTail;\nlet tailEnv = tailEnvD - tailEnvA;\nlet tl = nL * tailEnv;\nlet tr = nRw * tailEnv;\nlet tv3L = tl - tIc2L;\nlet tv1L = tA1 * tIc1L + tA2 * tv3L;\nlet tv2L = tIc2L + tA2 * tIc1L + tA3 * tv3L;\ntIc1L = 2.0 * tv1L - tIc1L;\ntIc2L = 2.0 * tv2L - tIc2L;\nlet tv3R = tr - tIc2R;\nlet tv1R = tA1 * tIc1R + tA2 * tv3R;\nlet tv2R = tIc2R + tA2 * tIc1R + tA3 * tv3R;\ntIc1R = 2.0 * tv1R - tIc1R;\ntIc2R = 2.0 * tv2R - tIc2R;\n// air also opens the tail: band-pass blended with the brighter raw noise\nlet tailHi = 1500.0 + 9000.0 * airAmt;\nlet tbl = 0.6 * tv1L + 0.25 * airAmt * tailLpL.next(tl, tailHi);\nlet tbr = 0.6 * tv1R + 0.25 * airAmt * tailLpR.next(tr, tailHi);\nyl += 0.8 * tbl;\nyr += 0.8 * tbr;\n\nyl = yl - dcLpL.next(yl, 30.0);\nyr = yr - dcLpR.next(yr, 30.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = 1.4 * yl * gain;\nout2 = 1.4 * yr * gain;\n",
                                        "nocache": 0
                                    },
                                    "rnbo_serial": 1,
                                    "rnbo_uniqueid": "effect_code",
