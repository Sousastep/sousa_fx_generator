                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 84.0, 131.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 10_phasor_synced_comb_flanger.txt\n// Unix-Style Effect 10: 1-Bar Phasor-Synced Riddim Comb Sweeper\n// Driven by the 1-bar audio-rate phasor (0..1) on in3.\n// Sweeps a stereo pair of high-resonance comb filters using customizable\n// rhythmic subdivisions and warp curves (kink / triangle / exponential drop)\n// to create tempo-locked riddim \"wonk\", laser sweeps, and metallic talk-comb grooves.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: 1-Bar Audio-Rate Phasor [0..1] (if unpatched/0, uses internal 0.5 Hz LFO)\n// Outlets:\n//   out1: Left Rhythmic Comb Output\n//   out2: Right Rhythmic Comb Output\n\n@param({ min: 1.0, max: 16.0, steps: 16 }) subdiv_rate = 4.0;\n@param({ min: 0.15, max: 15.0 }) base_ms = 2.5;\n@param({ min: 0.0, max: 1.0 }) sweep_depth = 0.7;\n@param({ min: -0.96, max: 0.96 }) resonance = 0.8;\n\n@state combBufL = new FixedSampleArray(2048);\n@state combBufR = new FixedSampleArray(2048);\n@state writeIdx: Int = 0;\n\n@state fallbackPhasor = new phasor();\n@state prevBarIn = 0.0;\n@state smoothDelL = 120.0;\n@state smoothDelR = 120.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet barIn = in3;\n\n// Detect if external 1-bar phasor is active; otherwise fall back to internal LFO\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet masterPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackPhasor.next(0.5);\n\n// --- 1. Rhythmic Subdivision & Riddim Envelope Shaping ---\nlet sub = floor(clamp(subdiv_rate, 1.0, 16.0));\nlet cyclePhL = wrap(masterPh * sub, 0.0, 1.0);\nlet cyclePhR = wrap(cyclePhL + 0.08, 0.0, 1.0); // Stereo phase offset for wide whip\n\n// Use RNBO triangle() with duty=0.25 for classic fast-attack / slow-decay riddim whip\nlet lfoL = pow(triangle(cyclePhL, 0.25), 1.6);\nlet lfoR = pow(triangle(cyclePhR, 0.25), 1.6);\n\n// --- 2. Exponential Delay Time Calculation (in ms -> samples) ---\n// Sweeps up to 3.5 octaves down/up from base_ms\nlet depthOct = pow(clamp(sweep_depth, 0.0, 1.0), 1.3) * 3.5;\nlet msL = clamp(base_ms * pow(2.0, (lfoL - 0.3) * depthOct), 0.12, 35.0);\nlet msR = clamp(base_ms * pow(2.0, (lfoR - 0.3) * depthOct), 0.12, 35.0);\n\nlet targetSampsL = clamp(mstosamps(msL), 2.0, 2040.0);\nlet targetSampsR = clamp(mstosamps(msR), 2.0, 2040.0);\n\nlet slew = 1.0 - exp(-1.0 / (0.002 * sr));\nsmoothDelL += (targetSampsL - smoothDelL) * slew;\nsmoothDelR += (targetSampsR - smoothDelR) * slew;\n\n// --- 3. Cubic Interpolated Comb Read & Feedback ---\nlet rPosL = writeIdx - smoothDelL;\nwhile (rPosL < 0.0) { rPosL += 2048.0; }\nlet iL0: Int = floor(rPosL);\nlet fracL = rPosL - iL0;\nlet delL = cubicinterp(fracL,\n\tcombBufL[(iL0 - 1 + 2048) % 2048],\n\tcombBufL[iL0 % 2048],\n\tcombBufL[(iL0 + 1) % 2048],\n\tcombBufL[(iL0 + 2) % 2048]\n);\n\nlet rPosR = writeIdx - smoothDelR;\nwhile (rPosR < 0.0) { rPosR += 2048.0; }\nlet iR0: Int = floor(rPosR);\nlet fracR = rPosR - iR0;\nlet delR = cubicinterp(fracR,\n\tcombBufR[(iR0 - 1 + 2048) % 2048],\n\tcombBufR[iR0 % 2048],\n\tcombBufR[(iR0 + 1) % 2048],\n\tcombBufR[(iR0 + 2) % 2048]\n);\n\nlet fb = clamp(resonance, -0.96, 0.96);\ncombBufL[writeIdx] = tanh(xL + fb * delL);\ncombBufR[writeIdx] = tanh(xR + fb * delR);\nwriteIdx = (writeIdx + 1) % 2048;\n\n// Output combines feedforward + feedback comb response for deep notches & peaks\nlet norm = 1.0 / (1.0 + 0.6 * abs(fb));\nout1 = (xL + fb * delL) * norm;\nout2 = (xR + fb * delR) * norm;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 3,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 10_phasor_synced_comb_flanger.txt\n// Unix-Style Effect 10: 1-Bar Phasor-Synced Riddim Comb Sweeper\n// Driven by the 1-bar audio-rate phasor (0..1) on in3.\n// Sweeps a stereo pair of high-resonance comb filters using customizable\n// rhythmic subdivisions and warp curves (kink / triangle / exponential drop)\n// to create tempo-locked riddim \"wonk\", laser sweeps, and metallic talk-comb grooves.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: 1-Bar Audio-Rate Phasor [0..1] (if unpatched/0, uses internal 0.5 Hz LFO)\n// Outlets:\n//   out1: Left Rhythmic Comb Output\n//   out2: Right Rhythmic Comb Output\n\n@param({ min: 1.0, max: 16.0, steps: 16 }) subdiv_rate = 4.0;\n@param({ min: 0.15, max: 15.0 }) base_ms = 2.5;\n@param({ min: 0.0, max: 1.0 }) sweep_depth = 0.7;\n@param({ min: -0.96, max: 0.96 }) resonance = 0.8;\n\n@state combBufL = new FixedSampleArray(2048);\n@state combBufR = new FixedSampleArray(2048);\n@state writeIdx: Int = 0;\n\n@state fallbackPhasor = new phasor();\n@state prevBarIn = 0.0;\n@state smoothDelL = 120.0;\n@state smoothDelR = 120.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet barIn = in3;\n\n// Detect if external 1-bar phasor is active; otherwise fall back to internal LFO\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet masterPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackPhasor.next(0.5);\n\n// --- 1. Rhythmic Subdivision & Riddim Envelope Shaping ---\nlet sub = floor(clamp(subdiv_rate, 1.0, 16.0));\nlet cyclePhL = wrap(masterPh * sub, 0.0, 1.0);\nlet cyclePhR = wrap(cyclePhL + 0.08, 0.0, 1.0); // Stereo phase offset for wide whip\n\n// Use RNBO triangle() with duty=0.25 for classic fast-attack / slow-decay riddim whip\nlet lfoL = pow(triangle(cyclePhL, 0.25), 1.6);\nlet lfoR = pow(triangle(cyclePhR, 0.25), 1.6);\n\n// --- 2. Exponential Delay Time Calculation (in ms -> samples) ---\n// Sweeps up to 3.5 octaves down/up from base_ms\nlet depthOct = pow(clamp(sweep_depth, 0.0, 1.0), 1.3) * 3.5;\nlet msL = clamp(base_ms * pow(2.0, (lfoL - 0.3) * depthOct), 0.12, 35.0);\nlet msR = clamp(base_ms * pow(2.0, (lfoR - 0.3) * depthOct), 0.12, 35.0);\n\nlet targetSampsL = clamp(mstosamps(msL), 2.0, 2040.0);\nlet targetSampsR = clamp(mstosamps(msR), 2.0, 2040.0);\n\nlet slew = 1.0 - exp(-1.0 / (0.002 * sr));\nsmoothDelL += (targetSampsL - smoothDelL) * slew;\nsmoothDelR += (targetSampsR - smoothDelR) * slew;\n\n// --- 3. Cubic Interpolated Comb Read & Feedback ---\nlet rPosL = writeIdx - smoothDelL;\nwhile (rPosL < 0.0) { rPosL += 2048.0; }\nlet iL0: Int = floor(rPosL);\nlet fracL = rPosL - iL0;\nlet delL = cubicinterp(fracL,\n\tcombBufL[(iL0 - 1 + 2048) % 2048],\n\tcombBufL[iL0 % 2048],\n\tcombBufL[(iL0 + 1) % 2048],\n\tcombBufL[(iL0 + 2) % 2048]\n);\n\nlet rPosR = writeIdx - smoothDelR;\nwhile (rPosR < 0.0) { rPosR += 2048.0; }\nlet iR0: Int = floor(rPosR);\nlet fracR = rPosR - iR0;\nlet delR = cubicinterp(fracR,\n\tcombBufR[(iR0 - 1 + 2048) % 2048],\n\tcombBufR[iR0 % 2048],\n\tcombBufR[(iR0 + 1) % 2048],\n\tcombBufR[(iR0 + 2) % 2048]\n);\n\nlet fb = clamp(resonance, -0.96, 0.96);\ncombBufL[writeIdx] = tanh(xL + fb * delL);\ncombBufR[writeIdx] = tanh(xR + fb * delR);\nwriteIdx = (writeIdx + 1) % 2048;\n\n// Output combines feedforward + feedback comb response for deep notches & peaks\nlet norm = 1.0 / (1.0 + 0.6 * abs(fb));\nout1 = (xL + fb * delL) * norm;\nout2 = (xR + fb * delR) * norm;\n",
                                        "expr": ""
                                    },
                                    "rnbo_serial": 2,
