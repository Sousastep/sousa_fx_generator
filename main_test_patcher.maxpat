                    },
                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 1274.0, 446.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 12_adaa_chebyshev_wavefolder.txt\n// Unix-Style Effect 12: ADAA Lockhart Wavefolder & Chebyshev Harmonic Shaper\n// Implements Approach 2.1, 2.3, 4.1, 4.3, 4.4 from the research docs &\n// Bilbao, Esqueda, Parker & Valimaki (IEEE SPL 2017):\n// First-order Antiderivative Antialiased (ADAA1) Sine/Lockhart Wavefolder\n// blended with deterministic Chebyshev polynomial harmonic synthesis (T2..T5)\n// and asymmetric tube bias for alias-suppressed West-Coast / dubstep growl.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (works great on both raw tuba and 01_harmonic_isolator)\n//   in2: Right Audio Input\n// Outlets:\n//   out1: Left Wavefolded / Chebyshev Output\n//   out2: Right Wavefolded / Chebyshev Output\n\n@param({ min: 0.0, max: 30.0 }) drive_db = 12.0;\n@param({ min: 0.0, max: 1.0 }) fold_cheby = 0.35;\n@param({ min: -0.6, max: 0.6 }) asym_bias = 0.15;\n@param({ min: 0.0, max: 1.0 }) sub_preserve = 0.45;\n\n// ADAA1 state memory (x[n-1] and antiderivative F1(x[n-1]))\n@state prevXL = 0.0;\n@state prevF1L = 0.0;\n@state prevXR = 0.0;\n@state prevF1R = 0.0;\n\n// Clean low-octave preservation filter & DC blockers\n@state lowLpL = new onepole();\n@state lowLpR = new onepole();\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\n// Antiderivative F1(x) of the wavefolder f(x) = sin(pi * x) + 0.5 * tanh(x)\n// F1(x) = -cos(pi * x) / pi + 0.5 * log(cosh(x))\n// Stable log(cosh(x)) = |x| + log(1 + exp(-2*|x|)) - log(2)\nfunction folderAntideriv(x: number): number {\n\tlet ax = abs(x);\n\tlet logCosh = ax + log(1.0 + exp(-2.0 * ax)) - 0.69314718056;\n\treturn (-cos(pi * x) / pi) + 0.5 * logCosh;\n}\n\nfunction folderDirect(x: number): number {\n\treturn sin(pi * x) + 0.5 * tanh(x);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\n\n// --- 1. Extract Clean Sub-Bass Fundamental Path (UnBox / Focus concept) ---\nlet subL = lowLpL.next(xL, 95.0);\nlet subR = lowLpR.next(xR, 95.0);\n\n// --- 2. Input Drive (dB to Linear) & Asymmetric Even-Harmonic Bias ---\nlet gain = dbtoa(clamp(drive_db, 0.0, 30.0));\nlet bias = clamp(asym_bias, -0.6, 0.6);\n\nlet uL = clamp(xL * gain + bias, -8.0, 8.0);\nlet uR = clamp(xR * gain - bias, -8.0, 8.0); // Opposite bias polarity on R for stereo width\n\n// --- 3. First-Order Antiderivative Antialiased (ADAA1) Wavefolder ---\nlet diffL = uL - prevXL;\nlet f1L = folderAntideriv(uL);\nlet foldOutL = (abs(diffL) > 0.00001) ? ((f1L - prevF1L) / diffL) : folderDirect(0.5 * (uL + prevXL));\nprevXL = uL;\nprevF1L = f1L;\n\nlet diffR = uR - prevXR;\nlet f1R = folderAntideriv(uR);\nlet foldOutR = (abs(diffR) > 0.00001) ? ((f1R - prevF1R) / diffR) : folderDirect(0.5 * (uR + prevXR));\nprevXR = uR;\nprevF1R = f1R;\n\n// --- 4. Chebyshev Polynomial Harmonic Generator (Pafnuty2 / Arfib 1979) ---\n// Normalize input to [-1, 1] via tanh(u * 0.5) so Chebyshev polynomials stay bounded\nlet cInL = tanh(uL * 0.45);\nlet cInR = tanh(uR * 0.45);\n\nlet l2 = cInL * cInL;\nlet l3 = l2 * cInL;\nlet l4 = l2 * l2;\nlet l5 = l4 * cInL;\n// T2 = 2x^2 - 1, T3 = 4x^3 - 3x, T4 = 8x^4 - 8x^2 + 1, T5 = 16x^5 - 20x^3 + 5x\nlet chebL = 0.45 * cInL + 0.25 * (2.0 * l2 - 1.0) + 0.35 * (4.0 * l3 - 3.0 * cInL) + 0.18 * (8.0 * l4 - 8.0 * l2 + 1.0) + 0.22 * (16.0 * l5 - 20.0 * l3 + 5.0 * cInL);\n\nlet r2 = cInR * cInR;\nlet r3 = r2 * cInR;\nlet r4 = r2 * r2;\nlet r5 = r4 * cInR;\nlet chebR = 0.45 * cInR + 0.25 * (2.0 * r2 - 1.0) + 0.35 * (4.0 * r3 - 3.0 * cInR) + 0.18 * (8.0 * r4 - 8.0 * r2 + 1.0) + 0.22 * (16.0 * r5 - 20.0 * r3 + 5.0 * cInR);\n\n// Morph between ADAA Wavefolder (0.0) and Chebyshev Polynomial Harmonics (1.0)\nlet distL = linearinterp(clamp(fold_cheby, 0.0, 1.0), foldOutL * 0.7, chebL);\nlet distR = linearinterp(clamp(fold_cheby, 0.0, 1.0), foldOutR * 0.7, chebR);\n\n// --- 5. DC Blocker & Clean Low-End Re-Injection ---\nlet dcCoeff = 1.0 - (2.0 * pi * 15.0 / sr);\nlet cleanL = distL - dcXL + dcCoeff * dcYL; dcXL = distL; dcYL = cleanL;\nlet cleanR = distR - dcXR + dcCoeff * dcYR; dcXR = distR; dcYR = cleanR;\n\nlet subMix = pow(clamp(sub_preserve, 0.0, 1.0), 1.2);\nout1 = cleanL * (1.0 - 0.35 * subMix) + subL * subMix * 1.4;\nout2 = cleanR * (1.0 - 0.35 * subMix) + subR * subMix * 1.4;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 12_adaa_chebyshev_wavefolder.txt\n// Unix-Style Effect 12: ADAA Lockhart Wavefolder & Chebyshev Harmonic Shaper\n// Implements Approach 2.1, 2.3, 4.1, 4.3, 4.4 from the research docs &\n// Bilbao, Esqueda, Parker & Valimaki (IEEE SPL 2017):\n// First-order Antiderivative Antialiased (ADAA1) Sine/Lockhart Wavefolder\n// blended with deterministic Chebyshev polynomial harmonic synthesis (T2..T5)\n// and asymmetric tube bias for alias-suppressed West-Coast / dubstep growl.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (works great on both raw tuba and 01_harmonic_isolator)\n//   in2: Right Audio Input\n// Outlets:\n//   out1: Left Wavefolded / Chebyshev Output\n//   out2: Right Wavefolded / Chebyshev Output\n\n@param({ min: 0.0, max: 30.0 }) drive_db = 12.0;\n@param({ min: 0.0, max: 1.0 }) fold_cheby = 0.35;\n@param({ min: -0.6, max: 0.6 }) asym_bias = 0.15;\n@param({ min: 0.0, max: 1.0 }) sub_preserve = 0.45;\n\n// ADAA1 state memory (x[n-1] and antiderivative F1(x[n-1]))\n@state prevXL = 0.0;\n@state prevF1L = 0.0;\n@state prevXR = 0.0;\n@state prevF1R = 0.0;\n\n// Clean low-octave preservation filter & DC blockers\n@state lowLpL = new onepole();\n@state lowLpR = new onepole();\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\n// Antiderivative F1(x) of the wavefolder f(x) = sin(pi * x) + 0.5 * tanh(x)\n// F1(x) = -cos(pi * x) / pi + 0.5 * log(cosh(x))\n// Stable log(cosh(x)) = |x| + log(1 + exp(-2*|x|)) - log(2)\nfunction folderAntideriv(x: number): number {\n\tlet ax = abs(x);\n\tlet logCosh = ax + log(1.0 + exp(-2.0 * ax)) - 0.69314718056;\n\treturn (-cos(pi * x) / pi) + 0.5 * logCosh;\n}\n\nfunction folderDirect(x: number): number {\n\treturn sin(pi * x) + 0.5 * tanh(x);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\n\n// --- 1. Extract Clean Sub-Bass Fundamental Path (UnBox / Focus concept) ---\nlet subL = lowLpL.next(xL, 95.0);\nlet subR = lowLpR.next(xR, 95.0);\n\n// --- 2. Input Drive (dB to Linear) & Asymmetric Even-Harmonic Bias ---\nlet gain = dbtoa(clamp(drive_db, 0.0, 30.0));\nlet bias = clamp(asym_bias, -0.6, 0.6);\n\nlet uL = clamp(xL * gain + bias, -8.0, 8.0);\nlet uR = clamp(xR * gain - bias, -8.0, 8.0); // Opposite bias polarity on R for stereo width\n\n// --- 3. First-Order Antiderivative Antialiased (ADAA1) Wavefolder ---\nlet diffL = uL - prevXL;\nlet f1L = folderAntideriv(uL);\nlet foldOutL = (abs(diffL) > 0.00001) ? ((f1L - prevF1L) / diffL) : folderDirect(0.5 * (uL + prevXL));\nprevXL = uL;\nprevF1L = f1L;\n\nlet diffR = uR - prevXR;\nlet f1R = folderAntideriv(uR);\nlet foldOutR = (abs(diffR) > 0.00001) ? ((f1R - prevF1R) / diffR) : folderDirect(0.5 * (uR + prevXR));\nprevXR = uR;\nprevF1R = f1R;\n\n// --- 4. Chebyshev Polynomial Harmonic Generator (Pafnuty2 / Arfib 1979) ---\n// Normalize input to [-1, 1] via tanh(u * 0.5) so Chebyshev polynomials stay bounded\nlet cInL = tanh(uL * 0.45);\nlet cInR = tanh(uR * 0.45);\n\nlet l2 = cInL * cInL;\nlet l3 = l2 * cInL;\nlet l4 = l2 * l2;\nlet l5 = l4 * cInL;\n// T2 = 2x^2 - 1, T3 = 4x^3 - 3x, T4 = 8x^4 - 8x^2 + 1, T5 = 16x^5 - 20x^3 + 5x\nlet chebL = 0.45 * cInL + 0.25 * (2.0 * l2 - 1.0) + 0.35 * (4.0 * l3 - 3.0 * cInL) + 0.18 * (8.0 * l4 - 8.0 * l2 + 1.0) + 0.22 * (16.0 * l5 - 20.0 * l3 + 5.0 * cInL);\n\nlet r2 = cInR * cInR;\nlet r3 = r2 * cInR;\nlet r4 = r2 * r2;\nlet r5 = r4 * cInR;\nlet chebR = 0.45 * cInR + 0.25 * (2.0 * r2 - 1.0) + 0.35 * (4.0 * r3 - 3.0 * cInR) + 0.18 * (8.0 * r4 - 8.0 * r2 + 1.0) + 0.22 * (16.0 * r5 - 20.0 * r3 + 5.0 * cInR);\n\n// Morph between ADAA Wavefolder (0.0) and Chebyshev Polynomial Harmonics (1.0)\nlet distL = linearinterp(clamp(fold_cheby, 0.0, 1.0), foldOutL * 0.7, chebL);\nlet distR = linearinterp(clamp(fold_cheby, 0.0, 1.0), foldOutR * 0.7, chebR);\n\n// --- 5. DC Blocker & Clean Low-End Re-Injection ---\nlet dcCoeff = 1.0 - (2.0 * pi * 15.0 / sr);\nlet cleanL = distL - dcXL + dcCoeff * dcYL; dcXL = distL; dcYL = cleanL;\nlet cleanR = distR - dcXR + dcCoeff * dcYR; dcXR = distR; dcYR = cleanR;\n\nlet subMix = pow(clamp(sub_preserve, 0.0, 1.0), 1.2);\nout1 = cleanL * (1.0 - 0.35 * subMix) + subL * subMix * 1.4;\nout2 = cleanR * (1.0 - 0.35 * subMix) + subR * subMix * 1.4;\n",
                                        "expr": ""
                                    },
                                    "rnbo_serial": 2,
                                    "rnbo_uniqueid": "effect_code",
