                        },
                        "classnamespace": "rnbo",
                        "rect": [ 451.0, 255.0, 1654.0, 1036.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 17_inst_cyber_tuba_tearout_engine.txt\n// Advanced Instrument 5: Cyber-Tuba Tearout & Machine-Gun Engine\n// Designed for extreme Tearout / Brostep / Riddim drops:\n//   - Pitch-tracked fundamental isolator + Self-FM Feedback Delay Loop (Approach 1c)\n//   - Rotating Analytic Ring Modulator / Harmonic Slider (Approach 3f: Re{s_a * e^(j*psi)})\n//   - 16-Stage Stereo Allpass Phase Disperser with Joystick-swept Cutoff & Pinch\n//   - 1-Bar Phasor-Synced \"Machine-Gun\" Chop & Pitch-Drop Envelope Generator\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs machine-gun tearout chops)\n// Outlets:\n//   out1: Left Tearout Engine Output\n//   out2: Right Tearout Engine Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_disperse_freq = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_fb_tearout = 0.0;\n@param({ min: -1.0, max: 2.0 }) rot_harmonic = 0.0;\n@param({ min: 1.0, max: 16.0, steps: 16 }) gun_subdiv = 8.0;\n@param({ min: 0.0, max: 1.0 }) gun_chop_depth = 0.65;\n@param({ min: 0.0, max: 1.0 }) pitch_drop_env = 0.5;\n@param({ min: 1.0, max: 10.0 }) disperse_q = 3.5;\n@param({ min: 0.0, max: 24.0 }) post_slam_db = 9.0;\n\n// Quadrature Hilbert pair for Rotating Ring Modulation (Approach 3f)\n@state hReX = new FixedSampleArray(4); @state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4); @state hImY = new FixedSampleArray(4);\n@state hDelRe = 0.0;\n@state prevTheta = 0.0;\n@state wrapCnt: Int = 0;\n\n// Feedback FM Delay Line (1024 samples per channel)\n@state fbBufL = new FixedSampleArray(1024);\n@state fbBufR = new FixedSampleArray(1024);\n@state fbWrite: Int = 0;\n@state prevFmL = 0.0;\n@state prevFmR = 0.0;\n\n// 16-stage 2nd-order Allpass Disperser per channel\n@state apZ1L = new FixedSampleArray(16);\n@state apZ2L = new FixedSampleArray(16);\n@state apZ1R = new FixedSampleArray(16);\n@state apZ2R = new FixedSampleArray(16);\n\n// Pitch & Phasor states\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch & Joystick Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nsmoothJoyX += (clamp(joy_x_disperse_freq, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_fb_tearout, -1.0, 1.0) - smoothJoyY) * slew;\n\nlet f0 = clamp(smoothF0, 24.0, 900.0);\n\n// --- 2. 1-Bar Rhythmic Machine-Gun Envelope & Pitch-Drop ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet gSub = floor(clamp(gun_subdiv, 1.0, 16.0));\nlet gunPh = wrap(barPh * gSub, 0.0, 1.0);\n// Steep decaying punch envelope for each machine-gun repeat\nlet punchEnv = pow(1.0 - gunPh, 2.2);\nlet gateWindow = trapezoid(gunPh, 0.02, 0.72);\nlet chopGain = linearinterp(clamp(gun_chop_depth, 0.0, 1.0), 1.0, gateWindow * (0.35 + 0.65 * punchEnv));\n\n// --- 3. Analytic Signal & Rotating Ring Modulation (Approach 3f) ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet sRe = mono;\nlet yRe0 = cRe0 * (sRe - hReY[0]) + hReX[0]; hReX[0] = sRe; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe - hReY[1]) + hReX[1]; hReX[1] = sRe; hReY[1] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe - hReY[2]) + hReX[2]; hReX[2] = sRe; hReY[2] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe - hReY[3]) + hReX[3]; hReX[3] = sRe; hReY[3] = yRe3;\nlet outRe = hDelRe; hDelRe = yRe3;\n\nlet sIm = mono;\nlet yIm0 = cIm0 * (sIm - hImY[0]) + hImX[0]; hImX[0] = sIm; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm - hImY[1]) + hImX[1]; hImX[1] = sIm; hImY[1] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm - hImY[2]) + hImX[2]; hImX[2] = sIm; hImY[2] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm - hImY[3]) + hImX[3]; hImX[3] = sIm; hImY[3] = yIm3;\nlet outIm = yIm3;\n\nlet pol = cartopol(outRe, outIm);\nlet theta = pol[1];\nlet dTh = theta - prevTheta;\nif (dTh < -pi) { wrapCnt = (wrapCnt + 1) % 4; }\nelse if (dTh > pi) { wrapCnt = (wrapCnt + 3) % 4; }\nprevTheta = theta;\n\nlet unwTheta = theta + 2.0 * pi * wrapCnt;\n// Rotating phase trajectory psi = (rot_harmonic + pitch_drop_env * punchEnv) * unwTheta\n// rot_harmonic = -0.5 gives locked sub-octave; 0.0 = original; +1.0 = octave up\nlet rotMult = clamp(rot_harmonic, -1.0, 2.0) + clamp(pitch_drop_env, 0.0, 1.0) * punchEnv * 1.5;\nlet psiL = rotMult * unwTheta;\nlet psiR = psiL + 0.15 * smoothJoyY;\n\nlet rotSigL = outRe * cos(psiL) - outIm * sin(psiL);\nlet rotSigR = outRe * cos(psiR) - outIm * sin(psiR);\n\n// --- 4. Feedback FM Delay Stage Driven by Joystick Y (Approach 1c) ---\nfbBufL[fbWrite] = rotSigL + 0.35 * xL;\nfbBufR[fbWrite] = rotSigR + 0.35 * xR;\n\nlet joyY_u = 0.5 * (smoothJoyY + 1.0);\n// Feedback FM index k: small k = sawtooth brass brightening; high k = torn metallic chaos\nlet fbK = pow(joyY_u, 1.3) * 0.85;\nlet baseDelSamps = clamp(sr / (f0 * 2.0), 4.0, 480.0);\n\nlet modDelL = clamp(baseDelSamps * (1.0 + fbK * prevFmL + 0.5 * clamp(pitch_drop_env, 0.0, 1.0) * (1.0 - punchEnv)), 2.0, 1018.0);\nlet modDelR = clamp(baseDelSamps * (1.0 + fbK * prevFmR + 0.5 * clamp(pitch_drop_env, 0.0, 1.0) * (1.0 - punchEnv)), 2.0, 1018.0);\n\nlet rPosL = fbWrite - modDelL;\nwhile (rPosL < 0.0) { rPosL += 1024.0; }\nlet iL0: Int = floor(rPosL);\nlet fracL = rPosL - iL0;\nlet fmOutL = cubicinterp(fracL, fbBufL[(iL0 - 1 + 1024) % 1024], fbBufL[iL0 % 1024], fbBufL[(iL0 + 1) % 1024], fbBufL[(iL0 + 2) % 1024]);\n\nlet rPosR = fbWrite - modDelR;\nwhile (rPosR < 0.0) { rPosR += 1024.0; }\nlet iR0: Int = floor(rPosR);\nlet fracR = rPosR - iR0;\nlet fmOutR = cubicinterp(fracR, fbBufR[(iR0 - 1 + 1024) % 1024], fbBufR[iR0 % 1024], fbBufR[(iR0 + 1) % 1024], fbBufR[(iR0 + 2) % 1024]);\n\nfbWrite = (fbWrite + 1) % 1024;\nprevFmL = tanh(fmOutL);\nprevFmR = tanh(fmOutR);\n\n// --- 5. 16-Stage Allpass Phase Disperser Swept by Joystick X & Punch Env ---\nlet dispHz = clamp(220.0 * pow(12.0, smoothJoyX + 0.5 * punchEnv), 45.0, 5000.0);\nlet apW0 = 2.0 * pi * dispHz / sr;\nlet apAlpha = sin(apW0) / (2.0 * clamp(disperse_q, 1.0, 10.0));\nlet apA0_inv = 1.0 / (1.0 + apAlpha);\nlet apB0 = (1.0 - apAlpha) * apA0_inv;\nlet apB1 = (-2.0 * cos(apW0)) * apA0_inv;\n\nlet dispL = prevFmL;\nlet dispR = prevFmR;\nfor (let i: Int = 0; i < 16; i++) {\n\tlet yL = apB0 * dispL + apZ1L[i];\n\tapZ1L[i] = apB1 * dispL - apB1 * yL + apZ2L[i];\n\tapZ2L[i] = dispL - apB0 * yL;\n\tdispL = yL;\n\n\tlet yR = apB0 * dispR + apZ1R[i];\n\tapZ1R[i] = apB1 * dispR - apB1 * yR + apZ2R[i];\n\tapZ2R[i] = dispR - apB0 * yR;\n\tdispR = yR;\n}\n\n// --- 6. Post-Slam Clipper & Machine-Gun Chopper ---\nlet slamGain = dbtoa(clamp(post_slam_db, 0.0, 24.0));\nout1 = tanh(dispL * slamGain) * chopGain;\nout2 = tanh(dispR * slamGain) * chopGain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 17_inst_cyber_tuba_tearout_engine.txt\n// Advanced Instrument 5: Cyber-Tuba Tearout & Machine-Gun Engine\n// Designed for extreme Tearout / Brostep / Riddim drops:\n//   - Pitch-tracked fundamental isolator + Self-FM Feedback Delay Loop (Approach 1c)\n//   - Rotating Analytic Ring Modulator / Harmonic Slider (Approach 3f: Re{s_a * e^(j*psi)})\n//   - 16-Stage Stereo Allpass Phase Disperser with Joystick-swept Cutoff & Pinch\n//   - 1-Bar Phasor-Synced \"Machine-Gun\" Chop & Pitch-Drop Envelope Generator\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs machine-gun tearout chops)\n// Outlets:\n//   out1: Left Tearout Engine Output\n//   out2: Right Tearout Engine Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_disperse_freq = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_fb_tearout = 0.0;\n@param({ min: -1.0, max: 2.0 }) rot_harmonic = 0.0;\n@param({ min: 1.0, max: 16.0, steps: 16 }) gun_subdiv = 8.0;\n@param({ min: 0.0, max: 1.0 }) gun_chop_depth = 0.65;\n@param({ min: 0.0, max: 1.0 }) pitch_drop_env = 0.5;\n@param({ min: 1.0, max: 10.0 }) disperse_q = 3.5;\n@param({ min: 0.0, max: 24.0 }) post_slam_db = 9.0;\n\n// Quadrature Hilbert pair for Rotating Ring Modulation (Approach 3f)\n@state hReX = new FixedSampleArray(4); @state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4); @state hImY = new FixedSampleArray(4);\n@state hDelRe = 0.0;\n@state prevTheta = 0.0;\n@state wrapCnt: Int = 0;\n\n// Feedback FM Delay Line (1024 samples per channel)\n@state fbBufL = new FixedSampleArray(1024);\n@state fbBufR = new FixedSampleArray(1024);\n@state fbWrite: Int = 0;\n@state prevFmL = 0.0;\n@state prevFmR = 0.0;\n\n// 16-stage 2nd-order Allpass Disperser per channel\n@state apZ1L = new FixedSampleArray(16);\n@state apZ2L = new FixedSampleArray(16);\n@state apZ1R = new FixedSampleArray(16);\n@state apZ2R = new FixedSampleArray(16);\n\n// Pitch & Phasor states\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch & Joystick Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nsmoothJoyX += (clamp(joy_x_disperse_freq, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_fb_tearout, -1.0, 1.0) - smoothJoyY) * slew;\n\nlet f0 = clamp(smoothF0, 24.0, 900.0);\n\n// --- 2. 1-Bar Rhythmic Machine-Gun Envelope & Pitch-Drop ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet gSub = floor(clamp(gun_subdiv, 1.0, 16.0));\nlet gunPh = wrap(barPh * gSub, 0.0, 1.0);\n// Steep decaying punch envelope for each machine-gun repeat\nlet punchEnv = pow(1.0 - gunPh, 2.2);\nlet gateWindow = trapezoid(gunPh, 0.02, 0.72);\nlet chopGain = linearinterp(clamp(gun_chop_depth, 0.0, 1.0), 1.0, gateWindow * (0.35 + 0.65 * punchEnv));\n\n// --- 3. Analytic Signal & Rotating Ring Modulation (Approach 3f) ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet sRe = mono;\nlet yRe0 = cRe0 * (sRe - hReY[0]) + hReX[0]; hReX[0] = sRe; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe - hReY[1]) + hReX[1]; hReX[1] = sRe; hReY[1] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe - hReY[2]) + hReX[2]; hReX[2] = sRe; hReY[2] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe - hReY[3]) + hReX[3]; hReX[3] = sRe; hReY[3] = yRe3;\nlet outRe = hDelRe; hDelRe = yRe3;\n\nlet sIm = mono;\nlet yIm0 = cIm0 * (sIm - hImY[0]) + hImX[0]; hImX[0] = sIm; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm - hImY[1]) + hImX[1]; hImX[1] = sIm; hImY[1] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm - hImY[2]) + hImX[2]; hImX[2] = sIm; hImY[2] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm - hImY[3]) + hImX[3]; hImX[3] = sIm; hImY[3] = yIm3;\nlet outIm = yIm3;\n\nlet pol = cartopol(outRe, outIm);\nlet theta = pol[1];\nlet dTh = theta - prevTheta;\nif (dTh < -pi) { wrapCnt = (wrapCnt + 1) % 4; }\nelse if (dTh > pi) { wrapCnt = (wrapCnt + 3) % 4; }\nprevTheta = theta;\n\nlet unwTheta = theta + 2.0 * pi * wrapCnt;\n// Rotating phase trajectory psi = (rot_harmonic + pitch_drop_env * punchEnv) * unwTheta\n// rot_harmonic = -0.5 gives locked sub-octave; 0.0 = original; +1.0 = octave up\nlet rotMult = clamp(rot_harmonic, -1.0, 2.0) + clamp(pitch_drop_env, 0.0, 1.0) * punchEnv * 1.5;\nlet psiL = rotMult * unwTheta;\nlet psiR = psiL + 0.15 * smoothJoyY;\n\nlet rotSigL = outRe * cos(psiL) - outIm * sin(psiL);\nlet rotSigR = outRe * cos(psiR) - outIm * sin(psiR);\n\n// --- 4. Feedback FM Delay Stage Driven by Joystick Y (Approach 1c) ---\nfbBufL[fbWrite] = rotSigL + 0.35 * xL;\nfbBufR[fbWrite] = rotSigR + 0.35 * xR;\n\nlet joyY_u = 0.5 * (smoothJoyY + 1.0);\n// Feedback FM index k: small k = sawtooth brass brightening; high k = torn metallic chaos\nlet fbK = pow(joyY_u, 1.3) * 0.85;\nlet baseDelSamps = clamp(sr / (f0 * 2.0), 4.0, 480.0);\n\nlet modDelL = clamp(baseDelSamps * (1.0 + fbK * prevFmL + 0.5 * clamp(pitch_drop_env, 0.0, 1.0) * (1.0 - punchEnv)), 2.0, 1018.0);\nlet modDelR = clamp(baseDelSamps * (1.0 + fbK * prevFmR + 0.5 * clamp(pitch_drop_env, 0.0, 1.0) * (1.0 - punchEnv)), 2.0, 1018.0);\n\nlet rPosL = fbWrite - modDelL;\nwhile (rPosL < 0.0) { rPosL += 1024.0; }\nlet iL0: Int = floor(rPosL);\nlet fracL = rPosL - iL0;\nlet fmOutL = cubicinterp(fracL, fbBufL[(iL0 - 1 + 1024) % 1024], fbBufL[iL0 % 1024], fbBufL[(iL0 + 1) % 1024], fbBufL[(iL0 + 2) % 1024]);\n\nlet rPosR = fbWrite - modDelR;\nwhile (rPosR < 0.0) { rPosR += 1024.0; }\nlet iR0: Int = floor(rPosR);\nlet fracR = rPosR - iR0;\nlet fmOutR = cubicinterp(fracR, fbBufR[(iR0 - 1 + 1024) % 1024], fbBufR[iR0 % 1024], fbBufR[(iR0 + 1) % 1024], fbBufR[(iR0 + 2) % 1024]);\n\nfbWrite = (fbWrite + 1) % 1024;\nprevFmL = tanh(fmOutL);\nprevFmR = tanh(fmOutR);\n\n// --- 5. 16-Stage Allpass Phase Disperser Swept by Joystick X & Punch Env ---\nlet dispHz = clamp(220.0 * pow(12.0, smoothJoyX + 0.5 * punchEnv), 45.0, 5000.0);\nlet apW0 = 2.0 * pi * dispHz / sr;\nlet apAlpha = sin(apW0) / (2.0 * clamp(disperse_q, 1.0, 10.0));\nlet apA0_inv = 1.0 / (1.0 + apAlpha);\nlet apB0 = (1.0 - apAlpha) * apA0_inv;\nlet apB1 = (-2.0 * cos(apW0)) * apA0_inv;\n\nlet dispL = prevFmL;\nlet dispR = prevFmR;\nfor (let i: Int = 0; i < 16; i++) {\n\tlet yL = apB0 * dispL + apZ1L[i];\n\tapZ1L[i] = apB1 * dispL - apB1 * yL + apZ2L[i];\n\tapZ2L[i] = dispL - apB0 * yL;\n\tdispL = yL;\n\n\tlet yR = apB0 * dispR + apZ1R[i];\n\tapZ1R[i] = apB1 * dispR - apB1 * yR + apZ2R[i];\n\tapZ2R[i] = dispR - apB0 * yR;\n\tdispR = yR;\n}\n\n// --- 6. Post-Slam Clipper & Machine-Gun Chopper ---\nlet slamGain = dbtoa(clamp(post_slam_db, 0.0, 24.0));\nout1 = tanh(dispL * slamGain) * chopGain;\nout2 = tanh(dispR * slamGain) * chopGain;\n",
                                        "expr": ""
                                    },
                                    "rnbo_serial": 2,
                                    "rnbo_uniqueid": "effect_code",
