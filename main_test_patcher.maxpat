                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 311.0, 411.0, 1526.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 16_inst_phaseshaper_matrix_lead.txt\n// Advanced Instrument 4: Nested Phaseshaper Matrix Instrument (SMC 2010 Suite)\n// Turns the tuba into an analytic phasor phi(t) in [0, 1) and runs it through\n// a live-morphable 2D matrix of the oscillator algorithms from Kleimola,\n// Lazzarini, Timoney & Valimaki (SMC 2010):\n//   - PolyBLEP Hard Sync (Eq. 22)\n//   - Tilted Parabolic Triangle Phase gvtri -> Sinusoid (Eq. 16-17, Fig. 15-16)\n//   - Roland JP-8000 Triangle Modulation (Eq. 26)\n//   - Roland JP-8000 Ripple Supersaw (Eq. 28)\n//   - Phase-Divided Sub-Octave Lock (cos(theta/2))\n// With 1-Bar Phasor rhythmic sync-ratio envelopes and Joystick X/Y control.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs rhythmic phase-sync sweep)\n// Outlets:\n//   out1: Left Phaseshaper Matrix Output\n//   out2: Right Phaseshaper Matrix Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_sync_sweep = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_morph_algo = 0.0;\n@param({ min: 0.1, max: 0.9 }) tilt_duty_w = 0.5;\n@param({ min: 0.0, max: 1.0 }) supersaw_ripple = 0.55;\n@param({ min: 1.0, max: 16.0, steps: 16 }) rhythm_subdiv = 4.0;\n@param({ min: 0.0, max: 1.0 }) rhythm_depth = 0.5;\n@param({ min: 0.0, max: 1.0 }) sub_lock_mix = 0.5;\n@param({ min: 0.0, max: 1.0 }) pre_sine_iso = 0.7;\n\n// Pre-isolation SVF for clean phasor extraction\n@state svfIso = new svf();\n\n// 4-stage Quadrature Hilbert network for analytic phasor phi(t)\n@state hReX = new FixedSampleArray(4); @state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4); @state hImY = new FixedSampleArray(4);\n@state hDelRe = 0.0;\n\n// Unwrapped phase counter for locked sub-octave cos(theta/2)\n@state prevTheta = 0.0;\n@state wrapBit: Int = 0;\n\n// Fallback pitch & bar phasor\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.0;\n\nfunction polyblep(t: number, dt: number): number {\n\tlet corr = 0.0;\n\tlet sDt = clamp(dt, 0.0001, 0.45);\n\tif (t < sDt) {\n\t\tlet u = t / sDt;\n\t\tcorr = u + u - u * u - 1.0;\n\t} else if (t > 1.0 - sDt) {\n\t\tlet u = (t - 1.0) / sDt;\n\t\tcorr = u * u + u + u + 1.0;\n\t}\n\treturn corr;\n}\n\nfunction modm(x: number, m: number): number {\n\tlet sm = maximum(m, 0.01);\n\treturn x - sm * floor(x / sm);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch & Joystick Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nsmoothJoyX += (clamp(joy_x_sync_sweep, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_morph_algo, -1.0, 1.0) - smoothJoyY) * slew;\n\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Pre-Filter & Analytic Phasor Extraction ---\nlet isoAmt = clamp(pre_sine_iso, 0.0, 1.0);\nlet bpSig = svfIso.next(mono, f0, clamp(0.55 + 0.38 * isoAmt, 0.5, 0.94))[2] * 2.2;\nlet cleanIn = linearinterp(isoAmt, mono, bpSig);\n\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet sRe = cleanIn;\nlet yRe0 = cRe0 * (sRe - hReY[0]) + hReX[0]; hReX[0] = sRe; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe - hReY[1]) + hReX[1]; hReX[1] = sRe; hReY[1] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe - hReY[2]) + hReX[2]; hReX[2] = sRe; hReY[2] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe - hReY[3]) + hReX[3]; hReX[3] = sRe; hReY[3] = yRe3;\nlet outRe = hDelRe; hDelRe = yRe3;\n\nlet sIm = cleanIn;\nlet yIm0 = cIm0 * (sIm - hImY[0]) + hImX[0]; hImX[0] = sIm; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm - hImY[1]) + hImX[1]; hImX[1] = sIm; hImY[1] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm - hImY[2]) + hImX[2]; hImX[2] = sIm; hImY[2] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm - hImY[3]) + hImX[3]; hImX[3] = sIm; hImY[3] = yIm3;\nlet outIm = yIm3;\n\nlet pol = cartopol(outRe, outIm);\nlet instAmp = pol[0];\nlet theta = pol[1];\nlet phi = wrap((theta + pi) / (2.0 * pi), 0.0, 1.0);\n\n// Track wraps for zero-drift sub-octave cos(theta / 2)\nlet dTheta = theta - prevTheta;\nif (dTheta < -pi || dTheta > pi) {\n\twrapBit = 1 - wrapBit;\n}\nprevTheta = theta;\nlet subOctWave = cos(0.5 * (theta + 2.0 * pi * wrapBit));\n\n// --- 3. 1-Bar Rhythmic Phasor & Sync Ratio Calculation (a1) ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet rSub = floor(clamp(rhythm_subdiv, 1.0, 16.0));\nlet cycPh = wrap(barPh * rSub, 0.0, 1.0);\nlet cycEnv = pow(triangle(cycPh, 0.2), 1.5);\n\n// Master phase scaling a1 controlled by Joystick X (0.5x waveslice to 10x hard sync) + Rhythmic Env\nlet a1 = clamp(2.5 * pow(3.2, smoothJoyX) + 5.0 * clamp(rhythm_depth, 0.0, 1.0) * cycEnv, 0.35, 12.0);\nlet Ts = clamp((f0 * a1) / sr, 0.0001, 0.45);\n\n// --- 4. Variable-Slope Tilted Triangle Pre-Shaper svtri (SMC 2010 Eq. 16) ---\nlet w = clamp(tilt_duty_w, 0.1, 0.9);\nlet aT = 1.0 / (8.0 * maximum(w - w * w, 0.01));\nlet gb1 = 2.0 * phi - 1.0;\nlet gb2 = 2.0 * wrap(phi - w, 0.0, 1.0) - 1.0;\nlet svtri = clamp(aT * (gb1 * gb1 - gb2 * gb2) + 0.5, 0.0, 1.0);\n\nlet phiL = linearinterp(abs(w - 0.5) * 2.0, phi, svtri);\nlet phiR = wrap(phiL + 0.03, 0.0, 1.0);\n\n// --- 5. Compute the 3 SMC 2010 Phaseshaper Voices ---\n// Voice 1 (Joy Y = -1): Tilted-Triangle Sinusoidal Formant Waveshaper (Eq. 17 & Fig. 15)\nlet gvtriL = wrap(a1 * svtri, 0.0, 1.0);\nlet gvtriR = wrap(a1 * wrap(svtri + 0.03, 0.0, 1.0), 0.0, 1.0);\nlet v1L = sin(2.0 * pi * gvtriL);\nlet v1R = sin(2.0 * pi * gvtriR);\n\n// Voice 2 (Joy Y = 0): PolyBLEP Hard Sync + JP-8000 Triangle Modulation Hybrid (Eq. 22 & 26)\nlet syncPhL = wrap(a1 * phiL, 0.0, 1.0);\nlet syncPhR = wrap(a1 * phiR, 0.0, 1.0);\nlet hSyncL = (2.0 * syncPhL - 1.0) - polyblep(syncPhL, Ts);\nlet hSyncR = (2.0 * syncPhR - 1.0) - polyblep(syncPhR, Ts);\n\nlet aTM = clamp(0.72 + 0.28 * (0.5 * (smoothJoyX + 1.0)), 0.7, 1.0);\nlet xTL = aTM * wrap(2.0 * abs(2.0 * phiL - 1.0), 0.0, 1.0) - 1.0;\nlet xTR = aTM * wrap(2.0 * abs(2.0 * phiR - 1.0), 0.0, 1.0) - 1.0;\nlet triModL = 2.0 * (xTL - ceil(xTL) - 0.5);\nlet triModR = 2.0 * (xTR - ceil(xTR) - 0.5);\n\nlet v2L = 0.55 * hSyncL + 0.45 * triModL;\nlet v2R = 0.55 * hSyncR + 0.45 * triModR;\n\n// Voice 3 (Joy Y = +1): Ripple Supersaw Unison (Eq. 28)\nlet rip = clamp(supersaw_ripple, 0.0, 1.0);\nlet m1L = 0.2 + 0.55 * rip * (0.6 + 0.4 * sin(2.0 * pi * barPh));\nlet m1R = 0.2 + 0.55 * rip * (0.6 + 0.4 * cos(2.0 * pi * barPh));\nlet xssL = a1 * phiL;\nlet xssR = a1 * phiR;\nlet v3L = sin(2.0 * pi * (2.0 * modm(modm(xssL, m1L) + xssL, 0.88) - 1.0));\nlet v3R = sin(2.0 * pi * (2.0 * modm(modm(xssR, m1R) + xssR, 0.88) - 1.0));\n\n// Morph across Voice 1 -> Voice 2 -> Voice 3 using Joystick Y\nlet jy = smoothJoyY;\nlet leadL = (jy < 0.0) ? linearinterp(jy + 1.0, v1L, v2L) : linearinterp(jy, v2L, v3L);\nlet leadR = (jy < 0.0) ? linearinterp(jy + 1.0, v1R, v2R) : linearinterp(jy, v2R, v3R);\n\n// --- 6. Combine with Phase-Locked Sub-Octave & Restore Tuba Breath Dynamics ---\nlet gate = clamp((instAmp - 0.0008) * 250.0, 0.0, 1.0);\nlet sMix = clamp(sub_lock_mix, 0.0, 1.0);\nlet finalL = ((1.0 - 0.4 * sMix) * leadL + sMix * subOctWave) * instAmp * 1.8 * gate;\nlet finalR = ((1.0 - 0.4 * sMix) * leadR + sMix * subOctWave) * instAmp * 1.8 * gate;\n\nout1 = tanh(finalL);\nout2 = tanh(finalR);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 16_inst_phaseshaper_matrix_lead.txt\n// Advanced Instrument 4: Nested Phaseshaper Matrix Instrument (SMC 2010 Suite)\n// Turns the tuba into an analytic phasor phi(t) in [0, 1) and runs it through\n// a live-morphable 2D matrix of the oscillator algorithms from Kleimola,\n// Lazzarini, Timoney & Valimaki (SMC 2010):\n//   - PolyBLEP Hard Sync (Eq. 22)\n//   - Tilted Parabolic Triangle Phase gvtri -> Sinusoid (Eq. 16-17, Fig. 15-16)\n//   - Roland JP-8000 Triangle Modulation (Eq. 26)\n//   - Roland JP-8000 Ripple Supersaw (Eq. 28)\n//   - Phase-Divided Sub-Octave Lock (cos(theta/2))\n// With 1-Bar Phasor rhythmic sync-ratio envelopes and Joystick X/Y control.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs rhythmic phase-sync sweep)\n// Outlets:\n//   out1: Left Phaseshaper Matrix Output\n//   out2: Right Phaseshaper Matrix Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_sync_sweep = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_morph_algo = 0.0;\n@param({ min: 0.1, max: 0.9 }) tilt_duty_w = 0.5;\n@param({ min: 0.0, max: 1.0 }) supersaw_ripple = 0.55;\n@param({ min: 1.0, max: 16.0, steps: 16 }) rhythm_subdiv = 4.0;\n@param({ min: 0.0, max: 1.0 }) rhythm_depth = 0.5;\n@param({ min: 0.0, max: 1.0 }) sub_lock_mix = 0.5;\n@param({ min: 0.0, max: 1.0 }) pre_sine_iso = 0.7;\n\n// Pre-isolation SVF for clean phasor extraction\n@state svfIso = new svf();\n\n// 4-stage Quadrature Hilbert network for analytic phasor phi(t)\n@state hReX = new FixedSampleArray(4); @state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4); @state hImY = new FixedSampleArray(4);\n@state hDelRe = 0.0;\n\n// Unwrapped phase counter for locked sub-octave cos(theta/2)\n@state prevTheta = 0.0;\n@state wrapBit: Int = 0;\n\n// Fallback pitch & bar phasor\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.0;\n\nfunction polyblep(t: number, dt: number): number {\n\tlet corr = 0.0;\n\tlet sDt = clamp(dt, 0.0001, 0.45);\n\tif (t < sDt) {\n\t\tlet u = t / sDt;\n\t\tcorr = u + u - u * u - 1.0;\n\t} else if (t > 1.0 - sDt) {\n\t\tlet u = (t - 1.0) / sDt;\n\t\tcorr = u * u + u + u + 1.0;\n\t}\n\treturn corr;\n}\n\nfunction modm(x: number, m: number): number {\n\tlet sm = maximum(m, 0.01);\n\treturn x - sm * floor(x / sm);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch & Joystick Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nsmoothJoyX += (clamp(joy_x_sync_sweep, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_morph_algo, -1.0, 1.0) - smoothJoyY) * slew;\n\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Pre-Filter & Analytic Phasor Extraction ---\nlet isoAmt = clamp(pre_sine_iso, 0.0, 1.0);\nlet bpSig = svfIso.next(mono, f0, clamp(0.55 + 0.38 * isoAmt, 0.5, 0.94))[2] * 2.2;\nlet cleanIn = linearinterp(isoAmt, mono, bpSig);\n\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet sRe = cleanIn;\nlet yRe0 = cRe0 * (sRe - hReY[0]) + hReX[0]; hReX[0] = sRe; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe - hReY[1]) + hReX[1]; hReX[1] = sRe; hReY[1] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe - hReY[2]) + hReX[2]; hReX[2] = sRe; hReY[2] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe - hReY[3]) + hReX[3]; hReX[3] = sRe; hReY[3] = yRe3;\nlet outRe = hDelRe; hDelRe = yRe3;\n\nlet sIm = cleanIn;\nlet yIm0 = cIm0 * (sIm - hImY[0]) + hImX[0]; hImX[0] = sIm; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm - hImY[1]) + hImX[1]; hImX[1] = sIm; hImY[1] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm - hImY[2]) + hImX[2]; hImX[2] = sIm; hImY[2] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm - hImY[3]) + hImX[3]; hImX[3] = sIm; hImY[3] = yIm3;\nlet outIm = yIm3;\n\nlet pol = cartopol(outRe, outIm);\nlet instAmp = pol[0];\nlet theta = pol[1];\nlet phi = wrap((theta + pi) / (2.0 * pi), 0.0, 1.0);\n\n// Track wraps for zero-drift sub-octave cos(theta / 2)\nlet dTheta = theta - prevTheta;\nif (dTheta < -pi || dTheta > pi) {\n\twrapBit = 1 - wrapBit;\n}\nprevTheta = theta;\nlet subOctWave = cos(0.5 * (theta + 2.0 * pi * wrapBit));\n\n// --- 3. 1-Bar Rhythmic Phasor & Sync Ratio Calculation (a1) ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet rSub = floor(clamp(rhythm_subdiv, 1.0, 16.0));\nlet cycPh = wrap(barPh * rSub, 0.0, 1.0);\nlet cycEnv = pow(triangle(cycPh, 0.2), 1.5);\n\n// Master phase scaling a1 controlled by Joystick X (0.5x waveslice to 10x hard sync) + Rhythmic Env\nlet a1 = clamp(2.5 * pow(3.2, smoothJoyX) + 5.0 * clamp(rhythm_depth, 0.0, 1.0) * cycEnv, 0.35, 12.0);\nlet Ts = clamp((f0 * a1) / sr, 0.0001, 0.45);\n\n// --- 4. Variable-Slope Tilted Triangle Pre-Shaper svtri (SMC 2010 Eq. 16) ---\nlet w = clamp(tilt_duty_w, 0.1, 0.9);\nlet aT = 1.0 / (8.0 * maximum(w - w * w, 0.01));\nlet gb1 = 2.0 * phi - 1.0;\nlet gb2 = 2.0 * wrap(phi - w, 0.0, 1.0) - 1.0;\nlet svtri = clamp(aT * (gb1 * gb1 - gb2 * gb2) + 0.5, 0.0, 1.0);\n\nlet phiL = linearinterp(abs(w - 0.5) * 2.0, phi, svtri);\nlet phiR = wrap(phiL + 0.03, 0.0, 1.0);\n\n// --- 5. Compute the 3 SMC 2010 Phaseshaper Voices ---\n// Voice 1 (Joy Y = -1): Tilted-Triangle Sinusoidal Formant Waveshaper (Eq. 17 & Fig. 15)\nlet gvtriL = wrap(a1 * svtri, 0.0, 1.0);\nlet gvtriR = wrap(a1 * wrap(svtri + 0.03, 0.0, 1.0), 0.0, 1.0);\nlet v1L = sin(2.0 * pi * gvtriL);\nlet v1R = sin(2.0 * pi * gvtriR);\n\n// Voice 2 (Joy Y = 0): PolyBLEP Hard Sync + JP-8000 Triangle Modulation Hybrid (Eq. 22 & 26)\nlet syncPhL = wrap(a1 * phiL, 0.0, 1.0);\nlet syncPhR = wrap(a1 * phiR, 0.0, 1.0);\nlet hSyncL = (2.0 * syncPhL - 1.0) - polyblep(syncPhL, Ts);\nlet hSyncR = (2.0 * syncPhR - 1.0) - polyblep(syncPhR, Ts);\n\nlet aTM = clamp(0.72 + 0.28 * (0.5 * (smoothJoyX + 1.0)), 0.7, 1.0);\nlet xTL = aTM * wrap(2.0 * abs(2.0 * phiL - 1.0), 0.0, 1.0) - 1.0;\nlet xTR = aTM * wrap(2.0 * abs(2.0 * phiR - 1.0), 0.0, 1.0) - 1.0;\nlet triModL = 2.0 * (xTL - ceil(xTL) - 0.5);\nlet triModR = 2.0 * (xTR - ceil(xTR) - 0.5);\n\nlet v2L = 0.55 * hSyncL + 0.45 * triModL;\nlet v2R = 0.55 * hSyncR + 0.45 * triModR;\n\n// Voice 3 (Joy Y = +1): Ripple Supersaw Unison (Eq. 28)\nlet rip = clamp(supersaw_ripple, 0.0, 1.0);\nlet m1L = 0.2 + 0.55 * rip * (0.6 + 0.4 * sin(2.0 * pi * barPh));\nlet m1R = 0.2 + 0.55 * rip * (0.6 + 0.4 * cos(2.0 * pi * barPh));\nlet xssL = a1 * phiL;\nlet xssR = a1 * phiR;\nlet v3L = sin(2.0 * pi * (2.0 * modm(modm(xssL, m1L) + xssL, 0.88) - 1.0));\nlet v3R = sin(2.0 * pi * (2.0 * modm(modm(xssR, m1R) + xssR, 0.88) - 1.0));\n\n// Morph across Voice 1 -> Voice 2 -> Voice 3 using Joystick Y\nlet jy = smoothJoyY;\nlet leadL = (jy < 0.0) ? linearinterp(jy + 1.0, v1L, v2L) : linearinterp(jy, v2L, v3L);\nlet leadR = (jy < 0.0) ? linearinterp(jy + 1.0, v1R, v2R) : linearinterp(jy, v2R, v3R);\n\n// --- 6. Combine with Phase-Locked Sub-Octave & Restore Tuba Breath Dynamics ---\nlet gate = clamp((instAmp - 0.0008) * 250.0, 0.0, 1.0);\nlet sMix = clamp(sub_lock_mix, 0.0, 1.0);\nlet finalL = ((1.0 - 0.4 * sMix) * leadL + sMix * subOctWave) * instAmp * 1.8 * gate;\nlet finalR = ((1.0 - 0.4 * sMix) * leadR + sMix * subOctWave) * instAmp * 1.8 * gate;\n\nout1 = tanh(finalL);\nout2 = tanh(finalR);\n",
                                        "expr": ""
