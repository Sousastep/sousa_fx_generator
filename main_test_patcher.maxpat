                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 743.0, 319.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 00d_tuba_4op_modfm_resynthesizer.txt\n// 4-Operator Adaptive ModFM & Phaseshaper Vocoder Resynthesizer\n// Driven directly by the 9 outlets of 00c_tuba_4harmonic_sift_analyzer.txt\n// ============================================================================\n// Implements:\n//   1. Lazzarini & Timoney (ICMC 2011 / DAFx-08) \"ModFM Synthesis Vocoder\":\n//      Each of the 4 tracked tuba harmonics (f1..f4, A1..A4) drives an\n//      independent ModFM / Phaseshaper operator:\n//        s_k(t) = A_k(t) * cos(2*pi*g_k(phi_k)) * exp(k_mod * (cos(2*pi*phi_mod) - 1))\n//      Because exp(k*(cos(w_m*t) - 1)) generates strictly monotonic Modified\n//      Bessel sidebands I_n(k)*e^(-k) that never exceed 0 dB at any index k,\n//      each harmonic blossoms into a alias-controlled formant cluster without\n//      Bessel phase cancellations or volume overload!\n//   2. Cross-Harmonic Phase Modulation & Inharmonicity Exaggeration:\n//      Measures the real-time deviation of f2, f3, f4 from integer multiples\n//      (2*f1, 3*f1, 4*f1) and scales it by `inharm_stretch` (0x = pure harmonic\n//      lock, 1x = natural tuba bore inharmonicity, up to 4x = metallic ghost-note\n//      bell/tearout clangor).\n//   3. Centroid-Driven Dubstep Morphing (via in9 from 00c):\n//      The player's live embouchure brightness (Spectral Centroid in [1..4])\n//      and optional 1-bar phasor (in10) dynamically sweep the ModFM index k,\n//      SMC 2010 PolyBLEP Hard-Sync ratio, and Sub-Octave foundation.\n// ============================================================================\n// Inlets (patch 1-to-1 from outlets out1..out9 of 00c_tuba_4harmonic_sift_analyzer):\n//   in1: f1 — Harmonic 1 Instantaneous Frequency (Hz)\n//   in2: f2 — Harmonic 2 Instantaneous Frequency (Hz)\n//   in3: f3 — Harmonic 3 Instantaneous Frequency (Hz)\n//   in4: f4 — Harmonic 4 Instantaneous Frequency (Hz)\n//   in5: A1 — Harmonic 1 Instantaneous Amplitude\n//   in6: A2 — Harmonic 2 Instantaneous Amplitude\n//   in7: A3 — Harmonic 3 Instantaneous Amplitude\n//   in8: A4 — Harmonic 4 Instantaneous Amplitude\n//   in9: Real-Time Brass Spectral Centroid Ratio [1.0 .. 4.0]\n//   in10: Optional 1-Bar Audio-Rate Phasor [0.0 .. 1.0] (for rhythmic wobble sync)\n// Outlets:\n//   out1: Left Stereo 4-Op ModFM Resynthesizer Output\n//   out2: Right Stereo 4-Op ModFM Resynthesizer Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_sync_formant = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_modfm_index = 0.2;\n@param({ min: 0.0, max: 4.0 }) inharm_stretch = 1.0;\n@param({ min: 0.0, max: 1.0 }) cross_op_fm = 0.35;\n@param({ min: 0.0, max: 1.0 }) sub_octave_mix = 0.65;\n@param({ min: 1.0, max: 16.0, steps: 16 }) rhythm_subdiv = 4.0;\n@param({ min: 0.0, max: 1.0 }) rhythm_wobble = 0.45;\n@param({ min: 0.0, max: 1.0 }) stereo_pan_spread = 0.6;\n\n// 4 Carrier Phasors + 4 Modulator Phasors + 1 Sub-Octave Phasor\n@state carPh = new FixedSampleArray(4);\n@state modPh = new FixedSampleArray(4);\n@state opOutPrev = new FixedSampleArray(4);\n@state subPh = 0.0;\n\n// 6-Stage Stereo Allpass Disperser on the summed 4-Op bus for liquid dubstep punch\n@state apZ1L = new FixedSampleArray(6);\n@state apZ2L = new FixedSampleArray(6);\n@state apZ1R = new FixedSampleArray(6);\n@state apZ2R = new FixedSampleArray(6);\n\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.2;\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\nfunction polyblep(t: number, dt: number): number {\n\tlet corr = 0.0;\n\tlet sDt = clamp(dt, 0.0001, 0.45);\n\tif (t < sDt) {\n\t\tlet u = t / sDt;\n\t\tcorr = u + u - u * u - 1.0;\n\t} else if (t > 1.0 - sDt) {\n\t\tlet u = (t - 1.0) / sDt;\n\t\tcorr = u * u + u + u + 1.0;\n\t}\n\treturn corr;\n}\n\nlet sr = maximum(samplerate(), 1.0);\n\n// Read 9 SIFT Analyzer inputs + optional 10th 1-bar phasor\nlet f1_in = (in1 > 20.0) ? in1 : 58.27;\nlet f2_in = (in2 > 40.0) ? in2 : (f1_in * 2.0);\nlet f3_in = (in3 > 60.0) ? in3 : (f1_in * 3.0);\nlet f4_in = (in4 > 80.0) ? in4 : (f1_in * 4.0);\n\nlet a1_in = maximum(in5, 0.0);\nlet a2_in = maximum(in6, 0.0);\nlet a3_in = maximum(in7, 0.0);\nlet a4_in = maximum(in8, 0.0);\n\nlet centroid = clamp((in9 >= 1.0) ? in9 : 1.5, 1.0, 4.0);\nlet barIn = in10;\n\n// Smooth Joystick X/Y controls\nlet slew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothJoyX += (clamp(joy_x_sync_formant, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_modfm_index, -1.0, 1.0) - smoothJoyY) * slew;\n\n// ============================================================================\n// 1. 1-BAR RHYTHMIC WOBBLE ENVELOPE & EMBOUCHURE CENTROID COUPLING\n// ============================================================================\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet rSub = floor(clamp(rhythm_subdiv, 1.0, 16.0));\nlet wobPh = wrap(barPh * rSub, 0.0, 1.0);\nlet wobLfo = pow(triangle(wobPh, 0.22), 1.5);\nlet wobMod = linearinterp(clamp(rhythm_wobble, 0.0, 1.0), 1.0, wobLfo);\n\n// Normalize centroid [1..4] -> [0..1] so playing brighter/louder expands synthesis\nlet brassBright = clamp((centroid - 1.0) / 2.2, 0.0, 1.0);\n\n// ============================================================================\n// 2. INHARMONICITY STRETCH (EXAGGERATING BORE / GHOST-NOTE DEVIATIONS)\n// ============================================================================\nlet stretch = clamp(inharm_stretch, 0.0, 4.0);\nlet fOp = new FixedSampleArray(4);\nfOp[0] = clamp(f1_in, 22.0, sr * 0.42);\nfOp[1] = clamp(2.0 * f1_in + (f2_in - 2.0 * f1_in) * stretch, 40.0, sr * 0.42);\nfOp[2] = clamp(3.0 * f1_in + (f3_in - 3.0 * f1_in) * stretch, 60.0, sr * 0.42);\nfOp[3] = clamp(4.0 * f1_in + (f4_in - 4.0 * f1_in) * stretch, 80.0, sr * 0.42);\n\nlet aOp = new FixedSampleArray(4);\naOp[0] = a1_in;\naOp[1] = a2_in;\naOp[2] = a3_in;\naOp[3] = a4_in;\n\n// ============================================================================\n// 3. 4-OPERATOR ADAPTIVE MODFM + POLYBLEP PHASESHAPING ENGINE\n// ============================================================================\n// Sync ratio a1 controlled by Joystick X + embouchure centroid + rhythmic wobble\nlet syncRatio = clamp(1.8 * pow(2.6, smoothJoyX) * (1.0 + 0.6 * brassBright * wobMod), 1.0, 10.0);\n\n// ModFM Index k controlled by Joystick Y + embouchure brightness + rhythmic wobble\nlet joyY_u = 0.5 * (smoothJoyY + 1.0);\nlet baseK = (0.3 + 7.5 * pow(joyY_u, 1.35)) * (0.45 + 0.85 * brassBright) * wobMod;\nlet xFmAmt = pow(clamp(cross_op_fm, 0.0, 1.0), 1.3) * 0.45;\nlet panSpread = clamp(stereo_pan_spread, 0.0, 1.0);\n\nlet sumL = 0.0;\nlet sumR = 0.0;\n\nfor (let k: Int = 0; k < 4; k++) {\n\tlet fk = fOp[k];\n\tlet dtCar = clamp(fk / sr, 0.00001, 0.45);\n\tcarPh[k] = wrap(carPh[k] + dtCar, 0.0, 1.0);\n\n\t// Modulator runs at f1 (fundamental) so sidebands around every harmonic lock to f0!\n\tlet dtMod = clamp(fOp[0] / sr, 0.00001, 0.45);\n\tmodPh[k] = wrap(modPh[k] + dtMod, 0.0, 1.0);\n\n\t// Cross-operator phase modulation: Operator k is phase-modulated by Operator k-1\n\t// (Op 0 is self/feedback modulated by Op 3 for closed-loop growl)\n\tlet prevIdx: Int = (k + 3) % 4;\n\tlet crossPhase = xFmAmt * opOutPrev[prevIdx];\n\n\t// SMC 2010 Hard-Sync Phaseshaper on each operator's carrier phase\n\tlet opSyncMult = 1.0 + (syncRatio - 1.0) * (1.0 - 0.15 * k);\n\tlet rawSyncPhL = wrap(opSyncMult * wrap(carPh[k] + crossPhase, 0.0, 1.0), 0.0, 1.0);\n\tlet rawSyncPhR = wrap(opSyncMult * wrap(carPh[k] - crossPhase + 0.03 * k * panSpread, 0.0, 1.0), 0.0, 1.0);\n\n\tlet syncDt = clamp(dtCar * opSyncMult, 0.0001, 0.45);\n\tlet syncSawL = (2.0 * rawSyncPhL - 1.0) - polyblep(rawSyncPhL, syncDt);\n\tlet syncSawR = (2.0 * rawSyncPhR - 1.0) - polyblep(rawSyncPhR, syncDt);\n\n\t// Blend sinusoidal carrier cos(2*pi*g(phi)) with PolyBLEP hard-sync saw as Joy X rises\n\tlet sawBlend = clamp(0.5 * (smoothJoyX + 1.0), 0.0, 0.75);\n\tlet carWaveL = linearinterp(sawBlend, cos(2.0 * pi * rawSyncPhL), syncSawL);\n\tlet carWaveR = linearinterp(sawBlend, cos(2.0 * pi * rawSyncPhR), syncSawR);\n\n\t// Lazzarini & Timoney ModFM Window: exp(k_op * (cos(2*pi*modPh) - 1))\n\t// Guaranteed <= 1.0 for all k_op >= 0, producing pure Modified Bessel In(k) formants\n\tlet kOp = clamp(baseK * (1.0 + 0.25 * k), 0.0, 12.0);\n\tlet modWinL = exp(kOp * (cos(2.0 * pi * modPh[k]) - 1.0));\n\tlet modWinR = exp(kOp * (cos(2.0 * pi * (modPh[k] + 0.05 * panSpread)) - 1.0));\n\n\tlet sigOpL = carWaveL * modWinL;\n\tlet sigOpR = carWaveR * modWinR;\n\topOutPrev[k] = 0.5 * (sigOpL + sigOpR);\n\n\t// Alternate stereo panning across harmonics 1..4 (Op 1 centered, Op 2..4 spread L/R)\n\tlet panDir = (k == 0) ? 0.0 : ((k % 2 == 1) ? -1.0 : 1.0);\n\tlet panPos = 0.5 + 0.38 * panSpread * panDir * (k / 3.0);\n\tlet gainL = cos(panPos * 0.5 * pi);\n\tlet gainR = sin(panPos * 0.5 * pi);\n\n\t// Boost upper harmonics slightly when joy_y is pushed up so high partials scream\n\tlet harmBoost = 1.0 + 0.45 * k * joyY_u;\n\tsumL += sigOpL * aOp[k] * gainL * harmBoost;\n\tsumR += sigOpR * aOp[k] * gainR * harmBoost;\n}\n\n// ============================================================================\n// 4. PHASE-LOCKED SUB-OCTAVE FOUNDATION (Driven by f1 & A1)\n// ============================================================================\nsubPh = wrap(subPh + clamp((0.5 * fOp[0]) / sr, 0.00001, 0.45), 0.0, 1.0);\n// Sub-octave with subtle 2nd/3rd Chebyshev warmth weighted by Fundamental Amplitude A1\nlet subWave = (sin(2.0 * pi * subPh) + 0.25 * sin(6.0 * pi * subPh)) * aOp[0] * clamp(sub_octave_mix, 0.0, 1.0) * 1.6;\n\nlet busL = sumL * 2.2 + subWave;\nlet busR = sumR * 2.2 + subWave;\n\n// ============================================================================\n// 5. 6-STAGE ALLPASS PHASE DISPERSER (Tuned to Centroid * f1) & DC BLOCK\n// ============================================================================\nlet dispHz = clamp(fOp[0] * centroid * 1.5, 55.0, 3500.0);\nlet apW0 = 2.0 * pi * dispHz / sr;\nlet apAlpha = sin(apW0) / (2.0 * 2.8);\nlet apA0_inv = 1.0 / (1.0 + apAlpha);\nlet apB0 = (1.0 - apAlpha) * apA0_inv;\nlet apB1 = (-2.0 * cos(apW0)) * apA0_inv;\n\nlet dispL = busL;\nlet dispR = busR;\nfor (let i: Int = 0; i < 6; i++) {\n\tlet yL = apB0 * dispL + apZ1L[i];\n\tapZ1L[i] = apB1 * dispL - apB1 * yL + apZ2L[i];\n\tapZ2L[i] = dispL - apB0 * yL;\n\tdispL = yL;\n\n\tlet yR = apB0 * dispR + apZ1R[i];\n\tapZ1R[i] = apB1 * dispR - apB1 * yR + apZ2R[i];\n\tapZ2R[i] = dispR - apB0 * yR;\n\tdispR = yR;\n}\n\nlet dcCoeff = 1.0 - (2.0 * pi * 14.0 / sr);\nlet cleanL = dispL - dcXL + dcCoeff * dcYL; dcXL = dispL; dcYL = cleanL;\nlet cleanR = dispR - dcXR + dcCoeff * dcYR; dcXR = dispR; dcYR = cleanR;\n\nout1 = tanh(cleanL * 1.3);\nout2 = tanh(cleanR * 1.3);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 10,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 00d_tuba_4op_modfm_resynthesizer.txt\n// 4-Operator Adaptive ModFM & Phaseshaper Vocoder Resynthesizer\n// Driven directly by the 9 outlets of 00c_tuba_4harmonic_sift_analyzer.txt\n// ============================================================================\n// Implements:\n//   1. Lazzarini & Timoney (ICMC 2011 / DAFx-08) \"ModFM Synthesis Vocoder\":\n//      Each of the 4 tracked tuba harmonics (f1..f4, A1..A4) drives an\n//      independent ModFM / Phaseshaper operator:\n//        s_k(t) = A_k(t) * cos(2*pi*g_k(phi_k)) * exp(k_mod * (cos(2*pi*phi_mod) - 1))\n//      Because exp(k*(cos(w_m*t) - 1)) generates strictly monotonic Modified\n//      Bessel sidebands I_n(k)*e^(-k) that never exceed 0 dB at any index k,\n//      each harmonic blossoms into a alias-controlled formant cluster without\n//      Bessel phase cancellations or volume overload!\n//   2. Cross-Harmonic Phase Modulation & Inharmonicity Exaggeration:\n//      Measures the real-time deviation of f2, f3, f4 from integer multiples\n//      (2*f1, 3*f1, 4*f1) and scales it by `inharm_stretch` (0x = pure harmonic\n//      lock, 1x = natural tuba bore inharmonicity, up to 4x = metallic ghost-note\n//      bell/tearout clangor).\n//   3. Centroid-Driven Dubstep Morphing (via in9 from 00c):\n//      The player's live embouchure brightness (Spectral Centroid in [1..4])\n//      and optional 1-bar phasor (in10) dynamically sweep the ModFM index k,\n//      SMC 2010 PolyBLEP Hard-Sync ratio, and Sub-Octave foundation.\n// ============================================================================\n// Inlets (patch 1-to-1 from outlets out1..out9 of 00c_tuba_4harmonic_sift_analyzer):\n//   in1: f1 — Harmonic 1 Instantaneous Frequency (Hz)\n//   in2: f2 — Harmonic 2 Instantaneous Frequency (Hz)\n//   in3: f3 — Harmonic 3 Instantaneous Frequency (Hz)\n//   in4: f4 — Harmonic 4 Instantaneous Frequency (Hz)\n//   in5: A1 — Harmonic 1 Instantaneous Amplitude\n//   in6: A2 — Harmonic 2 Instantaneous Amplitude\n//   in7: A3 — Harmonic 3 Instantaneous Amplitude\n//   in8: A4 — Harmonic 4 Instantaneous Amplitude\n//   in9: Real-Time Brass Spectral Centroid Ratio [1.0 .. 4.0]\n//   in10: Optional 1-Bar Audio-Rate Phasor [0.0 .. 1.0] (for rhythmic wobble sync)\n// Outlets:\n//   out1: Left Stereo 4-Op ModFM Resynthesizer Output\n//   out2: Right Stereo 4-Op ModFM Resynthesizer Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_sync_formant = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_modfm_index = 0.2;\n@param({ min: 0.0, max: 4.0 }) inharm_stretch = 1.0;\n@param({ min: 0.0, max: 1.0 }) cross_op_fm = 0.35;\n@param({ min: 0.0, max: 1.0 }) sub_octave_mix = 0.65;\n@param({ min: 1.0, max: 16.0, steps: 16 }) rhythm_subdiv = 4.0;\n@param({ min: 0.0, max: 1.0 }) rhythm_wobble = 0.45;\n@param({ min: 0.0, max: 1.0 }) stereo_pan_spread = 0.6;\n\n// 4 Carrier Phasors + 4 Modulator Phasors + 1 Sub-Octave Phasor\n@state carPh = new FixedSampleArray(4);\n@state modPh = new FixedSampleArray(4);\n@state opOutPrev = new FixedSampleArray(4);\n@state subPh = 0.0;\n\n// 6-Stage Stereo Allpass Disperser on the summed 4-Op bus for liquid dubstep punch\n@state apZ1L = new FixedSampleArray(6);\n@state apZ2L = new FixedSampleArray(6);\n@state apZ1R = new FixedSampleArray(6);\n@state apZ2R = new FixedSampleArray(6);\n\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.2;\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\nfunction polyblep(t: number, dt: number): number {\n\tlet corr = 0.0;\n\tlet sDt = clamp(dt, 0.0001, 0.45);\n\tif (t < sDt) {\n\t\tlet u = t / sDt;\n\t\tcorr = u + u - u * u - 1.0;\n\t} else if (t > 1.0 - sDt) {\n\t\tlet u = (t - 1.0) / sDt;\n\t\tcorr = u * u + u + u + 1.0;\n\t}\n\treturn corr;\n}\n\nlet sr = maximum(samplerate(), 1.0);\n\n// Read 9 SIFT Analyzer inputs + optional 10th 1-bar phasor\nlet f1_in = (in1 > 20.0) ? in1 : 58.27;\nlet f2_in = (in2 > 40.0) ? in2 : (f1_in * 2.0);\nlet f3_in = (in3 > 60.0) ? in3 : (f1_in * 3.0);\nlet f4_in = (in4 > 80.0) ? in4 : (f1_in * 4.0);\n\nlet a1_in = maximum(in5, 0.0);\nlet a2_in = maximum(in6, 0.0);\nlet a3_in = maximum(in7, 0.0);\nlet a4_in = maximum(in8, 0.0);\n\nlet centroid = clamp((in9 >= 1.0) ? in9 : 1.5, 1.0, 4.0);\nlet barIn = in10;\n\n// Smooth Joystick X/Y controls\nlet slew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothJoyX += (clamp(joy_x_sync_formant, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_modfm_index, -1.0, 1.0) - smoothJoyY) * slew;\n\n// ============================================================================\n// 1. 1-BAR RHYTHMIC WOBBLE ENVELOPE & EMBOUCHURE CENTROID COUPLING\n// ============================================================================\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet rSub = floor(clamp(rhythm_subdiv, 1.0, 16.0));\nlet wobPh = wrap(barPh * rSub, 0.0, 1.0);\nlet wobLfo = pow(triangle(wobPh, 0.22), 1.5);\nlet wobMod = linearinterp(clamp(rhythm_wobble, 0.0, 1.0), 1.0, wobLfo);\n\n// Normalize centroid [1..4] -> [0..1] so playing brighter/louder expands synthesis\nlet brassBright = clamp((centroid - 1.0) / 2.2, 0.0, 1.0);\n\n// ============================================================================\n// 2. INHARMONICITY STRETCH (EXAGGERATING BORE / GHOST-NOTE DEVIATIONS)\n// ============================================================================\nlet stretch = clamp(inharm_stretch, 0.0, 4.0);\nlet fOp = new FixedSampleArray(4);\nfOp[0] = clamp(f1_in, 22.0, sr * 0.42);\nfOp[1] = clamp(2.0 * f1_in + (f2_in - 2.0 * f1_in) * stretch, 40.0, sr * 0.42);\nfOp[2] = clamp(3.0 * f1_in + (f3_in - 3.0 * f1_in) * stretch, 60.0, sr * 0.42);\nfOp[3] = clamp(4.0 * f1_in + (f4_in - 4.0 * f1_in) * stretch, 80.0, sr * 0.42);\n\nlet aOp = new FixedSampleArray(4);\naOp[0] = a1_in;\naOp[1] = a2_in;\naOp[2] = a3_in;\naOp[3] = a4_in;\n\n// ============================================================================\n// 3. 4-OPERATOR ADAPTIVE MODFM + POLYBLEP PHASESHAPING ENGINE\n// ============================================================================\n// Sync ratio a1 controlled by Joystick X + embouchure centroid + rhythmic wobble\nlet syncRatio = clamp(1.8 * pow(2.6, smoothJoyX) * (1.0 + 0.6 * brassBright * wobMod), 1.0, 10.0);\n\n// ModFM Index k controlled by Joystick Y + embouchure brightness + rhythmic wobble\nlet joyY_u = 0.5 * (smoothJoyY + 1.0);\nlet baseK = (0.3 + 7.5 * pow(joyY_u, 1.35)) * (0.45 + 0.85 * brassBright) * wobMod;\nlet xFmAmt = pow(clamp(cross_op_fm, 0.0, 1.0), 1.3) * 0.45;\nlet panSpread = clamp(stereo_pan_spread, 0.0, 1.0);\n\nlet sumL = 0.0;\nlet sumR = 0.0;\n\nfor (let k: Int = 0; k < 4; k++) {\n\tlet fk = fOp[k];\n\tlet dtCar = clamp(fk / sr, 0.00001, 0.45);\n\tcarPh[k] = wrap(carPh[k] + dtCar, 0.0, 1.0);\n\n\t// Modulator runs at f1 (fundamental) so sidebands around every harmonic lock to f0!\n\tlet dtMod = clamp(fOp[0] / sr, 0.00001, 0.45);\n\tmodPh[k] = wrap(modPh[k] + dtMod, 0.0, 1.0);\n\n\t// Cross-operator phase modulation: Operator k is phase-modulated by Operator k-1\n\t// (Op 0 is self/feedback modulated by Op 3 for closed-loop growl)\n\tlet prevIdx: Int = (k + 3) % 4;\n\tlet crossPhase = xFmAmt * opOutPrev[prevIdx];\n\n\t// SMC 2010 Hard-Sync Phaseshaper on each operator's carrier phase\n\tlet opSyncMult = 1.0 + (syncRatio - 1.0) * (1.0 - 0.15 * k);\n\tlet rawSyncPhL = wrap(opSyncMult * wrap(carPh[k] + crossPhase, 0.0, 1.0), 0.0, 1.0);\n\tlet rawSyncPhR = wrap(opSyncMult * wrap(carPh[k] - crossPhase + 0.03 * k * panSpread, 0.0, 1.0), 0.0, 1.0);\n\n\tlet syncDt = clamp(dtCar * opSyncMult, 0.0001, 0.45);\n\tlet syncSawL = (2.0 * rawSyncPhL - 1.0) - polyblep(rawSyncPhL, syncDt);\n\tlet syncSawR = (2.0 * rawSyncPhR - 1.0) - polyblep(rawSyncPhR, syncDt);\n\n\t// Blend sinusoidal carrier cos(2*pi*g(phi)) with PolyBLEP hard-sync saw as Joy X rises\n\tlet sawBlend = clamp(0.5 * (smoothJoyX + 1.0), 0.0, 0.75);\n\tlet carWaveL = linearinterp(sawBlend, cos(2.0 * pi * rawSyncPhL), syncSawL);\n\tlet carWaveR = linearinterp(sawBlend, cos(2.0 * pi * rawSyncPhR), syncSawR);\n\n\t// Lazzarini & Timoney ModFM Window: exp(k_op * (cos(2*pi*modPh) - 1))\n\t// Guaranteed <= 1.0 for all k_op >= 0, producing pure Modified Bessel In(k) formants\n\tlet kOp = clamp(baseK * (1.0 + 0.25 * k), 0.0, 12.0);\n\tlet modWinL = exp(kOp * (cos(2.0 * pi * modPh[k]) - 1.0));\n\tlet modWinR = exp(kOp * (cos(2.0 * pi * (modPh[k] + 0.05 * panSpread)) - 1.0));\n\n\tlet sigOpL = carWaveL * modWinL;\n\tlet sigOpR = carWaveR * modWinR;\n\topOutPrev[k] = 0.5 * (sigOpL + sigOpR);\n\n\t// Alternate stereo panning across harmonics 1..4 (Op 1 centered, Op 2..4 spread L/R)\n\tlet panDir = (k == 0) ? 0.0 : ((k % 2 == 1) ? -1.0 : 1.0);\n\tlet panPos = 0.5 + 0.38 * panSpread * panDir * (k / 3.0);\n\tlet gainL = cos(panPos * 0.5 * pi);\n\tlet gainR = sin(panPos * 0.5 * pi);\n\n\t// Boost upper harmonics slightly when joy_y is pushed up so high partials scream\n\tlet harmBoost = 1.0 + 0.45 * k * joyY_u;\n\tsumL += sigOpL * aOp[k] * gainL * harmBoost;\n\tsumR += sigOpR * aOp[k] * gainR * harmBoost;\n}\n\n// ============================================================================\n// 4. PHASE-LOCKED SUB-OCTAVE FOUNDATION (Driven by f1 & A1)\n// ============================================================================\nsubPh = wrap(subPh + clamp((0.5 * fOp[0]) / sr, 0.00001, 0.45), 0.0, 1.0);\n// Sub-octave with subtle 2nd/3rd Chebyshev warmth weighted by Fundamental Amplitude A1\nlet subWave = (sin(2.0 * pi * subPh) + 0.25 * sin(6.0 * pi * subPh)) * aOp[0] * clamp(sub_octave_mix, 0.0, 1.0) * 1.6;\n\nlet busL = sumL * 2.2 + subWave;\nlet busR = sumR * 2.2 + subWave;\n\n// ============================================================================\n// 5. 6-STAGE ALLPASS PHASE DISPERSER (Tuned to Centroid * f1) & DC BLOCK\n// ============================================================================\nlet dispHz = clamp(fOp[0] * centroid * 1.5, 55.0, 3500.0);\nlet apW0 = 2.0 * pi * dispHz / sr;\nlet apAlpha = sin(apW0) / (2.0 * 2.8);\nlet apA0_inv = 1.0 / (1.0 + apAlpha);\nlet apB0 = (1.0 - apAlpha) * apA0_inv;\nlet apB1 = (-2.0 * cos(apW0)) * apA0_inv;\n\nlet dispL = busL;\nlet dispR = busR;\nfor (let i: Int = 0; i < 6; i++) {\n\tlet yL = apB0 * dispL + apZ1L[i];\n\tapZ1L[i] = apB1 * dispL - apB1 * yL + apZ2L[i];\n\tapZ2L[i] = dispL - apB0 * yL;\n\tdispL = yL;\n\n\tlet yR = apB0 * dispR + apZ1R[i];\n\tapZ1R[i] = apB1 * dispR - apB1 * yR + apZ2R[i];\n\tapZ2R[i] = dispR - apB0 * yR;\n\tdispR = yR;\n}\n\nlet dcCoeff = 1.0 - (2.0 * pi * 14.0 / sr);\nlet cleanL = dispL - dcXL + dcCoeff * dcYL; dcXL = dispL; dcYL = cleanL;\nlet cleanR = dispR - dcXR + dcCoeff * dcYR; dcXR = dispR; dcYR = cleanR;\n\nout1 = tanh(cleanL * 1.3);\nout2 = tanh(cleanR * 1.3);\n",
                                        "expr": ""
                                    },
                                    "rnbo_serial": 2,
                                    "rnbo_uniqueid": "effect_code",
