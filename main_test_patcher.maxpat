                        "classnamespace": "rnbo",
                        "rect": [ 414.0, 368.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 15_inst_split_sideband_morph_synth.txt\n// Advanced Instrument 3: Split-Sideband (ASpSB) & Bode Quadrant Morph Synth\n// Full performance instrument built on Lazzarini, Timoney & Lysaght (DAFx-08, Sec 3):\n//   - Extracts the tuba's harmonic carrier (with adjustable fundamental isolation)\n//   - Computes the 4 orthogonal ASpSB sideband groups:\n//       1) Upper-Even (aeu)   2) Upper-Odd (aou)\n//       3) Lower-Even (ael)   4) Lower-Odd (aol)\n//   - Maps Joystick X (Odd <-> Even) and Joystick Y (Lower <-> Upper + Mod Index)\n//     to perform live 2D vector morphing across the 4 sideband quadrants!\n//   - Adds a 1-bar phasor-synced rhythmic gate/index pulse and stereo Bode detune.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs rhythmic sideband pulse)\n// Outlets:\n//   out1: Left ASpSB Vector Morph Output\n//   out2: Right ASpSB Vector Morph Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_odd_even = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_low_high = 0.3;\n@param({ min: 0.1, max: 4.0 }) cm_ratio = 1.5;\n@param({ min: 0.0, max: 6.0 }) base_index = 2.5;\n@param({ min: 1.0, max: 16.0, steps: 16 }) pulse_rate = 4.0;\n@param({ min: 0.0, max: 1.0 }) pulse_depth = 0.5;\n@param({ min: 0.0, max: 25.0 }) stereo_bode_hz = 2.5;\n@param({ min: 0.0, max: 1.0 }) carrier_focus = 0.4;\n\n// Pre-filter SVF for optional carrier harmonic isolation\n@state svfCar = new svf();\n\n// 3 Quadrature 4-stage IIR Hilbert transform pairs (Carrier, Even Mod, Odd Mod)\n@state cReX = new FixedSampleArray(4); @state cReY = new FixedSampleArray(4);\n@state cImX = new FixedSampleArray(4); @state cImY = new FixedSampleArray(4);\n@state cDelRe = 0.0;\n\n@state eReX = new FixedSampleArray(4); @state eReY = new FixedSampleArray(4);\n@state eImX = new FixedSampleArray(4); @state eImY = new FixedSampleArray(4);\n@state eDelRe = 0.0;\n\n@state oReX = new FixedSampleArray(4); @state oReY = new FixedSampleArray(4);\n@state oImX = new FixedSampleArray(4); @state oImY = new FixedSampleArray(4);\n@state oDelRe = 0.0;\n\n@state modPhasor = new phasor();\n@state bodePhasor = new phasor();\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.3;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch & Joystick Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nsmoothJoyX += (clamp(joy_x_odd_even, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_low_high, -1.0, 1.0) - smoothJoyY) * slew;\n\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Carrier Focus (Blend full brass spectrum with isolated fundamental) ---\nlet foc = clamp(carrier_focus, 0.0, 1.0);\nlet bpCar = svfCar.next(mono, f0, clamp(0.5 + 0.42 * foc, 0.5, 0.94))[2] * 2.0;\nlet carSig = linearinterp(foc, mono, bpCar);\n\n// --- 3. 1-Bar Rhythmic Modulation of Index I ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet pRate = floor(clamp(pulse_rate, 1.0, 16.0));\nlet pulsePh = wrap(barPh * pRate, 0.0, 1.0);\nlet pulseEnv = hann(pulsePh);\n\n// Modulation Index combines base_index, rhythmic pulse, and Joystick Y boost\nlet joyY_boost = 1.0 + 0.65 * smoothJoyY;\nlet pDepth = clamp(pulse_depth, 0.0, 1.0);\nlet dynIndex = clamp(base_index * joyY_boost * ((1.0 - pDepth) + pDepth * pulseEnv * 1.5), 0.0, 8.0);\n\nlet fm = clamp(f0 / clamp(cm_ratio, 0.1, 4.0), 2.0, 2500.0);\nlet modSin = dynIndex * sin(2.0 * pi * modPhasor.next(fm));\n\nlet a2_even = cos(modSin);\nlet a3_odd = sin(modSin);\n\n// --- 4. Three Quadrature Hilbert Networks ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\n// Carrier (ac, ad)\nlet sC = carSig;\nlet yc0 = cRe0 * (sC - cReY[0]) + cReX[0]; cReX[0] = sC; cReY[0] = yc0; sC = yc0;\nlet yc1 = cRe1 * (sC - cReY[1]) + cReX[1]; cReX[1] = sC; cReY[1] = yc1; sC = yc1;\nlet yc2 = cRe2 * (sC - cReY[2]) + cReX[2]; cReX[2] = sC; cReY[2] = yc2; sC = yc2;\nlet yc3 = cRe3 * (sC - cReY[3]) + cReX[3]; cReX[3] = sC; cReY[3] = yc3;\nlet ac = cDelRe; cDelRe = yc3;\n\nlet sCi = carSig;\nlet yci0 = cIm0 * (sCi - cImY[0]) + cImX[0]; cImX[0] = sCi; cImY[0] = yci0; sCi = yci0;\nlet yci1 = cIm1 * (sCi - cImY[1]) + cImX[1]; cImX[1] = sCi; cImY[1] = yci1; sCi = yci1;\nlet yci2 = cIm2 * (sCi - cImY[2]) + cImX[2]; cImX[2] = sCi; cImY[2] = yci2; sCi = yci2;\nlet yci3 = cIm3 * (sCi - cImY[3]) + cImX[3]; cImX[3] = sCi; cImY[3] = yci3;\nlet ad = yci3;\n\n// Even Modulator (aae, abe)\nlet sE = a2_even;\nlet ye0 = cRe0 * (sE - eReY[0]) + eReX[0]; eReX[0] = sE; eReY[0] = ye0; sE = ye0;\nlet ye1 = cRe1 * (sE - eReY[1]) + eReX[1]; eReX[1] = sE; eReY[1] = ye1; sE = ye1;\nlet ye2 = cRe2 * (sE - eReY[2]) + eReX[2]; eReX[2] = sE; eReY[2] = ye2; sE = ye2;\nlet ye3 = cRe3 * (sE - eReY[3]) + eReX[3]; eReX[3] = sE; eReY[3] = ye3;\nlet aae = eDelRe; eDelRe = ye3;\n\nlet sEi = a2_even;\nlet yei0 = cIm0 * (sEi - eImY[0]) + eImX[0]; eImX[0] = sEi; eImY[0] = yei0; sEi = yei0;\nlet yei1 = cIm1 * (sEi - eImY[1]) + eImX[1]; eImX[1] = sEi; eImY[1] = yei1; sEi = yei1;\nlet yei2 = cIm2 * (sEi - eImY[2]) + eImX[2]; eImX[2] = sEi; eImY[2] = yei2; sEi = yei2;\nlet yei3 = cIm3 * (sEi - eImY[3]) + eImX[3]; eImX[3] = sEi; eImY[3] = yei3;\nlet abe = yei3;\n\n// Odd Modulator (aao, abo)\nlet sO = a3_odd;\nlet yo0 = cRe0 * (sO - oReY[0]) + oReX[0]; oReX[0] = sO; oReY[0] = yo0; sO = yo0;\nlet yo1 = cRe1 * (sO - oReY[1]) + oReX[1]; oReX[1] = sO; oReY[1] = yo1; sO = yo1;\nlet yo2 = cRe2 * (sO - oReY[2]) + oReX[2]; oReX[2] = sO; oReY[2] = yo2; sO = yo2;\nlet yo3 = cRe3 * (sO - oReY[3]) + oReX[3]; oReX[3] = sO; oReY[3] = yo3;\nlet aao = oDelRe; oDelRe = yo3;\n\nlet sOi = a3_odd;\nlet yoi0 = cIm0 * (sOi - oImY[0]) + oImX[0]; oImX[0] = sOi; oImY[0] = yoi0; sOi = yoi0;\nlet yoi1 = cIm1 * (sOi - oImY[1]) + oImX[1]; oImX[1] = sOi; oImY[1] = yoi1; sOi = yoi1;\nlet yoi2 = cIm2 * (sOi - oImY[2]) + oImX[2]; oImX[2] = sOi; oImY[2] = yoi2; sOi = yoi2;\nlet yoi3 = cIm3 * (sOi - oImY[3]) + oImX[3]; oImX[3] = sOi; oImY[3] = yoi3;\nlet abo = yoi3;\n\n// --- 5. Stereo Bode Micro-Detune on Carrier Quadrature Pair ---\nlet bHz = pow(clamp(stereo_bode_hz / 25.0, 0.0, 1.0), 1.6) * 25.0;\nlet bPh = bodePhasor.next(bHz);\nlet cosB = cos(2.0 * pi * bPh);\nlet sinB = sin(2.0 * pi * bPh);\n\n// Rotate Left carrier up by +bHz, Right carrier down by -bHz\nlet acL = ac * cosB - ad * sinB;\nlet adL = ad * cosB + ac * sinB;\nlet acR = ac * cosB + ad * sinB;\nlet adR = ad * cosB - ac * sinB;\n\n// Compute 4 ASpSB Quadrants for Left and Right\nlet aeuL = aae * acL - abe * adL;\nlet aouL = aao * acL - abo * adL;\nlet aelL = aae * acL + abe * adL;\nlet aolL = aao * acL + abo * adL;\n\nlet aeuR = aae * acR - abe * adR;\nlet aouR = aao * acR - abo * adR;\nlet aelR = aae * acR + abe * adR;\nlet aolR = aao * acR + abo * adR;\n\n// --- 6. 2D Vector Joystick Mixing Across the 4 Quadrants ---\nlet wEven = 0.5 * (smoothJoyX + 1.0);\nlet wOdd = 1.0 - wEven;\nlet wUp = 0.5 * (smoothJoyY + 1.0);\nlet wLow = 1.0 - wUp;\n\nlet mixL = wUp * (wEven * aeuL + wOdd * aouL) + wLow * (wEven * aelL + wOdd * aolL);\nlet mixR = wUp * (wEven * aeuR + wOdd * aouR) + wLow * (wEven * aelR + wOdd * aolR);\n\nout1 = tanh(mixL * 1.4);\nout2 = tanh(mixR * 1.4);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 15_inst_split_sideband_morph_synth.txt\n// Advanced Instrument 3: Split-Sideband (ASpSB) & Bode Quadrant Morph Synth\n// Full performance instrument built on Lazzarini, Timoney & Lysaght (DAFx-08, Sec 3):\n//   - Extracts the tuba's harmonic carrier (with adjustable fundamental isolation)\n//   - Computes the 4 orthogonal ASpSB sideband groups:\n//       1) Upper-Even (aeu)   2) Upper-Odd (aou)\n//       3) Lower-Even (ael)   4) Lower-Odd (aol)\n//   - Maps Joystick X (Odd <-> Even) and Joystick Y (Lower <-> Upper + Mod Index)\n//     to perform live 2D vector morphing across the 4 sideband quadrants!\n//   - Adds a 1-bar phasor-synced rhythmic gate/index pulse and stereo Bode detune.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs rhythmic sideband pulse)\n// Outlets:\n//   out1: Left ASpSB Vector Morph Output\n//   out2: Right ASpSB Vector Morph Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_odd_even = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_low_high = 0.3;\n@param({ min: 0.1, max: 4.0 }) cm_ratio = 1.5;\n@param({ min: 0.0, max: 6.0 }) base_index = 2.5;\n@param({ min: 1.0, max: 16.0, steps: 16 }) pulse_rate = 4.0;\n@param({ min: 0.0, max: 1.0 }) pulse_depth = 0.5;\n@param({ min: 0.0, max: 25.0 }) stereo_bode_hz = 2.5;\n@param({ min: 0.0, max: 1.0 }) carrier_focus = 0.4;\n\n// Pre-filter SVF for optional carrier harmonic isolation\n@state svfCar = new svf();\n\n// 3 Quadrature 4-stage IIR Hilbert transform pairs (Carrier, Even Mod, Odd Mod)\n@state cReX = new FixedSampleArray(4); @state cReY = new FixedSampleArray(4);\n@state cImX = new FixedSampleArray(4); @state cImY = new FixedSampleArray(4);\n@state cDelRe = 0.0;\n\n@state eReX = new FixedSampleArray(4); @state eReY = new FixedSampleArray(4);\n@state eImX = new FixedSampleArray(4); @state eImY = new FixedSampleArray(4);\n@state eDelRe = 0.0;\n\n@state oReX = new FixedSampleArray(4); @state oReY = new FixedSampleArray(4);\n@state oImX = new FixedSampleArray(4); @state oImY = new FixedSampleArray(4);\n@state oDelRe = 0.0;\n\n@state modPhasor = new phasor();\n@state bodePhasor = new phasor();\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.3;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch & Joystick Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nsmoothJoyX += (clamp(joy_x_odd_even, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_low_high, -1.0, 1.0) - smoothJoyY) * slew;\n\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Carrier Focus (Blend full brass spectrum with isolated fundamental) ---\nlet foc = clamp(carrier_focus, 0.0, 1.0);\nlet bpCar = svfCar.next(mono, f0, clamp(0.5 + 0.42 * foc, 0.5, 0.94))[2] * 2.0;\nlet carSig = linearinterp(foc, mono, bpCar);\n\n// --- 3. 1-Bar Rhythmic Modulation of Index I ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet pRate = floor(clamp(pulse_rate, 1.0, 16.0));\nlet pulsePh = wrap(barPh * pRate, 0.0, 1.0);\nlet pulseEnv = hann(pulsePh);\n\n// Modulation Index combines base_index, rhythmic pulse, and Joystick Y boost\nlet joyY_boost = 1.0 + 0.65 * smoothJoyY;\nlet pDepth = clamp(pulse_depth, 0.0, 1.0);\nlet dynIndex = clamp(base_index * joyY_boost * ((1.0 - pDepth) + pDepth * pulseEnv * 1.5), 0.0, 8.0);\n\nlet fm = clamp(f0 / clamp(cm_ratio, 0.1, 4.0), 2.0, 2500.0);\nlet modSin = dynIndex * sin(2.0 * pi * modPhasor.next(fm));\n\nlet a2_even = cos(modSin);\nlet a3_odd = sin(modSin);\n\n// --- 4. Three Quadrature Hilbert Networks ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\n// Carrier (ac, ad)\nlet sC = carSig;\nlet yc0 = cRe0 * (sC - cReY[0]) + cReX[0]; cReX[0] = sC; cReY[0] = yc0; sC = yc0;\nlet yc1 = cRe1 * (sC - cReY[1]) + cReX[1]; cReX[1] = sC; cReY[1] = yc1; sC = yc1;\nlet yc2 = cRe2 * (sC - cReY[2]) + cReX[2]; cReX[2] = sC; cReY[2] = yc2; sC = yc2;\nlet yc3 = cRe3 * (sC - cReY[3]) + cReX[3]; cReX[3] = sC; cReY[3] = yc3;\nlet ac = cDelRe; cDelRe = yc3;\n\nlet sCi = carSig;\nlet yci0 = cIm0 * (sCi - cImY[0]) + cImX[0]; cImX[0] = sCi; cImY[0] = yci0; sCi = yci0;\nlet yci1 = cIm1 * (sCi - cImY[1]) + cImX[1]; cImX[1] = sCi; cImY[1] = yci1; sCi = yci1;\nlet yci2 = cIm2 * (sCi - cImY[2]) + cImX[2]; cImX[2] = sCi; cImY[2] = yci2; sCi = yci2;\nlet yci3 = cIm3 * (sCi - cImY[3]) + cImX[3]; cImX[3] = sCi; cImY[3] = yci3;\nlet ad = yci3;\n\n// Even Modulator (aae, abe)\nlet sE = a2_even;\nlet ye0 = cRe0 * (sE - eReY[0]) + eReX[0]; eReX[0] = sE; eReY[0] = ye0; sE = ye0;\nlet ye1 = cRe1 * (sE - eReY[1]) + eReX[1]; eReX[1] = sE; eReY[1] = ye1; sE = ye1;\nlet ye2 = cRe2 * (sE - eReY[2]) + eReX[2]; eReX[2] = sE; eReY[2] = ye2; sE = ye2;\nlet ye3 = cRe3 * (sE - eReY[3]) + eReX[3]; eReX[3] = sE; eReY[3] = ye3;\nlet aae = eDelRe; eDelRe = ye3;\n\nlet sEi = a2_even;\nlet yei0 = cIm0 * (sEi - eImY[0]) + eImX[0]; eImX[0] = sEi; eImY[0] = yei0; sEi = yei0;\nlet yei1 = cIm1 * (sEi - eImY[1]) + eImX[1]; eImX[1] = sEi; eImY[1] = yei1; sEi = yei1;\nlet yei2 = cIm2 * (sEi - eImY[2]) + eImX[2]; eImX[2] = sEi; eImY[2] = yei2; sEi = yei2;\nlet yei3 = cIm3 * (sEi - eImY[3]) + eImX[3]; eImX[3] = sEi; eImY[3] = yei3;\nlet abe = yei3;\n\n// Odd Modulator (aao, abo)\nlet sO = a3_odd;\nlet yo0 = cRe0 * (sO - oReY[0]) + oReX[0]; oReX[0] = sO; oReY[0] = yo0; sO = yo0;\nlet yo1 = cRe1 * (sO - oReY[1]) + oReX[1]; oReX[1] = sO; oReY[1] = yo1; sO = yo1;\nlet yo2 = cRe2 * (sO - oReY[2]) + oReX[2]; oReX[2] = sO; oReY[2] = yo2; sO = yo2;\nlet yo3 = cRe3 * (sO - oReY[3]) + oReX[3]; oReX[3] = sO; oReY[3] = yo3;\nlet aao = oDelRe; oDelRe = yo3;\n\nlet sOi = a3_odd;\nlet yoi0 = cIm0 * (sOi - oImY[0]) + oImX[0]; oImX[0] = sOi; oImY[0] = yoi0; sOi = yoi0;\nlet yoi1 = cIm1 * (sOi - oImY[1]) + oImX[1]; oImX[1] = sOi; oImY[1] = yoi1; sOi = yoi1;\nlet yoi2 = cIm2 * (sOi - oImY[2]) + oImX[2]; oImX[2] = sOi; oImY[2] = yoi2; sOi = yoi2;\nlet yoi3 = cIm3 * (sOi - oImY[3]) + oImX[3]; oImX[3] = sOi; oImY[3] = yoi3;\nlet abo = yoi3;\n\n// --- 5. Stereo Bode Micro-Detune on Carrier Quadrature Pair ---\nlet bHz = pow(clamp(stereo_bode_hz / 25.0, 0.0, 1.0), 1.6) * 25.0;\nlet bPh = bodePhasor.next(bHz);\nlet cosB = cos(2.0 * pi * bPh);\nlet sinB = sin(2.0 * pi * bPh);\n\n// Rotate Left carrier up by +bHz, Right carrier down by -bHz\nlet acL = ac * cosB - ad * sinB;\nlet adL = ad * cosB + ac * sinB;\nlet acR = ac * cosB + ad * sinB;\nlet adR = ad * cosB - ac * sinB;\n\n// Compute 4 ASpSB Quadrants for Left and Right\nlet aeuL = aae * acL - abe * adL;\nlet aouL = aao * acL - abo * adL;\nlet aelL = aae * acL + abe * adL;\nlet aolL = aao * acL + abo * adL;\n\nlet aeuR = aae * acR - abe * adR;\nlet aouR = aao * acR - abo * adR;\nlet aelR = aae * acR + abe * adR;\nlet aolR = aao * acR + abo * adR;\n\n// --- 6. 2D Vector Joystick Mixing Across the 4 Quadrants ---\nlet wEven = 0.5 * (smoothJoyX + 1.0);\nlet wOdd = 1.0 - wEven;\nlet wUp = 0.5 * (smoothJoyY + 1.0);\nlet wLow = 1.0 - wUp;\n\nlet mixL = wUp * (wEven * aeuL + wOdd * aouL) + wLow * (wEven * aelL + wOdd * aolL);\nlet mixR = wUp * (wEven * aeuR + wOdd * aouR) + wLow * (wEven * aelR + wOdd * aolR);\n\nout1 = tanh(mixL * 1.4);\nout2 = tanh(mixR * 1.4);\n",
                                        "expr": ""
                                    },
