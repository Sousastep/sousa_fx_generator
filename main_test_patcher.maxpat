                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 59.0, 106.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 14_inst_metallic_comb_growler.txt\n// Advanced Instrument 2: Metallic Comb & Formant Growler (\"Talking Riddim Machine\")\n// Combines:\n//   1. Adaptive Asymmetric Delay-Line FM (DAFx-08 ASDFM2 moving formants)\n//   2. Dual Parallel Pitch-Tracked Waveguide Comb Filters (Vowel/Pipe Resonator)\n//   3. Allpass Phase Dispersion Matrix\n//   4. 1-Bar Phasor-Synced Comb Ratio Whip + Joystick X/Y Performance Mapping\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs rhythmic comb whip)\n// Outlets:\n//   out1: Left Metallic Comb Growler Output\n//   out2: Right Metallic Comb Growler Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_comb_morph = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_adfm_growl = 0.0;\n@param({ min: 1.0, max: 16.0, steps: 16 }) whip_subdiv = 4.0;\n@param({ min: 0.0, max: 1.0 }) whip_depth = 0.55;\n@param({ min: -0.98, max: 0.98 }) comb_feedback = 0.85;\n@param({ min: 0.0, max: 1.0 }) comb_damping = 0.75;\n@param({ min: 0.0, max: 1.0 }) disperse_pinch = 0.6;\n@param({ min: 0.0, max: 1.0 }) stereo_width = 0.4;\n\n// Delay buffer for AdFM stage (2048 samples)\n@state fmBufL = new FixedSampleArray(2048);\n@state fmBufR = new FixedSampleArray(2048);\n@state fmWrite: Int = 0;\n\n// Dual Comb Filter buffers (4096 samples per channel)\n@state combBufL = new FixedSampleArray(4096);\n@state combBufR = new FixedSampleArray(4096);\n@state combWrite: Int = 0;\n\n@state dampLpL = new onepole();\n@state dampLpR = new onepole();\n\n// 6-stage Allpass Disperser post-comb\n@state apZ1L = new FixedSampleArray(6);\n@state apZ2L = new FixedSampleArray(6);\n@state apZ1R = new FixedSampleArray(6);\n@state apZ2R = new FixedSampleArray(6);\n\n// Pitch & Phasor states\n@state modPhasor = new phasor();\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.0;\n@state smoothCombDelL = 150.0;\n@state smoothCombDelR = 150.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch & Controller Conditioning ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nsmoothJoyX += (clamp(joy_x_comb_morph, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_adfm_growl, -1.0, 1.0) - smoothJoyY) * slew;\n\nlet f0 = clamp(smoothF0, 25.0, 900.0);\n\n// --- 2. Stage 1: Delay-Based Asymmetric AdFM Driven by Joystick Y ---\nfmBufL[fmWrite] = xL;\nfmBufR[fmWrite] = xR;\n\nlet joyY_u = 0.5 * (smoothJoyY + 1.0);\nlet kIdx = 0.4 + 4.2 * pow(joyY_u, 1.3);\n// Asymmetry factor r shifts upward as Joy Y increases -> upper moving formants\nlet rSym = pow(3.2, smoothJoyY);\nlet phMod = modPhasor.next(f0);\nlet modSin = 0.5 * (1.0 - sin(2.0 * pi * phMod));\nlet modCos = cos(2.0 * pi * phMod);\n\nlet delDepth = clamp((kIdx / (pi * f0)) * sr, 0.0, 1000.0);\nlet dSamps = 2.0 + delDepth * modSin;\n\nlet rFm = fmWrite - dSamps;\nwhile (rFm < 0.0) { rFm += 2048.0; }\nlet iFm0: Int = floor(rFm);\nlet fracFm = rFm - iFm0;\nlet fmOutL = cubicinterp(fracFm, fmBufL[(iFm0 - 1 + 2048) % 2048], fmBufL[iFm0 % 2048], fmBufL[(iFm0 + 1) % 2048], fmBufL[(iFm0 + 2) % 2048]);\nlet fmOutR = cubicinterp(fracFm, fmBufR[(iFm0 - 1 + 2048) % 2048], fmBufR[iFm0 % 2048], fmBufR[(iFm0 + 1) % 2048], fmBufR[(iFm0 + 2) % 2048]);\nfmWrite = (fmWrite + 1) % 2048;\n\nlet kAsym = clamp(0.4 * kIdx * (rSym - 1.0 / rSym), -3.5, 3.5);\nlet envAsym = exp(kAsym * modCos - abs(kAsym));\nlet preCombL = fmOutL * envAsym;\nlet preCombR = fmOutR * envAsym;\n\n// --- 3. Stage 2: 1-Bar Rhythmic Comb Whip + Joystick X Harmonic Ratio ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet subDiv = floor(clamp(whip_subdiv, 1.0, 16.0));\nlet whipPh = wrap(barPh * subDiv, 0.0, 1.0);\nlet whipEnv = kink(whipPh, 0.35);\nlet whipTri = pow(triangle(whipEnv, 0.25), 1.4);\n\n// Comb harmonic ratio controlled by Joystick X (0.5x sub-pipe to 12x high metallic formant) + Whip LFO\nlet octShift = 1.8 * smoothJoyX + 2.4 * clamp(whip_depth, 0.0, 1.0) * (whipTri - 0.3);\nlet combHz = clamp(f0 * 2.0 * pow(2.0, octShift), 22.0, 4500.0);\n\nlet wid = pow(clamp(stereo_width, 0.0, 1.0), 1.5) * 0.35; // up to +/- 0.35 octaves L/R\nlet widRatio = pow(2.0, wid);\n\nlet targetDelL = clamp(sr / (combHz / widRatio), 4.0, 4090.0);\nlet targetDelR = clamp(sr / (combHz * widRatio), 4.0, 4090.0);\n\nlet delSlew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothCombDelL += (targetDelL - smoothCombDelL) * delSlew;\nsmoothCombDelR += (targetDelR - smoothCombDelR) * delSlew;\n\nlet rCL = combWrite - smoothCombDelL;\nwhile (rCL < 0.0) { rCL += 4096.0; }\nlet icL: Int = floor(rCL);\nlet fcL = rCL - icL;\nlet cReadL = cubicinterp(fcL, combBufL[(icL - 1 + 4096) % 4096], combBufL[icL % 4096], combBufL[(icL + 1) % 4096], combBufL[(icL + 2) % 4096]);\n\nlet rCR = combWrite - smoothCombDelR;\nwhile (rCR < 0.0) { rCR += 4096.0; }\nlet icR: Int = floor(rCR);\nlet fcR = rCR - icR;\nlet cReadR = cubicinterp(fcR, combBufR[(icR - 1 + 4096) % 4096], combBufR[icR % 4096], combBufR[(icR + 1) % 4096], combBufR[(icR + 2) % 4096]);\n\nlet dampHz = 450.0 * pow(38.0, clamp(comb_damping, 0.0, 1.0));\nlet dReadL = dampLpL.next(cReadL, dampHz);\nlet dReadR = dampLpR.next(cReadR, dampHz);\n\nlet fbSign = (comb_feedback >= 0.0) ? 1.0 : -1.0;\nlet fbMag = 1.0 - pow(1.0 - abs(clamp(comb_feedback, -0.98, 0.98)), 1.4);\nlet fb = fbSign * clamp(fbMag, 0.0, 0.985);\n\ncombBufL[combWrite] = tanh(preCombL + fb * dReadL);\ncombBufR[combWrite] = tanh(preCombR + fb * dReadR);\ncombWrite = (combWrite + 1) % 4096;\n\nlet combOutL = (preCombL + fb * cReadL) / (1.0 + 0.55 * abs(fb));\nlet combOutR = (preCombR + fb * cReadR) / (1.0 + 0.55 * abs(fb));\n\n// --- 4. Stage 3: 6-Stage Allpass Phase Disperser Tuned to Comb Formant ---\nlet pinch = clamp(disperse_pinch, 0.0, 1.0);\nlet apQ = 0.707 + 6.5 * pow(pinch, 1.4);\nlet apW0 = 2.0 * pi * clamp(combHz * 0.75, 60.0, 3500.0) / sr;\nlet apAlpha = sin(apW0) / (2.0 * apQ);\nlet apA0_inv = 1.0 / (1.0 + apAlpha);\nlet apB0 = (1.0 - apAlpha) * apA0_inv;\nlet apB1 = (-2.0 * cos(apW0)) * apA0_inv;\n\nlet dispL = combOutL;\nlet dispR = combOutR;\nfor (let i: Int = 0; i < 6; i++) {\n\tlet yL = apB0 * dispL + apZ1L[i];\n\tapZ1L[i] = apB1 * dispL - apB1 * yL + apZ2L[i];\n\tapZ2L[i] = dispL - apB0 * yL;\n\tdispL = yL;\n\n\tlet yR = apB0 * dispR + apZ1R[i];\n\tapZ1R[i] = apB1 * dispR - apB1 * yR + apZ2R[i];\n\tapZ2R[i] = dispR - apB0 * yR;\n\tdispR = yR;\n}\n\nout1 = linearinterp(pinch, combOutL, dispL);\nout2 = linearinterp(pinch, combOutR, dispR);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 14_inst_metallic_comb_growler.txt\n// Advanced Instrument 2: Metallic Comb & Formant Growler (\"Talking Riddim Machine\")\n// Combines:\n//   1. Adaptive Asymmetric Delay-Line FM (DAFx-08 ASDFM2 moving formants)\n//   2. Dual Parallel Pitch-Tracked Waveguide Comb Filters (Vowel/Pipe Resonator)\n//   3. Allpass Phase Dispersion Matrix\n//   4. 1-Bar Phasor-Synced Comb Ratio Whip + Joystick X/Y Performance Mapping\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs rhythmic comb whip)\n// Outlets:\n//   out1: Left Metallic Comb Growler Output\n//   out2: Right Metallic Comb Growler Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_comb_morph = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_adfm_growl = 0.0;\n@param({ min: 1.0, max: 16.0, steps: 16 }) whip_subdiv = 4.0;\n@param({ min: 0.0, max: 1.0 }) whip_depth = 0.55;\n@param({ min: -0.98, max: 0.98 }) comb_feedback = 0.85;\n@param({ min: 0.0, max: 1.0 }) comb_damping = 0.75;\n@param({ min: 0.0, max: 1.0 }) disperse_pinch = 0.6;\n@param({ min: 0.0, max: 1.0 }) stereo_width = 0.4;\n\n// Delay buffer for AdFM stage (2048 samples)\n@state fmBufL = new FixedSampleArray(2048);\n@state fmBufR = new FixedSampleArray(2048);\n@state fmWrite: Int = 0;\n\n// Dual Comb Filter buffers (4096 samples per channel)\n@state combBufL = new FixedSampleArray(4096);\n@state combBufR = new FixedSampleArray(4096);\n@state combWrite: Int = 0;\n\n@state dampLpL = new onepole();\n@state dampLpR = new onepole();\n\n// 6-stage Allpass Disperser post-comb\n@state apZ1L = new FixedSampleArray(6);\n@state apZ2L = new FixedSampleArray(6);\n@state apZ1R = new FixedSampleArray(6);\n@state apZ2R = new FixedSampleArray(6);\n\n// Pitch & Phasor states\n@state modPhasor = new phasor();\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.0;\n@state smoothCombDelL = 150.0;\n@state smoothCombDelR = 150.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch & Controller Conditioning ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nsmoothJoyX += (clamp(joy_x_comb_morph, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_adfm_growl, -1.0, 1.0) - smoothJoyY) * slew;\n\nlet f0 = clamp(smoothF0, 25.0, 900.0);\n\n// --- 2. Stage 1: Delay-Based Asymmetric AdFM Driven by Joystick Y ---\nfmBufL[fmWrite] = xL;\nfmBufR[fmWrite] = xR;\n\nlet joyY_u = 0.5 * (smoothJoyY + 1.0);\nlet kIdx = 0.4 + 4.2 * pow(joyY_u, 1.3);\n// Asymmetry factor r shifts upward as Joy Y increases -> upper moving formants\nlet rSym = pow(3.2, smoothJoyY);\nlet phMod = modPhasor.next(f0);\nlet modSin = 0.5 * (1.0 - sin(2.0 * pi * phMod));\nlet modCos = cos(2.0 * pi * phMod);\n\nlet delDepth = clamp((kIdx / (pi * f0)) * sr, 0.0, 1000.0);\nlet dSamps = 2.0 + delDepth * modSin;\n\nlet rFm = fmWrite - dSamps;\nwhile (rFm < 0.0) { rFm += 2048.0; }\nlet iFm0: Int = floor(rFm);\nlet fracFm = rFm - iFm0;\nlet fmOutL = cubicinterp(fracFm, fmBufL[(iFm0 - 1 + 2048) % 2048], fmBufL[iFm0 % 2048], fmBufL[(iFm0 + 1) % 2048], fmBufL[(iFm0 + 2) % 2048]);\nlet fmOutR = cubicinterp(fracFm, fmBufR[(iFm0 - 1 + 2048) % 2048], fmBufR[iFm0 % 2048], fmBufR[(iFm0 + 1) % 2048], fmBufR[(iFm0 + 2) % 2048]);\nfmWrite = (fmWrite + 1) % 2048;\n\nlet kAsym = clamp(0.4 * kIdx * (rSym - 1.0 / rSym), -3.5, 3.5);\nlet envAsym = exp(kAsym * modCos - abs(kAsym));\nlet preCombL = fmOutL * envAsym;\nlet preCombR = fmOutR * envAsym;\n\n// --- 3. Stage 2: 1-Bar Rhythmic Comb Whip + Joystick X Harmonic Ratio ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet subDiv = floor(clamp(whip_subdiv, 1.0, 16.0));\nlet whipPh = wrap(barPh * subDiv, 0.0, 1.0);\nlet whipEnv = kink(whipPh, 0.35);\nlet whipTri = pow(triangle(whipEnv, 0.25), 1.4);\n\n// Comb harmonic ratio controlled by Joystick X (0.5x sub-pipe to 12x high metallic formant) + Whip LFO\nlet octShift = 1.8 * smoothJoyX + 2.4 * clamp(whip_depth, 0.0, 1.0) * (whipTri - 0.3);\nlet combHz = clamp(f0 * 2.0 * pow(2.0, octShift), 22.0, 4500.0);\n\nlet wid = pow(clamp(stereo_width, 0.0, 1.0), 1.5) * 0.35; // up to +/- 0.35 octaves L/R\nlet widRatio = pow(2.0, wid);\n\nlet targetDelL = clamp(sr / (combHz / widRatio), 4.0, 4090.0);\nlet targetDelR = clamp(sr / (combHz * widRatio), 4.0, 4090.0);\n\nlet delSlew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothCombDelL += (targetDelL - smoothCombDelL) * delSlew;\nsmoothCombDelR += (targetDelR - smoothCombDelR) * delSlew;\n\nlet rCL = combWrite - smoothCombDelL;\nwhile (rCL < 0.0) { rCL += 4096.0; }\nlet icL: Int = floor(rCL);\nlet fcL = rCL - icL;\nlet cReadL = cubicinterp(fcL, combBufL[(icL - 1 + 4096) % 4096], combBufL[icL % 4096], combBufL[(icL + 1) % 4096], combBufL[(icL + 2) % 4096]);\n\nlet rCR = combWrite - smoothCombDelR;\nwhile (rCR < 0.0) { rCR += 4096.0; }\nlet icR: Int = floor(rCR);\nlet fcR = rCR - icR;\nlet cReadR = cubicinterp(fcR, combBufR[(icR - 1 + 4096) % 4096], combBufR[icR % 4096], combBufR[(icR + 1) % 4096], combBufR[(icR + 2) % 4096]);\n\nlet dampHz = 450.0 * pow(38.0, clamp(comb_damping, 0.0, 1.0));\nlet dReadL = dampLpL.next(cReadL, dampHz);\nlet dReadR = dampLpR.next(cReadR, dampHz);\n\nlet fbSign = (comb_feedback >= 0.0) ? 1.0 : -1.0;\nlet fbMag = 1.0 - pow(1.0 - abs(clamp(comb_feedback, -0.98, 0.98)), 1.4);\nlet fb = fbSign * clamp(fbMag, 0.0, 0.985);\n\ncombBufL[combWrite] = tanh(preCombL + fb * dReadL);\ncombBufR[combWrite] = tanh(preCombR + fb * dReadR);\ncombWrite = (combWrite + 1) % 4096;\n\nlet combOutL = (preCombL + fb * cReadL) / (1.0 + 0.55 * abs(fb));\nlet combOutR = (preCombR + fb * cReadR) / (1.0 + 0.55 * abs(fb));\n\n// --- 4. Stage 3: 6-Stage Allpass Phase Disperser Tuned to Comb Formant ---\nlet pinch = clamp(disperse_pinch, 0.0, 1.0);\nlet apQ = 0.707 + 6.5 * pow(pinch, 1.4);\nlet apW0 = 2.0 * pi * clamp(combHz * 0.75, 60.0, 3500.0) / sr;\nlet apAlpha = sin(apW0) / (2.0 * apQ);\nlet apA0_inv = 1.0 / (1.0 + apAlpha);\nlet apB0 = (1.0 - apAlpha) * apA0_inv;\nlet apB1 = (-2.0 * cos(apW0)) * apA0_inv;\n\nlet dispL = combOutL;\nlet dispR = combOutR;\nfor (let i: Int = 0; i < 6; i++) {\n\tlet yL = apB0 * dispL + apZ1L[i];\n\tapZ1L[i] = apB1 * dispL - apB1 * yL + apZ2L[i];\n\tapZ2L[i] = dispL - apB0 * yL;\n\tdispL = yL;\n\n\tlet yR = apB0 * dispR + apZ1R[i];\n\tapZ1R[i] = apB1 * dispR - apB1 * yR + apZ2R[i];\n\tapZ2R[i] = dispR - apB0 * yR;\n\tdispR = yR;\n}\n\nout1 = linearinterp(pinch, combOutL, dispL);\nout2 = linearinterp(pinch, combOutR, dispR);\n",
                                        "expr": ""
