                    },
                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 109.0, 156.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 07_adaptive_split_sideband.txt\n// Unix-Style Effect 7: Adaptive Split-Sideband (ASpSB) Synthesizer\n// Implements Lazzarini, Timoney & Lysaght (DAFx-08, Section 3, Eq. 5-20):\n// \"The Split-Sideband Method\" (ASpSB).\n// Uses three quadrature Hilbert transforms (on the carrier tuba, the cosine-mapped\n// even modulator cos(I*sin(wm*t)), and the sine-mapped odd modulator sin(I*sin(wm*t)))\n// to separate FM distortion into 4 independent sideband groups:\n// Upper-Even, Upper-Odd, Lower-Even, and Lower-Odd.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba Carrier)\n//   in2: Right Audio Input (Tuba Carrier)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n// Outlets:\n//   out1: Left ASpSB Audio Output\n//   out2: Right ASpSB Audio Output\n\n@param({ min: 0.1, max: 4.0 }) cm_ratio = 1.0;\n@param({ min: 0.0, max: 6.0 }) mod_index = 2.2;\n@param({ min: -1.0, max: 1.0 }) low_high_tilt = 0.6;\n@param({ min: -1.0, max: 1.0 }) odd_even_tilt = 0.0;\n\n// 3 Quadrature 4-stage IIR Hilbert transform pairs:\n// 1) Carrier Tuba (ac, ad)\n@state cReX = new FixedSampleArray(4); @state cReY = new FixedSampleArray(4);\n@state cImX = new FixedSampleArray(4); @state cImY = new FixedSampleArray(4);\n@state cDelRe = 0.0;\n\n// 2) Even Modulator cos(I*sin(wm*t)) (aae, abe)\n@state eReX = new FixedSampleArray(4); @state eReY = new FixedSampleArray(4);\n@state eImX = new FixedSampleArray(4); @state eImY = new FixedSampleArray(4);\n@state eDelRe = 0.0;\n\n// 3) Odd Modulator sin(I*sin(wm*t)) (aao, abo)\n@state oReX = new FixedSampleArray(4); @state oReY = new FixedSampleArray(4);\n@state oImX = new FixedSampleArray(4); @state oImY = new FixedSampleArray(4);\n@state oDelRe = 0.0;\n\n// Modulator oscillator & fallback pitch tracker\n@state modPhasor = new phasor();\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nsmoothF0 += (rawF0 - smoothF0) * (1.0 - exp(-1.0 / (0.008 * sr)));\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Even & Odd Mapped Modulators (Paper Eq. 5 & 6) ---\nlet fm = clamp(f0 / clamp(cm_ratio, 0.1, 4.0), 2.0, 2500.0);\nlet I = pow(clamp(mod_index / 6.0, 0.0, 1.0), 1.25) * 6.0;\nlet modSin = I * sin(2.0 * pi * modPhasor.next(fm));\n\nlet a2_even = cos(modSin); // Eq. 5: J0(I) + 2*sum(J_{2n}(I)*cos(2n*wm*t))\nlet a3_odd = sin(modSin);  // Eq. 6: 2*sum(J_{2n-1}(I)*sin((2n-1)*wm*t))\n\n// --- 3. Hilbert Transforms for Carrier, Even Mod, and Odd Mod ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\n// Carrier Hilbert -> (ac, ad)\nlet sC = mono;\nlet yc0 = cRe0 * (sC - cReY[0]) + cReX[0]; cReX[0] = sC; cReY[0] = yc0; sC = yc0;\nlet yc1 = cRe1 * (sC - cReY[1]) + cReX[1]; cReX[1] = sC; cReY[1] = yc1; sC = yc1;\nlet yc2 = cRe2 * (sC - cReY[2]) + cReX[2]; cReX[2] = sC; cReY[2] = yc2; sC = yc2;\nlet yc3 = cRe3 * (sC - cReY[3]) + cReX[3]; cReX[3] = sC; cReY[3] = yc3;\nlet ac = cDelRe; cDelRe = yc3;\n\nlet sCi = mono;\nlet yci0 = cIm0 * (sCi - cImY[0]) + cImX[0]; cImX[0] = sCi; cImY[0] = yci0; sCi = yci0;\nlet yci1 = cIm1 * (sCi - cImY[1]) + cImX[1]; cImX[1] = sCi; cImY[1] = yci1; sCi = yci1;\nlet yci2 = cIm2 * (sCi - cImY[2]) + cImX[2]; cImX[2] = sCi; cImY[2] = yci2; sCi = yci2;\nlet yci3 = cIm3 * (sCi - cImY[3]) + cImX[3]; cImX[3] = sCi; cImY[3] = yci3;\nlet ad = yci3;\n\n// Even Modulator Hilbert -> (aae, abe)\nlet sE = a2_even;\nlet ye0 = cRe0 * (sE - eReY[0]) + eReX[0]; eReX[0] = sE; eReY[0] = ye0; sE = ye0;\nlet ye1 = cRe1 * (sE - eReY[1]) + eReX[1]; eReX[1] = sE; eReY[1] = ye1; sE = ye1;\nlet ye2 = cRe2 * (sE - eReY[2]) + eReX[2]; eReX[2] = sE; eReY[2] = ye2; sE = ye2;\nlet ye3 = cRe3 * (sE - eReY[3]) + eReX[3]; eReX[3] = sE; eReY[3] = ye3;\nlet aae = eDelRe; eDelRe = ye3;\n\nlet sEi = a2_even;\nlet yei0 = cIm0 * (sEi - eImY[0]) + eImX[0]; eImX[0] = sEi; eImY[0] = yei0; sEi = yei0;\nlet yei1 = cIm1 * (sEi - eImY[1]) + eImX[1]; eImX[1] = sEi; eImY[1] = yei1; sEi = yei1;\nlet yei2 = cIm2 * (sEi - eImY[2]) + eImX[2]; eImX[2] = sEi; eImY[2] = yei2; sEi = yei2;\nlet yei3 = cIm3 * (sEi - eImY[3]) + eImX[3]; eImX[3] = sEi; eImY[3] = yei3;\nlet abe = yei3;\n\n// Odd Modulator Hilbert -> (aao, abo)\nlet sO = a3_odd;\nlet yo0 = cRe0 * (sO - oReY[0]) + oReX[0]; oReX[0] = sO; oReY[0] = yo0; sO = yo0;\nlet yo1 = cRe1 * (sO - oReY[1]) + oReX[1]; oReX[1] = sO; oReY[1] = yo1; sO = yo1;\nlet yo2 = cRe2 * (sO - oReY[2]) + oReX[2]; oReX[2] = sO; oReY[2] = yo2; sO = yo2;\nlet yo3 = cRe3 * (sO - oReY[3]) + oReX[3]; oReX[3] = sO; oReY[3] = yo3;\nlet aao = oDelRe; oDelRe = yo3;\n\nlet sOi = a3_odd;\nlet yoi0 = cIm0 * (sOi - oImY[0]) + oImX[0]; oImX[0] = sOi; oImY[0] = yoi0; sOi = yoi0;\nlet yoi1 = cIm1 * (sOi - oImY[1]) + oImX[1]; oImX[1] = sOi; oImY[1] = yoi1; sOi = yoi1;\nlet yoi2 = cIm2 * (sOi - oImY[2]) + oImX[2]; oImX[2] = sOi; oImY[2] = yoi2; sOi = yoi2;\nlet yoi3 = cIm3 * (sOi - oImY[3]) + oImX[3]; oImX[3] = sOi; oImY[3] = yoi3;\nlet abo = yoi3;\n\n// --- 4. ASpSB Matrix Heterodyning (Paper Eq. 20 & Csound ASpSB Opcode) ---\nlet aeu = aae * ac - abe * ad; // Upper Even sidebands\nlet aou = aao * ac - abo * ad; // Upper Odd sidebands\nlet ael = aae * ac + abe * ad; // Lower Even sidebands\nlet aol = aao * ac + abo * ad; // Lower Odd sidebands\n\n// --- 5. Sideband Tilt Mixing & Stereo Spatialization (Paper Sec 4.3) ---\nlet lh = clamp(low_high_tilt, -1.0, 1.0);\nlet oe = clamp(odd_even_tilt, -1.0, 1.0);\n\nlet gainUpper = clamp(1.0 + lh, 0.0, 1.4);\nlet gainLower = clamp(1.0 - lh, 0.0, 1.4);\nlet gainEven = clamp(1.0 + oe, 0.0, 1.4);\nlet gainOdd = clamp(1.0 - oe, 0.0, 1.4);\n\n// Place Even & Odd sideband groups with subtle stereo spread for huge dubstep image\nlet outL = gainUpper * (gainEven * aeu + 0.7 * gainOdd * aou) + gainLower * (gainOdd * aol + 0.7 * gainEven * ael);\nlet outR = gainUpper * (gainOdd * aou + 0.7 * gainEven * aeu) + gainLower * (gainEven * ael + 0.7 * gainOdd * aol);\n\nout1 = outL * 0.7;\nout2 = outR * 0.7;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 3,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 07_adaptive_split_sideband.txt\n// Unix-Style Effect 7: Adaptive Split-Sideband (ASpSB) Synthesizer\n// Implements Lazzarini, Timoney & Lysaght (DAFx-08, Section 3, Eq. 5-20):\n// \"The Split-Sideband Method\" (ASpSB).\n// Uses three quadrature Hilbert transforms (on the carrier tuba, the cosine-mapped\n// even modulator cos(I*sin(wm*t)), and the sine-mapped odd modulator sin(I*sin(wm*t)))\n// to separate FM distortion into 4 independent sideband groups:\n// Upper-Even, Upper-Odd, Lower-Even, and Lower-Odd.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba Carrier)\n//   in2: Right Audio Input (Tuba Carrier)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n// Outlets:\n//   out1: Left ASpSB Audio Output\n//   out2: Right ASpSB Audio Output\n\n@param({ min: 0.1, max: 4.0 }) cm_ratio = 1.0;\n@param({ min: 0.0, max: 6.0 }) mod_index = 2.2;\n@param({ min: -1.0, max: 1.0 }) low_high_tilt = 0.6;\n@param({ min: -1.0, max: 1.0 }) odd_even_tilt = 0.0;\n\n// 3 Quadrature 4-stage IIR Hilbert transform pairs:\n// 1) Carrier Tuba (ac, ad)\n@state cReX = new FixedSampleArray(4); @state cReY = new FixedSampleArray(4);\n@state cImX = new FixedSampleArray(4); @state cImY = new FixedSampleArray(4);\n@state cDelRe = 0.0;\n\n// 2) Even Modulator cos(I*sin(wm*t)) (aae, abe)\n@state eReX = new FixedSampleArray(4); @state eReY = new FixedSampleArray(4);\n@state eImX = new FixedSampleArray(4); @state eImY = new FixedSampleArray(4);\n@state eDelRe = 0.0;\n\n// 3) Odd Modulator sin(I*sin(wm*t)) (aao, abo)\n@state oReX = new FixedSampleArray(4); @state oReY = new FixedSampleArray(4);\n@state oImX = new FixedSampleArray(4); @state oImY = new FixedSampleArray(4);\n@state oDelRe = 0.0;\n\n// Modulator oscillator & fallback pitch tracker\n@state modPhasor = new phasor();\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nsmoothF0 += (rawF0 - smoothF0) * (1.0 - exp(-1.0 / (0.008 * sr)));\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Even & Odd Mapped Modulators (Paper Eq. 5 & 6) ---\nlet fm = clamp(f0 / clamp(cm_ratio, 0.1, 4.0), 2.0, 2500.0);\nlet I = pow(clamp(mod_index / 6.0, 0.0, 1.0), 1.25) * 6.0;\nlet modSin = I * sin(2.0 * pi * modPhasor.next(fm));\n\nlet a2_even = cos(modSin); // Eq. 5: J0(I) + 2*sum(J_{2n}(I)*cos(2n*wm*t))\nlet a3_odd = sin(modSin);  // Eq. 6: 2*sum(J_{2n-1}(I)*sin((2n-1)*wm*t))\n\n// --- 3. Hilbert Transforms for Carrier, Even Mod, and Odd Mod ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\n// Carrier Hilbert -> (ac, ad)\nlet sC = mono;\nlet yc0 = cRe0 * (sC - cReY[0]) + cReX[0]; cReX[0] = sC; cReY[0] = yc0; sC = yc0;\nlet yc1 = cRe1 * (sC - cReY[1]) + cReX[1]; cReX[1] = sC; cReY[1] = yc1; sC = yc1;\nlet yc2 = cRe2 * (sC - cReY[2]) + cReX[2]; cReX[2] = sC; cReY[2] = yc2; sC = yc2;\nlet yc3 = cRe3 * (sC - cReY[3]) + cReX[3]; cReX[3] = sC; cReY[3] = yc3;\nlet ac = cDelRe; cDelRe = yc3;\n\nlet sCi = mono;\nlet yci0 = cIm0 * (sCi - cImY[0]) + cImX[0]; cImX[0] = sCi; cImY[0] = yci0; sCi = yci0;\nlet yci1 = cIm1 * (sCi - cImY[1]) + cImX[1]; cImX[1] = sCi; cImY[1] = yci1; sCi = yci1;\nlet yci2 = cIm2 * (sCi - cImY[2]) + cImX[2]; cImX[2] = sCi; cImY[2] = yci2; sCi = yci2;\nlet yci3 = cIm3 * (sCi - cImY[3]) + cImX[3]; cImX[3] = sCi; cImY[3] = yci3;\nlet ad = yci3;\n\n// Even Modulator Hilbert -> (aae, abe)\nlet sE = a2_even;\nlet ye0 = cRe0 * (sE - eReY[0]) + eReX[0]; eReX[0] = sE; eReY[0] = ye0; sE = ye0;\nlet ye1 = cRe1 * (sE - eReY[1]) + eReX[1]; eReX[1] = sE; eReY[1] = ye1; sE = ye1;\nlet ye2 = cRe2 * (sE - eReY[2]) + eReX[2]; eReX[2] = sE; eReY[2] = ye2; sE = ye2;\nlet ye3 = cRe3 * (sE - eReY[3]) + eReX[3]; eReX[3] = sE; eReY[3] = ye3;\nlet aae = eDelRe; eDelRe = ye3;\n\nlet sEi = a2_even;\nlet yei0 = cIm0 * (sEi - eImY[0]) + eImX[0]; eImX[0] = sEi; eImY[0] = yei0; sEi = yei0;\nlet yei1 = cIm1 * (sEi - eImY[1]) + eImX[1]; eImX[1] = sEi; eImY[1] = yei1; sEi = yei1;\nlet yei2 = cIm2 * (sEi - eImY[2]) + eImX[2]; eImX[2] = sEi; eImY[2] = yei2; sEi = yei2;\nlet yei3 = cIm3 * (sEi - eImY[3]) + eImX[3]; eImX[3] = sEi; eImY[3] = yei3;\nlet abe = yei3;\n\n// Odd Modulator Hilbert -> (aao, abo)\nlet sO = a3_odd;\nlet yo0 = cRe0 * (sO - oReY[0]) + oReX[0]; oReX[0] = sO; oReY[0] = yo0; sO = yo0;\nlet yo1 = cRe1 * (sO - oReY[1]) + oReX[1]; oReX[1] = sO; oReY[1] = yo1; sO = yo1;\nlet yo2 = cRe2 * (sO - oReY[2]) + oReX[2]; oReX[2] = sO; oReY[2] = yo2; sO = yo2;\nlet yo3 = cRe3 * (sO - oReY[3]) + oReX[3]; oReX[3] = sO; oReY[3] = yo3;\nlet aao = oDelRe; oDelRe = yo3;\n\nlet sOi = a3_odd;\nlet yoi0 = cIm0 * (sOi - oImY[0]) + oImX[0]; oImX[0] = sOi; oImY[0] = yoi0; sOi = yoi0;\nlet yoi1 = cIm1 * (sOi - oImY[1]) + oImX[1]; oImX[1] = sOi; oImY[1] = yoi1; sOi = yoi1;\nlet yoi2 = cIm2 * (sOi - oImY[2]) + oImX[2]; oImX[2] = sOi; oImY[2] = yoi2; sOi = yoi2;\nlet yoi3 = cIm3 * (sOi - oImY[3]) + oImX[3]; oImX[3] = sOi; oImY[3] = yoi3;\nlet abo = yoi3;\n\n// --- 4. ASpSB Matrix Heterodyning (Paper Eq. 20 & Csound ASpSB Opcode) ---\nlet aeu = aae * ac - abe * ad; // Upper Even sidebands\nlet aou = aao * ac - abo * ad; // Upper Odd sidebands\nlet ael = aae * ac + abe * ad; // Lower Even sidebands\nlet aol = aao * ac + abo * ad; // Lower Odd sidebands\n\n// --- 5. Sideband Tilt Mixing & Stereo Spatialization (Paper Sec 4.3) ---\nlet lh = clamp(low_high_tilt, -1.0, 1.0);\nlet oe = clamp(odd_even_tilt, -1.0, 1.0);\n\nlet gainUpper = clamp(1.0 + lh, 0.0, 1.4);\nlet gainLower = clamp(1.0 - lh, 0.0, 1.4);\nlet gainEven = clamp(1.0 + oe, 0.0, 1.4);\nlet gainOdd = clamp(1.0 - oe, 0.0, 1.4);\n\n// Place Even & Odd sideband groups with subtle stereo spread for huge dubstep image\nlet outL = gainUpper * (gainEven * aeu + 0.7 * gainOdd * aou) + gainLower * (gainOdd * aol + 0.7 * gainEven * ael);\nlet outR = gainUpper * (gainOdd * aou + 0.7 * gainEven * aeu) + gainLower * (gainEven * ael + 0.7 * gainOdd * aol);\n\nout1 = outL * 0.7;\nout2 = outR * 0.7;\n",
                                        "expr": ""
