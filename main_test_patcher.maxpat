                        "classnamespace": "rnbo",
                        "rect": [ 109.0, 156.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 03_coef_mod_allpass_pd.txt\n// Unix-Style Effect 3: Coefficient-Modulated Allpass Phase Distortion\n// Implements Timoney, Lazzarini, Pekonen & Valimaki (ICASSP 2009):\n// \"Spectrally Rich Phase Distortion Sound Synthesis Using an Allpass Filter\".\n// Modulates a first-order allpass filter coefficient a(t) in [0, 1] at the\n// tuba's fundamental rate using the tanh-smoothed sawtooth phase-deviation\n// mapping to impart rich sawtooth-like phase distortion to arbitrary brass audio.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n// Outlets:\n//   out1: Left Phase-Distorted Output\n//   out2: Right Phase-Distorted Output\n\n@param({ min: 0.0, max: 1.0 }) pd_depth = 0.75;\n@param({ min: 0.05, max: 0.95 }) knee_p = 0.25;\n@param({ min: 0.0, max: 1.0 }) smooth_beta = 0.5;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n\n// Modulator phasor locked to tracked pitch\n@state modPhasor = new phasor();\n\n// 2-stage cascaded 1st-order allpass filters per channel for deeper PD\n@state apX1L = 0.0;\n@state apY1L = 0.0;\n@state apX2L = 0.0;\n@state apY2L = 0.0;\n\n@state apX1R = 0.0;\n@state apY1R = 0.0;\n@state apX2R = 0.0;\n@state apY2R = 0.0;\n\n// Fallback ZC pitch tracker\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch Tracking Conditioning ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nsmoothF0 += (rawF0 - smoothF0) * (1.0 - exp(-1.0 / (0.006 * sr)));\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Paper Eq. (6)-(9): Sawtooth Phase Deviation to Allpass Coefficient ---\n// P in (0.05, 0.95) is the inflection point of the piecewise PD sawtooth (0.25 in paper)\nlet P = clamp(knee_p, 0.05, 0.95);\nlet depth = pow(clamp(pd_depth, 0.0, 1.0), 1.3);\n\n// Generate cyclical phase ramp at f0, stereo-offset by 90 deg on Right for width\nlet phL = modPhasor.next(f0);\nlet phR = wrap(phL + 0.12 * depth, 0.0, 1.0);\n\n// Piecewise saw(t, P) in [0, 1]: rises from 0 to 1 over [0, P], falls 1 to 0 over [P, 1]\nlet sawL = (phL < P) ? (phL / P) : (1.0 - (phL - P) / (1.0 - P));\nlet sawR = (phR < P) ? (phR / P) : (1.0 - (phR - P) / (1.0 - P));\n\n// Paper Eq. (7)-(8): scale phase deviation phi(w, t) between -w and -pi\nlet w = 2.0 * pi * f0 / sr;\nlet phiModL = (1.0 - 2.0 * P) * pi * sawL * depth;\nlet phiModR = (1.0 - 2.0 * P) * pi * sawR * depth;\n\nlet denom = maximum(abs((1.0 - 2.0 * P) * pi), 0.001);\nlet phiL = -w - (phiModL / denom) * (pi - w) * depth;\nlet phiR = -w - (phiModR / denom) * (pi - w) * depth;\n\n// Paper Eq. (6): m(t) = (phi(w,t) + w) / (2*sin(w) - (phi(w,t) - w)*cos(w))\nlet halfPhiW_L = 0.5 * (phiL + w);\nlet halfPhiW_R = 0.5 * (phiR + w);\nlet mRawL = clamp(abs(halfPhiW_L) / (sin(w) + abs(halfPhiW_L) * cos(w) + 0.0001), 0.0, 0.98);\nlet mRawR = clamp(abs(halfPhiW_R) / (sin(w) + abs(halfPhiW_R) * cos(w) + 0.0001), 0.0, 0.98);\n\n// Paper Eq. (9): Glitch-free smoothing m'(t) = tanh(alpha * m(t) - beta)\n// smooth_beta controls alpha & beta in [1.0, 2.0] (paper uses alpha=1.45, beta=1.5)\nlet beta = 1.0 + clamp(smooth_beta, 0.0, 1.0) * 0.85;\nlet alpha = beta - 0.05;\nlet mSmoothL = clamp(0.5 + 0.48 * tanh(alpha * mRawL * 2.5 - beta), 0.01, 0.96);\nlet mSmoothR = clamp(0.5 + 0.48 * tanh(alpha * mRawR * 2.5 - beta), 0.01, 0.96);\n\nlet mL = linearinterp(depth, 0.15, mSmoothL);\nlet mR = linearinterp(depth, 0.15, mSmoothR);\n\n// --- 3. Time-Varying 1st-Order Allpass Filter H(z) = (-a + z^-1) / (1 - a*z^-1) ---\nlet y1L = -mL * xL + apX1L + mL * apY1L;\napX1L = xL;\napY1L = y1L;\n\nlet y2L = -mL * y1L + apX2L + mL * apY2L;\napX2L = y1L;\napY2L = y2L;\n\nlet y1R = -mR * xR + apX1R + mR * apY1R;\napX1R = xR;\napY1R = y1R;\n\nlet y2R = -mR * y1R + apX2R + mR * apY2R;\napX2R = y1R;\napY2R = y2R;\n\nlet wetMix = clamp(mix, 0.0, 1.0);\nout1 = linearinterp(wetMix, xL, y2L);\nout2 = linearinterp(wetMix, xR, y2R);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 3,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 03_coef_mod_allpass_pd.txt\n// Unix-Style Effect 3: Coefficient-Modulated Allpass Phase Distortion\n// Implements Timoney, Lazzarini, Pekonen & Valimaki (ICASSP 2009):\n// \"Spectrally Rich Phase Distortion Sound Synthesis Using an Allpass Filter\".\n// Modulates a first-order allpass filter coefficient a(t) in [0, 1] at the\n// tuba's fundamental rate using the tanh-smoothed sawtooth phase-deviation\n// mapping to impart rich sawtooth-like phase distortion to arbitrary brass audio.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n// Outlets:\n//   out1: Left Phase-Distorted Output\n//   out2: Right Phase-Distorted Output\n\n@param({ min: 0.0, max: 1.0 }) pd_depth = 0.75;\n@param({ min: 0.05, max: 0.95 }) knee_p = 0.25;\n@param({ min: 0.0, max: 1.0 }) smooth_beta = 0.5;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n\n// Modulator phasor locked to tracked pitch\n@state modPhasor = new phasor();\n\n// 2-stage cascaded 1st-order allpass filters per channel for deeper PD\n@state apX1L = 0.0;\n@state apY1L = 0.0;\n@state apX2L = 0.0;\n@state apY2L = 0.0;\n\n@state apX1R = 0.0;\n@state apY1R = 0.0;\n@state apX2R = 0.0;\n@state apY2R = 0.0;\n\n// Fallback ZC pitch tracker\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch Tracking Conditioning ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nsmoothF0 += (rawF0 - smoothF0) * (1.0 - exp(-1.0 / (0.006 * sr)));\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Paper Eq. (6)-(9): Sawtooth Phase Deviation to Allpass Coefficient ---\n// P in (0.05, 0.95) is the inflection point of the piecewise PD sawtooth (0.25 in paper)\nlet P = clamp(knee_p, 0.05, 0.95);\nlet depth = pow(clamp(pd_depth, 0.0, 1.0), 1.3);\n\n// Generate cyclical phase ramp at f0, stereo-offset by 90 deg on Right for width\nlet phL = modPhasor.next(f0);\nlet phR = wrap(phL + 0.12 * depth, 0.0, 1.0);\n\n// Piecewise saw(t, P) in [0, 1]: rises from 0 to 1 over [0, P], falls 1 to 0 over [P, 1]\nlet sawL = (phL < P) ? (phL / P) : (1.0 - (phL - P) / (1.0 - P));\nlet sawR = (phR < P) ? (phR / P) : (1.0 - (phR - P) / (1.0 - P));\n\n// Paper Eq. (7)-(8): scale phase deviation phi(w, t) between -w and -pi\nlet w = 2.0 * pi * f0 / sr;\nlet phiModL = (1.0 - 2.0 * P) * pi * sawL * depth;\nlet phiModR = (1.0 - 2.0 * P) * pi * sawR * depth;\n\nlet denom = maximum(abs((1.0 - 2.0 * P) * pi), 0.001);\nlet phiL = -w - (phiModL / denom) * (pi - w) * depth;\nlet phiR = -w - (phiModR / denom) * (pi - w) * depth;\n\n// Paper Eq. (6): m(t) = (phi(w,t) + w) / (2*sin(w) - (phi(w,t) - w)*cos(w))\nlet halfPhiW_L = 0.5 * (phiL + w);\nlet halfPhiW_R = 0.5 * (phiR + w);\nlet mRawL = clamp(abs(halfPhiW_L) / (sin(w) + abs(halfPhiW_L) * cos(w) + 0.0001), 0.0, 0.98);\nlet mRawR = clamp(abs(halfPhiW_R) / (sin(w) + abs(halfPhiW_R) * cos(w) + 0.0001), 0.0, 0.98);\n\n// Paper Eq. (9): Glitch-free smoothing m'(t) = tanh(alpha * m(t) - beta)\n// smooth_beta controls alpha & beta in [1.0, 2.0] (paper uses alpha=1.45, beta=1.5)\nlet beta = 1.0 + clamp(smooth_beta, 0.0, 1.0) * 0.85;\nlet alpha = beta - 0.05;\nlet mSmoothL = clamp(0.5 + 0.48 * tanh(alpha * mRawL * 2.5 - beta), 0.01, 0.96);\nlet mSmoothR = clamp(0.5 + 0.48 * tanh(alpha * mRawR * 2.5 - beta), 0.01, 0.96);\n\nlet mL = linearinterp(depth, 0.15, mSmoothL);\nlet mR = linearinterp(depth, 0.15, mSmoothR);\n\n// --- 3. Time-Varying 1st-Order Allpass Filter H(z) = (-a + z^-1) / (1 - a*z^-1) ---\nlet y1L = -mL * xL + apX1L + mL * apY1L;\napX1L = xL;\napY1L = y1L;\n\nlet y2L = -mL * y1L + apX2L + mL * apY2L;\napX2L = y1L;\napY2L = y2L;\n\nlet y1R = -mR * xR + apX1R + mR * apY1R;\napX1R = xR;\napY1R = y1R;\n\nlet y2R = -mR * y1R + apX2R + mR * apY2R;\napX2R = y1R;\napY2R = y2R;\n\nlet wetMix = clamp(mix, 0.0, 1.0);\nout1 = linearinterp(wetMix, xL, y2L);\nout2 = linearinterp(wetMix, xR, y2R);\n",
                                        "expr": ""
                                    },
