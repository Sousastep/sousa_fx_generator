                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 84.0, 131.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 02_allpass_disperser.txt\n// Unix-Style Effect 2: Cascaded Allpass Phase Disperser\n// Passes the stereo signal through a pure series cascade of up to 32\n// second-order biquad allpass filters per channel (no dry/wet phaser notches).\n// Accumulates frequency-selective group delay around the cutoff to smear\n// brass attacks into liquid, laser-like dubstep transient chirps.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Optional Tracked Pitch in Hz (if > 20 Hz, gently biases cutoff tracking)\n//   in4: Optional 1-Bar Phasor [0..1] (unused when static, available for chain thru)\n// Outlets:\n//   out1: Left Dispersed Audio Output\n//   out2: Right Dispersed Audio Output\n\n@param({ min: 1.0, max: 32.0 }) stages = 16.0;\n@param({ min: 30.0, max: 4000.0 }) freq_hz = 180.0;\n@param({ min: 0.707, max: 12.0 }) pinch_q = 2.2;\n@param({ min: 0.0, max: 1.0 }) spread = 0.25;\n\n// 32 second-order allpass stages per channel (2 states per biquad = 64 per channel)\n@state z1L = new FixedSampleArray(32);\n@state z2L = new FixedSampleArray(32);\n@state z1R = new FixedSampleArray(32);\n@state z2R = new FixedSampleArray(32);\n\n@state smoothFreq = 180.0;\n@state smoothQ = 2.2;\n@state smoothSpread = 0.25;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// Smooth parameters to avoid zipper noise in long allpass cascades\nlet slew = 1.0 - exp(-1.0 / (0.005 * sr));\nlet targetFreq = clamp(freq_hz, 30.0, 4000.0);\nif (pitchIn > 20.0 && pitchIn < 1000.0) {\n\t// Optional pitch-relative offset when fluid.pitch~ is patched into in3\n\ttargetFreq = clamp(targetFreq * (pitchIn / 110.0), 28.0, 6000.0);\n}\nsmoothFreq += (targetFreq - smoothFreq) * slew;\nsmoothQ += (clamp(pinch_q, 0.707, 12.0) - smoothQ) * slew;\nsmoothSpread += (clamp(spread, 0.0, 1.0) - smoothSpread) * slew;\n\n// Stereo frequency offset (up to +/- 1 octave spread at max spread)\nlet spreadRatio = pow(2.0, smoothSpread * 0.75);\nlet freqL = clamp(smoothFreq / spreadRatio, 24.0, sr * 0.45);\nlet freqR = clamp(smoothFreq * spreadRatio, 24.0, sr * 0.45);\n\n// RBJ 2nd-order Allpass coefficients for Left channel\nlet w0L = 2.0 * pi * freqL / sr;\nlet cosL = cos(w0L);\nlet alphaL = sin(w0L) / (2.0 * smoothQ);\nlet a0L_inv = 1.0 / (1.0 + alphaL);\nlet b0L = (1.0 - alphaL) * a0L_inv;\nlet b1L = (-2.0 * cosL) * a0L_inv;\n// In RBJ allpass: b2 = 1.0, a1 = b1, a2 = b0\n\n// RBJ 2nd-order Allpass coefficients for Right channel\nlet w0R = 2.0 * pi * freqR / sr;\nlet cosR = cos(w0R);\nlet alphaR = sin(w0R) / (2.0 * smoothQ);\nlet a0R_inv = 1.0 / (1.0 + alphaR);\nlet b0R = (1.0 - alphaR) * a0R_inv;\nlet b1R = (-2.0 * cosR) * a0R_inv;\n\n// Fractional stage count allows click-free morphing of dispersion depth\nlet stagePos = clamp(stages, 1.0, 32.0);\nlet numFull: Int = floor(stagePos);\nlet frac = stagePos - numFull;\n\nlet sigL = xL;\nlet sigR = xR;\nlet prevL = xL;\nlet prevR = xR;\n\nfor (let i: Int = 0; i < 32; i++) {\n\tif (i < numFull + 1) {\n\t\tprevL = sigL;\n\t\tprevR = sigR;\n\n\t\t// Direct Form II Transposed 2nd-order allpass\n\t\tlet yL = b0L * sigL + z1L[i];\n\t\tz1L[i] = b1L * sigL - b1L * yL + z2L[i];\n\t\tz2L[i] = sigL - b0L * yL;\n\t\tsigL = yL;\n\n\t\tlet yR = b0R * sigR + z1R[i];\n\t\tz1R[i] = b1R * sigR - b1R * yR + z2R[i];\n\t\tz2R[i] = sigR - b0R * yR;\n\t\tsigR = yR;\n\t}\n}\n\n// Smoothly interpolate the final fractional stage\nif (numFull < 32) {\n\tsigL = linearinterp(frac, prevL, sigL);\n\tsigR = linearinterp(frac, prevR, sigR);\n}\n\nout1 = sigL;\nout2 = sigR;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 3,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 02_allpass_disperser.txt\n// Unix-Style Effect 2: Cascaded Allpass Phase Disperser\n// Passes the stereo signal through a pure series cascade of up to 32\n// second-order biquad allpass filters per channel (no dry/wet phaser notches).\n// Accumulates frequency-selective group delay around the cutoff to smear\n// brass attacks into liquid, laser-like dubstep transient chirps.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Optional Tracked Pitch in Hz (if > 20 Hz, gently biases cutoff tracking)\n//   in4: Optional 1-Bar Phasor [0..1] (unused when static, available for chain thru)\n// Outlets:\n//   out1: Left Dispersed Audio Output\n//   out2: Right Dispersed Audio Output\n\n@param({ min: 1.0, max: 32.0 }) stages = 16.0;\n@param({ min: 30.0, max: 4000.0 }) freq_hz = 180.0;\n@param({ min: 0.707, max: 12.0 }) pinch_q = 2.2;\n@param({ min: 0.0, max: 1.0 }) spread = 0.25;\n\n// 32 second-order allpass stages per channel (2 states per biquad = 64 per channel)\n@state z1L = new FixedSampleArray(32);\n@state z2L = new FixedSampleArray(32);\n@state z1R = new FixedSampleArray(32);\n@state z2R = new FixedSampleArray(32);\n\n@state smoothFreq = 180.0;\n@state smoothQ = 2.2;\n@state smoothSpread = 0.25;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// Smooth parameters to avoid zipper noise in long allpass cascades\nlet slew = 1.0 - exp(-1.0 / (0.005 * sr));\nlet targetFreq = clamp(freq_hz, 30.0, 4000.0);\nif (pitchIn > 20.0 && pitchIn < 1000.0) {\n\t// Optional pitch-relative offset when fluid.pitch~ is patched into in3\n\ttargetFreq = clamp(targetFreq * (pitchIn / 110.0), 28.0, 6000.0);\n}\nsmoothFreq += (targetFreq - smoothFreq) * slew;\nsmoothQ += (clamp(pinch_q, 0.707, 12.0) - smoothQ) * slew;\nsmoothSpread += (clamp(spread, 0.0, 1.0) - smoothSpread) * slew;\n\n// Stereo frequency offset (up to +/- 1 octave spread at max spread)\nlet spreadRatio = pow(2.0, smoothSpread * 0.75);\nlet freqL = clamp(smoothFreq / spreadRatio, 24.0, sr * 0.45);\nlet freqR = clamp(smoothFreq * spreadRatio, 24.0, sr * 0.45);\n\n// RBJ 2nd-order Allpass coefficients for Left channel\nlet w0L = 2.0 * pi * freqL / sr;\nlet cosL = cos(w0L);\nlet alphaL = sin(w0L) / (2.0 * smoothQ);\nlet a0L_inv = 1.0 / (1.0 + alphaL);\nlet b0L = (1.0 - alphaL) * a0L_inv;\nlet b1L = (-2.0 * cosL) * a0L_inv;\n// In RBJ allpass: b2 = 1.0, a1 = b1, a2 = b0\n\n// RBJ 2nd-order Allpass coefficients for Right channel\nlet w0R = 2.0 * pi * freqR / sr;\nlet cosR = cos(w0R);\nlet alphaR = sin(w0R) / (2.0 * smoothQ);\nlet a0R_inv = 1.0 / (1.0 + alphaR);\nlet b0R = (1.0 - alphaR) * a0R_inv;\nlet b1R = (-2.0 * cosR) * a0R_inv;\n\n// Fractional stage count allows click-free morphing of dispersion depth\nlet stagePos = clamp(stages, 1.0, 32.0);\nlet numFull: Int = floor(stagePos);\nlet frac = stagePos - numFull;\n\nlet sigL = xL;\nlet sigR = xR;\nlet prevL = xL;\nlet prevR = xR;\n\nfor (let i: Int = 0; i < 32; i++) {\n\tif (i < numFull + 1) {\n\t\tprevL = sigL;\n\t\tprevR = sigR;\n\n\t\t// Direct Form II Transposed 2nd-order allpass\n\t\tlet yL = b0L * sigL + z1L[i];\n\t\tz1L[i] = b1L * sigL - b1L * yL + z2L[i];\n\t\tz2L[i] = sigL - b0L * yL;\n\t\tsigL = yL;\n\n\t\tlet yR = b0R * sigR + z1R[i];\n\t\tz1R[i] = b1R * sigR - b1R * yR + z2R[i];\n\t\tz2R[i] = sigR - b0R * yR;\n\t\tsigR = yR;\n\t}\n}\n\n// Smoothly interpolate the final fractional stage\nif (numFull < 32) {\n\tsigL = linearinterp(frac, prevL, sigL);\n\tsigR = linearinterp(frac, prevR, sigR);\n}\n\nout1 = sigL;\nout2 = sigR;\n",
                                        "expr": ""
                                    },
                                    "rnbo_serial": 2,
                                    "rnbo_uniqueid": "effect_code",
