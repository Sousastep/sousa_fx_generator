                                    "code": "// ============================================================================\n// 08_suboctave_phase_ringmod.txt\n// Unix-Style Effect 8: Phase-Divided Sub-Octave Ring Modulator & Feedback AM\n// Implements Approach 3b & 5 from \"Novel Distortion Approaches for Live Tuba\"\n// and Kleimola et al. (2011) Feedback Amplitude Modulation (y[n] = x[n]*(1 + k*y[n-1])).\n// Extracts instantaneous phase theta(t), tracks phase wraps to construct a\n// zero-drift phase-divided sub-octave modulator cos(theta_unwrapped / 2) and\n// sub-fifth cos(theta_unwrapped / 3) that never beats against the tuba.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Optional Tracked Pitch in Hz (used to tune lowpass pre-conditioner if > 20 Hz)\n// Outlets:\n//   out1: Left Sub-Octave Ring-Mod / Feedback AM Output\n//   out2: Right Sub-Octave Ring-Mod / Feedback AM Output\n\n@param({ min: 0.0, max: 1.0 }) sub_harmonic = 0.0;\n@param({ min: 0.0, max: 1.0 }) rm_depth = 0.85;\n@param({ min: 0.0, max: 0.92 }) fb_am = 0.35;\n@param({ min: 0.0, max: 1.0 }) mix = 0.8;\n\n// Hilbert quadrature pair for instantaneous phase extraction\n@state hReX = new FixedSampleArray(4); @state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4); @state hImY = new FixedSampleArray(4);\n@state hDelRe = 0.0;\n\n// Phase wrap counter for exact phase division (theta / 2 and theta / 3)\n@state prevTheta = 0.0;\n@state wrapCount: Int = 0;\n\n// Feedback AM state (Kleimola et al. 2011)\n@state prevYL = 0.0;\n@state prevYR = 0.0;\n\n// Pre-filter for clean fundamental phase tracking + DC blockers\n@state lpTrack = new onepole();\n@state dcX1L = 0.0; @state dcY1L = 0.0;\n@state dcX1R = 0.0; @state dcY1R = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pre-Filter Tuba Fundamental for Clean Analytic Phase ---\nlet trackCutoff = (pitchIn > 20.0 && pitchIn < 1000.0) ? (pitchIn * 1.35) : 140.0;\nlet monoFund = lpTrack.next(0.5 * (xL + xR), clamp(trackCutoff, 35.0, 800.0));\n\n// --- 2. Analytic Phase Extraction ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet sRe = monoFund;\nlet yRe0 = cRe0 * (sRe - hReY[0]) + hReX[0]; hReX[0] = sRe; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe - hReY[1]) + hReX[1]; hReX[1] = sRe; hReY[1] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe - hReY[2]) + hReX[2]; hReX[2] = sRe; hReY[2] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe - hReY[3]) + hReX[3]; hReX[3] = sRe; hReY[3] = yRe3;\nlet outRe = hDelRe; hDelRe = yRe3;\n\nlet sIm = monoFund;\nlet yIm0 = cIm0 * (sIm - hImY[0]) + hImX[0]; hImX[0] = sIm; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm - hImY[1]) + hImX[1]; hImX[1] = sIm; hImY[1] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm - hImY[2]) + hImX[2]; hImX[2] = sIm; hImY[2] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm - hImY[3]) + hImX[3]; hImX[3] = sIm; hImY[3] = yIm3;\nlet outIm = yIm3;\n\nlet pol = cartopol(outRe, outIm);\nlet instAmp = pol[0];\nlet theta = pol[1]; // [-pi, pi]\n\n// --- 3. Phase Unwrapping Counter (Modulo 6 Cycles for LCM of /2 and /3) ---\nlet dTheta = theta - prevTheta;\nif (dTheta < -pi) {\n\twrapCount = (wrapCount + 1) % 6;\n} else if (dTheta > pi) {\n\twrapCount = (wrapCount + 5) % 6;\n}\nprevTheta = theta;\n\nlet unwrappedTheta = theta + 2.0 * pi * wrapCount;\n\n// Locked Sub-Octave (theta / 2), Sub-Twelfth (theta / 3), and Octave-Up (2 * theta)\nlet subOctL = cos(0.5 * unwrappedTheta);\nlet subOctR = cos(0.5 * unwrappedTheta + 0.25 * pi); // Stereo quadrature spread\nlet subFifthL = cos(unwrappedTheta / 3.0);\nlet subFifthR = cos(unwrappedTheta / 3.0 + 0.25 * pi);\nlet octUp = cos(2.0 * theta);\n\n// Morph modulator across Sub-Octave (0.0) -> Sub-Twelfth (0.5) -> Sub+Octave Growl (1.0)\nlet sh = clamp(sub_harmonic, 0.0, 1.0);\nlet modWaveL = (sh < 0.5) ? linearinterp(sh * 2.0, subOctL, subFifthL) : linearinterp((sh - 0.5) * 2.0, subFifthL, 0.7 * subOctL + 0.5 * octUp);\nlet modWaveR = (sh < 0.5) ? linearinterp(sh * 2.0, subOctR, subFifthR) : linearinterp((sh - 0.5) * 2.0, subFifthR, 0.7 * subOctR - 0.5 * octUp);\n\n// Silence gate so phase noise doesn't chatter when not playing\nlet gate = clamp((instAmp - 0.0008) * 250.0, 0.0, 1.0);\nmodWaveL *= gate;\nmodWaveR *= gate;\n\n// --- 4. AM-to-RM Continuum + Feedback AM (Kleimola et al. 2011) ---\n// y = x * ( (1 - d) + d * modWave + k * y[n-1] )\nlet d = pow(clamp(rm_depth, 0.0, 1.0), 1.2);\nlet kFb = pow(clamp(fb_am / 0.92, 0.0, 1.0), 1.4) * 0.92;\n\nlet amModL = (1.0 - d) + d * modWaveL;\nlet amModR = (1.0 - d) + d * modWaveR;\n\nlet rawYL = xL * (amModL + kFb * prevYL);\nlet rawYR = xR * (amModR + kFb * prevYR);\n\n// Soft-saturate feedback loop to prevent runaway while keeping sawtooth bite\nprevYL = tanh(rawYL);\nprevYR = tanh(rawYR);\n\n// --- 5. DC Blocking Filter (Highpass at ~12 Hz) ---\nlet dcR = 1.0 - (2.0 * pi * 12.0 / sr);\nlet cleanL = prevYL - dcX1L + dcR * dcY1L;\ndcX1L = prevYL; dcY1L = cleanL;\n\nlet cleanR = prevYR - dcX1R + dcR * dcY1R;\ndcX1R = prevYR; dcY1R = cleanR;\n\nout1 = linearinterp(clamp(mix, 0.0, 1.0), xL, cleanL);\nout2 = linearinterp(clamp(mix, 0.0, 1.0), xR, cleanR);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 3,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 08_suboctave_phase_ringmod.txt\n// Unix-Style Effect 8: Phase-Divided Sub-Octave Ring Modulator & Feedback AM\n// Implements Approach 3b & 5 from \"Novel Distortion Approaches for Live Tuba\"\n// and Kleimola et al. (2011) Feedback Amplitude Modulation (y[n] = x[n]*(1 + k*y[n-1])).\n// Extracts instantaneous phase theta(t), tracks phase wraps to construct a\n// zero-drift phase-divided sub-octave modulator cos(theta_unwrapped / 2) and\n// sub-fifth cos(theta_unwrapped / 3) that never beats against the tuba.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Optional Tracked Pitch in Hz (used to tune lowpass pre-conditioner if > 20 Hz)\n// Outlets:\n//   out1: Left Sub-Octave Ring-Mod / Feedback AM Output\n//   out2: Right Sub-Octave Ring-Mod / Feedback AM Output\n\n@param({ min: 0.0, max: 1.0 }) sub_harmonic = 0.0;\n@param({ min: 0.0, max: 1.0 }) rm_depth = 0.85;\n@param({ min: 0.0, max: 0.92 }) fb_am = 0.35;\n@param({ min: 0.0, max: 1.0 }) mix = 0.8;\n\n// Hilbert quadrature pair for instantaneous phase extraction\n@state hReX = new FixedSampleArray(4); @state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4); @state hImY = new FixedSampleArray(4);\n@state hDelRe = 0.0;\n\n// Phase wrap counter for exact phase division (theta / 2 and theta / 3)\n@state prevTheta = 0.0;\n@state wrapCount: Int = 0;\n\n// Feedback AM state (Kleimola et al. 2011)\n@state prevYL = 0.0;\n@state prevYR = 0.0;\n\n// Pre-filter for clean fundamental phase tracking + DC blockers\n@state lpTrack = new onepole();\n@state dcX1L = 0.0; @state dcY1L = 0.0;\n@state dcX1R = 0.0; @state dcY1R = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pre-Filter Tuba Fundamental for Clean Analytic Phase ---\nlet trackCutoff = (pitchIn > 20.0 && pitchIn < 1000.0) ? (pitchIn * 1.35) : 140.0;\nlet monoFund = lpTrack.next(0.5 * (xL + xR), clamp(trackCutoff, 35.0, 800.0));\n\n// --- 2. Analytic Phase Extraction ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet sRe = monoFund;\nlet yRe0 = cRe0 * (sRe - hReY[0]) + hReX[0]; hReX[0] = sRe; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe - hReY[1]) + hReX[1]; hReX[1] = sRe; hReY[1] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe - hReY[2]) + hReX[2]; hReX[2] = sRe; hReY[2] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe - hReY[3]) + hReX[3]; hReX[3] = sRe; hReY[3] = yRe3;\nlet outRe = hDelRe; hDelRe = yRe3;\n\nlet sIm = monoFund;\nlet yIm0 = cIm0 * (sIm - hImY[0]) + hImX[0]; hImX[0] = sIm; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm - hImY[1]) + hImX[1]; hImX[1] = sIm; hImY[1] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm - hImY[2]) + hImX[2]; hImX[2] = sIm; hImY[2] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm - hImY[3]) + hImX[3]; hImX[3] = sIm; hImY[3] = yIm3;\nlet outIm = yIm3;\n\nlet pol = cartopol(outRe, outIm);\nlet instAmp = pol[0];\nlet theta = pol[1]; // [-pi, pi]\n\n// --- 3. Phase Unwrapping Counter (Modulo 6 Cycles for LCM of /2 and /3) ---\nlet dTheta = theta - prevTheta;\nif (dTheta < -pi) {\n\twrapCount = (wrapCount + 1) % 6;\n} else if (dTheta > pi) {\n\twrapCount = (wrapCount + 5) % 6;\n}\nprevTheta = theta;\n\nlet unwrappedTheta = theta + 2.0 * pi * wrapCount;\n\n// Locked Sub-Octave (theta / 2), Sub-Twelfth (theta / 3), and Octave-Up (2 * theta)\nlet subOctL = cos(0.5 * unwrappedTheta);\nlet subOctR = cos(0.5 * unwrappedTheta + 0.25 * pi); // Stereo quadrature spread\nlet subFifthL = cos(unwrappedTheta / 3.0);\nlet subFifthR = cos(unwrappedTheta / 3.0 + 0.25 * pi);\nlet octUp = cos(2.0 * theta);\n\n// Morph modulator across Sub-Octave (0.0) -> Sub-Twelfth (0.5) -> Sub+Octave Growl (1.0)\nlet sh = clamp(sub_harmonic, 0.0, 1.0);\nlet modWaveL = (sh < 0.5) ? linearinterp(sh * 2.0, subOctL, subFifthL) : linearinterp((sh - 0.5) * 2.0, subFifthL, 0.7 * subOctL + 0.5 * octUp);\nlet modWaveR = (sh < 0.5) ? linearinterp(sh * 2.0, subOctR, subFifthR) : linearinterp((sh - 0.5) * 2.0, subFifthR, 0.7 * subOctR - 0.5 * octUp);\n\n// Silence gate so phase noise doesn't chatter when not playing\nlet gate = clamp((instAmp - 0.0008) * 250.0, 0.0, 1.0);\nmodWaveL *= gate;\nmodWaveR *= gate;\n\n// --- 4. AM-to-RM Continuum + Feedback AM (Kleimola et al. 2011) ---\n// y = x * ( (1 - d) + d * modWave + k * y[n-1] )\nlet d = pow(clamp(rm_depth, 0.0, 1.0), 1.2);\nlet kFb = pow(clamp(fb_am / 0.92, 0.0, 1.0), 1.4) * 0.92;\n\nlet amModL = (1.0 - d) + d * modWaveL;\nlet amModR = (1.0 - d) + d * modWaveR;\n\nlet rawYL = xL * (amModL + kFb * prevYL);\nlet rawYR = xR * (amModR + kFb * prevYR);\n\n// Soft-saturate feedback loop to prevent runaway while keeping sawtooth bite\nprevYL = tanh(rawYL);\nprevYR = tanh(rawYR);\n\n// --- 5. DC Blocking Filter (Highpass at ~12 Hz) ---\nlet dcR = 1.0 - (2.0 * pi * 12.0 / sr);\nlet cleanL = prevYL - dcX1L + dcR * dcY1L;\ndcX1L = prevYL; dcY1L = cleanL;\n\nlet cleanR = prevYR - dcX1R + dcR * dcY1R;\ndcX1R = prevYR; dcY1R = cleanR;\n\nout1 = linearinterp(clamp(mix, 0.0, 1.0), xL, cleanL);\nout2 = linearinterp(clamp(mix, 0.0, 1.0), xR, cleanR);\n",
