                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 361.0, 174.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 04_hilbert_phasor_sync.txt\n// Unix-Style Effect 4: Analytic Phasor Extractor & PolyBLEP Hard/Soft Sync\n// Implements Kleimola, Lazzarini, Timoney & Valimaki (SMC 2010):\n// \"Phaseshaping Oscillator Algorithms for Musical Sound Synthesis\" (Sec 2.1, 2.2, 3.2, 3.3).\n// Extracts the instantaneous phase phi(t) in [0, 1) from the tuba via a 4-stage\n// quadrature IIR Hilbert allpass pair, then applies single-oscillator hard sync\n// (mod1 o glin) and soft sync (gtri) with 2-sample PolyBLEP antialiasing.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (prefer sine-ified tuba from 01_harmonic_isolator)\n//   in2: Right Audio Input\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n// Outlets:\n//   out1: Left Phaseshaped Sync Output\n//   out2: Right Phaseshaped Sync Output\n\n@param({ min: 1.0, max: 12.0 }) sync_ratio = 2.5;\n@param({ min: 0.0, max: 1.0 }) soft_hard = 0.7;\n@param({ min: 0.0, max: 1.0 }) wave_sin = 0.5;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n\n// 4-stage IIR Hilbert transform allpass filter states (0 deg and 90 deg branches)\n// Coefficients designed for 90-degree quadrature across 25 Hz - 18 kHz\n@state hReX = new FixedSampleArray(4);\n@state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4);\n@state hImY = new FixedSampleArray(4);\n@state hDelayRe = 0.0;\n\n// Fallback ZC pitch tracker\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothRatio = 2.5;\n\n// PolyBLEP helper function (Paper Eq. 21)\nfunction polyblep(t: number, dt: number): number {\n\tlet corr = 0.0;\n\tlet safeDt = clamp(dt, 0.0001, 0.45);\n\tif (t < safeDt) {\n\t\tlet u = t / safeDt;\n\t\tcorr = u + u - u * u - 1.0;\n\t} else if (t > 1.0 - safeDt) {\n\t\tlet u = (t - 1.0) / safeDt;\n\t\tcorr = u * u + u + u + 1.0;\n\t}\n\treturn corr;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 200.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\n// Exponentially tapered sync ratio feel if desired, or smooth direct ratio\nsmoothRatio += (clamp(sync_ratio, 1.0, 12.0) - smoothRatio) * slew;\n\n// --- 2. Analytic Signal Extraction via Quadrature Allpass Pair ---\n// Allpass coefficients a^2 for 90-deg Hilbert pair\nlet cRe0 = 0.4794008656;\nlet cRe1 = 0.8762184935;\nlet cRe2 = 0.9765975895;\nlet cRe3 = 0.9974992559;\n\nlet cIm0 = 0.1617584983;\nlet cIm1 = 0.7330289323;\nlet cIm2 = 0.9453497003;\nlet cIm3 = 0.9905991567;\n\n// Branch 1 (Real / 0 deg)\nlet sRe = monoLow;\nlet yRe0 = cRe0 * (sRe - hReY[0]) + hReX[0]; hReX[0] = sRe; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe - hReY[1]) + hReX[1]; hReX[1] = sRe; hReY[1] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe - hReY[2]) + hReX[2]; hReX[2] = sRe; hReY[2] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe - hReY[3]) + hReX[3]; hReX[3] = sRe; hReY[3] = yRe3;\nlet outRe = hDelayRe;\nhDelayRe = yRe3;\n\n// Branch 2 (Imag / 90 deg)\nlet sIm = monoLow;\nlet yIm0 = cIm0 * (sIm - hImY[0]) + hImX[0]; hImX[0] = sIm; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm - hImY[1]) + hImX[1]; hImX[1] = sIm; hImY[1] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm - hImY[2]) + hImX[2]; hImX[2] = sIm; hImY[2] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm - hImY[3]) + hImX[3]; hImX[3] = sIm; hImY[3] = yIm3;\nlet outIm = yIm3;\n\n// Instantaneous amplitude A(t) and normalized phasor phi(t) in [0, 1)\nlet pol = cartopol(outRe, outIm);\nlet instAmp = pol[0];\nlet instTheta = pol[1]; // [-pi, pi]\nlet phi = wrap((instTheta + pi) / (2.0 * pi), 0.0, 1.0);\n\n// Stereo phase offset for wide stereo sync image\nlet phiL = phi;\nlet phiR = wrap(phi + 0.04, 0.0, 1.0);\n\n// --- 3. SMC 2010 Eq. (22) & (24): Hard Sync & Soft Sync Phaseshapers ---\nlet a1 = smoothRatio;\nlet Ts = clamp((smoothF0 * a1) / sr, 0.0001, 0.45);\n\n// Hard Sync phase: mod1(a1 * phi) with PolyBLEP at slave & master resets\nlet scaledL = a1 * phiL;\nlet hardPhL = scaledL - floor(scaledL);\nlet hardSawL = (2.0 * hardPhL - 1.0) - polyblep(hardPhL, Ts);\n\nlet scaledR = a1 * phiR;\nlet hardPhR = scaledR - floor(scaledR);\nlet hardSawR = (2.0 * hardPhR - 1.0) - polyblep(hardPhR, Ts);\n\n// Soft Sync phase (Paper Eq. 12 & 24): gtri(phi, a1) = mod1(a1 * abs(2*phi - 1))\nlet triBaseL = abs(2.0 * phiL - 1.0);\nlet softPhL = (a1 * triBaseL) - floor(a1 * triBaseL);\nlet softWaveL = 1.0 - 2.0 * abs(2.0 * softPhL - 1.0);\n\nlet triBaseR = abs(2.0 * phiR - 1.0);\nlet softPhR = (a1 * triBaseR) - floor(a1 * triBaseR);\nlet softWaveR = 1.0 - 2.0 * abs(2.0 * softPhR - 1.0);\n\n// Morph between Soft Sync and Hard Sync\nlet syncGeoL = linearinterp(soft_hard, softWaveL, hardSawL);\nlet syncGeoR = linearinterp(soft_hard, softWaveR, hardSawR);\n\n// Optional sinusoidal terminal waveshaper cos(2*pi*g(phi)) (Paper Eq. 6)\nlet syncPhL = linearinterp(soft_hard, softPhL, hardPhL);\nlet syncPhR = linearinterp(soft_hard, softPhR, hardPhR);\nlet syncSinL = cos(2.0 * pi * syncPhL);\nlet syncSinR = cos(2.0 * pi * syncPhR);\n\nlet shapedL = linearinterp(wave_sin, syncGeoL, syncSinL);\nlet shapedR = linearinterp(wave_sin, syncGeoR, syncSinR);\n\n// Restore player's natural amplitude envelope A(t) with silence gating\nlet envGate = clamp((instAmp - 0.001) * 200.0, 0.0, 1.0);\nlet wetL = shapedL * instAmp * 1.6 * envGate;\nlet wetR = shapedR * instAmp * 1.6 * envGate;\n\nout1 = linearinterp(mix, xL, wetL);\nout2 = linearinterp(mix, xR, wetR);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 3,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 04_hilbert_phasor_sync.txt\n// Unix-Style Effect 4: Analytic Phasor Extractor & PolyBLEP Hard/Soft Sync\n// Implements Kleimola, Lazzarini, Timoney & Valimaki (SMC 2010):\n// \"Phaseshaping Oscillator Algorithms for Musical Sound Synthesis\" (Sec 2.1, 2.2, 3.2, 3.3).\n// Extracts the instantaneous phase phi(t) in [0, 1) from the tuba via a 4-stage\n// quadrature IIR Hilbert allpass pair, then applies single-oscillator hard sync\n// (mod1 o glin) and soft sync (gtri) with 2-sample PolyBLEP antialiasing.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (prefer sine-ified tuba from 01_harmonic_isolator)\n//   in2: Right Audio Input\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n// Outlets:\n//   out1: Left Phaseshaped Sync Output\n//   out2: Right Phaseshaped Sync Output\n\n@param({ min: 1.0, max: 12.0 }) sync_ratio = 2.5;\n@param({ min: 0.0, max: 1.0 }) soft_hard = 0.7;\n@param({ min: 0.0, max: 1.0 }) wave_sin = 0.5;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n\n// 4-stage IIR Hilbert transform allpass filter states (0 deg and 90 deg branches)\n// Coefficients designed for 90-degree quadrature across 25 Hz - 18 kHz\n@state hReX = new FixedSampleArray(4);\n@state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4);\n@state hImY = new FixedSampleArray(4);\n@state hDelayRe = 0.0;\n\n// Fallback ZC pitch tracker\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothRatio = 2.5;\n\n// PolyBLEP helper function (Paper Eq. 21)\nfunction polyblep(t: number, dt: number): number {\n\tlet corr = 0.0;\n\tlet safeDt = clamp(dt, 0.0001, 0.45);\n\tif (t < safeDt) {\n\t\tlet u = t / safeDt;\n\t\tcorr = u + u - u * u - 1.0;\n\t} else if (t > 1.0 - safeDt) {\n\t\tlet u = (t - 1.0) / safeDt;\n\t\tcorr = u * u + u + u + 1.0;\n\t}\n\treturn corr;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 200.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\n// Exponentially tapered sync ratio feel if desired, or smooth direct ratio\nsmoothRatio += (clamp(sync_ratio, 1.0, 12.0) - smoothRatio) * slew;\n\n// --- 2. Analytic Signal Extraction via Quadrature Allpass Pair ---\n// Allpass coefficients a^2 for 90-deg Hilbert pair\nlet cRe0 = 0.4794008656;\nlet cRe1 = 0.8762184935;\nlet cRe2 = 0.9765975895;\nlet cRe3 = 0.9974992559;\n\nlet cIm0 = 0.1617584983;\nlet cIm1 = 0.7330289323;\nlet cIm2 = 0.9453497003;\nlet cIm3 = 0.9905991567;\n\n// Branch 1 (Real / 0 deg)\nlet sRe = monoLow;\nlet yRe0 = cRe0 * (sRe - hReY[0]) + hReX[0]; hReX[0] = sRe; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe - hReY[1]) + hReX[1]; hReX[1] = sRe; hReY[1] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe - hReY[2]) + hReX[2]; hReX[2] = sRe; hReY[2] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe - hReY[3]) + hReX[3]; hReX[3] = sRe; hReY[3] = yRe3;\nlet outRe = hDelayRe;\nhDelayRe = yRe3;\n\n// Branch 2 (Imag / 90 deg)\nlet sIm = monoLow;\nlet yIm0 = cIm0 * (sIm - hImY[0]) + hImX[0]; hImX[0] = sIm; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm - hImY[1]) + hImX[1]; hImX[1] = sIm; hImY[1] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm - hImY[2]) + hImX[2]; hImX[2] = sIm; hImY[2] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm - hImY[3]) + hImX[3]; hImX[3] = sIm; hImY[3] = yIm3;\nlet outIm = yIm3;\n\n// Instantaneous amplitude A(t) and normalized phasor phi(t) in [0, 1)\nlet pol = cartopol(outRe, outIm);\nlet instAmp = pol[0];\nlet instTheta = pol[1]; // [-pi, pi]\nlet phi = wrap((instTheta + pi) / (2.0 * pi), 0.0, 1.0);\n\n// Stereo phase offset for wide stereo sync image\nlet phiL = phi;\nlet phiR = wrap(phi + 0.04, 0.0, 1.0);\n\n// --- 3. SMC 2010 Eq. (22) & (24): Hard Sync & Soft Sync Phaseshapers ---\nlet a1 = smoothRatio;\nlet Ts = clamp((smoothF0 * a1) / sr, 0.0001, 0.45);\n\n// Hard Sync phase: mod1(a1 * phi) with PolyBLEP at slave & master resets\nlet scaledL = a1 * phiL;\nlet hardPhL = scaledL - floor(scaledL);\nlet hardSawL = (2.0 * hardPhL - 1.0) - polyblep(hardPhL, Ts);\n\nlet scaledR = a1 * phiR;\nlet hardPhR = scaledR - floor(scaledR);\nlet hardSawR = (2.0 * hardPhR - 1.0) - polyblep(hardPhR, Ts);\n\n// Soft Sync phase (Paper Eq. 12 & 24): gtri(phi, a1) = mod1(a1 * abs(2*phi - 1))\nlet triBaseL = abs(2.0 * phiL - 1.0);\nlet softPhL = (a1 * triBaseL) - floor(a1 * triBaseL);\nlet softWaveL = 1.0 - 2.0 * abs(2.0 * softPhL - 1.0);\n\nlet triBaseR = abs(2.0 * phiR - 1.0);\nlet softPhR = (a1 * triBaseR) - floor(a1 * triBaseR);\nlet softWaveR = 1.0 - 2.0 * abs(2.0 * softPhR - 1.0);\n\n// Morph between Soft Sync and Hard Sync\nlet syncGeoL = linearinterp(soft_hard, softWaveL, hardSawL);\nlet syncGeoR = linearinterp(soft_hard, softWaveR, hardSawR);\n\n// Optional sinusoidal terminal waveshaper cos(2*pi*g(phi)) (Paper Eq. 6)\nlet syncPhL = linearinterp(soft_hard, softPhL, hardPhL);\nlet syncPhR = linearinterp(soft_hard, softPhR, hardPhR);\nlet syncSinL = cos(2.0 * pi * syncPhL);\nlet syncSinR = cos(2.0 * pi * syncPhR);\n\nlet shapedL = linearinterp(wave_sin, syncGeoL, syncSinL);\nlet shapedR = linearinterp(wave_sin, syncGeoR, syncSinR);\n\n// Restore player's natural amplitude envelope A(t) with silence gating\nlet envGate = clamp((instAmp - 0.001) * 200.0, 0.0, 1.0);\nlet wetL = shapedL * instAmp * 1.6 * envGate;\nlet wetR = shapedR * instAmp * 1.6 * envGate;\n\nout1 = linearinterp(mix, xL, wetL);\nout2 = linearinterp(mix, xR, wetR);\n",
