                                    "rnbo_uniqueid": "dcblock~_obj-61",
                                    "text": "dcblock~"
                                }
                            },
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 18_inst_harmonic_cannon_polybass.txt\n// Advanced Instrument 6: Multiband Harmonic Cannon & Coefficient-Modulated Polybass\n// Combines:\n//   - Pitch-Tracked Multiband Harmonic Splitter (Approach 6: splits at 1.5*f0 & 3.5*f0)\n//   - Band 1 (Fundamental < 1.5*f0): Phase-Divided Sub-Octave + Clean Sine Foundation\n//   - Band 2 (Low-Mids 1.5*f0..3.5*f0): ICASSP 2009 Coefficient-Modulated Allpass PD\n//     + Chebyshev Polynomial Harmonic Generator (Pafnuty2 / Focus concept)\n//   - Band 3 (High Harmonics > 3.5*f0): Pitch-Tracked Stereo Metallic Comb + Bode Detune\n//   - 1-Bar Phasor-Synced Vowel Formant Filter + Joystick X/Y Performance Control\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs multiband formant motion)\n// Outlets:\n//   out1: Left Multiband Harmonic Cannon Output\n//   out2: Right Multiband Harmonic Cannon Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_vowel_tilt = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_multidrive = 0.2;\n@param({ min: 0.0, max: 1.0 }) sub_foundation = 0.8;\n@param({ min: 0.0, max: 1.0 }) mid_allpass_pd = 0.75;\n@param({ min: 0.0, max: 1.0 }) high_comb_metal = 0.65;\n@param({ min: 1.0, max: 16.0, steps: 16 }) motion_subdiv = 4.0;\n@param({ min: 0.0, max: 1.0 }) motion_depth = 0.55;\n@param({ min: 0.0, max: 1.0 }) stereo_spread = 0.5;\n\n// Pitch-tracked crossover SVFs (split at 1.5*f0 and 3.5*f0)\n@state xover1L = new svf(); @state xover1R = new svf();\n@state xover2L = new svf(); @state xover2R = new svf();\n\n// Formant sculpting SVFs on the mid/high bands\n@state formSvfL1 = new svf(); @state formSvfR1 = new svf();\n@state formSvfL2 = new svf(); @state formSvfR2 = new svf();\n\n// Band 2: Coefficient-modulated allpass states (ICASSP 2009)\n@state pdPhasor = new phasor();\n@state apX1L = 0.0; @state apY1L = 0.0;\n@state apX2L = 0.0; @state apY2L = 0.0;\n@state apX1R = 0.0; @state apY1R = 0.0;\n@state apX2R = 0.0; @state apY2R = 0.0;\n\n// Band 3: High-band stereo metallic comb buffer (2048 samples)\n@state hiCombL = new FixedSampleArray(2048);\n@state hiCombR = new FixedSampleArray(2048);\n@state hiWrite: Int = 0;\n\n// Sub-octave zero-crossing flip-flop locked to Band 1 fundamental\n@state prevBand1 = 0.0;\n@state subFlip = 1.0;\n@state subLp = new onepole();\n\n// Pitch & Phasor states\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.2;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch & Joystick Conditioning ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nsmoothJoyX += (clamp(joy_x_vowel_tilt, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_multidrive, -1.0, 1.0) - smoothJoyY) * slew;\n\nlet f0 = clamp(smoothF0, 24.0, 800.0);\nlet joyY_u = 0.5 * (smoothJoyY + 1.0);\n\n// --- 2. Pitch-Tracked Harmonic Band Splitting (1.5 * f0 and 3.5 * f0) ---\nlet split1Hz = clamp(f0 * 1.5, 36.0, 1500.0);\nlet split2Hz = clamp(f0 * 3.5, 84.0, 4500.0);\n\nlet sp1L = xover1L.next(xL, split1Hz, 0.55);\nlet sp1R = xover1R.next(xR, split1Hz, 0.55);\nlet band1L = sp1L[0]; // Fundamental only (< 1.5*f0)\nlet band1R = sp1R[0];\n\nlet sp2L = xover2L.next(sp1L[1], split2Hz, 0.55);\nlet sp2R = xover2R.next(sp1R[1], split2Hz, 0.55);\nlet band2L = sp2L[0]; // Harmonics 2 & 3 (1.5*f0 .. 3.5*f0)\nlet band2R = sp2R[0];\nlet band3L = sp2L[1]; // Upper Harmonics (> 3.5*f0)\nlet band3R = sp2R[1];\n\n// --- 3. Band 1: Fundamental + Locked Sub-Octave Foundation ---\nlet monoB1 = 0.5 * (band1L + band1R);\nif (prevBand1 <= 0.0 && monoB1 > 0.0) {\n\tsubFlip = -subFlip;\n}\nprevBand1 = monoB1;\nlet subSine = subLp.next(subFlip * abs(monoB1) * 1.6, f0 * 0.65);\nlet subGain = pow(clamp(sub_foundation, 0.0, 1.0), 1.2);\nlet outB1L = tanh(band1L * 1.4 + subSine * subGain * 1.5);\nlet outB1R = tanh(band1R * 1.4 + subSine * subGain * 1.5);\n\n// --- 4. Band 2: Coefficient-Modulated Allpass PD + Chebyshev T3/T5 ---\nlet pdAmt = clamp(mid_allpass_pd, 0.0, 1.0) * (0.5 + 0.5 * joyY_u);\nlet phPd = pdPhasor.next(f0);\nlet P = 0.22;\nlet sawPd = (phPd < P) ? (phPd / P) : (1.0 - (phPd - P) / (1.0 - P));\nlet mCoef = clamp(0.15 + 0.78 * pdAmt * (0.5 + 0.5 * tanh(2.2 * sawPd - 1.1)), 0.02, 0.95);\n\nlet ap1L = -mCoef * band2L + apX1L + mCoef * apY1L; apX1L = band2L; apY1L = ap1L;\nlet ap2L = -mCoef * ap1L + apX2L + mCoef * apY2L; apX2L = ap1L; apY2L = ap2L;\n\nlet ap1R = -mCoef * band2R + apX1R + mCoef * apY1R; apX1R = band2R; apY1R = ap1R;\nlet ap2R = -mCoef * ap1R + apX2R + mCoef * apY2R; apX2R = ap1R; apY2R = ap2R;\n\n// Drive Band 2 through Chebyshev T2 + T3 + T5 harmonic shaper\nlet u2L = tanh(ap2L * (1.8 + 4.5 * joyY_u));\nlet u2R = tanh(ap2R * (1.8 + 4.5 * joyY_u));\nlet u2L2 = u2L * u2L; let u2L3 = u2L2 * u2L; let u2L5 = u2L3 * u2L2;\nlet u2R2 = u2R * u2R; let u2R3 = u2R2 * u2R; let u2R5 = u2R3 * u2R2;\n\nlet outB2L = 0.5 * u2L + 0.25 * (2.0 * u2L2 - 1.0) + 0.35 * (4.0 * u2L3 - 3.0 * u2L) + 0.2 * (16.0 * u2L5 - 20.0 * u2L3 + 5.0 * u2L);\nlet outB2R = 0.5 * u2R - 0.25 * (2.0 * u2R2 - 1.0) + 0.35 * (4.0 * u2R3 - 3.0 * u2R) + 0.2 * (16.0 * u2R5 - 20.0 * u2R3 + 5.0 * u2R);\n\n// --- 5. Band 3: High-Harmonic Pitch-Tracked Stereo Metallic Comb ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet mSub = floor(clamp(motion_subdiv, 1.0, 16.0));\nlet motPh = wrap(barPh * mSub, 0.0, 1.0);\nlet motLfo = triangle(motPh, 0.3);\n\nlet spr = clamp(stereo_spread, 0.0, 1.0) * 0.25;\nlet combHz = clamp(f0 * 4.0 * pow(2.0, 0.8 * smoothJoyX + clamp(motion_depth, 0.0, 1.0) * motLfo), 80.0, 5000.0);\nlet delSampsL = clamp(sr / (combHz * (1.0 - spr)), 3.0, 2040.0);\nlet delSampsR = clamp(sr / (combHz * (1.0 + spr)), 3.0, 2040.0);\n\nlet rL = hiWrite - delSampsL; while (rL < 0.0) { rL += 2048.0; }\nlet iL: Int = floor(rL);\nlet cL = linearinterp(rL - iL, hiCombL[iL % 2048], hiCombL[(iL + 1) % 2048]);\n\nlet rR = hiWrite - delSampsR; while (rR < 0.0) { rR += 2048.0; }\nlet iR: Int = floor(rR);\nlet cR = linearinterp(rR - iR, hiCombR[iR % 2048], hiCombR[(iR + 1) % 2048]);\n\nlet cFb = clamp(high_comb_metal, 0.0, 1.0) * 0.88;\nhiCombL[hiWrite] = tanh(band3L * (1.5 + 3.0 * joyY_u) + cFb * cL);\nhiCombR[hiWrite] = tanh(band3R * (1.5 + 3.0 * joyY_u) + cFb * cR);\nhiWrite = (hiWrite + 1) % 2048;\n\nlet outB3L = band3L + cFb * cL;\nlet outB3R = band3R + cFb * cR;\n\n// --- 6. Dual Formant Filter Sculpting & Multiband Recombination ---\n// Vowel formant frequencies swept by Joystick X + 1-bar rhythmic LFO\nlet formMod = clamp(0.5 + 0.4 * smoothJoyX + 0.35 * clamp(motion_depth, 0.0, 1.0) * (motLfo - 0.5), 0.0, 1.0);\nlet f1Hz = 240.0 * pow(3.8, formMod);\nlet f2Hz = 750.0 * pow(3.5, 1.0 - 0.6 * formMod + 0.4 * smoothJoyY);\n\nlet midHiL = outB2L * 0.75 + outB3L * 0.85;\nlet midHiR = outB2R * 0.75 + outB3R * 0.85;\n\nlet v1L = formSvfL1.next(midHiL, f1Hz, 0.78);\nlet v1R = formSvfR1.next(midHiR, f1Hz * (1.0 + 0.1 * spr), 0.78);\nlet v2L = formSvfL2.next(midHiL, f2Hz, 0.82);\nlet v2R = formSvfR2.next(midHiR, f2Hz * (1.0 - 0.1 * spr), 0.82);\n\n// Blend direct multiband grit with dual vowel bandpass formants\nlet sculptedMidHiL = 0.45 * v1L[0] + 0.65 * (v1L[2] + v2L[2]);\nlet sculptedMidHiR = 0.45 * v1R[0] + 0.65 * (v1R[2] + v2R[2]);\n\nout1 = tanh(outB1L * 0.9 + sculptedMidHiL * 1.1);\nout2 = tanh(outB1R * 0.9 + sculptedMidHiR * 1.1);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 18_inst_harmonic_cannon_polybass.txt\n// Advanced Instrument 6: Multiband Harmonic Cannon & Coefficient-Modulated Polybass\n// Combines:\n//   - Pitch-Tracked Multiband Harmonic Splitter (Approach 6: splits at 1.5*f0 & 3.5*f0)\n//   - Band 1 (Fundamental < 1.5*f0): Phase-Divided Sub-Octave + Clean Sine Foundation\n//   - Band 2 (Low-Mids 1.5*f0..3.5*f0): ICASSP 2009 Coefficient-Modulated Allpass PD\n//     + Chebyshev Polynomial Harmonic Generator (Pafnuty2 / Focus concept)\n//   - Band 3 (High Harmonics > 3.5*f0): Pitch-Tracked Stereo Metallic Comb + Bode Detune\n//   - 1-Bar Phasor-Synced Vowel Formant Filter + Joystick X/Y Performance Control\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs multiband formant motion)\n// Outlets:\n//   out1: Left Multiband Harmonic Cannon Output\n//   out2: Right Multiband Harmonic Cannon Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_vowel_tilt = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_multidrive = 0.2;\n@param({ min: 0.0, max: 1.0 }) sub_foundation = 0.8;\n@param({ min: 0.0, max: 1.0 }) mid_allpass_pd = 0.75;\n@param({ min: 0.0, max: 1.0 }) high_comb_metal = 0.65;\n@param({ min: 1.0, max: 16.0, steps: 16 }) motion_subdiv = 4.0;\n@param({ min: 0.0, max: 1.0 }) motion_depth = 0.55;\n@param({ min: 0.0, max: 1.0 }) stereo_spread = 0.5;\n\n// Pitch-tracked crossover SVFs (split at 1.5*f0 and 3.5*f0)\n@state xover1L = new svf(); @state xover1R = new svf();\n@state xover2L = new svf(); @state xover2R = new svf();\n\n// Formant sculpting SVFs on the mid/high bands\n@state formSvfL1 = new svf(); @state formSvfR1 = new svf();\n@state formSvfL2 = new svf(); @state formSvfR2 = new svf();\n\n// Band 2: Coefficient-modulated allpass states (ICASSP 2009)\n@state pdPhasor = new phasor();\n@state apX1L = 0.0; @state apY1L = 0.0;\n@state apX2L = 0.0; @state apY2L = 0.0;\n@state apX1R = 0.0; @state apY1R = 0.0;\n@state apX2R = 0.0; @state apY2R = 0.0;\n\n// Band 3: High-band stereo metallic comb buffer (2048 samples)\n@state hiCombL = new FixedSampleArray(2048);\n@state hiCombR = new FixedSampleArray(2048);\n@state hiWrite: Int = 0;\n\n// Sub-octave zero-crossing flip-flop locked to Band 1 fundamental\n@state prevBand1 = 0.0;\n@state subFlip = 1.0;\n@state subLp = new onepole();\n\n// Pitch & Phasor states\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.2;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch & Joystick Conditioning ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nsmoothJoyX += (clamp(joy_x_vowel_tilt, -1.0, 1.0) - smoothJoyX) * slew;\nsmoothJoyY += (clamp(joy_y_multidrive, -1.0, 1.0) - smoothJoyY) * slew;\n\nlet f0 = clamp(smoothF0, 24.0, 800.0);\nlet joyY_u = 0.5 * (smoothJoyY + 1.0);\n\n// --- 2. Pitch-Tracked Harmonic Band Splitting (1.5 * f0 and 3.5 * f0) ---\nlet split1Hz = clamp(f0 * 1.5, 36.0, 1500.0);\nlet split2Hz = clamp(f0 * 3.5, 84.0, 4500.0);\n\nlet sp1L = xover1L.next(xL, split1Hz, 0.55);\nlet sp1R = xover1R.next(xR, split1Hz, 0.55);\nlet band1L = sp1L[0]; // Fundamental only (< 1.5*f0)\nlet band1R = sp1R[0];\n\nlet sp2L = xover2L.next(sp1L[1], split2Hz, 0.55);\nlet sp2R = xover2R.next(sp1R[1], split2Hz, 0.55);\nlet band2L = sp2L[0]; // Harmonics 2 & 3 (1.5*f0 .. 3.5*f0)\nlet band2R = sp2R[0];\nlet band3L = sp2L[1]; // Upper Harmonics (> 3.5*f0)\nlet band3R = sp2R[1];\n\n// --- 3. Band 1: Fundamental + Locked Sub-Octave Foundation ---\nlet monoB1 = 0.5 * (band1L + band1R);\nif (prevBand1 <= 0.0 && monoB1 > 0.0) {\n\tsubFlip = -subFlip;\n}\nprevBand1 = monoB1;\nlet subSine = subLp.next(subFlip * abs(monoB1) * 1.6, f0 * 0.65);\nlet subGain = pow(clamp(sub_foundation, 0.0, 1.0), 1.2);\nlet outB1L = tanh(band1L * 1.4 + subSine * subGain * 1.5);\nlet outB1R = tanh(band1R * 1.4 + subSine * subGain * 1.5);\n\n// --- 4. Band 2: Coefficient-Modulated Allpass PD + Chebyshev T3/T5 ---\nlet pdAmt = clamp(mid_allpass_pd, 0.0, 1.0) * (0.5 + 0.5 * joyY_u);\nlet phPd = pdPhasor.next(f0);\nlet P = 0.22;\nlet sawPd = (phPd < P) ? (phPd / P) : (1.0 - (phPd - P) / (1.0 - P));\nlet mCoef = clamp(0.15 + 0.78 * pdAmt * (0.5 + 0.5 * tanh(2.2 * sawPd - 1.1)), 0.02, 0.95);\n\nlet ap1L = -mCoef * band2L + apX1L + mCoef * apY1L; apX1L = band2L; apY1L = ap1L;\nlet ap2L = -mCoef * ap1L + apX2L + mCoef * apY2L; apX2L = ap1L; apY2L = ap2L;\n\nlet ap1R = -mCoef * band2R + apX1R + mCoef * apY1R; apX1R = band2R; apY1R = ap1R;\nlet ap2R = -mCoef * ap1R + apX2R + mCoef * apY2R; apX2R = ap1R; apY2R = ap2R;\n\n// Drive Band 2 through Chebyshev T2 + T3 + T5 harmonic shaper\nlet u2L = tanh(ap2L * (1.8 + 4.5 * joyY_u));\nlet u2R = tanh(ap2R * (1.8 + 4.5 * joyY_u));\nlet u2L2 = u2L * u2L; let u2L3 = u2L2 * u2L; let u2L5 = u2L3 * u2L2;\nlet u2R2 = u2R * u2R; let u2R3 = u2R2 * u2R; let u2R5 = u2R3 * u2R2;\n\nlet outB2L = 0.5 * u2L + 0.25 * (2.0 * u2L2 - 1.0) + 0.35 * (4.0 * u2L3 - 3.0 * u2L) + 0.2 * (16.0 * u2L5 - 20.0 * u2L3 + 5.0 * u2L);\nlet outB2R = 0.5 * u2R - 0.25 * (2.0 * u2R2 - 1.0) + 0.35 * (4.0 * u2R3 - 3.0 * u2R) + 0.2 * (16.0 * u2R5 - 20.0 * u2R3 + 5.0 * u2R);\n\n// --- 5. Band 3: High-Harmonic Pitch-Tracked Stereo Metallic Comb ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet mSub = floor(clamp(motion_subdiv, 1.0, 16.0));\nlet motPh = wrap(barPh * mSub, 0.0, 1.0);\nlet motLfo = triangle(motPh, 0.3);\n\nlet spr = clamp(stereo_spread, 0.0, 1.0) * 0.25;\nlet combHz = clamp(f0 * 4.0 * pow(2.0, 0.8 * smoothJoyX + clamp(motion_depth, 0.0, 1.0) * motLfo), 80.0, 5000.0);\nlet delSampsL = clamp(sr / (combHz * (1.0 - spr)), 3.0, 2040.0);\nlet delSampsR = clamp(sr / (combHz * (1.0 + spr)), 3.0, 2040.0);\n\nlet rL = hiWrite - delSampsL; while (rL < 0.0) { rL += 2048.0; }\nlet iL: Int = floor(rL);\nlet cL = linearinterp(rL - iL, hiCombL[iL % 2048], hiCombL[(iL + 1) % 2048]);\n\nlet rR = hiWrite - delSampsR; while (rR < 0.0) { rR += 2048.0; }\nlet iR: Int = floor(rR);\nlet cR = linearinterp(rR - iR, hiCombR[iR % 2048], hiCombR[(iR + 1) % 2048]);\n\nlet cFb = clamp(high_comb_metal, 0.0, 1.0) * 0.88;\nhiCombL[hiWrite] = tanh(band3L * (1.5 + 3.0 * joyY_u) + cFb * cL);\nhiCombR[hiWrite] = tanh(band3R * (1.5 + 3.0 * joyY_u) + cFb * cR);\nhiWrite = (hiWrite + 1) % 2048;\n\nlet outB3L = band3L + cFb * cL;\nlet outB3R = band3R + cFb * cR;\n\n// --- 6. Dual Formant Filter Sculpting & Multiband Recombination ---\n// Vowel formant frequencies swept by Joystick X + 1-bar rhythmic LFO\nlet formMod = clamp(0.5 + 0.4 * smoothJoyX + 0.35 * clamp(motion_depth, 0.0, 1.0) * (motLfo - 0.5), 0.0, 1.0);\nlet f1Hz = 240.0 * pow(3.8, formMod);\nlet f2Hz = 750.0 * pow(3.5, 1.0 - 0.6 * formMod + 0.4 * smoothJoyY);\n\nlet midHiL = outB2L * 0.75 + outB3L * 0.85;\nlet midHiR = outB2R * 0.75 + outB3R * 0.85;\n\nlet v1L = formSvfL1.next(midHiL, f1Hz, 0.78);\nlet v1R = formSvfR1.next(midHiR, f1Hz * (1.0 + 0.1 * spr), 0.78);\nlet v2L = formSvfL2.next(midHiL, f2Hz, 0.82);\nlet v2R = formSvfR2.next(midHiR, f2Hz * (1.0 - 0.1 * spr), 0.82);\n\n// Blend direct multiband grit with dual vowel bandpass formants\nlet sculptedMidHiL = 0.45 * v1L[0] + 0.65 * (v1L[2] + v2L[2]);\nlet sculptedMidHiR = 0.45 * v1R[0] + 0.65 * (v1R[2] + v2R[2]);\n\nout1 = tanh(outB1L * 0.9 + sculptedMidHiL * 1.1);\nout2 = tanh(outB1R * 0.9 + sculptedMidHiR * 1.1);\n",
                                        "expr": ""
