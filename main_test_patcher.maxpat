                    },
                    "outlettype": [ "signal", "signal", "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 84.0, 131.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 00b_tuba_transient_valve_detector.txt\n// Tuba Tongue-Attack & Valve-Click Transient Detector + Transition Freeze Engine\n// ============================================================================\n// Designed specifically for live amplified/effected tuba dubstep & riddim:\n//   1. Dual-Band Spectral Flux & Teager-Kaiser Energy Operator (TKEO):\n//      - Band A (Tongue / Lip Attack, 80 Hz - 900 Hz): Detects the explosive\n//        low-mid pressure wavefront (\"tah\" / \"dah\" / slap-tongue) using\n//        log-ratio fast/slow differential envelope + TKEO (psi[x] = x[n-1]^2 - x[n]*x[n-2]).\n//      - Band B (Valve Click / Air Chuff, 1.8 kHz - 9 kHz): Detects mechanical\n//        piston/rotary clacks and unpitched breath bursts where high-frequency\n//        energy spikes while low-end periodicity drops.\n//   2. Outputs 4 performance control signals at audio rate:\n//      - out1: Combined Trigger Impulse (1.0 spike for 2 ms on every tongue/attack)\n//      - out2: Shaped Dubstep Synth Attack-Decay Envelope [0.0 .. 1.0] (for whipping\n//              filter cutoffs, FM indices, or allpass dispersion on every tongue hit)\n//      - out3: Pitch-Freeze / Transition Gate (1.0 during messy valve transitions or\n//              unpitched attacks so downstream pitch trackers hold steady)\n//      - out4: Isolated Valve-Click Trigger Impulse (1.0 spike specifically on mechanical\n//              valve/chuff transients for triggering percussion/glitch layers)\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba; mono in1 supported automatically)\n//   in3: Optional Pitch Confidence [0..1] (from out2 of 00_tuba_sift_yin_tracker)\n// Outlets:\n//   out1: Master Tongue/Attack Trigger Pulse [0 or 1]\n//   out2: Dubstep Mod Envelope [0.0 .. 1.0]\n//   out3: Transition Freeze Gate [0 or 1] (1 = freeze pitch during transition/click)\n//   out4: Valve-Click / Air-Chuff Specific Trigger [0 or 1]\n\n@param({ min: 0.0, max: 1.0 }) sensitivity = 0.65;\n@param({ min: 15.0, max: 1500.0 }) env_decay_ms = 220.0;\n@param({ min: 5.0, max: 150.0 }) freeze_hold_ms = 35.0;\n@param({ min: -1.0, max: 1.0 }) env_curve = -0.35;\n\n// Band-splitting filters: Tongue body (SVF bandpass ~280 Hz) vs Valve click (SVF highpass ~2200 Hz)\n@state svfTongue = new svf();\n@state svfValve1 = new svf();\n@state svfValve2 = new svf();\n\n// TKEO (Teager-Kaiser Energy Operator) 2-sample delay history for instantaneous wavefront detection\n@state tkT1 = 0.0; @state tkT2 = 0.0;\n@state tkV1 = 0.0; @state tkV2 = 0.0;\n\n// Dual-speed Differential Envelope Followers (Fast attack vs Slow baseline reference)\n@state fastTongue = 0.0;\n@state slowTongue = 0.0;\n@state fastValve = 0.0;\n@state slowValve = 0.0;\n\n// Trigger hold, refractory lockout (debounce), Freeze timer, and Dubstep Envelope state\n@state lockoutSamps = 0.0;\n@state trigPulseSamps = 0.0;\n@state valvePulseSamps = 0.0;\n@state freezeSamps = 0.0;\n@state modEnvPhase = 1.0;\n@state peakVel = 1.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet confIn = in3;\n\nlet mono = (abs(xR) > 0.0000001) ? (0.5 * (xL + xR)) : xL;\n\n// ============================================================================\n// 1. SPECTRAL SEPARATION: TONGUE WAVEFRONT vs. MECHANICAL VALVE CLICK\n// ============================================================================\n// Tongue Band: Bandpass centered at 260 Hz (captures fundamental + 2nd/3rd harmonic \"tah\" punch)\nlet tongueSig = svfTongue.next(mono, 260.0, 0.55)[2];\n\n// Valve / Chuff Band: 2-stage Highpass at 2200 Hz (captures piston/rotor clack & lip burst)\nlet hp1 = svfValve1.next(mono, 2200.0, 0.707)[1];\nlet valveSig = svfValve2.next(hp1, 2200.0, 0.707)[1];\n\n// ============================================================================\n// 2. TEAGER-KAISER ENERGY OPERATOR: psi(x[n]) = x[n-1]^2 - x[n]*x[n-2]\n// Responds in 3 samples to sudden changes in both amplitude AND frequency!\n// ============================================================================\nlet tkeoTongue = abs(tkT1 * tkT1 - tongueSig * tkT2);\ntkT2 = tkT1;\ntkT1 = tongueSig;\n\nlet tkeoValve = abs(tkV1 * tkV1 - valveSig * tkV2);\ntkV2 = tkV1;\ntkV1 = valveSig;\n\nlet energyTongue = abs(tongueSig) + 2.5 * sqrt(tkeoTongue);\nlet energyValve = abs(valveSig) * 3.0 + 4.0 * sqrt(tkeoValve);\n\n// ============================================================================\n// 3. DIFFERENTIAL FAST / SLOW ENVELOPE RATIO (ONSET FLUX)\n// ============================================================================\nlet cFastT = 1.0 - exp(-1.0 / (0.0012 * sr)); // 1.2 ms fast attack\nlet cSlowT = 1.0 - exp(-1.0 / (0.045 * sr));  // 45 ms adaptive baseline\nfastTongue += (energyTongue - fastTongue) * cFastT;\nslowTongue += (energyTongue - slowTongue) * cSlowT;\n\nlet cFastV = 1.0 - exp(-1.0 / (0.0005 * sr)); // 0.5 ms ultra-fast click capture\nlet cSlowV = 1.0 - exp(-1.0 / (0.030 * sr));  // 30 ms baseline\nfastValve += (energyValve - fastValve) * cFastV;\nslowValve += (energyValve - slowValve) * cSlowV;\n\n// Normalized onset ratios\nlet fluxTongue = (fastTongue - slowTongue) / (slowTongue + 0.002);\nlet fluxValve = (fastValve - slowValve) / (slowValve + 0.0008);\n\n// Sensitivity taper: maps [0..1] to threshold in [3.2 .. 0.35]\nlet sens = clamp(sensitivity, 0.0, 1.0);\nlet threshTongue = 3.2 * pow(0.11, pow(sens, 1.2));\nlet threshValve = threshTongue * 1.15;\n\n// ============================================================================\n// 4. TRANSIENT CLASSIFICATION, DEBOUNCE & PITCH-FREEZE TIMER\n// ============================================================================\nif (lockoutSamps > 0.0) {\n\tlockoutSamps -= 1.0;\n}\n\nlet isTongueHit = (fluxTongue > threshTongue && fastTongue > 0.004 && lockoutSamps <= 0.0);\nlet isValveHit = (fluxValve > threshValve && fastValve > 0.0015 && lockoutSamps <= 0.0);\n\nlet pulseLen = mstosamps(2.5); // 2.5 ms trigger pulse width for downstream RNBO objects\nlet refLock = mstosamps(28.0); // 28 ms refractory debounce period\n\nif (isTongueHit || isValveHit) {\n\ttrigPulseSamps = pulseLen;\n\tlockoutSamps = refLock;\n\tmodEnvPhase = 0.0; // Reset dubstep attack-decay envelope\n\tpeakVel = clamp(0.4 + 0.6 * sqrt(fastTongue * 8.0 + fastValve * 4.0), 0.35, 1.0);\n\t// Start transition pitch-freeze timer\n\tfreezeSamps = mstosamps(clamp(freeze_hold_ms, 5.0, 150.0));\n\tif (isValveHit && fluxValve > fluxTongue * 0.9) {\n\t\tvalvePulseSamps = pulseLen;\n\t}\n}\n\n// ============================================================================\n// 5. DUBSTEP SYNTH ENVELOPE GENERATOR & TRANSITION FREEZE OUTPUTS\n// ============================================================================\nlet trigOut = 0.0;\nif (trigPulseSamps > 0.0) {\n\ttrigPulseSamps -= 1.0;\n\ttrigOut = 1.0;\n}\n\nlet valveOut = 0.0;\nif (valvePulseSamps > 0.0) {\n\tvalvePulseSamps -= 1.0;\n\tvalveOut = 1.0;\n}\n\n// Also hold freeze gate high if external tracker confidence (in3) drops during slurs\nlet confFreeze = (confIn > 0.0001 && confIn < 0.45) ? 1.0 : 0.0;\nlet freezeOut = confFreeze;\nif (freezeSamps > 0.0) {\n\tfreezeSamps -= 1.0;\n\tfreezeOut = 1.0;\n}\n\n// Advance Attack-Decay Dubstep Mod Envelope (1.5 ms punch attack + curved decay)\nlet decSamples = maximum(mstosamps(clamp(env_decay_ms, 15.0, 1500.0)), 10.0);\nmodEnvPhase = clamp(modEnvPhase + 1.0 / decSamples, 0.0, 1.0);\n\n// Shape decay curve with env_curve (-1.0 = snappy whip, 0.0 = linear, +1.0 = convex sustain)\nlet cExp = pow(3.0, -clamp(env_curve, -1.0, 1.0));\nlet envVal = pow(1.0 - modEnvPhase, cExp) * peakVel;\n\nout1 = trigOut;\nout2 = envVal;\nout3 = freezeOut;\nout4 = valveOut;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 3,
                                    "numoutlets": 4,
                                    "outlettype": [ "signal", "signal", "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 00b_tuba_transient_valve_detector.txt\n// Tuba Tongue-Attack & Valve-Click Transient Detector + Transition Freeze Engine\n// ============================================================================\n// Designed specifically for live amplified/effected tuba dubstep & riddim:\n//   1. Dual-Band Spectral Flux & Teager-Kaiser Energy Operator (TKEO):\n//      - Band A (Tongue / Lip Attack, 80 Hz - 900 Hz): Detects the explosive\n//        low-mid pressure wavefront (\"tah\" / \"dah\" / slap-tongue) using\n//        log-ratio fast/slow differential envelope + TKEO (psi[x] = x[n-1]^2 - x[n]*x[n-2]).\n//      - Band B (Valve Click / Air Chuff, 1.8 kHz - 9 kHz): Detects mechanical\n//        piston/rotary clacks and unpitched breath bursts where high-frequency\n//        energy spikes while low-end periodicity drops.\n//   2. Outputs 4 performance control signals at audio rate:\n//      - out1: Combined Trigger Impulse (1.0 spike for 2 ms on every tongue/attack)\n//      - out2: Shaped Dubstep Synth Attack-Decay Envelope [0.0 .. 1.0] (for whipping\n//              filter cutoffs, FM indices, or allpass dispersion on every tongue hit)\n//      - out3: Pitch-Freeze / Transition Gate (1.0 during messy valve transitions or\n//              unpitched attacks so downstream pitch trackers hold steady)\n//      - out4: Isolated Valve-Click Trigger Impulse (1.0 spike specifically on mechanical\n//              valve/chuff transients for triggering percussion/glitch layers)\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba; mono in1 supported automatically)\n//   in3: Optional Pitch Confidence [0..1] (from out2 of 00_tuba_sift_yin_tracker)\n// Outlets:\n//   out1: Master Tongue/Attack Trigger Pulse [0 or 1]\n//   out2: Dubstep Mod Envelope [0.0 .. 1.0]\n//   out3: Transition Freeze Gate [0 or 1] (1 = freeze pitch during transition/click)\n//   out4: Valve-Click / Air-Chuff Specific Trigger [0 or 1]\n\n@param({ min: 0.0, max: 1.0 }) sensitivity = 0.65;\n@param({ min: 15.0, max: 1500.0 }) env_decay_ms = 220.0;\n@param({ min: 5.0, max: 150.0 }) freeze_hold_ms = 35.0;\n@param({ min: -1.0, max: 1.0 }) env_curve = -0.35;\n\n// Band-splitting filters: Tongue body (SVF bandpass ~280 Hz) vs Valve click (SVF highpass ~2200 Hz)\n@state svfTongue = new svf();\n@state svfValve1 = new svf();\n@state svfValve2 = new svf();\n\n// TKEO (Teager-Kaiser Energy Operator) 2-sample delay history for instantaneous wavefront detection\n@state tkT1 = 0.0; @state tkT2 = 0.0;\n@state tkV1 = 0.0; @state tkV2 = 0.0;\n\n// Dual-speed Differential Envelope Followers (Fast attack vs Slow baseline reference)\n@state fastTongue = 0.0;\n@state slowTongue = 0.0;\n@state fastValve = 0.0;\n@state slowValve = 0.0;\n\n// Trigger hold, refractory lockout (debounce), Freeze timer, and Dubstep Envelope state\n@state lockoutSamps = 0.0;\n@state trigPulseSamps = 0.0;\n@state valvePulseSamps = 0.0;\n@state freezeSamps = 0.0;\n@state modEnvPhase = 1.0;\n@state peakVel = 1.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet confIn = in3;\n\nlet mono = (abs(xR) > 0.0000001) ? (0.5 * (xL + xR)) : xL;\n\n// ============================================================================\n// 1. SPECTRAL SEPARATION: TONGUE WAVEFRONT vs. MECHANICAL VALVE CLICK\n// ============================================================================\n// Tongue Band: Bandpass centered at 260 Hz (captures fundamental + 2nd/3rd harmonic \"tah\" punch)\nlet tongueSig = svfTongue.next(mono, 260.0, 0.55)[2];\n\n// Valve / Chuff Band: 2-stage Highpass at 2200 Hz (captures piston/rotor clack & lip burst)\nlet hp1 = svfValve1.next(mono, 2200.0, 0.707)[1];\nlet valveSig = svfValve2.next(hp1, 2200.0, 0.707)[1];\n\n// ============================================================================\n// 2. TEAGER-KAISER ENERGY OPERATOR: psi(x[n]) = x[n-1]^2 - x[n]*x[n-2]\n// Responds in 3 samples to sudden changes in both amplitude AND frequency!\n// ============================================================================\nlet tkeoTongue = abs(tkT1 * tkT1 - tongueSig * tkT2);\ntkT2 = tkT1;\ntkT1 = tongueSig;\n\nlet tkeoValve = abs(tkV1 * tkV1 - valveSig * tkV2);\ntkV2 = tkV1;\ntkV1 = valveSig;\n\nlet energyTongue = abs(tongueSig) + 2.5 * sqrt(tkeoTongue);\nlet energyValve = abs(valveSig) * 3.0 + 4.0 * sqrt(tkeoValve);\n\n// ============================================================================\n// 3. DIFFERENTIAL FAST / SLOW ENVELOPE RATIO (ONSET FLUX)\n// ============================================================================\nlet cFastT = 1.0 - exp(-1.0 / (0.0012 * sr)); // 1.2 ms fast attack\nlet cSlowT = 1.0 - exp(-1.0 / (0.045 * sr));  // 45 ms adaptive baseline\nfastTongue += (energyTongue - fastTongue) * cFastT;\nslowTongue += (energyTongue - slowTongue) * cSlowT;\n\nlet cFastV = 1.0 - exp(-1.0 / (0.0005 * sr)); // 0.5 ms ultra-fast click capture\nlet cSlowV = 1.0 - exp(-1.0 / (0.030 * sr));  // 30 ms baseline\nfastValve += (energyValve - fastValve) * cFastV;\nslowValve += (energyValve - slowValve) * cSlowV;\n\n// Normalized onset ratios\nlet fluxTongue = (fastTongue - slowTongue) / (slowTongue + 0.002);\nlet fluxValve = (fastValve - slowValve) / (slowValve + 0.0008);\n\n// Sensitivity taper: maps [0..1] to threshold in [3.2 .. 0.35]\nlet sens = clamp(sensitivity, 0.0, 1.0);\nlet threshTongue = 3.2 * pow(0.11, pow(sens, 1.2));\nlet threshValve = threshTongue * 1.15;\n\n// ============================================================================\n// 4. TRANSIENT CLASSIFICATION, DEBOUNCE & PITCH-FREEZE TIMER\n// ============================================================================\nif (lockoutSamps > 0.0) {\n\tlockoutSamps -= 1.0;\n}\n\nlet isTongueHit = (fluxTongue > threshTongue && fastTongue > 0.004 && lockoutSamps <= 0.0);\nlet isValveHit = (fluxValve > threshValve && fastValve > 0.0015 && lockoutSamps <= 0.0);\n\nlet pulseLen = mstosamps(2.5); // 2.5 ms trigger pulse width for downstream RNBO objects\nlet refLock = mstosamps(28.0); // 28 ms refractory debounce period\n\nif (isTongueHit || isValveHit) {\n\ttrigPulseSamps = pulseLen;\n\tlockoutSamps = refLock;\n\tmodEnvPhase = 0.0; // Reset dubstep attack-decay envelope\n\tpeakVel = clamp(0.4 + 0.6 * sqrt(fastTongue * 8.0 + fastValve * 4.0), 0.35, 1.0);\n\t// Start transition pitch-freeze timer\n\tfreezeSamps = mstosamps(clamp(freeze_hold_ms, 5.0, 150.0));\n\tif (isValveHit && fluxValve > fluxTongue * 0.9) {\n\t\tvalvePulseSamps = pulseLen;\n\t}\n}\n\n// ============================================================================\n// 5. DUBSTEP SYNTH ENVELOPE GENERATOR & TRANSITION FREEZE OUTPUTS\n// ============================================================================\nlet trigOut = 0.0;\nif (trigPulseSamps > 0.0) {\n\ttrigPulseSamps -= 1.0;\n\ttrigOut = 1.0;\n}\n\nlet valveOut = 0.0;\nif (valvePulseSamps > 0.0) {\n\tvalvePulseSamps -= 1.0;\n\tvalveOut = 1.0;\n}\n\n// Also hold freeze gate high if external tracker confidence (in3) drops during slurs\nlet confFreeze = (confIn > 0.0001 && confIn < 0.45) ? 1.0 : 0.0;\nlet freezeOut = confFreeze;\nif (freezeSamps > 0.0) {\n\tfreezeSamps -= 1.0;\n\tfreezeOut = 1.0;\n}\n\n// Advance Attack-Decay Dubstep Mod Envelope (1.5 ms punch attack + curved decay)\nlet decSamples = maximum(mstosamps(clamp(env_decay_ms, 15.0, 1500.0)), 10.0);\nmodEnvPhase = clamp(modEnvPhase + 1.0 / decSamples, 0.0, 1.0);\n\n// Shape decay curve with env_curve (-1.0 = snappy whip, 0.0 = linear, +1.0 = convex sustain)\nlet cExp = pow(3.0, -clamp(env_curve, -1.0, 1.0));\nlet envVal = pow(1.0 - modEnvPhase, cExp) * peakVel;\n\nout1 = trigOut;\nout2 = envVal;\nout3 = freezeOut;\nout4 = valveOut;\n",
