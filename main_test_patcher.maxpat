                    "outlettype": [ "signal", "signal", "signal", "signal", "signal", "signal", "signal", "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 1271.0, 269.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 00c_tuba_4harmonic_IFT_analyzer.txt\n// Simultaneous 4-Harmonic IFT (Instantaneous Frequency & Amplitude)\n// Analyzer & Additive/ModFM Spectral Envelope Extractor for Live Tuba\n// ============================================================================\n// Tracks the first 4 harmonics (f1 = f0, f2 = 2*f0, f3 = 3*f0, f4 = 4*f0) of\n// the live tuba simultaneously at audio rate:\n//   1. Locks 4 dual-stage high-Q SVF bandpass filters onto 1x, 2x, 3x, and 4x\n//      the tracked fundamental f0 (from 00_tuba_freq_tracker on in3, or\n//      its own internal zero-crossing tracker if in3 <= 0).\n//   2. Passes all 4 isolated harmonics through 4 independent 4-stage quadrature\n//      IIR Hilbert Transform networks to extract each partial's complex analytic\n//      signal s_k(t) = A_k(t) * e^(j * theta_k(t)).\n//   3. Differentiates each harmonic's unwrapped phase d(theta_k)/dt EVERY SAMPLE\n//      to measure its exact Instantaneous Frequency f_k(t) (capturing\n//      nonlinear brass wave-steepening, bore inharmonicity, and ghost-note pull)\n//      and instantaneous amplitude A_k(t).\n//   4. Outputs 9 audio-rate signals:\n//      - out1..out4: Instantaneous Frequencies f1, f2, f3, f4 in Hz\n//      - out5..out8: Instantaneous Amplitudes A1, A2, A3, A4 (or normalized weights)\n//      - out9: Spectral Centroid / Brass Brightness Ratio [1.0 .. 4.0]\n//              (weighted average harmonic number, ideal for driving FM index or\n//               wobble filter cutoff directly from your embouchure brightness!)\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba; mono in1 supported automatically)\n//   in3: Tracked Fundamental f0 in Hz (from 00_tuba_freq_tracker or fluid.pitch~)\n//   in4: Optional Freeze Gate [0 or 1] (from out3 of 00b_tuba_transient_valve_detector)\n// Outlets:\n//   out1: Harmonic 1 Instantaneous Frequency f1 (Hz)\n//   out2: Harmonic 2 Instantaneous Frequency f2 (Hz)\n//   out3: Harmonic 3 Instantaneous Frequency f3 (Hz)\n//   out4: Harmonic 4 Instantaneous Frequency f4 (Hz)\n//   out5: Harmonic 1 Instantaneous Amplitude A1\n//   out6: Harmonic 2 Instantaneous Amplitude A2\n//   out7: Harmonic 3 Instantaneous Amplitude A3\n//   out8: Harmonic 4 Instantaneous Amplitude A4\n//   out9: Real-Time Brass Spectral Centroid Ratio [1.0 .. 4.0]\n\n@param({ min: 0.2, max: 1.0 }) filter_selectivity = 0.78;\n@param({ min: 0.5, max: 50.0 }) smooth_ms = 4.5;\n@param({ min: 0.0, max: 1.0 }) inharm_range = 0.15;\n@param({ min: 0.0, max: 1.0 }) norm_amplitudes = 0.0;\n\n// 4 Dual-Stage SVF Bandpass Filters (2 stages per harmonic k = 0..3)\n@state svf1_0 = new svf(); @state svf2_0 = new svf();\n@state svf1_1 = new svf(); @state svf2_1 = new svf();\n@state svf1_2 = new svf(); @state svf2_2 = new svf();\n@state svf1_3 = new svf(); @state svf2_3 = new svf();\n\n// 4 Quadrature 4-Stage IIR Hilbert Transform State Arrays (indexed [harmonic 0..3][stage 0..3])\n@state hReX = new FixedSampleArray(4, 4);\n@state hReY = new FixedSampleArray(4, 4);\n@state hImX = new FixedSampleArray(4, 4);\n@state hImY = new FixedSampleArray(4, 4);\n@state hDelRe = new FixedSampleArray(4);\n\n// Per-harmonic phase history and smoothed instantaneous frequency & amplitude states\n@state prevTheta = new FixedSampleArray(4);\n@state instHz = new FixedSampleArray([58.27, 116.54, 174.81, 233.08]);\n@state instAmp = new FixedSampleArray(4);\n@state smoothCentroid = 1.5;\n\n// Fallback internal zero-crossing fundamental tracker if in3 is unpatched\n@state lpTrack = new onepole();\n@state prevTrackSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 58.27;\n@state condF0 = 58.27;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet freezeIn = in4;\n\nlet mono = (abs(xR) > 0.0000001) ? (0.5 * (xL + xR)) : xL;\n\n// ============================================================================\n// 1. FUNDAMENTAL ANCHOR CONDITIONING & FREEZE GATE\n// ============================================================================\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevTrackSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevTrackSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\n// Only update anchor pitch when freeze gate (in4) is low (< 0.5)\nif (freezeIn < 0.5) {\n\tlet f0Slew = 1.0 - exp(-1.0 / (0.004 * sr));\n\tcondF0 += (rawF0 - condF0) * f0Slew;\n}\nlet f0 = clamp(condF0, 24.0, 700.0);\n\n// ============================================================================\n// 2. 4-HARMONIC DUAL-STAGE SVF ISOLATION\n// ============================================================================\n// Map filter_selectivity [0.2..1.0] to SVF Q in [0.65..0.95]\nlet qSvf = clamp(0.55 + 0.40 * pow(clamp(filter_selectivity, 0.2, 1.0), 0.8), 0.55, 0.95);\n\nlet fNom0 = clamp(f0 * 1.0, 24.0, sr * 0.44);\nlet fNom1 = clamp(f0 * 2.0, 48.0, sr * 0.44);\nlet fNom2 = clamp(f0 * 3.0, 72.0, sr * 0.44);\nlet fNom3 = clamp(f0 * 4.0, 96.0, sr * 0.44);\n\nlet hSig = new FixedSampleArray(4);\nhSig[0] = svf2_0.next(svf1_0.next(mono, fNom0, qSvf)[2], fNom0, qSvf)[2] * 2.2;\nhSig[1] = svf2_1.next(svf1_1.next(mono, fNom1, qSvf)[2], fNom1, qSvf)[2] * 2.2;\nhSig[2] = svf2_2.next(svf1_2.next(mono, fNom2, qSvf)[2], fNom2, qSvf)[2] * 2.2;\nhSig[3] = svf2_3.next(svf1_3.next(mono, fNom3, qSvf)[2], fNom3, qSvf)[2] * 2.2;\n\nlet fNomArr = new FixedSampleArray(4);\nfNomArr[0] = fNom0;\nfNomArr[1] = fNom1;\nfNomArr[2] = fNom2;\nfNomArr[3] = fNom3;\n\n// ============================================================================\n// 3. 4x QUADRATURE HILBERT TRANSFORMS & INSTANTANEOUS PHASE DIFFERENTIATION\n// ============================================================================\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet tauSamps = maximum(mstosamps(clamp(smooth_ms, 0.5, 50.0)), 1.0);\nlet slewCoeff = 1.0 - exp(-1.0 / tauSamps);\nlet maxDev = clamp(inharm_range, 0.0, 1.0) * 0.25 + 0.02; // +/- 2% to +/- 27% deviation window\n\nfor (let k: Int = 0; k < 4; k++) {\n\tlet sIn = hSig[k];\n\n\t// Real branch (0 deg)\n\tlet sRe = sIn;\n\tlet yr0 = cRe0 * (sRe - hReY[k][0]) + hReX[k][0]; hReX[k][0] = sRe; hReY[k][0] = yr0; sRe = yr0;\n\tlet yr1 = cRe1 * (sRe - hReY[k][1]) + hReX[k][1]; hReX[k][1] = sRe; hReY[k][1] = yr1; sRe = yr1;\n\tlet yr2 = cRe2 * (sRe - hReY[k][2]) + hReX[k][2]; hReX[k][2] = sRe; hReY[k][2] = yr2; sRe = yr2;\n\tlet yr3 = cRe3 * (sRe - hReY[k][3]) + hReX[k][3]; hReX[k][3] = sRe; hReY[k][3] = yr3;\n\tlet outRe = hDelRe[k];\n\thDelRe[k] = yr3;\n\n\t// Imaginary branch (90 deg)\n\tlet sIm = sIn;\n\tlet yi0 = cIm0 * (sIm - hImY[k][0]) + hImX[k][0]; hImX[k][0] = sIm; hImY[k][0] = yi0; sIm = yi0;\n\tlet yi1 = cIm1 * (sIm - hImY[k][1]) + hImX[k][1]; hImX[k][1] = sIm; hImY[k][1] = yi1; sIm = yi1;\n\tlet yi2 = cIm2 * (sIm - hImY[k][2]) + hImX[k][2]; hImX[k][2] = sIm; hImY[k][2] = yi2; sIm = yi2;\n\tlet yi3 = cIm3 * (sIm - hImY[k][3]) + hImX[k][3]; hImX[k][3] = sIm; hImY[k][3] = yi3;\n\tlet outIm = yi3;\n\n\t// Polar conversion -> instantaneous envelope A_k(t) and phase theta_k(t)\n\tlet pol = cartopol(outRe, outIm);\n\tlet ampK = pol[0];\n\tlet thetaK = pol[1];\n\n\t// Unwrap single-sample phase advance dTheta in [-pi, pi]\n\tlet dTheta = thetaK - prevTheta[k];\n\tif (dTheta < -pi) { dTheta += 2.0 * pi; }\n\telse if (dTheta > pi) { dTheta -= 2.0 * pi; }\n\tprevTheta[k] = thetaK;\n\n\t// Instantaneous frequency f_k(t) = (dTheta / (2*pi)) * sr\n\tlet rawFk = (dTheta / (2.0 * pi)) * sr;\n\tlet nomFk = fNomArr[k];\n\n\t// Update amplitude envelope A_k(t)\n\tinstAmp[k] = instAmp[k] + (ampK - instAmp[k]) * slewCoeff;\n\n\t// Update instantaneous frequency f_k(t) when not frozen and partial energy is above noise floor\n\tif (freezeIn < 0.5) {\n\t\tlet relErr = abs(rawFk - nomFk) / maximum(nomFk, 20.0);\n\t\tif (relErr <= maxDev && ampK > 0.00015) {\n\t\t\tinstHz[k] = instHz[k] + (rawFk - instHz[k]) * slewCoeff;\n\t\t} else {\n\t\t\t// Gently relax toward harmonic multiple k*f0 when partial is silent\n\t\t\tinstHz[k] = instHz[k] + (nomFk - instHz[k]) * (slewCoeff * 0.25);\n\t\t}\n\t}\n}\n\n// ============================================================================\n// 4. AMPLITUDE NORMALIZATION & REAL-TIME BRASS SPECTRAL CENTROID (out9)\n// ============================================================================\nlet a1 = instAmp[0];\nlet a2 = instAmp[1];\nlet a3 = instAmp[2];\nlet a4 = instAmp[3];\nlet sumAmp = a1 + a2 + a3 + a4 + 0.0001;\n\n// Spectral centroid in harmonic units [1.0 .. 4.0]:\n// 1.0 = pure fundamental sine (soft dynamics), > 2.2 = bright brassy wave-steepened fortissimo\nlet rawCentroid = (1.0 * a1 + 2.0 * a2 + 3.0 * a3 + 4.0 * a4) / sumAmp;\nif ( sumAmp > 0.001 && freezeIn < 0.5 ) {\n\tsmoothCentroid += (clamp(rawCentroid, 1.0, 4.0) - smoothCentroid) * slewCoeff;\n}\n\n// Blend between raw partial amplitudes and sum-normalized relative weights (for ModFM vocoding)\nlet normMix = clamp(norm_amplitudes, 0.0, 1.0);\nlet outA1 = linearinterp(normMix, a1, a1 / sumAmp);\nlet outA2 = linearinterp(normMix, a2, a2 / sumAmp);\nlet outA3 = linearinterp(normMix, a3, a3 / sumAmp);\nlet outA4 = linearinterp(normMix, a4, a4 / sumAmp);\n\nout1 = instHz[0];\nout2 = instHz[1];\nout3 = instHz[2];\nout4 = instHz[3];\nout5 = outA1;\nout6 = outA2;\nout7 = outA3;\nout8 = outA4;\nout9 = smoothCentroid;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 9,
                                    "outlettype": [ "signal", "signal", "signal", "signal", "signal", "signal", "signal", "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 00c_tuba_4harmonic_IFT_analyzer.txt\n// Simultaneous 4-Harmonic IFT (Instantaneous Frequency & Amplitude)\n// Analyzer & Additive/ModFM Spectral Envelope Extractor for Live Tuba\n// ============================================================================\n// Tracks the first 4 harmonics (f1 = f0, f2 = 2*f0, f3 = 3*f0, f4 = 4*f0) of\n// the live tuba simultaneously at audio rate:\n//   1. Locks 4 dual-stage high-Q SVF bandpass filters onto 1x, 2x, 3x, and 4x\n//      the tracked fundamental f0 (from 00_tuba_freq_tracker on in3, or\n//      its own internal zero-crossing tracker if in3 <= 0).\n//   2. Passes all 4 isolated harmonics through 4 independent 4-stage quadrature\n//      IIR Hilbert Transform networks to extract each partial's complex analytic\n//      signal s_k(t) = A_k(t) * e^(j * theta_k(t)).\n//   3. Differentiates each harmonic's unwrapped phase d(theta_k)/dt EVERY SAMPLE\n//      to measure its exact Instantaneous Frequency f_k(t) (capturing\n//      nonlinear brass wave-steepening, bore inharmonicity, and ghost-note pull)\n//      and instantaneous amplitude A_k(t).\n//   4. Outputs 9 audio-rate signals:\n//      - out1..out4: Instantaneous Frequencies f1, f2, f3, f4 in Hz\n//      - out5..out8: Instantaneous Amplitudes A1, A2, A3, A4 (or normalized weights)\n//      - out9: Spectral Centroid / Brass Brightness Ratio [1.0 .. 4.0]\n//              (weighted average harmonic number, ideal for driving FM index or\n//               wobble filter cutoff directly from your embouchure brightness!)\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba; mono in1 supported automatically)\n//   in3: Tracked Fundamental f0 in Hz (from 00_tuba_freq_tracker or fluid.pitch~)\n//   in4: Optional Freeze Gate [0 or 1] (from out3 of 00b_tuba_transient_valve_detector)\n// Outlets:\n//   out1: Harmonic 1 Instantaneous Frequency f1 (Hz)\n//   out2: Harmonic 2 Instantaneous Frequency f2 (Hz)\n//   out3: Harmonic 3 Instantaneous Frequency f3 (Hz)\n//   out4: Harmonic 4 Instantaneous Frequency f4 (Hz)\n//   out5: Harmonic 1 Instantaneous Amplitude A1\n//   out6: Harmonic 2 Instantaneous Amplitude A2\n//   out7: Harmonic 3 Instantaneous Amplitude A3\n//   out8: Harmonic 4 Instantaneous Amplitude A4\n//   out9: Real-Time Brass Spectral Centroid Ratio [1.0 .. 4.0]\n\n@param({ min: 0.2, max: 1.0 }) filter_selectivity = 0.78;\n@param({ min: 0.5, max: 50.0 }) smooth_ms = 4.5;\n@param({ min: 0.0, max: 1.0 }) inharm_range = 0.15;\n@param({ min: 0.0, max: 1.0 }) norm_amplitudes = 0.0;\n\n// 4 Dual-Stage SVF Bandpass Filters (2 stages per harmonic k = 0..3)\n@state svf1_0 = new svf(); @state svf2_0 = new svf();\n@state svf1_1 = new svf(); @state svf2_1 = new svf();\n@state svf1_2 = new svf(); @state svf2_2 = new svf();\n@state svf1_3 = new svf(); @state svf2_3 = new svf();\n\n// 4 Quadrature 4-Stage IIR Hilbert Transform State Arrays (indexed [harmonic 0..3][stage 0..3])\n@state hReX = new FixedSampleArray(4, 4);\n@state hReY = new FixedSampleArray(4, 4);\n@state hImX = new FixedSampleArray(4, 4);\n@state hImY = new FixedSampleArray(4, 4);\n@state hDelRe = new FixedSampleArray(4);\n\n// Per-harmonic phase history and smoothed instantaneous frequency & amplitude states\n@state prevTheta = new FixedSampleArray(4);\n@state instHz = new FixedSampleArray([58.27, 116.54, 174.81, 233.08]);\n@state instAmp = new FixedSampleArray(4);\n@state smoothCentroid = 1.5;\n\n// Fallback internal zero-crossing fundamental tracker if in3 is unpatched\n@state lpTrack = new onepole();\n@state prevTrackSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 58.27;\n@state condF0 = 58.27;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet freezeIn = in4;\n\nlet mono = (abs(xR) > 0.0000001) ? (0.5 * (xL + xR)) : xL;\n\n// ============================================================================\n// 1. FUNDAMENTAL ANCHOR CONDITIONING & FREEZE GATE\n// ============================================================================\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevTrackSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevTrackSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\n// Only update anchor pitch when freeze gate (in4) is low (< 0.5)\nif (freezeIn < 0.5) {\n\tlet f0Slew = 1.0 - exp(-1.0 / (0.004 * sr));\n\tcondF0 += (rawF0 - condF0) * f0Slew;\n}\nlet f0 = clamp(condF0, 24.0, 700.0);\n\n// ============================================================================\n// 2. 4-HARMONIC DUAL-STAGE SVF ISOLATION\n// ============================================================================\n// Map filter_selectivity [0.2..1.0] to SVF Q in [0.65..0.95]\nlet qSvf = clamp(0.55 + 0.40 * pow(clamp(filter_selectivity, 0.2, 1.0), 0.8), 0.55, 0.95);\n\nlet fNom0 = clamp(f0 * 1.0, 24.0, sr * 0.44);\nlet fNom1 = clamp(f0 * 2.0, 48.0, sr * 0.44);\nlet fNom2 = clamp(f0 * 3.0, 72.0, sr * 0.44);\nlet fNom3 = clamp(f0 * 4.0, 96.0, sr * 0.44);\n\nlet hSig = new FixedSampleArray(4);\nhSig[0] = svf2_0.next(svf1_0.next(mono, fNom0, qSvf)[2], fNom0, qSvf)[2] * 2.2;\nhSig[1] = svf2_1.next(svf1_1.next(mono, fNom1, qSvf)[2], fNom1, qSvf)[2] * 2.2;\nhSig[2] = svf2_2.next(svf1_2.next(mono, fNom2, qSvf)[2], fNom2, qSvf)[2] * 2.2;\nhSig[3] = svf2_3.next(svf1_3.next(mono, fNom3, qSvf)[2], fNom3, qSvf)[2] * 2.2;\n\nlet fNomArr = new FixedSampleArray(4);\nfNomArr[0] = fNom0;\nfNomArr[1] = fNom1;\nfNomArr[2] = fNom2;\nfNomArr[3] = fNom3;\n\n// ============================================================================\n// 3. 4x QUADRATURE HILBERT TRANSFORMS & INSTANTANEOUS PHASE DIFFERENTIATION\n// ============================================================================\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet tauSamps = maximum(mstosamps(clamp(smooth_ms, 0.5, 50.0)), 1.0);\nlet slewCoeff = 1.0 - exp(-1.0 / tauSamps);\nlet maxDev = clamp(inharm_range, 0.0, 1.0) * 0.25 + 0.02; // +/- 2% to +/- 27% deviation window\n\nfor (let k: Int = 0; k < 4; k++) {\n\tlet sIn = hSig[k];\n\n\t// Real branch (0 deg)\n\tlet sRe = sIn;\n\tlet yr0 = cRe0 * (sRe - hReY[k][0]) + hReX[k][0]; hReX[k][0] = sRe; hReY[k][0] = yr0; sRe = yr0;\n\tlet yr1 = cRe1 * (sRe - hReY[k][1]) + hReX[k][1]; hReX[k][1] = sRe; hReY[k][1] = yr1; sRe = yr1;\n\tlet yr2 = cRe2 * (sRe - hReY[k][2]) + hReX[k][2]; hReX[k][2] = sRe; hReY[k][2] = yr2; sRe = yr2;\n\tlet yr3 = cRe3 * (sRe - hReY[k][3]) + hReX[k][3]; hReX[k][3] = sRe; hReY[k][3] = yr3;\n\tlet outRe = hDelRe[k];\n\thDelRe[k] = yr3;\n\n\t// Imaginary branch (90 deg)\n\tlet sIm = sIn;\n\tlet yi0 = cIm0 * (sIm - hImY[k][0]) + hImX[k][0]; hImX[k][0] = sIm; hImY[k][0] = yi0; sIm = yi0;\n\tlet yi1 = cIm1 * (sIm - hImY[k][1]) + hImX[k][1]; hImX[k][1] = sIm; hImY[k][1] = yi1; sIm = yi1;\n\tlet yi2 = cIm2 * (sIm - hImY[k][2]) + hImX[k][2]; hImX[k][2] = sIm; hImY[k][2] = yi2; sIm = yi2;\n\tlet yi3 = cIm3 * (sIm - hImY[k][3]) + hImX[k][3]; hImX[k][3] = sIm; hImY[k][3] = yi3;\n\tlet outIm = yi3;\n\n\t// Polar conversion -> instantaneous envelope A_k(t) and phase theta_k(t)\n\tlet pol = cartopol(outRe, outIm);\n\tlet ampK = pol[0];\n\tlet thetaK = pol[1];\n\n\t// Unwrap single-sample phase advance dTheta in [-pi, pi]\n\tlet dTheta = thetaK - prevTheta[k];\n\tif (dTheta < -pi) { dTheta += 2.0 * pi; }\n\telse if (dTheta > pi) { dTheta -= 2.0 * pi; }\n\tprevTheta[k] = thetaK;\n\n\t// Instantaneous frequency f_k(t) = (dTheta / (2*pi)) * sr\n\tlet rawFk = (dTheta / (2.0 * pi)) * sr;\n\tlet nomFk = fNomArr[k];\n\n\t// Update amplitude envelope A_k(t)\n\tinstAmp[k] = instAmp[k] + (ampK - instAmp[k]) * slewCoeff;\n\n\t// Update instantaneous frequency f_k(t) when not frozen and partial energy is above noise floor\n\tif (freezeIn < 0.5) {\n\t\tlet relErr = abs(rawFk - nomFk) / maximum(nomFk, 20.0);\n\t\tif (relErr <= maxDev && ampK > 0.00015) {\n\t\t\tinstHz[k] = instHz[k] + (rawFk - instHz[k]) * slewCoeff;\n\t\t} else {\n\t\t\t// Gently relax toward harmonic multiple k*f0 when partial is silent\n\t\t\tinstHz[k] = instHz[k] + (nomFk - instHz[k]) * (slewCoeff * 0.25);\n\t\t}\n\t}\n}\n\n// ============================================================================\n// 4. AMPLITUDE NORMALIZATION & REAL-TIME BRASS SPECTRAL CENTROID (out9)\n// ============================================================================\nlet a1 = instAmp[0];\nlet a2 = instAmp[1];\nlet a3 = instAmp[2];\nlet a4 = instAmp[3];\nlet sumAmp = a1 + a2 + a3 + a4 + 0.0001;\n\n// Spectral centroid in harmonic units [1.0 .. 4.0]:\n// 1.0 = pure fundamental sine (soft dynamics), > 2.2 = bright brassy wave-steepened fortissimo\nlet rawCentroid = (1.0 * a1 + 2.0 * a2 + 3.0 * a3 + 4.0 * a4) / sumAmp;\nif ( sumAmp > 0.001 && freezeIn < 0.5 ) {\n\tsmoothCentroid += (clamp(rawCentroid, 1.0, 4.0) - smoothCentroid) * slewCoeff;\n}\n\n// Blend between raw partial amplitudes and sum-normalized relative weights (for ModFM vocoding)\nlet normMix = clamp(norm_amplitudes, 0.0, 1.0);\nlet outA1 = linearinterp(normMix, a1, a1 / sumAmp);\nlet outA2 = linearinterp(normMix, a2, a2 / sumAmp);\nlet outA3 = linearinterp(normMix, a3, a3 / sumAmp);\nlet outA4 = linearinterp(normMix, a4, a4 / sumAmp);\n\nout1 = instHz[0];\nout2 = instHz[1];\nout3 = instHz[2];\nout4 = instHz[3];\nout5 = outA1;\nout6 = outA2;\nout7 = outA3;\nout8 = outA4;\nout9 = smoothCentroid;\n",
                                        "expr": ""
                                    },
                                    "rnbo_serial": 3,
                                    "rnbo_uniqueid": "effect_code",
