                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 1058.0, 507.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 05_phaseshaper_supersaw_tri.txt\n// Unix-Style Effect 5: JP-8000 Triangle Modulation & Ripple Supersaw Phaseshaper\n// Implements Kleimola, Lazzarini, Timoney & Valimaki (SMC 2010, Sec 2.4, 3.5, 3.6):\n//   - Mode 0..0.5: Roland JP-8000 Triangle Modulation (Eq. 26: xT = aTM*gtri(phi,2)-1,\n//     y = 2*(xT - ceil(xT) - 0.5)) -> odd-harmonic formant sweeps with dominant 3rd partial.\n//   - Mode 0.5..1.0: Single-oscillator Ripple Supersaw (Eq. 28: sin(2*pi*gb(modm(modm(a1*phi,m1)+a1*phi,m2))))\n//     plus Variable-Slope Tilted Triangle Phase (Eq. 16-17: gvtri) for stereo unison & spectral tilt.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Tracked Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: Optional 1-Bar Phasor [0..1] (modulates supersaw ripple detune if connected)\n// Outlets:\n//   out1: Left Phaseshaped Output\n//   out2: Right Phaseshaped Output\n\n@param({ min: 0.0, max: 1.0 }) shape_mod = 0.55;\n@param({ min: 0.0, max: 1.0 }) ripple_detune = 0.5;\n@param({ min: 0.1, max: 0.9 }) tilt_duty = 0.5;\n@param({ min: 0.0, max: 1.0 }) mode_blend = 0.5;\n\n// Quadrature Hilbert pair for analytic phase extraction\n@state hReX = new FixedSampleArray(4);\n@state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4);\n@state hImY = new FixedSampleArray(4);\n@state hDelayRe = 0.0;\n\n// Internal slow LFO for Supersaw m1 animation (Paper Fig. 13)\n@state lfoPhasor = new phasor();\n\n// Real-valued modulo helper modm[x, m] = x - m * floor(x / m) (Paper Eq. 18)\nfunction modm(x: number, m: number): number {\n\tlet safeM = maximum(m, 0.01);\n\treturn x - safeM * floor(x / safeM);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet barPhasor = in4;\r\nlet placeholder20834 = in3;\n\nlet mono = 0.5 * (xL + xR);\n\n// --- 1. Hilbert Transform Analytic Phase Extraction ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet sRe = mono;\nlet yRe0 = cRe0 * (sRe - hReY[0]) + hReX[0]; hReX[0] = sRe; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe - hReY[1]) + hReX[1]; hReX[1] = sRe; hReY[1] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe - hReY[2]) + hReX[2]; hReX[2] = sRe; hReY[2] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe - hReY[3]) + hReX[3]; hReX[3] = sRe; hReY[3] = yRe3;\nlet outRe = hDelayRe;\nhDelayRe = yRe3;\n\nlet sIm = mono;\nlet yIm0 = cIm0 * (sIm - hImY[0]) + hImX[0]; hImX[0] = sIm; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm - hImY[1]) + hImX[1]; hImX[1] = sIm; hImY[1] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm - hImY[2]) + hImX[2]; hImX[2] = sIm; hImY[2] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm - hImY[3]) + hImX[3]; hImX[3] = sIm; hImY[3] = yIm3;\nlet outIm = yIm3;\n\nlet pol = cartopol(outRe, outIm);\nlet instAmp = pol[0];\nlet phi = wrap((pol[1] + pi) / (2.0 * pi), 0.0, 1.0);\n\n// --- 2. Variable-Slope Parabolic Triangle Phase svtri (Paper Eq. 16) ---\nlet w = clamp(tilt_duty, 0.1, 0.9);\nlet aT = 1.0 / (8.0 * maximum(w - w * w, 0.01));\nlet gb1 = 2.0 * phi - 1.0;\nlet phiShift = wrap(phi - w, 0.0, 1.0);\nlet gb2 = 2.0 * phiShift - 1.0;\nlet svtri = clamp(aT * (gb1 * gb1 - gb2 * gb2) + 0.5, 0.0, 1.0);\n\n// Blend raw phasor phi with tilted triangle phase based on distance of tilt_duty from 0.5\nlet tiltAmt = abs(w - 0.5) * 2.0;\nlet basePhiL = linearinterp(tiltAmt, phi, svtri);\nlet basePhiR = wrap(basePhiL + 0.025 * ripple_detune, 0.0, 1.0);\n\n// --- 3. Algorithm A: Roland JP-8000 Triangle Modulation (Paper Eq. 26) ---\n// aTM in [0.7, 1.0] controls the V-fold depth of the 3rd-harmonic-dominant odd spectrum\nlet aTM = 0.7 + 0.3 * clamp(shape_mod, 0.0, 1.0);\n\nlet gtri2L = wrap(2.0 * abs(2.0 * basePhiL - 1.0), 0.0, 1.0);\nlet xTL = aTM * gtri2L - 1.0;\nlet yTriModL = 2.0 * (xTL - ceil(xTL) - 0.5);\n\nlet gtri2R = wrap(2.0 * abs(2.0 * basePhiR - 1.0), 0.0, 1.0);\nlet xTR = aTM * gtri2R - 1.0;\nlet yTriModR = 2.0 * (xTR - ceil(xTR) - 0.5);\n\n// --- 4. Algorithm B: Ripple Supersaw Simulation (Paper Eq. 28 & Fig. 13) ---\n// y(n) = sin(2*pi * gb{ modm[ modm[a1*phi, m1] + a1*phi, m2 ] })\nlet lfoPhase = (barPhasor > 0.0001 && barPhasor < 0.9999) ? barPhasor : lfoPhasor.next(0.35);\nlet lfoL = 0.5 + 0.5 * sin(2.0 * pi * lfoPhase);\nlet lfoR = 0.5 + 0.5 * cos(2.0 * pi * lfoPhase);\n\nlet a1_ss = 1.15 + 1.1 * clamp(shape_mod, 0.0, 1.0); // Paper uses a1 = 1.5\nlet m2 = 0.88; // Paper Fig. 12 constant\nlet detDepth = clamp(ripple_detune, 0.0, 1.0);\nlet m1L = 0.18 + 0.62 * (0.6 * detDepth + 0.4 * detDepth * lfoL);\nlet m1R = 0.18 + 0.62 * (0.6 * detDepth + 0.4 * detDepth * lfoR);\n\nlet xssL = a1_ss * basePhiL;\nlet ripInnerL = modm(modm(xssL, m1L) + xssL, m2);\nlet ySuperL = sin(2.0 * pi * (2.0 * ripInnerL - 1.0));\n\nlet xssR = a1_ss * basePhiR;\nlet ripInnerR = modm(modm(xssR, m1R) + xssR, m2);\nlet ySuperR = sin(2.0 * pi * (2.0 * ripInnerR - 1.0));\n\n// --- 5. Blend Triangle Modulation and Ripple Supersaw & Restore Envelope ---\nlet envGate = clamp((instAmp - 0.001) * 200.0, 0.0, 1.0);\nlet wetL = linearinterp(clamp(mode_blend, 0.0, 1.0), yTriModL, ySuperL) * instAmp * 1.5 * envGate;\nlet wetR = linearinterp(clamp(mode_blend, 0.0, 1.0), yTriModR, ySuperR) * instAmp * 1.5 * envGate;\n\nout1 = wetL;\nout2 = wetR;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 05_phaseshaper_supersaw_tri.txt\n// Unix-Style Effect 5: JP-8000 Triangle Modulation & Ripple Supersaw Phaseshaper\n// Implements Kleimola, Lazzarini, Timoney & Valimaki (SMC 2010, Sec 2.4, 3.5, 3.6):\n//   - Mode 0..0.5: Roland JP-8000 Triangle Modulation (Eq. 26: xT = aTM*gtri(phi,2)-1,\n//     y = 2*(xT - ceil(xT) - 0.5)) -> odd-harmonic formant sweeps with dominant 3rd partial.\n//   - Mode 0.5..1.0: Single-oscillator Ripple Supersaw (Eq. 28: sin(2*pi*gb(modm(modm(a1*phi,m1)+a1*phi,m2))))\n//     plus Variable-Slope Tilted Triangle Phase (Eq. 16-17: gvtri) for stereo unison & spectral tilt.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Tracked Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: Optional 1-Bar Phasor [0..1] (modulates supersaw ripple detune if connected)\n// Outlets:\n//   out1: Left Phaseshaped Output\n//   out2: Right Phaseshaped Output\n\n@param({ min: 0.0, max: 1.0 }) shape_mod = 0.55;\n@param({ min: 0.0, max: 1.0 }) ripple_detune = 0.5;\n@param({ min: 0.1, max: 0.9 }) tilt_duty = 0.5;\n@param({ min: 0.0, max: 1.0 }) mode_blend = 0.5;\n\n// Quadrature Hilbert pair for analytic phase extraction\n@state hReX = new FixedSampleArray(4);\n@state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4);\n@state hImY = new FixedSampleArray(4);\n@state hDelayRe = 0.0;\n\n// Internal slow LFO for Supersaw m1 animation (Paper Fig. 13)\n@state lfoPhasor = new phasor();\n\n// Real-valued modulo helper modm[x, m] = x - m * floor(x / m) (Paper Eq. 18)\nfunction modm(x: number, m: number): number {\n\tlet safeM = maximum(m, 0.01);\n\treturn x - safeM * floor(x / safeM);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet barPhasor = in4;\r\nlet placeholder20834 = in3;\n\nlet mono = 0.5 * (xL + xR);\n\n// --- 1. Hilbert Transform Analytic Phase Extraction ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet sRe = mono;\nlet yRe0 = cRe0 * (sRe - hReY[0]) + hReX[0]; hReX[0] = sRe; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe - hReY[1]) + hReX[1]; hReX[1] = sRe; hReY[1] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe - hReY[2]) + hReX[2]; hReX[2] = sRe; hReY[2] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe - hReY[3]) + hReX[3]; hReX[3] = sRe; hReY[3] = yRe3;\nlet outRe = hDelayRe;\nhDelayRe = yRe3;\n\nlet sIm = mono;\nlet yIm0 = cIm0 * (sIm - hImY[0]) + hImX[0]; hImX[0] = sIm; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm - hImY[1]) + hImX[1]; hImX[1] = sIm; hImY[1] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm - hImY[2]) + hImX[2]; hImX[2] = sIm; hImY[2] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm - hImY[3]) + hImX[3]; hImX[3] = sIm; hImY[3] = yIm3;\nlet outIm = yIm3;\n\nlet pol = cartopol(outRe, outIm);\nlet instAmp = pol[0];\nlet phi = wrap((pol[1] + pi) / (2.0 * pi), 0.0, 1.0);\n\n// --- 2. Variable-Slope Parabolic Triangle Phase svtri (Paper Eq. 16) ---\nlet w = clamp(tilt_duty, 0.1, 0.9);\nlet aT = 1.0 / (8.0 * maximum(w - w * w, 0.01));\nlet gb1 = 2.0 * phi - 1.0;\nlet phiShift = wrap(phi - w, 0.0, 1.0);\nlet gb2 = 2.0 * phiShift - 1.0;\nlet svtri = clamp(aT * (gb1 * gb1 - gb2 * gb2) + 0.5, 0.0, 1.0);\n\n// Blend raw phasor phi with tilted triangle phase based on distance of tilt_duty from 0.5\nlet tiltAmt = abs(w - 0.5) * 2.0;\nlet basePhiL = linearinterp(tiltAmt, phi, svtri);\nlet basePhiR = wrap(basePhiL + 0.025 * ripple_detune, 0.0, 1.0);\n\n// --- 3. Algorithm A: Roland JP-8000 Triangle Modulation (Paper Eq. 26) ---\n// aTM in [0.7, 1.0] controls the V-fold depth of the 3rd-harmonic-dominant odd spectrum\nlet aTM = 0.7 + 0.3 * clamp(shape_mod, 0.0, 1.0);\n\nlet gtri2L = wrap(2.0 * abs(2.0 * basePhiL - 1.0), 0.0, 1.0);\nlet xTL = aTM * gtri2L - 1.0;\nlet yTriModL = 2.0 * (xTL - ceil(xTL) - 0.5);\n\nlet gtri2R = wrap(2.0 * abs(2.0 * basePhiR - 1.0), 0.0, 1.0);\nlet xTR = aTM * gtri2R - 1.0;\nlet yTriModR = 2.0 * (xTR - ceil(xTR) - 0.5);\n\n// --- 4. Algorithm B: Ripple Supersaw Simulation (Paper Eq. 28 & Fig. 13) ---\n// y(n) = sin(2*pi * gb{ modm[ modm[a1*phi, m1] + a1*phi, m2 ] })\nlet lfoPhase = (barPhasor > 0.0001 && barPhasor < 0.9999) ? barPhasor : lfoPhasor.next(0.35);\nlet lfoL = 0.5 + 0.5 * sin(2.0 * pi * lfoPhase);\nlet lfoR = 0.5 + 0.5 * cos(2.0 * pi * lfoPhase);\n\nlet a1_ss = 1.15 + 1.1 * clamp(shape_mod, 0.0, 1.0); // Paper uses a1 = 1.5\nlet m2 = 0.88; // Paper Fig. 12 constant\nlet detDepth = clamp(ripple_detune, 0.0, 1.0);\nlet m1L = 0.18 + 0.62 * (0.6 * detDepth + 0.4 * detDepth * lfoL);\nlet m1R = 0.18 + 0.62 * (0.6 * detDepth + 0.4 * detDepth * lfoR);\n\nlet xssL = a1_ss * basePhiL;\nlet ripInnerL = modm(modm(xssL, m1L) + xssL, m2);\nlet ySuperL = sin(2.0 * pi * (2.0 * ripInnerL - 1.0));\n\nlet xssR = a1_ss * basePhiR;\nlet ripInnerR = modm(modm(xssR, m1R) + xssR, m2);\nlet ySuperR = sin(2.0 * pi * (2.0 * ripInnerR - 1.0));\n\n// --- 5. Blend Triangle Modulation and Ripple Supersaw & Restore Envelope ---\nlet envGate = clamp((instAmp - 0.001) * 200.0, 0.0, 1.0);\nlet wetL = linearinterp(clamp(mode_blend, 0.0, 1.0), yTriModL, ySuperL) * instAmp * 1.5 * envGate;\nlet wetR = linearinterp(clamp(mode_blend, 0.0, 1.0), yTriModR, ySuperR) * instAmp * 1.5 * envGate;\n\nout1 = wetL;\nout2 = wetR;\n",
