                        ]
                    },
                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 134.0, 181.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 11_bode_ssb_freq_shifter.txt\n// Unix-Style Effect 11: Pitch-Relative Bode / SSB Frequency Shifter\n// Implements Approach 3c from \"Novel Distortion Approaches for Live Tuba\" and\n// Wardle (DAFx-99) Hilbert Transform Single-Sideband Frequency Shifter:\n//   y_up   = s*cos(w_s*t) - s_hat*sin(w_s*t)\n//   y_down = s*cos(w_s*t) + s_hat*sin(w_s*t)\n// Shifts every harmonic of the tuba by a fixed Hz OR a tracked ratio of f0\n// (e.g., -0.5*f0 folds the fundamental toward sub-bass while making upper\n// partials clangorously inharmonic or creating lush barber-pole stereo detune).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Optional Tracked Pitch in Hz (if > 20 Hz, enables pitch-proportional shift)\n// Outlets:\n//   out1: Left Frequency-Shifted Output\n//   out2: Right Frequency-Shifted Output\n\n@param({ min: -500.0, max: 500.0 }) shift_hz = -28.0;\n@param({ min: 0.0, max: 1.0 }) f0_track_amt = 0.5;\n@param({ min: -1.0, max: 1.0 }) up_down_stereo = 0.0;\n@param({ min: 0.0, max: 1.0 }) mix = 0.65;\n\n// Stereo 4-stage IIR Hilbert transform states (Left and Right channels)\n@state lReX = new FixedSampleArray(4); @state lReY = new FixedSampleArray(4);\n@state lImX = new FixedSampleArray(4); @state lImY = new FixedSampleArray(4);\n@state lDelRe = 0.0;\n\n@state rReX = new FixedSampleArray(4); @state rReY = new FixedSampleArray(4);\n@state rImX = new FixedSampleArray(4); @state rImY = new FixedSampleArray(4);\n@state rDelRe = 0.0;\n\n@state shiftPhasor = new phasor();\n@state smoothF0 = 55.0;\n\n// DC Blockers (for shifts near -f0 that fold fundamental to 0 Hz DC)\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch-Proportional vs. Fixed Hz Shift Calculation ---\nif (pitchIn > 20.0 && pitchIn < 1000.0) {\n\tsmoothF0 += (pitchIn - smoothF0) * (1.0 - exp(-1.0 / (0.008 * sr)));\n}\n\n// Nonlinear cubic taper around 0 Hz on shift_hz so small barber-pole shifts (0.5..15 Hz)\n// are easy to dial in, while outer extremes reach +/- 500 Hz clangorous metal\nlet normShift = clamp(shift_hz / 500.0, -1.0, 1.0);\nlet taperedHz = 500.0 * (0.25 * normShift + 0.75 * normShift * normShift * normShift);\n\n// When f0_track_amt > 0, scale shift proportionally to smoothF0 / 55 Hz\nlet pitchScale = linearinterp(clamp(f0_track_amt, 0.0, 1.0), 1.0, smoothF0 / 55.0);\nlet finalShiftHz = clamp(taperedHz * pitchScale, -2000.0, 2000.0);\n\n// --- 2. Quadrature Hilbert Transform on Left & Right Channels ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\n// Left Channel Hilbert -> (sL, shatL)\nlet tL = xL;\nlet yl0 = cRe0 * (tL - lReY[0]) + lReX[0]; lReX[0] = tL; lReY[0] = yl0; tL = yl0;\nlet yl1 = cRe1 * (tL - lReY[1]) + lReX[1]; lReX[1] = tL; lReY[1] = yl1; tL = yl1;\nlet yl2 = cRe2 * (tL - lReY[2]) + lReX[2]; lReX[2] = tL; lReY[2] = yl2; tL = yl2;\nlet yl3 = cRe3 * (tL - lReY[3]) + lReX[3]; lReX[3] = tL; lReY[3] = yl3;\nlet sL = lDelRe; lDelRe = yl3;\n\nlet tLi = xL;\nlet yli0 = cIm0 * (tLi - lImY[0]) + lImX[0]; lImX[0] = tLi; lImY[0] = yli0; tLi = yli0;\nlet yli1 = cIm1 * (tLi - lImY[1]) + lImX[1]; lImX[1] = tLi; lImY[1] = yli1; tLi = yli1;\nlet yli2 = cIm2 * (tLi - lImY[2]) + lImX[2]; lImX[2] = tLi; lImY[2] = yli2; tLi = yli2;\nlet yli3 = cIm3 * (tLi - lImY[3]) + lImX[3]; lImX[3] = tLi; lImY[3] = yli3;\nlet shatL = yli3;\n\n// Right Channel Hilbert -> (sR, shatR)\nlet tR = xR;\nlet yr0 = cRe0 * (tR - rReY[0]) + rReX[0]; rReX[0] = tR; rReY[0] = yr0; tR = yr0;\nlet yr1 = cRe1 * (tR - rReY[1]) + rReX[1]; rReX[1] = tR; rReY[1] = yr1; tR = yr1;\nlet yr2 = cRe2 * (tR - rReY[2]) + rReX[2]; rReX[2] = tR; rReY[2] = yr2; tR = yr2;\nlet yr3 = cRe3 * (tR - rReY[3]) + rReX[3]; rReX[3] = tR; rReY[3] = yr3;\nlet sR = rDelRe; rDelRe = yr3;\n\nlet tRi = xR;\nlet yri0 = cIm0 * (tRi - rImY[0]) + rImX[0]; rImX[0] = tRi; rImY[0] = yri0; tRi = yri0;\nlet yri1 = cIm1 * (tRi - rImY[1]) + rImX[1]; rImX[1] = tRi; rImY[1] = yri1; tRi = yri1;\nlet yri2 = cIm2 * (tRi - rImY[2]) + rImX[2]; rImX[2] = tRi; rImY[2] = yri2; tRi = yri2;\nlet yri3 = cIm3 * (tRi - rImY[3]) + rImX[3]; rImX[3] = tRi; rImY[3] = yri3;\nlet shatR = yri3;\n\n// --- 3. Quadrature Oscillator & SSB Sideband Selection ---\nlet ph = shiftPhasor.next(finalShiftHz);\nlet cosW = cos(2.0 * pi * ph);\nlet sinW = sin(2.0 * pi * ph);\n\nlet upL = sL * cosW - shatL * sinW;\nlet dnL = sL * cosW + shatL * sinW;\nlet upR = sR * cosW - shatR * sinW;\nlet dnR = sR * cosW + shatR * sinW;\n\n// up_down_stereo:\n//  -1.0: Both channels Down-shifted\n//   0.0: Stereo Split (Left = Up-shifted, Right = Down-shifted -> huge barber-pole reese)\n//  +1.0: Both channels Up-shifted\nlet uds = clamp(up_down_stereo, -1.0, 1.0);\nlet wetL = (uds < 0.0) ? linearinterp(uds + 1.0, dnL, upL) : upL;\nlet wetR = (uds < 0.0) ? dnR : linearinterp(uds, dnR, upR);\n\n// --- 4. DC Blocker (essential when shift approaches -f0 \"through-zero\" gnarl) ---\nlet dcCoeff = 1.0 - (2.0 * pi * 12.0 / sr);\nlet cleanL = wetL - dcXL + dcCoeff * dcYL; dcXL = wetL; dcYL = cleanL;\nlet cleanR = wetR - dcXR + dcCoeff * dcYR; dcXR = wetR; dcYR = cleanR;\n\nout1 = linearinterp(clamp(mix, 0.0, 1.0), xL, cleanL);\nout2 = linearinterp(clamp(mix, 0.0, 1.0), xR, cleanR);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 3,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 11_bode_ssb_freq_shifter.txt\n// Unix-Style Effect 11: Pitch-Relative Bode / SSB Frequency Shifter\n// Implements Approach 3c from \"Novel Distortion Approaches for Live Tuba\" and\n// Wardle (DAFx-99) Hilbert Transform Single-Sideband Frequency Shifter:\n//   y_up   = s*cos(w_s*t) - s_hat*sin(w_s*t)\n//   y_down = s*cos(w_s*t) + s_hat*sin(w_s*t)\n// Shifts every harmonic of the tuba by a fixed Hz OR a tracked ratio of f0\n// (e.g., -0.5*f0 folds the fundamental toward sub-bass while making upper\n// partials clangorously inharmonic or creating lush barber-pole stereo detune).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Optional Tracked Pitch in Hz (if > 20 Hz, enables pitch-proportional shift)\n// Outlets:\n//   out1: Left Frequency-Shifted Output\n//   out2: Right Frequency-Shifted Output\n\n@param({ min: -500.0, max: 500.0 }) shift_hz = -28.0;\n@param({ min: 0.0, max: 1.0 }) f0_track_amt = 0.5;\n@param({ min: -1.0, max: 1.0 }) up_down_stereo = 0.0;\n@param({ min: 0.0, max: 1.0 }) mix = 0.65;\n\n// Stereo 4-stage IIR Hilbert transform states (Left and Right channels)\n@state lReX = new FixedSampleArray(4); @state lReY = new FixedSampleArray(4);\n@state lImX = new FixedSampleArray(4); @state lImY = new FixedSampleArray(4);\n@state lDelRe = 0.0;\n\n@state rReX = new FixedSampleArray(4); @state rReY = new FixedSampleArray(4);\n@state rImX = new FixedSampleArray(4); @state rImY = new FixedSampleArray(4);\n@state rDelRe = 0.0;\n\n@state shiftPhasor = new phasor();\n@state smoothF0 = 55.0;\n\n// DC Blockers (for shifts near -f0 that fold fundamental to 0 Hz DC)\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch-Proportional vs. Fixed Hz Shift Calculation ---\nif (pitchIn > 20.0 && pitchIn < 1000.0) {\n\tsmoothF0 += (pitchIn - smoothF0) * (1.0 - exp(-1.0 / (0.008 * sr)));\n}\n\n// Nonlinear cubic taper around 0 Hz on shift_hz so small barber-pole shifts (0.5..15 Hz)\n// are easy to dial in, while outer extremes reach +/- 500 Hz clangorous metal\nlet normShift = clamp(shift_hz / 500.0, -1.0, 1.0);\nlet taperedHz = 500.0 * (0.25 * normShift + 0.75 * normShift * normShift * normShift);\n\n// When f0_track_amt > 0, scale shift proportionally to smoothF0 / 55 Hz\nlet pitchScale = linearinterp(clamp(f0_track_amt, 0.0, 1.0), 1.0, smoothF0 / 55.0);\nlet finalShiftHz = clamp(taperedHz * pitchScale, -2000.0, 2000.0);\n\n// --- 2. Quadrature Hilbert Transform on Left & Right Channels ---\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935; let cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323; let cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\n// Left Channel Hilbert -> (sL, shatL)\nlet tL = xL;\nlet yl0 = cRe0 * (tL - lReY[0]) + lReX[0]; lReX[0] = tL; lReY[0] = yl0; tL = yl0;\nlet yl1 = cRe1 * (tL - lReY[1]) + lReX[1]; lReX[1] = tL; lReY[1] = yl1; tL = yl1;\nlet yl2 = cRe2 * (tL - lReY[2]) + lReX[2]; lReX[2] = tL; lReY[2] = yl2; tL = yl2;\nlet yl3 = cRe3 * (tL - lReY[3]) + lReX[3]; lReX[3] = tL; lReY[3] = yl3;\nlet sL = lDelRe; lDelRe = yl3;\n\nlet tLi = xL;\nlet yli0 = cIm0 * (tLi - lImY[0]) + lImX[0]; lImX[0] = tLi; lImY[0] = yli0; tLi = yli0;\nlet yli1 = cIm1 * (tLi - lImY[1]) + lImX[1]; lImX[1] = tLi; lImY[1] = yli1; tLi = yli1;\nlet yli2 = cIm2 * (tLi - lImY[2]) + lImX[2]; lImX[2] = tLi; lImY[2] = yli2; tLi = yli2;\nlet yli3 = cIm3 * (tLi - lImY[3]) + lImX[3]; lImX[3] = tLi; lImY[3] = yli3;\nlet shatL = yli3;\n\n// Right Channel Hilbert -> (sR, shatR)\nlet tR = xR;\nlet yr0 = cRe0 * (tR - rReY[0]) + rReX[0]; rReX[0] = tR; rReY[0] = yr0; tR = yr0;\nlet yr1 = cRe1 * (tR - rReY[1]) + rReX[1]; rReX[1] = tR; rReY[1] = yr1; tR = yr1;\nlet yr2 = cRe2 * (tR - rReY[2]) + rReX[2]; rReX[2] = tR; rReY[2] = yr2; tR = yr2;\nlet yr3 = cRe3 * (tR - rReY[3]) + rReX[3]; rReX[3] = tR; rReY[3] = yr3;\nlet sR = rDelRe; rDelRe = yr3;\n\nlet tRi = xR;\nlet yri0 = cIm0 * (tRi - rImY[0]) + rImX[0]; rImX[0] = tRi; rImY[0] = yri0; tRi = yri0;\nlet yri1 = cIm1 * (tRi - rImY[1]) + rImX[1]; rImX[1] = tRi; rImY[1] = yri1; tRi = yri1;\nlet yri2 = cIm2 * (tRi - rImY[2]) + rImX[2]; rImX[2] = tRi; rImY[2] = yri2; tRi = yri2;\nlet yri3 = cIm3 * (tRi - rImY[3]) + rImX[3]; rImX[3] = tRi; rImY[3] = yri3;\nlet shatR = yri3;\n\n// --- 3. Quadrature Oscillator & SSB Sideband Selection ---\nlet ph = shiftPhasor.next(finalShiftHz);\nlet cosW = cos(2.0 * pi * ph);\nlet sinW = sin(2.0 * pi * ph);\n\nlet upL = sL * cosW - shatL * sinW;\nlet dnL = sL * cosW + shatL * sinW;\nlet upR = sR * cosW - shatR * sinW;\nlet dnR = sR * cosW + shatR * sinW;\n\n// up_down_stereo:\n//  -1.0: Both channels Down-shifted\n//   0.0: Stereo Split (Left = Up-shifted, Right = Down-shifted -> huge barber-pole reese)\n//  +1.0: Both channels Up-shifted\nlet uds = clamp(up_down_stereo, -1.0, 1.0);\nlet wetL = (uds < 0.0) ? linearinterp(uds + 1.0, dnL, upL) : upL;\nlet wetR = (uds < 0.0) ? dnR : linearinterp(uds, dnR, upR);\n\n// --- 4. DC Blocker (essential when shift approaches -f0 \"through-zero\" gnarl) ---\nlet dcCoeff = 1.0 - (2.0 * pi * 12.0 / sr);\nlet cleanL = wetL - dcXL + dcCoeff * dcYL; dcXL = wetL; dcYL = cleanL;\nlet cleanR = wetR - dcXR + dcCoeff * dcYR; dcXR = wetR; dcYR = cleanR;\n\nout1 = linearinterp(clamp(mix, 0.0, 1.0), xL, cleanL);\nout2 = linearinterp(clamp(mix, 0.0, 1.0), xR, cleanR);\n",
                                        "expr": ""
