                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 94.0, 420.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// 13_inst_riddim_wobble_titan.txt\n// Advanced Instrument 1: Riddim Wobble Titan\n// Complete Tuba-to-Dubstep/Riddim Instrument in a single codebox~:\n//   1. Pitch-Tracked Harmonic Sine-ifier (isolates f0 with envelope normalization)\n//   2. Phase-Locked Sub-Octave Carrier + Tuba Modulator FM Synthesis (with Joy X)\n//   3. ADAA1 Wavefolder & Asymmetric Saturation (with Joy Y)\n//   4. 8-Stage Allpass Phase Disperser (for liquid transient \"chirp\")\n//   5. 1-Bar Phasor-Synced Dual SVF Morphing Wobble Filter (Lowpass <-> Bandpass/Notch)\n// Designed for live performance with a game controller attached to the tuba.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs wobble LFO; internal fallback if unpatched)\n// Outlets:\n//   out1: Left Stereo Dubstep Instrument Output\n//   out2: Right Stereo Dubstep Instrument Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_filtsweep = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_fm_scream = 0.0;\n@param({ min: 1.0, max: 16.0, steps: 16 }) wobble_rate = 4.0;\n@param({ min: 0.0, max: 1.0 }) wobble_shape = 0.35;\n@param({ min: 0.0, max: 36.0 }) sine_boost_db = 24.0;\n@param({ min: 0.0, max: 1.0 }) sub_oct_level = 0.75;\n@param({ min: 0.0, max: 1.0 }) disperse_amt = 0.6;\n@param({ min: 0.0, max: 1.0 }) filter_res = 0.72;\n\n// Pitch-tracked bell isolator + envelope follower\n@state bqIso = new biquad();\n@state svfIso = new svf();\n@state lpTrack = new onepole();\n@state prevTrack = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state envFast = 0.0;\n@state envSlow = 0.0;\n\n// Carrier & Sub-octave oscillators\n@state carPhasor = new phasor();\n@state subPhasor = new phasor();\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n\n// ADAA1 Wavefolder state\n@state prevXL = 0.0; @state prevF1L = 0.0;\n@state prevXR = 0.0; @state prevF1R = 0.0;\n\n// 8-stage 2nd-order Allpass Disperser state per channel\n@state apZ1L = new FixedSampleArray(8);\n@state apZ2L = new FixedSampleArray(8);\n@state apZ1R = new FixedSampleArray(8);\n@state apZ2R = new FixedSampleArray(8);\n\n// Dual Stereo SVF Wobble Filter states\n@state wobSvfL1 = new svf();\n@state wobSvfR1 = new svf();\n@state wobSvfL2 = new svf();\n@state wobSvfR2 = new svf();\n\n// Smoothers for joystick X/Y\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.0;\n\nfunction folderF1(x: number): number {\n\tlet ax = abs(x);\n\tlet logCosh = ax + log(1.0 + exp(-2.0 * ax)) - 0.69314718056;\n\treturn (-cos(pi * x) / pi) + 0.5 * logCosh;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch Tracking & Joystick Smoothing ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevTrack <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevTrack = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slewFast = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slewFast;\nsmoothJoyX += (clamp(joy_x_filtsweep, -1.0, 1.0) - smoothJoyX) * slewFast;\nsmoothJoyY += (clamp(joy_y_fm_scream, -1.0, 1.0) - smoothJoyY) * slewFast;\n\nlet f0 = clamp(smoothF0, 24.0, 800.0);\n\n// --- 2. Fundamental Sine-ifier & Dynamic Envelope Extraction ---\nlet A_iso = pow(10.0, clamp(sine_boost_db, 0.0, 36.0) / 40.0);\nlet w0 = 2.0 * pi * f0 / sr;\nlet alphaIso = sin(w0) / (2.0 * 4.5);\nlet a0_inv = 1.0 / (1.0 + alphaIso / A_iso);\nlet b0 = (1.0 + alphaIso * A_iso) * a0_inv;\nlet b1 = (-2.0 * cos(w0)) * a0_inv;\nlet b2 = (1.0 - alphaIso * A_iso) * a0_inv;\nlet a1 = b1;\nlet a2 = (1.0 - alphaIso / A_iso) * a0_inv;\n\nlet boosted = bqIso.next(mono, b0, b1, b2, a1, a2) / pow(A_iso, 1.25);\nlet isoSine = svfIso.next(boosted, f0, 0.75)[2] * 2.0;\n\nlet absIn = abs(isoSine);\nenvFast += (absIn - envFast) * (1.0 - exp(-1.0 / (0.003 * sr)));\nenvSlow += (absIn - envSlow) * (1.0 - exp(-1.0 / (0.035 * sr)));\nlet gate = clamp((envSlow - 0.0008) * 250.0, 0.0, 1.0);\nlet uMod = tanh(isoSine / (envFast * 1.2 + 0.0006)) * gate;\n\n// --- 3. Adaptive FM + Sub-Octave Synthesis Driven by Joystick Y ---\n// Joystick Y [-1..1] sweeps FM index and harmonic carrier ratio (1x -> 2x/3x scream)\nlet joyY_unip = 0.5 * (smoothJoyY + 1.0);\nlet fmIndex = (1.2 + 5.5 * pow(joyY_unip, 1.3)) * (0.4 + 0.6 * clamp(envSlow * 3.0, 0.0, 1.0));\nlet harmMult = (smoothJoyY > 0.25) ? (1.0 + floor((smoothJoyY - 0.25) * 4.0)) : 1.0;\n\nlet cPh = carPhasor.next(f0 * harmMult);\nlet subPh = subPhasor.next(f0 * 0.5);\n\n// Stereo phase-modulated carrier locked to tuba modulator uMod\nlet fmL = cos(2.0 * pi * cPh + fmIndex * uMod);\nlet fmR = cos(2.0 * pi * (cPh + 0.04) + fmIndex * uMod * 0.92);\n\n// Clean + 3rd-harmonic rich Sub-Octave foundation\nlet subWave = (sin(2.0 * pi * subPh) + 0.25 * sin(6.0 * pi * subPh)) * clamp(sub_oct_level, 0.0, 1.0);\n\n// Combine FM carrier, raw brass articulation, and ADAA1 Wavefolder\nlet preFoldL = (fmL * 0.75 + xL * 0.45) * (1.0 + 1.8 * joyY_unip);\nlet preFoldR = (fmR * 0.75 + xR * 0.45) * (1.0 + 1.8 * joyY_unip);\n\nlet dL = preFoldL - prevXL;\nlet f1L = folderF1(preFoldL);\nlet foldL = (abs(dL) > 0.00001) ? ((f1L - prevF1L) / dL) : (sin(pi * preFoldL) + 0.5 * tanh(preFoldL));\nprevXL = preFoldL; prevF1L = f1L;\n\nlet dR = preFoldR - prevXR;\nlet f1R = folderF1(preFoldR);\nlet foldR = (abs(dR) > 0.00001) ? ((f1R - prevF1R) / dR) : (sin(pi * preFoldR) + 0.5 * tanh(preFoldR));\nprevXR = preFoldR; prevF1R = f1R;\n\nlet synthL = (foldL * 0.7 + subWave * 0.85) * clamp(envSlow * 2.2, 0.0, 1.2) * gate;\nlet synthR = (foldR * 0.7 + subWave * 0.85) * clamp(envSlow * 2.2, 0.0, 1.2) * gate;\n\n// --- 4. 8-Stage Allpass Phase Disperser ---\nlet apW0 = 2.0 * pi * clamp(f0 * 2.5, 90.0, 1200.0) / sr;\nlet apAlpha = sin(apW0) / (2.0 * 2.5);\nlet apA0_inv = 1.0 / (1.0 + apAlpha);\nlet apB0 = (1.0 - apAlpha) * apA0_inv;\nlet apB1 = (-2.0 * cos(apW0)) * apA0_inv;\n\nlet dispL = synthL;\nlet dispR = synthR;\nfor (let i: Int = 0; i < 8; i++) {\n\tlet yL = apB0 * dispL + apZ1L[i];\n\tapZ1L[i] = apB1 * dispL - apB1 * yL + apZ2L[i];\n\tapZ2L[i] = dispL - apB0 * yL;\n\tdispL = yL;\n\n\tlet yR = apB0 * dispR + apZ1R[i];\n\tapZ1R[i] = apB1 * dispR - apB1 * yR + apZ2R[i];\n\tapZ2R[i] = dispR - apB0 * yR;\n\tdispR = yR;\n}\nlet postDispL = linearinterp(clamp(disperse_amt, 0.0, 1.0), synthL, dispL);\nlet postDispR = linearinterp(clamp(disperse_amt, 0.0, 1.0), synthR, dispR);\n\n// --- 5. 1-Bar Phasor-Synced Wobble LFO + Joystick X Filter Control ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet subRate = floor(clamp(wobble_rate, 1.0, 16.0));\nlet wobPh = wrap(barPh * subRate, 0.0, 1.0);\n\n// Morph wobble LFO shape: Sine (0.0) -> Riddim Whip Triangle (0.5) -> Chopped Square/Ramp (1.0)\nlet shp = clamp(wobble_shape, 0.0, 1.0);\nlet lfoSin = 0.5 - 0.5 * cos(2.0 * pi * wobPh);\nlet lfoWhip = pow(triangle(wobPh, 0.2), 1.5);\nlet lfoChop = (wobPh < 0.55) ? pow(1.0 - wobPh / 0.55, 0.7) : 0.0;\nlet wobEnv = (shp < 0.5) ? linearinterp(shp * 2.0, lfoSin, lfoWhip) : linearinterp((shp - 0.5) * 2.0, lfoWhip, lfoChop);\n\n// Cutoff combines Wobble LFO + Joystick X manual sweep (exponentially mapped 75 Hz .. 6500 Hz)\nlet cutoffExp = clamp(0.15 + 0.65 * wobEnv + 0.45 * smoothJoyX, 0.0, 1.0);\nlet cutoffHz = 70.0 * pow(90.0, cutoffExp);\nlet qSvf = clamp(0.55 + 0.4 * pow(clamp(filter_res, 0.0, 1.0), 1.2), 0.5, 0.96);\n\nlet svfOutL1 = wobSvfL1.next(postDispL, cutoffHz, qSvf);\nlet svfOutR1 = wobSvfR1.next(postDispR, cutoffHz * 1.04, qSvf);\n\n// Morph LP + BP peak when Joystick Y is pushed up for vocal \"yoink\" formant\nlet bpBlend = clamp(0.25 + 0.45 * joyY_unip, 0.0, 0.75);\nlet stage1L = svfOutL1[0] + bpBlend * svfOutL1[2];\nlet stage1R = svfOutR1[0] + bpBlend * svfOutR1[2];\n\nlet svfOutL2 = wobSvfL2.next(stage1L, cutoffHz * 1.35, qSvf * 0.85);\nlet svfOutR2 = wobSvfR2.next(stage1R, cutoffHz * 1.40, qSvf * 0.85);\n\nout1 = tanh((svfOutL2[0] + 0.35 * svfOutL2[2]) * 1.3);\nout2 = tanh((svfOutR2[0] + 0.35 * svfOutR2[2]) * 1.3);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "code": "// ============================================================================\n// 13_inst_riddim_wobble_titan.txt\n// Advanced Instrument 1: Riddim Wobble Titan\n// Complete Tuba-to-Dubstep/Riddim Instrument in a single codebox~:\n//   1. Pitch-Tracked Harmonic Sine-ifier (isolates f0 with envelope normalization)\n//   2. Phase-Locked Sub-Octave Carrier + Tuba Modulator FM Synthesis (with Joy X)\n//   3. ADAA1 Wavefolder & Asymmetric Saturation (with Joy Y)\n//   4. 8-Stage Allpass Phase Disperser (for liquid transient \"chirp\")\n//   5. 1-Bar Phasor-Synced Dual SVF Morphing Wobble Filter (Lowpass <-> Bandpass/Notch)\n// Designed for live performance with a game controller attached to the tuba.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (Tuba)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n//   in4: 1-Bar Audio-Rate Phasor [0..1] (syncs wobble LFO; internal fallback if unpatched)\n// Outlets:\n//   out1: Left Stereo Dubstep Instrument Output\n//   out2: Right Stereo Dubstep Instrument Output\n\n@param({ min: -1.0, max: 1.0 }) joy_x_filtsweep = 0.0;\n@param({ min: -1.0, max: 1.0 }) joy_y_fm_scream = 0.0;\n@param({ min: 1.0, max: 16.0, steps: 16 }) wobble_rate = 4.0;\n@param({ min: 0.0, max: 1.0 }) wobble_shape = 0.35;\n@param({ min: 0.0, max: 36.0 }) sine_boost_db = 24.0;\n@param({ min: 0.0, max: 1.0 }) sub_oct_level = 0.75;\n@param({ min: 0.0, max: 1.0 }) disperse_amt = 0.6;\n@param({ min: 0.0, max: 1.0 }) filter_res = 0.72;\n\n// Pitch-tracked bell isolator + envelope follower\n@state bqIso = new biquad();\n@state svfIso = new svf();\n@state lpTrack = new onepole();\n@state prevTrack = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n@state envFast = 0.0;\n@state envSlow = 0.0;\n\n// Carrier & Sub-octave oscillators\n@state carPhasor = new phasor();\n@state subPhasor = new phasor();\n@state fallbackBar = new phasor();\n@state prevBarIn = 0.0;\n\n// ADAA1 Wavefolder state\n@state prevXL = 0.0; @state prevF1L = 0.0;\n@state prevXR = 0.0; @state prevF1R = 0.0;\n\n// 8-stage 2nd-order Allpass Disperser state per channel\n@state apZ1L = new FixedSampleArray(8);\n@state apZ2L = new FixedSampleArray(8);\n@state apZ1R = new FixedSampleArray(8);\n@state apZ2R = new FixedSampleArray(8);\n\n// Dual Stereo SVF Wobble Filter states\n@state wobSvfL1 = new svf();\n@state wobSvfR1 = new svf();\n@state wobSvfL2 = new svf();\n@state wobSvfR2 = new svf();\n\n// Smoothers for joystick X/Y\n@state smoothJoyX = 0.0;\n@state smoothJoyY = 0.0;\n\nfunction folderF1(x: number): number {\n\tlet ax = abs(x);\n\tlet logCosh = ax + log(1.0 + exp(-2.0 * ax)) - 0.69314718056;\n\treturn (-cos(pi * x) / pi) + 0.5 * logCosh;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch Tracking & Joystick Smoothing ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 180.0);\nzcCount += 1.0;\nif (prevTrack <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevTrack = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slewFast = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slewFast;\nsmoothJoyX += (clamp(joy_x_filtsweep, -1.0, 1.0) - smoothJoyX) * slewFast;\nsmoothJoyY += (clamp(joy_y_fm_scream, -1.0, 1.0) - smoothJoyY) * slewFast;\n\nlet f0 = clamp(smoothF0, 24.0, 800.0);\n\n// --- 2. Fundamental Sine-ifier & Dynamic Envelope Extraction ---\nlet A_iso = pow(10.0, clamp(sine_boost_db, 0.0, 36.0) / 40.0);\nlet w0 = 2.0 * pi * f0 / sr;\nlet alphaIso = sin(w0) / (2.0 * 4.5);\nlet a0_inv = 1.0 / (1.0 + alphaIso / A_iso);\nlet b0 = (1.0 + alphaIso * A_iso) * a0_inv;\nlet b1 = (-2.0 * cos(w0)) * a0_inv;\nlet b2 = (1.0 - alphaIso * A_iso) * a0_inv;\nlet a1 = b1;\nlet a2 = (1.0 - alphaIso / A_iso) * a0_inv;\n\nlet boosted = bqIso.next(mono, b0, b1, b2, a1, a2) / pow(A_iso, 1.25);\nlet isoSine = svfIso.next(boosted, f0, 0.75)[2] * 2.0;\n\nlet absIn = abs(isoSine);\nenvFast += (absIn - envFast) * (1.0 - exp(-1.0 / (0.003 * sr)));\nenvSlow += (absIn - envSlow) * (1.0 - exp(-1.0 / (0.035 * sr)));\nlet gate = clamp((envSlow - 0.0008) * 250.0, 0.0, 1.0);\nlet uMod = tanh(isoSine / (envFast * 1.2 + 0.0006)) * gate;\n\n// --- 3. Adaptive FM + Sub-Octave Synthesis Driven by Joystick Y ---\n// Joystick Y [-1..1] sweeps FM index and harmonic carrier ratio (1x -> 2x/3x scream)\nlet joyY_unip = 0.5 * (smoothJoyY + 1.0);\nlet fmIndex = (1.2 + 5.5 * pow(joyY_unip, 1.3)) * (0.4 + 0.6 * clamp(envSlow * 3.0, 0.0, 1.0));\nlet harmMult = (smoothJoyY > 0.25) ? (1.0 + floor((smoothJoyY - 0.25) * 4.0)) : 1.0;\n\nlet cPh = carPhasor.next(f0 * harmMult);\nlet subPh = subPhasor.next(f0 * 0.5);\n\n// Stereo phase-modulated carrier locked to tuba modulator uMod\nlet fmL = cos(2.0 * pi * cPh + fmIndex * uMod);\nlet fmR = cos(2.0 * pi * (cPh + 0.04) + fmIndex * uMod * 0.92);\n\n// Clean + 3rd-harmonic rich Sub-Octave foundation\nlet subWave = (sin(2.0 * pi * subPh) + 0.25 * sin(6.0 * pi * subPh)) * clamp(sub_oct_level, 0.0, 1.0);\n\n// Combine FM carrier, raw brass articulation, and ADAA1 Wavefolder\nlet preFoldL = (fmL * 0.75 + xL * 0.45) * (1.0 + 1.8 * joyY_unip);\nlet preFoldR = (fmR * 0.75 + xR * 0.45) * (1.0 + 1.8 * joyY_unip);\n\nlet dL = preFoldL - prevXL;\nlet f1L = folderF1(preFoldL);\nlet foldL = (abs(dL) > 0.00001) ? ((f1L - prevF1L) / dL) : (sin(pi * preFoldL) + 0.5 * tanh(preFoldL));\nprevXL = preFoldL; prevF1L = f1L;\n\nlet dR = preFoldR - prevXR;\nlet f1R = folderF1(preFoldR);\nlet foldR = (abs(dR) > 0.00001) ? ((f1R - prevF1R) / dR) : (sin(pi * preFoldR) + 0.5 * tanh(preFoldR));\nprevXR = preFoldR; prevF1R = f1R;\n\nlet synthL = (foldL * 0.7 + subWave * 0.85) * clamp(envSlow * 2.2, 0.0, 1.2) * gate;\nlet synthR = (foldR * 0.7 + subWave * 0.85) * clamp(envSlow * 2.2, 0.0, 1.2) * gate;\n\n// --- 4. 8-Stage Allpass Phase Disperser ---\nlet apW0 = 2.0 * pi * clamp(f0 * 2.5, 90.0, 1200.0) / sr;\nlet apAlpha = sin(apW0) / (2.0 * 2.5);\nlet apA0_inv = 1.0 / (1.0 + apAlpha);\nlet apB0 = (1.0 - apAlpha) * apA0_inv;\nlet apB1 = (-2.0 * cos(apW0)) * apA0_inv;\n\nlet dispL = synthL;\nlet dispR = synthR;\nfor (let i: Int = 0; i < 8; i++) {\n\tlet yL = apB0 * dispL + apZ1L[i];\n\tapZ1L[i] = apB1 * dispL - apB1 * yL + apZ2L[i];\n\tapZ2L[i] = dispL - apB0 * yL;\n\tdispL = yL;\n\n\tlet yR = apB0 * dispR + apZ1R[i];\n\tapZ1R[i] = apB1 * dispR - apB1 * yR + apZ2R[i];\n\tapZ2R[i] = dispR - apB0 * yR;\n\tdispR = yR;\n}\nlet postDispL = linearinterp(clamp(disperse_amt, 0.0, 1.0), synthL, dispL);\nlet postDispR = linearinterp(clamp(disperse_amt, 0.0, 1.0), synthR, dispR);\n\n// --- 5. 1-Bar Phasor-Synced Wobble LFO + Joystick X Filter Control ---\nlet barActive = (abs(barIn - prevBarIn) > 0.0000001 || (barIn > 0.0001 && barIn < 0.9999));\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : fallbackBar.next(0.5);\n\nlet subRate = floor(clamp(wobble_rate, 1.0, 16.0));\nlet wobPh = wrap(barPh * subRate, 0.0, 1.0);\n\n// Morph wobble LFO shape: Sine (0.0) -> Riddim Whip Triangle (0.5) -> Chopped Square/Ramp (1.0)\nlet shp = clamp(wobble_shape, 0.0, 1.0);\nlet lfoSin = 0.5 - 0.5 * cos(2.0 * pi * wobPh);\nlet lfoWhip = pow(triangle(wobPh, 0.2), 1.5);\nlet lfoChop = (wobPh < 0.55) ? pow(1.0 - wobPh / 0.55, 0.7) : 0.0;\nlet wobEnv = (shp < 0.5) ? linearinterp(shp * 2.0, lfoSin, lfoWhip) : linearinterp((shp - 0.5) * 2.0, lfoWhip, lfoChop);\n\n// Cutoff combines Wobble LFO + Joystick X manual sweep (exponentially mapped 75 Hz .. 6500 Hz)\nlet cutoffExp = clamp(0.15 + 0.65 * wobEnv + 0.45 * smoothJoyX, 0.0, 1.0);\nlet cutoffHz = 70.0 * pow(90.0, cutoffExp);\nlet qSvf = clamp(0.55 + 0.4 * pow(clamp(filter_res, 0.0, 1.0), 1.2), 0.5, 0.96);\n\nlet svfOutL1 = wobSvfL1.next(postDispL, cutoffHz, qSvf);\nlet svfOutR1 = wobSvfR1.next(postDispR, cutoffHz * 1.04, qSvf);\n\n// Morph LP + BP peak when Joystick Y is pushed up for vocal \"yoink\" formant\nlet bpBlend = clamp(0.25 + 0.45 * joyY_unip, 0.0, 0.75);\nlet stage1L = svfOutL1[0] + bpBlend * svfOutL1[2];\nlet stage1R = svfOutR1[0] + bpBlend * svfOutR1[2];\n\nlet svfOutL2 = wobSvfL2.next(stage1L, cutoffHz * 1.35, qSvf * 0.85);\nlet svfOutR2 = wobSvfR2.next(stage1R, cutoffHz * 1.40, qSvf * 0.85);\n\nout1 = tanh((svfOutL2[0] + 0.35 * svfOutL2[2]) * 1.3);\nout2 = tanh((svfOutR2[0] + 0.35 * svfOutR2[2]) * 1.3);\n",
                                        "expr": ""
                                    },
                                    "rnbo_serial": 2,
                                    "rnbo_uniqueid": "effect_code",
